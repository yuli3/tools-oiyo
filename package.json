{
  "name": "tools-oiyo",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro",
    "type-check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "ASTRO_TELEMETRY_DISABLED=1 astro check && npm run lint:shadcn",
    "lint:shadcn": "eslint --pass-on-unpruned-suppressions src",
    "lint:shadcn:prune": "eslint --prune-suppressions src",
    "test": "node --test scripts/kr-rates.test.mjs scripts/car-bond.test.mjs && npm run test:file-utilities && npm run test:monitor-ppi && npm run test:loan-comparison && npm run test:country-labor && npm run test:usage-cost",
    "test:usage-cost": "node --experimental-strip-types --test src/lib/usage-cost.test.ts",
    "test:usage-cost-html": "node --test scripts/usage-cost-html.test.mjs",
    "test:loan-comparison": "node --experimental-strip-types --test src/lib/loan-comparison.test.ts",
    "test:loan-comparison-html": "node --test scripts/loan-comparison-html.test.mjs",
    "test:country-labor": "node --experimental-strip-types --test src/lib/japan-premium.test.ts src/lib/singapore-month.test.ts src/lib/taiwan-leave.test.ts",
    "test:country-labor-html": "node --test scripts/country-labor-html.test.mjs",
    "test:monitor-ppi": "node --experimental-strip-types --test src/lib/monitor-ppi.test.ts",
    "test:monitor-ppi-html": "node --test scripts/monitor-ppi-html.test.mjs",
    "test:file-utilities": "node --experimental-strip-types --test src/lib/image-fit.test.ts src/lib/pdf-ranges.test.ts src/lib/qr-payload.test.ts",
    "test:file-utilities-html": "node --test scripts/file-utilities.test.mjs",
    "sync:kr-rates": "node scripts/sync-kr-rates.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.15",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "vite": "6.4.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/qrcode": "^1.5.5",
    "@astrojs/check": "^0.9.10",
    "@shadcn/lint": "^0.2.1",
    "@typescript-eslint/parser": "^8.71.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3"
  }
}
