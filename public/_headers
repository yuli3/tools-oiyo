# Cloudflare Pages cache & security headers
# tools.oiyo.net

# STATIC ASSETS — immutable long cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# IMAGES & ICONS — 1 week CDN
/*.png
  Cache-Control: public, max-age=604800, s-maxage=604800, stale-while-revalidate=86400

/*.ico
  Cache-Control: public, max-age=604800, s-maxage=604800

/*.svg
  Cache-Control: public, max-age=604800, s-maxage=604800
  X-Content-Type-Options: nosniff

# MANIFEST & SEO
/manifest.json
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

/simple-calculators/*
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap*.xml
  Cache-Control: public, max-age=3600, s-maxage=86400

/ads.txt
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

/llms.txt
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *

# GLOBAL SECURITY HEADERS
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: object-src 'none'; base-uri 'self'; upgrade-insecure-requests

# 구독형 달력(webcal) 피드 — 달력 앱이 하루 한 번 다시 읽어요
/cal/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400
  Access-Control-Allow-Origin: *

# 블로그용 계산기 위젯 — 다른 사이트가 iframe으로 넣어요(noindex, 사용자 정보 없음).
# Cloudflare 규칙은 splat 하나만 돼요.
/ko/embed/*
  ! X-Frame-Options
