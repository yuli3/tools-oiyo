  "formulaTitle": "使用的规则",
  "formulas": [
    {
      "title": "上限",
      "body": "本省上年度就业人员年平均工资 × 50%（第165条）。"
    },
    {
      "title": "约定适用",
      "body": "超过50%但在2倍以下，双方约定可以适用。"
    },
    {
      "title": "审级",
      "body": "一审终审。"
    }
  ],
  "howToTitle": "怎么用",
  "steps": [
    "填写请求金额。",
    "填写本省公布的上年度年平均工资。",
    "查看是否适用小额诉讼。"
  ],
  "faqTitle": "常见问题",
  "faqs": [
    {
      "question": "诉讼时效是几年？",
      "answer": "民法典的诉讼时效这里没有核对，不计算期限。"
