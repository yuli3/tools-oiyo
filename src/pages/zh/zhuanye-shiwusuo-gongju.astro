---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import ProOffice from '../../components/tools/office/ProOffice';
import { officeFloors, OFFICE_AS_OF } from '../../data/pro-office';
import { OFFICE_COPY } from '../../data/pro-office-copy';
// Practice office hub (2026-11-23). No new calculation: existing tools, MCP tools and Claude skills arranged as floors and rooms.
const c = {
  "introTitle": "实务办公室",
  "intro": "为从业者及其客户准备的工具，按事务所的样子排列：前台、每个国家一层、每层六个房间。每个房间都有会改变结论的受理问题、基于该国官方资料的计算与核对工具、AI 工具，以及可打印的咨询记录。",
  "formulaTitle": "每个房间里有什么",
  "formulas": [
    {
      "title": "受理",
      "body": "每个房间5个会改变结论的问题：谁的、哪个期间、哪些凭证、哪个期限、哪份通知。"
    },
    {
      "title": "工具",
      "body": "该国的计算与核对工具，标明面向咨询者或从业者，可收藏。"
    },
    {
      "title": "咨询记录",
      "body": "勾选的问题、用过的工具和备注，连同免费官方渠道打印成一页。"
    }
  ],
  "howToTitle": "使用方法",
  "steps": [
    "在楼层导览上选择国家。",
    "进入税务、劳动、生活·行政、法务、通关或理财规划房间。",
    "勾选受理问题，打开要用的工具并勾选加入记录。",
    "打印咨询记录存档。"
  ],
  "faqTitle": "常见问题",
  "faqs": [
    {
      "question": "这是律师事务所或税务师事务所吗？",
      "answer": "不是。这里是免费工具和一般信息，不提供咨询、代理或申报。每个房间都列出了免费官方渠道。"
    },
    {
      "question": "输入的内容会被保存吗？",
      "answer": "勾选、备注和客户名称只保存在这个浏览器里，不会发送到任何地方。"
    }
  ],
  "disclaimer": "仅为一般信息，不构成法律、税务或投资意见。"
};
const sources: [string, string][] = [
  ["OIYO MCP server (world)", "https://api.oiyo.net/mcp/world"],
  ["oiyo-skills (GitHub)", "https://github.com/yuli3/oiyo-skills"],
];
const floors = officeFloors('zh');
---
<DebtReliefPage slug="zhuanye-shiwusuo-gongju" c={c} sources={sources} sourcesTitle="来源" checked="工具列表核对于 2026-11-23">
  <ProOffice client:load locale="zh" floors={floors} copy={OFFICE_COPY['zh']} asOf={OFFICE_AS_OF} />
</DebtReliefPage>
