    },
    {
      "title": "Dépôt au greffe",
      "body": "1 mois après l'approbation sur papier, 2 mois par voie électronique."
    },
    {
      "title": "Sanction",
      "body": "Amende de 1 500 € (3 000 € en récidive), injonction sous astreinte."
    }
  ],
  "howToTitle": "Mode d'emploi",
  "steps": [
    "Saisissez la date de clôture.",
    "Ajoutez la date d'approbation si elle a eu lieu.",
    "Lisez les échéances et la prochaine."
  ],
