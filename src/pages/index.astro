---
import "../styles/global.css";
import { KR_RATES_2026 } from "../lib/kr-rates-2026.mjs";
import Layout from "../components/Layout.astro";
import SavingsQuickLinks from "../components/SavingsQuickLinks.astro";

// 2026-10-17: 카드 설명의 법정 수치는 SSOT에서 읽고, blog.oiyo.net과 겹치지 않는
// 11개 고유 도구만 tools.oiyo.net에 배치해요(세운 결정 2026-10-17).
const R = KR_RATES_2026;
const won = (n: number) => n.toLocaleString("ko-KR");
const pct = (r: number) => Number((r * 100).toFixed(3));

const tools = [
  {
    id: "unemployment-benefits",
    title: "실업급여(구직급여) 모의 계산기",
    desc: `2026년 구직급여 하한액(1일 ${won(R.unemployment.dailyFloor8h)}원)·상한액(1일 ${won(R.unemployment.dailyCap)}원)과 나이·가입기간별 소정급여일수(120~270일)로 총 수급액을 계산해요.`,
    href: "/ko/unemployment-benefits-calculator/",
    category: "노동/복지",
    badge: "2026 기준",
  },
  {
    id: "parental-leave",
    title: "육아휴직 급여 & 6+6 부모육아휴직 계산기",
    desc: "2025년 개편 기준(사후지급금 없이 매월 전액) 일반 육아휴직 급여와 6+6 부모 특례(1·2개월 차 250만 원~6개월 차 450만 원) 월별 수령액을 비교해요.",
    href: "/ko/parental-leave-calculator/",
    category: "복지/육아휴직",
    badge: "부모특례 450만",
  },
  {
    id: "overtime-pay",
    title: "연장·야간·휴일수당 가산수당 계산기",
    desc: "근로기준법 제56조 법정 가산율(연장 1.5배, 야간 +0.5배, 휴일 1.5~2.0배) 기반 주간/월간 수당을 즉시 산출해요.",
    href: "/ko/overtime-pay-calculator/",
    category: "근로/수당",
    badge: "근로기준법 56조",
  },
  {
    id: "health-insurance",
    title: "국민건강보험료 지역가입자 & 피부양자 판정기",
    desc: `2026년 건강보험료율 ${pct(R.health.total)}%·재산 점수당 ${R.regional.pointValue}원·재산 기본공제 1억 원으로 지역 건보료를 계산하고 피부양자 자격을 확인해요.`,
    href: "/ko/health-insurance-calculator/",
    category: "세무/복지",
    badge: "2026 개편",
  },
  {
    id: "temporary-two-house",
    title: "일시적 2주택 비과세 처분기한 시뮬레이터",
    desc: "신규주택 1년 경과 취득 요건, 전국 통일 3년 처분기한 마감일 D-Day 및 비과세 충족 여부를 정밀 판정해요.",
    href: "/ko/temporary-two-house-tax-calculator/",
    category: "부동산/세무",
    badge: "1-2-3 법칙",
  },
  {
    id: "car-bond-refund",
    title: "자동차 채권 환급금 & 공채 할인 매도 계산기",
    desc: "차량 가격과 등록 시·도별 법정 공채 매입 비율·면제 기준, 당일 할인 매도 본인부담금과 만기 상환액을 비교해요.",
    href: "/ko/car-bond-refund-calculator/",
    category: "자동차/세무",
    badge: "시·도별 기준표",
  },
  {
    id: "gas-bill",
    title: "도시가스 요금 계산기 (난방비·취사)",
    desc: "계량기 사용량(m³)을 평균발열량(42.8 MJ/m³)으로 변환하여 주택용 난방·취사 단가, 기본료, 부가세 10%를 반영한 예상 청구액을 산출해요.",
    href: "/ko/gas-bill-calculator/",
    category: "생활/공공요금",
    badge: "가스공사 공식",
  },
  {
    id: "military-service",
    title: "군 복무일 · 전역일 및 진급일 계산기",
    desc: "육군/해병대(18개월), 해군(20개월), 공군/사회복무(21개월) 복무기간 기준 전역일, 남은 일수, 복무율(%), 계급별 진급일을 계산해요.",
    href: "/ko/military-service-calculator/",
    category: "생활/병무",
    badge: "병역법 기준",
  },
  {
    id: "waste-sorter",
    title: "생활 폐기물 분리배출 판별기",
    desc: "헷갈리는 16대 생활 품목의 종량제·음식물·불연성마대·재활용 분류 기준 및 폐기물관리법 근거를 실시간 검색해요.",
    href: "/ko/waste-sorter/",
    category: "생활 규약",
    badge: "인기",
  },
  {
    id: "wind-chill",
    title: "체감온도 및 온열지수 계산기",
    desc: "기상청 공식 JAG/TI 대류 열손실 모델 및 여름철 습구 온열지수 수식으로 실제 피부 체감온도를 정밀 계산해요.",
    href: "/ko/wind-chill-calculator/",
    category: "기상 환경",
    badge: "기상청 공식",
  },
  {
    id: "business-day",
    title: "대한민국 법정 영업일·공휴일 조회기",
    desc: "관공서 공휴일에 관한 규정 및 대체공휴일 픽스처를 기반으로 특정 날짜의 영업일 여부와 휴일 사유를 판별해요.",
    href: "/ko/business-day-checker/",
    category: "캘린더/행정",
    badge: "B2A 연동",
  },
];
---

<Layout
  title="OIYO tools — 일상을 돕는 정밀 웹 유틸리티 허브"
  description="입력값을 브라우저에서 바로 계산하는 생활·복지·행정 계산기 모음이에요. 실업급여·육아휴직·지역 건보료·일시적 2주택 처분기한·자동차 공채·도시가스 요금·전역일 계산기를 제공해요."
  canonicalURL="https://tools.oiyo.net/"
>
  <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-8">
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
        <span>⚡ 100% 클라이언트 연산</span>
        <span>•</span>
        <span>입력값 서버 전송 없음</span>
      </div>
      <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
        일상을 돕는 웹 유틸리티 도구 허브
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        불필요한 스크롤과 로딩 없이 필요한 계산과 분류 결과를 바로 보여 드려요. 방문 통계(Google Analytics)와 광고(AdSense)는 사용해요.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="mb-8 flex flex-wrap items-center gap-2" id="filter-bar">
      <button
        type="button"
        class="filter-btn rounded-lg border border-primary bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground transition shadow-xs"
        data-filter="all"
      >
        전체 보기
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="labor"
      >
        노동 · 복지 · 건보
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="living"
      >
        생활 · 부동산 · 자동차
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="military"
      >
        병무 · 전역
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="environment"
      >
        기상 · 환경
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
      data-filter="calendar"
      >
        캘린더 · 공휴일
      </button>
    </div>

    <!-- Tools Grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="tools-grid">
      {tools.map((tool) => {
        let group = "labor";
        if (["gas-bill", "waste-sorter", "temporary-two-house", "car-bond-refund"].includes(tool.id)) group = "living";
        else if (["unemployment-benefits", "parental-leave", "overtime-pay", "health-insurance"].includes(tool.id)) group = "labor";
        else if (tool.id === "military-service") group = "military";
        else if (tool.id === "wind-chill") group = "environment";
        else if (tool.id === "business-day") group = "calendar";

        return (
          <a
            href={tool.href}
            data-group={group}
            class="tool-card group flex flex-col justify-between rounded-xl border border-border bg-card p-5 transition hover:border-primary/60 hover:shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="rounded-md border border-border bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground">
                  {tool.category}
                </span>
                <span class="rounded-md border border-primary/20 bg-primary/10 px-2 py-0.5 text-xs font-bold text-primary">
                  {tool.badge}
                </span>
              </div>
              <h2 class="mt-3 text-base font-bold text-foreground group-hover:text-primary transition-colors">
                {tool.title}
              </h2>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                {tool.desc}
              </p>
            </div>
            <div class="mt-4 flex items-center gap-1 text-xs font-bold text-primary">
              <span>도구 바로가기</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <SavingsQuickLinks />

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      const cards = document.querySelectorAll<HTMLElement>(".tool-card");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          buttons.forEach((b) => {
            b.classList.remove("border-primary", "bg-primary", "text-primary-foreground", "font-bold");
            b.classList.add("border-border", "bg-card", "text-muted-foreground", "font-medium");
          });
          btn.classList.add("border-primary", "bg-primary", "text-primary-foreground", "font-bold");
          btn.classList.remove("border-border", "bg-card", "text-muted-foreground", "font-medium");

          const filter = btn.getAttribute("data-filter") || "all";
          cards.forEach((card) => {
            const group = card.getAttribute("data-group");
            if (filter === "all" || group === filter) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    </script>
  </div>
</Layout>
