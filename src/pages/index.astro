---
import "../styles/global.css";

const tools = [
  {
    id: "net-salary",
    title: "2026 연봉 & 월급 실수령액 계산기",
    desc: "2026년 4대보험 요율(국민·건강·요양·고용)과 근로소득세 간이세액표를 반영하여 세전 급여 대비 실제 통장 입금액을 즉시 계산합니다.",
    href: "/ko/net-salary-calculator/",
    category: "급여/세무",
    badge: "2026 최신",
  },
  {
    id: "severance-pay",
    title: "법정 퇴직금 계산기",
    desc: "근로자퇴직급여 보장법 제8조 기준 3개월 평균임금과 통상임금을 상호 대조하여 퇴직금 예상액을 정밀 산출합니다.",
    href: "/ko/severance-pay-calculator/",
    category: "근로/수당",
    badge: "법정 기준",
  },
  {
    id: "annual-leave",
    title: "법정 연차일수 & 연차수당 계산기",
    desc: "근로기준법 제60조 근속연수별 법정 연차일수 부여 기준과 미사용 연차유급휴가 정산 수당을 통상임금으로 연산합니다.",
    href: "/ko/annual-leave-calculator/",
    category: "근로/휴가",
    badge: "근로기준법 60조",
  },
  {
    id: "unemployment-benefits",
    title: "실업급여(구직급여) 모의 계산기",
    desc: "2026년 최저시급(10,030원) 하한액(64,192원) 및 상한액(66,000원) 기준 연령·가입기간별 소정급여일수와 총 수급액을 계산합니다.",
    href: "/ko/unemployment-benefits-calculator/",
    category: "노동/복지",
    badge: "2026 신설",
  },
  {
    id: "weekly-holiday",
    title: "주휴수당 & 알바 시급 계산기",
    desc: "주 15시간 이상 근무 시 법정보장 주휴수당과 주휴 포함 실질 시급, 4대보험/3.3% 공제 선택에 따른 월 실수령액을 즉시 산출합니다.",
    href: "/ko/weekly-holiday-allowance/",
    category: "근로/급여",
    badge: "2026 최저임금",
  },
  {
    id: "electricity-bill",
    title: "주택용 전기요금 누진제 계산기",
    desc: "한전 전기공급약관 공식 요율 기반 저압·고압 3단계 누진 전력량요금, 하계(7~8월) 완화 구간, 기후환경요금 및 부가세를 정밀 연산합니다.",
    href: "/ko/electricity-bill-calculator/",
    category: "생활/공공요금",
    badge: "한전 공식",
  },
  {
    id: "overtime-pay",
    title: "연장·야간·휴일수당 가산수당 계산기",
    desc: "근로기준법 제56조 법정 가산율(연장 1.5배, 야간 +0.5배, 휴일 1.5~2.0배) 기반 주간/월간 수당을 즉시 산출합니다.",
    href: "/ko/overtime-pay-calculator/",
    category: "근로/수당",
    badge: "근로기준법 56조",
  },
  {
    id: "military-service",
    title: "군 복무일 · 전역일 및 진급일 계산기",
    desc: "육군/해병대(18개월), 해군(20개월), 공군/사회복무(21개월) 복무기간 기준 전역일, 남은 일수, 복무율(%), 계급별 진급일을 계산합니다.",
    href: "/ko/military-service-calculator/",
    category: "생활/병무",
    badge: "병역법 기준",
  },
  {
    id: "gas-bill",
    title: "도시가스 요금 계산기 (난방비·취사)",
    desc: "계량기 사용량(m³)을 평균발열량(42.8 MJ/m³)으로 변환하여 주택용 난방·취사 단가, 기본료, 부가세 10%를 반영한 예상 청구액을 산출합니다.",
    href: "/ko/gas-bill-calculator/",
    category: "생활/공공요금",
    badge: "가스공사 공식",
  },
  {
    id: "waste-sorter",
    title: "생활 폐기물 분리배출 판별기",
    desc: "헷갈리는 16대 생활 품목의 종량제·음식물·불연성마대·재활용 분류 기준 및 폐기물관리법 근거를 실시간 검색합니다.",
    href: "/ko/waste-sorter/",
    category: "생활 규약",
    badge: "인기",
  },
  {
    id: "wind-chill",
    title: "체감온도 및 온열지수 계산기",
    desc: "기상청 공식 JAG/TI 대류 열손실 모델 및 여름철 습구 온열지수 수식으로 실제 피부 체감온도를 정밀 계산합니다.",
    href: "/ko/wind-chill-calculator/",
    category: "기상 환경",
    badge: "기상청 공식",
  },
  {
    id: "business-day",
    title: "대한민국 법정 영업일·공휴일 조회기",
    desc: "관공서 공휴일에 관한 규정 및 대체공휴일 픽스처를 기반으로 특정 날짜의 영업일 여부와 휴일 사유를 판별합니다.",
    href: "/ko/business-day-checker/",
    category: "캘린더/행정",
    badge: "B2A 연동",
  },
  {
    id: "pyeong-sqm",
    title: "부동산 평수 ↔ ㎡ 면적 변환기",
    desc: "계량에 관한 법률 기준 1평(3.305785㎡) 및 1㎡(0.3025평) 양방향 정밀 환산 및 아파트 전용 59㎡·84㎡ 조견표를 제공합니다.",
    href: "/ko/pyeong-sqm-converter/",
    category: "생활/부동산",
    badge: "부동산 필수",
  },
  {
    id: "cagr",
    title: "CAGR 연평균 복합 성장률 계산기",
    desc: "투자 원금, 최종금액, 투자 기간을 바탕으로 연평균 복리 수익률(CAGR), 누적 수익률, 원금 2배 달성 소요 기간을 계산합니다.",
    href: "/ko/cagr-calculator/",
    category: "금융/투자",
    badge: "투자/재테크",
  },
  {
    id: "dday",
    title: "D-day 디데이 & 기념일 · 수습기간 계산기",
    desc: "목표일 D-day 및 경과일 카운트다운, 커플 100일·1주년 기념일 및 직장인 수습 3개월 만료일을 실시간 정확히 계산합니다.",
    href: "/ko/dday-calculator/",
    category: "생활/일정",
    badge: "실시간",
  },
  {
    id: "loan-repayment",
    title: "대출 이자 및 월별 상환액 계산기",
    desc: "원리금균등, 원금균등, 만기일시상환 방식에 따른 총 이자, 첫 회차 납입액 및 원금·이자 변동 스케줄을 정밀 산출합니다.",
    href: "/ko/loan-repayment-calculator/",
    category: "금융/대출",
    badge: "금융 공식",
  },
  {
    id: "acquisition-tax",
    title: "부동산 취득세 & 양도세 간편 계산기",
    desc: "주택 취득 시 취득세·지방교육세·생애최초 감면액과 매도 시 1세대 1주택 비과세 및 장특공제 양도소득세를 정밀 계산합니다.",
    href: "/ko/acquisition-tax-calculator/",
    category: "부동산/세무",
    badge: "2026 최신 세법",
  },
  {
    id: "freelancer-tax",
    title: "프리랜서 3.3% 세금 & 5월 환급 계산기",
    desc: "사업소득 3.3% 원천징수 실수령액 역산과 5월 종합소득세 단순경비율 적용 시 예상 국세환급금을 정밀 시뮬레이션합니다.",
    href: "/ko/freelancer-tax-calculator/",
    category: "세무/소득",
    badge: "국세청 기준",
  },
];
import Layout from "../components/Layout.astro";
---

<Layout
  title="OIYO tools — 일상을 돕는 정밀 웹 유틸리티 허브"
  description="광고 공해 없이 빠르고 정확한 웹 도구 모음. 노동 수당, 주택용 전기·도시가스 요금, 부동산 평수 변환, CAGR 복리 계산기 등을 제공합니다."
>
  <div class="mx-auto w-full max-w-5xl px-4 py-12 sm:px-8">
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-bold text-primary mb-3">
        <span>⚡ 100% 클라이언트 연산</span>
        <span>•</span>
        <span>데이터 수집 없음</span>
      </div>
      <h1 class="text-3xl font-black tracking-tight text-foreground sm:text-4xl">
        더 정확하고 빠른 웹 유틸리티 도구 허브
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted-foreground sm:text-base">
        불필요한 스크롤과 로딩 없이 필요한 계산과 분류 결과를 즉시 제공합니다.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="mb-8 flex flex-wrap items-center gap-2" id="filter-bar">
      <button
        type="button"
        class="filter-btn rounded-lg border border-primary bg-primary px-3.5 py-1.5 text-xs font-bold text-primary-foreground transition shadow-xs"
        data-filter="all"
      >
        전체 보기 (14)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="labor"
      >
        급여 · 노동 · 수당 (6)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="living"
      >
        생활 · 부동산 · 공과금 (4)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="finance"
      >
        금융 · 재테크 (1)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="military"
      >
        병무 · 전역 (1)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="environment"
      >
        기상 · 환경 (1)
      </button>
      <button
        type="button"
        class="filter-btn rounded-lg border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-muted-foreground transition hover:border-primary/40 hover:text-foreground"
        data-filter="calendar"
      >
        캘린더 · 공휴일 (1)
      </button>
    </div>

    <!-- Tools Grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="tools-grid">
      {tools.map((tool) => {
        let group = "labor";
        if (["electricity-bill", "gas-bill", "waste-sorter", "pyeong-sqm"].includes(tool.id)) group = "living";
        else if (tool.id === "cagr") group = "finance";
        else if (tool.id === "military-service") group = "military";
        else if (tool.id === "wind-chill") group = "environment";
        else if (tool.id === "business-day") group = "calendar";

        return (
          <a
            href={tool.href}
            data-group={group}
            class="tool-card group flex flex-col justify-between rounded-xl border border-border bg-card p-5 transition hover:border-primary/60 hover:shadow-sm"
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <span class="rounded-md border border-border bg-muted px-2 py-0.5 text-xs font-semibold text-muted-foreground">
                  {tool.category}
                </span>
                <span class="rounded-md border border-primary/20 bg-primary/10 px-2 py-0.5 text-xs font-bold text-primary">
                  {tool.badge}
                </span>
              </div>
              <h2 class="mt-3 text-base font-bold text-foreground group-hover:text-primary transition-colors">
                {tool.title}
              </h2>
              <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                {tool.desc}
              </p>
            </div>
            <div class="mt-4 flex items-center gap-1 text-xs font-bold text-primary">
              <span>도구 바로가기</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </div>
          </a>
        );
      })}
    </div>

    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
      const cards = document.querySelectorAll<HTMLElement>(".tool-card");

      buttons.forEach((btn) => {
        btn.addEventListener("click", () => {
          buttons.forEach((b) => {
            b.classList.remove("border-primary", "bg-primary", "text-primary-foreground", "font-bold");
            b.classList.add("border-border", "bg-card", "text-muted-foreground", "font-medium");
          });
          btn.classList.add("border-primary", "bg-primary", "text-primary-foreground", "font-bold");
          btn.classList.remove("border-border", "bg-card", "text-muted-foreground", "font-medium");

          const filter = btn.getAttribute("data-filter") || "all";
          cards.forEach((card) => {
            const group = card.getAttribute("data-group");
            if (filter === "all" || group === filter) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    </script>
  </div>
</Layout>
