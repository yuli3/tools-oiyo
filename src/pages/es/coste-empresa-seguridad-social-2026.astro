  "formulaTitle": "Tipos y bases usados (2026)",
  "formulas": [
    {
      "title": "Contingencias comunes",
      "body": "28,30 % en total: 23,60 % empresa y 4,70 % trabajador (Orden PJC/297/2026, art. 4)."
