    {
      "title": "Bases mensuales",
      "body": "Máxima 5.101,20 €. Mínimas: grupo 1 1.989,30 €, grupo 2 1.649,70 €, grupo 3 1.435,20 €, grupos 4 a 7 1.424,40 €."
    },
    {
      "title": "No incluido",
      "body": "Desempleo, FOGASA, formación profesional, MEI y accidentes de trabajo."
    }
  ],
  "howToTitle": "Cómo se usa",
  "steps": [
    "Elija el grupo de cotización.",
    "Escriba el salario bruto mensual con prorrata de pagas.",
