  ],
  "faqTitle": "Preguntas frecuentes",
  "faqs": [
    {
      "question": "¿Por qué el coste real es mayor?",
      "answer": "Faltan desempleo, FOGASA, formación profesional, MEI y accidentes de trabajo, que no hemos verificado."
    },
    {
