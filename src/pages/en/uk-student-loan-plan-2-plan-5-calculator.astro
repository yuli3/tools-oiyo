---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import UkStudentLoan from '../../components/tools/UkStudentLoan';
const c = {
  introTitle: 'Will you repay it, or will it be written off?',
  intro: 'English and Welsh student loans on Plan 2 and Plan 5 are repaid at 9% of income above a threshold, and whatever is left is written off: Plan 2 after 30 years and Plan 5 after 40 years from the April you were first due to repay. Whether you clear the loan depends far more on your salary path than on the balance. This simulator uses the thresholds and interest rates published on gov.uk and lets you set salary growth to see which outcome is likely.',
  formulaTitle: 'The gov.uk figures used',
  formulas: [
    { title: 'Repayment', body: '9% of income above £29,385 a year (Plan 2) or £25,000 a year (Plan 5).' },
    { title: 'Interest', body: 'Plan 5: the published rate (4.1% now). Plan 2: 4.1% up to £29,385 of income, rising to 6% at £52,885 or more, scaled in between; capped at 6%.' },
    { title: 'Write-off', body: 'Plan 2: 30 years after the April you were first due to repay. Plan 5: 40 years.' },
  ],
  howToTitle: 'How to use it',
  steps: [
    'Choose your plan and enter your balance from your Student Loans Company account.',
    'Enter your salary and a growth rate you think is realistic.',
    'Leave threshold growth at 0 to keep it frozen, or enter a rate if you expect it to rise.',
    'Read the year you repay, or how much is written off, and the yearly table.',
  ],
  faqTitle: 'Common questions',
  faqs: [
    { question: 'Should I overpay?', answer: 'If the simulation shows the loan being written off, extra payments may only reduce an amount that would be cancelled anyway. If it shows you repaying in full, overpaying cuts interest. Your real salary path decides.' },
    { question: 'Why does my statement show different interest?', answer: 'Rates change every September with RPI and can be capped; interest is charged daily. This page uses one yearly rate you can edit.' },
    { question: 'Are my inputs saved?', answer: 'The numbers stay in the current page memory only. The site uses analytics and advertising.' },
  ],
  disclaimer: 'Estimate for England and Wales Plan 2 and Plan 5 loans. Not financial advice; your Student Loans Company account is authoritative.',
};
const sources: [string,string][] = [
  ['gov.uk: Repaying your student loan — what you pay (thresholds and interest)', 'https://www.gov.uk/repaying-your-student-loan/what-you-pay'],
  ['gov.uk: When your student loan gets written off or cancelled', 'https://www.gov.uk/repaying-your-student-loan/when-your-student-loan-gets-written-off-or-cancelled'],
];
---
<DebtReliefPage slug="uk-student-loan-plan-2-plan-5-calculator" c={c} sources={sources} sourcesTitle="Sources" checked="gov.uk figures checked: 2026-11-02">
  <UkStudentLoan client:load />
</DebtReliefPage>
