---
// Moved from blog.oiyo.net/en/crossfit-male-to-female-weight-converter/ on 2026-10-27 (W14). English only, as on Blog.
import Layout from '../../components/Layout.astro';
import UtilityArticle, { type UtilityContent } from '../../components/UtilityArticle.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import CrossfitWeightEquivalent from '../../components/tools/CrossfitWeightEquivalent';
import { RATIO, STANDARDS } from '../../lib/crossfit-weight-equivalent';
import { utilityJsonLd } from '../../lib/utility-jsonld';

const pct = (Math.round(RATIO * 1000) / 10).toFixed(1);
const title = "CrossFit Male to Female Weight Converter — Rx Ratio and Chart";
const description = `Convert a CrossFit weight from men's to women's Rx or back. Uses the ${pct}% average of the benchmark standards, with the published lb and kg pairs in a chart.`;
const c: UtilityContent = {
  introTitle: "How are CrossFit weights scaled for women?",
  intro: `CrossFit writes most workouts with a men's and a women's Rx load, such as 95/65 lb for Fran thrusters or 225/155 lb for Diane deadlifts. Across the eight benchmark standards in the chart below, the women's load is ${pct}% of the men's on average, ranging from 66% (kettlebell) to 70% (Grace, Isabel, dumbbell, wall ball). This converter multiplies by that ratio and rounds to the nearest plate. When you type a standard load, it shows the published pair instead.`,
  formulaTitle: "Highlights",
  formulas: [
    { title: "Published pairs first", body: "Standard loads like 95, 135 or 53 lb return the official Rx pair." },
    { title: "Plate rounding", body: "Other weights round to 5 lb or 2.5 kg so you can load the bar." },
    { title: "Chart included", body: "Every benchmark used for the ratio is listed in lb and kg." },
  ],
  howToTitle: "How to use",
  steps: ["Choose men's → women's or women's → men's.", "Pick lb or kg.", "Type the weight written in the workout and read the equivalent."],
  faqTitle: "FAQ",
  faqs: [
    { question: "What is the CrossFit male to female weight ratio?", answer: `About ${pct}%. Most barbell standards sit near 68–70% (95/65, 135/95, 225/155) and the kettlebell is 66% (53/35 lb).` },
    { question: "What is 95 lb for women in CrossFit?", answer: "65 lb. That is the Rx thruster load in Fran (43/29 kg in metric)." },
    { question: "What is 135 lb for women?", answer: "95 lb, as in Grace and Isabel (61/43 kg)." },
    { question: "Why are the kg numbers not exact conversions of the lb numbers?", answer: "Metric loads are rounded to practical plate weights on their own, so 95 lb is written as 43 kg rather than 43.1 kg, and 53 lb kettlebells are 24 kg bells." },
  ],
  disclaimer: "Rx loads are a convention, not a measurement of equal effort. Scale to what lets you keep the intended stimulus of the workout.",
};
const url = 'https://tools.oiyo.net/en/crossfit-male-to-female-weight-converter/';
const schema = utilityJsonLd({ name: title, description, url, locale: 'en', steps: c.steps, faqs: c.faqs });
---
<Layout title={title} description={description} locale="en" availableLocales={['en']} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{description}</p>
    <CrossfitWeightEquivalent client:load />
      <div class="mt-6 overflow-x-auto">
        <table class="w-full text-sm">
          <caption class="mb-2 text-left text-xs text-muted-foreground">CrossFit male and female Rx weight chart (men / women)</caption>
          <thead>
            <tr class="border-b border-border text-left text-muted-foreground">
              <th class="py-2 pr-3 font-medium">Workout</th>
              <th class="py-2 pr-3 font-medium">lb</th>
              <th class="py-2 pr-3 font-medium">kg</th>
              <th class="py-2 font-medium">Women / men</th>
            </tr>
          </thead>
          <tbody>
            {STANDARDS.map((row) => (
              <tr class="border-b border-border/60 align-top">
                <td class="py-2 pr-3"><span class="text-foreground">{row.name}</span><br /><span class="text-xs text-muted-foreground">{row.movement}</span></td>
                <td class="py-2 pr-3 font-mono text-foreground">{row.lb.men} / {row.lb.women}</td>
                <td class="py-2 pr-3 font-mono text-foreground">{row.kg.men} / {row.kg.women}</td>
                <td class="py-2 font-mono text-foreground">{Math.round((row.lb.women / row.lb.men) * 100)}%</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-3 text-xs text-muted-foreground">Loads as prescribed in the CrossFit benchmark workouts and the CrossFit Open (crossfit.com). Average ratio {pct}%.</p>
      </div>
    <UtilityArticle c={c} />
    <RelatedUtilities locale="en" current="crossfit-male-to-female-weight-converter" group="health" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
