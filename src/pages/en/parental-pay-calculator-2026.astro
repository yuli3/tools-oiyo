---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import T from '../../components/tools/takehome/ParentalPay';
// Parental pay and child benefit (2026-11-22, world audience gap A3). Engine: lib/world-parental-pay-2026.ts
const c = {
  "introTitle": "How much will I get on parental leave?",
  "intro": "Pay during maternity or parental leave, and the monthly child benefit, from each country's official 2026 rates: Statutory Maternity Pay and Child Benefit in the UK, 育児休業給付金 in Japan, Elterngeld and Kindergeld in Germany.",
  "formulaTitle": "Rates used",
  "formulas": [
    {
      "title": "UK",
      "body": "Statutory Maternity Pay for up to 39 weeks: 90% of average weekly earnings for 6 weeks, then £194.32 or 90% if lower for 33 weeks. Child Benefit £27.05 a week for the eldest child, £17.90 for each other child. High Income Child Benefit Charge: 1% per £200 of adjusted net income over £60,000, all of it over £80,000."
    },
    {
      "title": "Japan",
      "body": "育児休業給付金: 67% of 休業開始時賃金月額 for the first 180 days, 50% after. From 1 August 2026 the monthly caps are ¥332,454 (67%) and ¥248,100 (50%); the wage counted is between ¥96,090 and ¥496,200. 出生後休業支援給付金 adds 13% for up to 28 days (cap ¥60,205)."
    },
    {
      "title": "Germany",
      "body": "Elterngeld (§ 2 BEEG): 67% of net income before birth, rising to 100% below €1,000 and falling to 65% above €1,200; at least €300, at most €1,800 a month. ElterngeldPlus is half, for twice as long. No Elterngeld if taxable income is over €175,000. Kindergeld €259 per child a month from 1 January 2026."
    }
  ],
  "howToTitle": "How to use it",
  "steps": [
    "Pick the country.",
    "Enter your earnings before the leave.",
    "Add the details for your country (children, months of leave, income after birth)."
  ],
  "faqTitle": "FAQ",
  "faqs": [
    {
      "question": "Does it check whether I qualify?",
      "answer": "No. Service and earnings conditions are not checked; it shows the amount if you qualify."
    },
    {
      "question": "Is my employer's own scheme included?",
      "answer": "No. Only statutory pay is shown; your contract may pay more."
    },
    {
      "question": "Is my data saved?",
      "answer": "No, it stays in your browser."
    }
  ],
  "disclaimer": "General information only, not advice. Check with GOV.UK, Hello Work or your Elterngeldstelle."
};
const sources: [string, string][] = [
  [
