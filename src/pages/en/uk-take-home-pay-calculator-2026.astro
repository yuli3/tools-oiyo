  "formulaTitle": "The rules used",
  "formulas": [
    {
      "title": "Income Tax (England, Wales, NI)",
      "body": "20% on the first £37,700 above the personal allowance, 40% up to £125,140, 45% above. The allowance falls by £1 for every £2 over £100,000."
    },
    {
      "title": "Income Tax (Scotland)",
      "body": "19% up to £3,967, 20% to £16,956, 21% to £31,092, 42% to £62,430, 45% to £125,140, 48% above (on income above the personal allowance)."
    },
    {
      "title": "National Insurance (category A)",
      "body": "8% of pay between £12,570 and £50,270 a year, 2% above."
    },
    {
      "title": "Student loans",
      "body": "9% above £26,900 (Plan 1), £29,385 (Plan 2), £33,795 (Plan 4) or £25,000 (Plan 5); postgraduate 6% above £21,000."
    }
  ],
  "howToTitle": "How to use it",
  "steps": [
