---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import T from '../../components/tools/limitation/UkLimitation';
// Limitation and small claims pack (2026-11-22, world pro-gap #4). Engine: lib/world-limitation-pack-2026.ts
const c = {
  "introTitle": "How long you have to sue, and what it costs to start",
  "intro": "In England and Wales most claims for unpaid money or broken contracts must be issued within 6 years, negligence and damage claims within 6 years, and personal injury claims within 3 years (or 3 years from when you knew). Claims up to £10,000 usually go to the small claims track. The court fee depends on the amount.",
  "formulaTitle": "The rules used",
  "formulas": [
    {
      "title": "Contract and tort",
      "body": "6 years from when the cause of action accrued (Limitation Act 1980 ss.2 and 5)."
    },
    {
      "title": "Personal injury",
      "body": "3 years from the injury or the date of knowledge if later (s.11)."
    },
    {
      "title": "Court fees",
      "body": "£35 up to £300 … £455 up to £10,000, then 5% up to £200,000, then £10,000."
    }
  ],
  "howToTitle": "How to use",
  "steps": [
    "Pick the type of claim.",
    "Enter when it happened and the amount.",
    "Read the limitation date and court fee."
  ],
  "faqTitle": "FAQ",
  "faqs": [
    {
      "question": "Does Scotland use the same rules?",
      "answer": "No. This page covers England and Wales only."
    },
    {
      "question": "Can the 6 years restart?",
      "answer": "Some events can change it; they are not applied here."
    },
    {
      "question": "Is my input stored?",
      "answer": "No, it stays in your browser."
    }
  ],
  "disclaimer": "General information, not legal advice."
};
const sources: [string, string][] = [
  [
    "Limitation Act 1980",
    "https://www.legislation.gov.uk/ukpga/1980/58"
  ],
  [
    "gov.uk — court fees for money claims",
    "https://www.gov.uk/make-court-claim-for-money/fees"
  ],
  [
    "Citizens Advice — small claims",
    "https://www.citizensadvice.org.uk/law-and-courts/legal-system/small-claims/deciding-whether-to-make-a-small-claim/"
  ]
];
---
<DebtReliefPage slug="uk-limitation-period-small-claims" c={c} sources={sources} sourcesTitle="Sources" checked="legislation.gov.uk and gov.uk checked 2026-11-22">
  <T client:load />
</DebtReliefPage>
