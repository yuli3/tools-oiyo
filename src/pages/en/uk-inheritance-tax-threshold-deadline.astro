  "formulaTitle": "The rules used",
  "formulas": [
    {
      "title": "Thresholds",
      "body": "Nil rate band £325,000 (to April 2031) plus residence nil rate band up to £175,000 (to April 2030)."
    },
    {
      "title": "Rate",
      "body": "40%, or 36% if 10%+ of the net value is left to charity."
    },
    {
      "title": "Gifts",
      "body": "No tax if the giver lives 7 years; within 3 years 40%, then 32%, 24%, 16%, 8%."
    }
  ],
  "howToTitle": "How to use",
