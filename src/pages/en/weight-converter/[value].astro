---
/**
 * One page per weight: "70 kg in pounds". English only (the query is asked in English).
 * Math lives in lib/unit-value-pages.ts. 1 lb = 0.45359237 kg exactly.
 */
import Layout from "../../../components/Layout.astro";
import RelatedUtilities from "../../../components/RelatedUtilities.astro";
import { kgToPounds, weightSlug, weightValues } from "../../../lib/unit-value-pages";

export function getStaticPaths() {
  return weightValues().map((kg) => ({ params: { value: weightSlug(kg) }, props: { kg } }));
}

const { kg } = Astro.props as { kg: number };
const w = kgToPounds(kg);
const toolUrl = "/en/weight-converter/";
const pageUrl = `https://tools.oiyo.net/en/weight-converter/${weightSlug(kg)}/`;
const title = `${kg} kg in Pounds: ${w.pounds} lb`;
const lbOz = `${w.lbWhole} lb ${w.ounces} oz`;
const st = `${w.stone} st ${w.stoneLb} lb`;
const description = `${kg} kg is ${w.pounds} pounds (${lbOz}), or ${st} in stone. See the working and a chart of nearby weights.`;

const all = weightValues();
const i = all.indexOf(kg);
const nearby = all.slice(Math.max(0, i - 5), i + 6);
// Division is kept in lib: two "/" on one frontmatter line made Astro's compiler read a regex.
const rawLb = w.rawPounds;
const steps = [
  `${kg} kg ÷ 0.45359237 = ${rawLb.toFixed(3)} lb`,
  `Leftover ${(rawLb - Math.floor(rawLb)).toFixed(3)} lb × 16 = ${w.ounces} oz → ${lbOz}`,
  `${w.pounds} lb ÷ 14 = ${w.stone} stone, ${w.stoneLb} lb left → ${st}`,
];
const faq = [
  { q: `How many pounds is ${kg} kg?`, a: description },
  { q: "Quick way to do it in your head", a: `Double the kilograms and add 10%: ${kg} × 2 = ${kg * 2}, plus ${(kg * 0.2).toFixed(1)} = ${(kg * 2.2).toFixed(1)} lb. That is within 0.3% of the exact ${w.pounds} lb.` },
  { q: "Why does a pound equal exactly 0.45359237 kg?", a: "The 1959 international yard and pound agreement fixed the avoirdupois pound at exactly 0.45359237 kg, so every kg-to-lb conversion uses that number." },
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Weight Converter", item: `https://tools.oiyo.net${toolUrl}` },
        { "@type": "ListItem", position: 2, name: `${kg} kg in pounds`, item: pageUrl },
      ],
    },
    { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  ],
};
---

<Layout title={title} description={description} locale="en" availableLocales={["en"]} canonicalURL={pageUrl}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  <div class="mx-auto max-w-3xl px-4 py-5 sm:py-8">
    <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
      <a class="font-semibold text-primary underline-offset-4 hover:underline" href={toolUrl}>Weight Converter</a>
      <span aria-hidden="true"> / </span>
      <span class="font-medium text-foreground">{kg} kg</span>
    </nav>

    <section class="mt-3 rounded-2xl border border-border bg-card p-4 sm:p-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Weight conversion</p>
      <h1 class="mt-2 text-2xl font-black tracking-tight text-foreground sm:text-3xl">{title}</h1>
      <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
      <div class="mt-5 rounded-xl border border-primary bg-primary/10 p-4">
        <p class="text-sm font-semibold text-muted-foreground">{kg} kg =</p>
        <p class="mt-1 font-mono text-4xl font-black text-foreground">{w.pounds} lb</p>
      </div>
      <div class="mt-3 grid grid-cols-3 gap-3">
        <div class="rounded-xl border border-border bg-muted p-3 text-center">
          <p class="text-xs font-semibold text-muted-foreground">Pounds &amp; ounces</p>
          <p class="mt-1 font-mono text-xl font-bold text-foreground">{lbOz}</p>
        </div>
        <div class="rounded-xl border border-border bg-muted p-3 text-center">
          <p class="text-xs font-semibold text-muted-foreground">Stone (UK)</p>
          <p class="mt-1 font-mono text-xl font-bold text-foreground">{st}</p>
        </div>
        <div class="rounded-xl border border-border bg-muted p-3 text-center">
          <p class="text-xs font-semibold text-muted-foreground">Grams</p>
          <p class="mt-1 font-mono text-xl font-bold text-foreground">{w.grams.toLocaleString("en-US")}</p>
        </div>
      </div>
      <a class="mt-5 inline-flex min-h-11 items-center rounded-full bg-primary px-5 text-sm font-bold text-primary-foreground" href={toolUrl}>Convert another weight</a>
    </section>

    <section class="mt-5 space-y-5 rounded-2xl border border-border bg-card p-4 sm:p-6" data-manual-ad-after>
      <div>
        <h2 class="text-lg font-bold text-foreground">How to work it out</h2>
        <ol class="mt-2 list-decimal space-y-1 pl-5 font-mono text-sm leading-7 text-foreground">
          {steps.map((s) => <li>{s}</li>)}
        </ol>
      </div>
      {faq.slice(1).map((f) => (
        <div class="border-t border-border pt-4">
          <h2 class="text-lg font-bold text-foreground">{f.q}</h2>
          <p class="mt-2 leading-7 text-foreground">{f.a}</p>
        </div>
      ))}
    </section>

    <section class="mt-5 rounded-2xl border border-border bg-card p-4 sm:p-6">
      <h2 class="text-lg font-bold text-foreground">Nearby weights in pounds</h2>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-border text-xs font-semibold text-muted-foreground">
              <th class="py-2 pr-3">kg</th>
              <th class="py-2 pr-3">Pounds</th>
              <th class="py-2 pr-3">lb &amp; oz</th>
              <th class="py-2">Stone</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {nearby.map((n) => {
              const r = kgToPounds(n);
              const current = n === kg;
              return (
                <tr class={current ? "bg-primary/10 font-bold" : ""}>
                  <td class="py-2 pr-3 font-mono">{current ? `${n} kg` : <a class="text-primary underline-offset-4 hover:underline" href={`/en/weight-converter/${weightSlug(n)}/`}>{n} kg</a>}</td>
                  <td class="py-2 pr-3 font-mono">{r.pounds}</td>
                  <td class="py-2 pr-3 font-mono">{r.lbWhole} lb {r.ounces} oz</td>
                  <td class="py-2 font-mono">{r.stone} st {r.stoneLb} lb</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-xs leading-6 text-muted-foreground">1 lb = 0.45359237 kg exactly; 1 lb = 16 oz; 1 stone = 14 lb.</p>
    </section>

    <div class="mt-8">
      <RelatedUtilities locale="en" current="weight-converter" group="units" />
    </div>
  </div>
</Layout>
