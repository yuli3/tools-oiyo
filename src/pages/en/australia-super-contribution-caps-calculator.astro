const c = {
  introTitle: 'How much more can you put into super this year?',
  intro: 'Concessional (before-tax) contributions are your employer\'s super guarantee, salary sacrifice and personal contributions you claim as a deduction. They share one yearly cap: $30,000 in 2025-26 and $32,500 in 2026-27. If your total super balance was under $500,000, unused cap from the last five years can be carried forward. Your fund pays 15% tax on these contributions, and if your income plus contributions is over $250,000 you also pay Division 293 tax.',
  formulaTitle: 'How it is calculated',
  formulas: [
    { title: 'Super guarantee', body: '12% of ordinary time earnings up to the maximum contribution base.' },
    { title: 'Cap', body: 'Concessional cap plus unused carry-forward amounts if your total super balance was under $500,000.' },
    { title: 'Division 293', body: '15% of the lesser of (income + concessional contributions − $250,000) and your taxable concessional contributions.' },
    { title: 'Saving', body: 'Extra contributions × your marginal rate, less 15% contributions tax and Division 293.' },
  ],
  howToTitle: 'How to use it',
  steps: ['Pick the financial year.', 'Enter your salary and any salary sacrifice or deductible personal contributions.', 'Add unused cap from ATO online services if you have it.', 'Read your room left, taxes and the rough saving.'],
