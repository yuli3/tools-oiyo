const faqs = [{"q": "이직하면 감면이 끝나나요?", "a": "아니요. 처음 감면받은 날부터 5년 안에서, 옮긴 회사도 감면 대상 중소기업이면 남은 기간을 이어서 받아요."}, {"q": "35세인데 군대를 2년 다녀왔어요", "a": "병역 기간을 빼면 33세로 보아 대상이에요. 병적증명서를 함께 내요."}, {"q": "작년에 신청을 못 했어요", "a": "5년 안에 홈택스 경정청구로 돌려받을 수 있어요. 회사에 신청서를 내고 원천징수 수정을 요청해도 돼요."}, {"q": "2027년에 바뀌나요?", "a": "2026년 세법개정안은 2027년 이후 비수도권 취업자의 감면 기간을 6~10년으로 늘리는 안이에요. 국회 통과 뒤 반영할게요."}];
