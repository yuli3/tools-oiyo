---
// 생활 지원금·노동권 도구 2차 (2026-11-16). 엔진: lib/kr-home-tax-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import RentalIncomeTax from "../../components/tools/welfare/RentalIncomeTax";
