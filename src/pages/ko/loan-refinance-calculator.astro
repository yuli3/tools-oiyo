---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="대출 중도상환수수료 & 대환대출 갈아타기 실익 계산기 — 손익분기점(BEP) 시뮬레이터"
  description="2026년 대출 규정 및 중도상환수수료 잔여일수 일할 감액 공식을 반영하여 기존 대출과 신규 대환 금리 차이, 중도상환수수료, 부대비용 및 갈아타기 손익분기점(회수 개월수)을 즉시 계산합니다."
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
        대출 중도상환수수료 & 대환대출 실익 계산기
      </h1>
      <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
        더 낮은 금리의 대출로 갈아탈 때 발생하는 중도상환수수료와 부대비용을 감안하여, 매월 줄어드는 이자로 몇 개월 만에 비용을 회수할 수 있는지 손익분기점(BEP)을 정밀 산출합니다.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Column -->
      <div class="lg:col-span-6 space-y-6">
        <!-- 기존 대출 정보 -->
        <div class="bg-card border border-border rounded-2xl p-6 shadow-xs space-y-4">
          <p class="text-xs font-bold text-foreground">기존 대출 조건</p>

          <div>
            <label for="loan-balance" class="block text-xs font-semibold text-muted-foreground">
              대환(상환)할 대출 잔액 (원)
            </label>
            <div class="mt-1.5 relative">
              <input
                type="number"
                id="loan-balance"
                value="200000000"
                step="5000000"
                min="1000000"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
            </div>
            <p id="loan-balance-ko" class="mt-1 text-xs text-muted-foreground">2억 원</p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="current-rate" class="block text-xs font-semibold text-muted-foreground">
                현재 대출 금리 (%)
              </label>
              <div class="mt-1.5 relative">
                <input
                  type="number"
                  id="current-rate"
                  value="4.8"
                  step="0.05"
                  min="0.1"
                  max="20"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">%</span>
              </div>
            </div>

            <div>
              <label for="penalty-rate" class="block text-xs font-semibold text-muted-foreground">
                약정 수수료율 (%)
              </label>
              <div class="mt-1.5 relative">
                <input
                  type="number"
                  id="penalty-rate"
                  value="1.2"
                  step="0.1"
                  min="0"
                  max="3"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">%</span>
              </div>
            </div>
          </div>

          <div>
            <div class="flex justify-between items-center">
              <label for="elapsed-months" class="block text-xs font-semibold text-muted-foreground">
                대출 실행 후 경과 기간
              </label>
              <span id="elapsed-months-display" class="text-xs font-bold text-foreground font-mono">12개월 경과</span>
            </div>
            <input
              type="range"
              id="elapsed-months"
              min="0"
              max="36"
              value="12"
              step="1"
              class="mt-2 w-full accent-primary cursor-pointer"
            />
            <div class="flex justify-between text-xs text-muted-foreground mt-1">
              <span>0개월 (방금 실행)</span>
              <span>18개월 (절반)</span>
              <span>36개월 (수수료 면제)</span>
            </div>
          </div>
        </div>

        <!-- 신규 대출 조건 -->
        <div class="bg-card border border-border rounded-2xl p-6 shadow-xs space-y-4">
          <p class="text-xs font-bold text-foreground">신규 대환(갈아타기) 대출 조건</p>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="new-rate" class="block text-xs font-semibold text-muted-foreground">
                신규 대출 금리 (%)
              </label>
              <div class="mt-1.5 relative">
                <input
                  type="number"
                  id="new-rate"
                  value="3.9"
                  step="0.05"
                  min="0.1"
                  max="20"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">%</span>
              </div>
            </div>

            <div>
              <label for="incidental-costs" class="block text-xs font-semibold text-muted-foreground">
                기타 부대비용 (원)
              </label>
              <div class="mt-1.5 relative">
                <input
                  type="number"
                  id="incidental-costs"
                  value="75000"
                  step="10000"
                  min="0"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
              </div>
            </div>
          </div>
          <p class="text-xs text-muted-foreground">인지세(5천만 초과 시 고객부담 3.5~7.5만원) 및 채권할인료 등 예상 부대비용</p>
        </div>
      </div>

      <!-- Result Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs">
          <p class="text-xs font-bold text-primary mb-1">
            대환대출 실익 판정
          </p>
          <div class="mt-2 border-b border-border pb-4">
            <p id="res-verdict-title" class="text-xl sm:text-2xl font-black text-foreground">
              대환 적극 추천
            </p>
            <p id="res-bep-desc" class="mt-1 text-xs text-muted-foreground">
              손익분기점: 약 11개월 만에 수수료 전액 회수
            </p>
          </div>

          <div class="mt-4 space-y-3 text-xs">
            <div class="flex justify-between">
              <span class="text-muted-foreground">금리 인하폭</span>
              <span id="res-rate-diff" class="font-mono font-bold text-primary">▼ 0.90%p</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">매월 절감되는 이자액</span>
              <span id="res-monthly-savings" class="font-mono font-bold text-foreground">150,000원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">중도상환수수료 (잔여일수 반영)</span>
              <span id="res-penalty-fee" class="font-mono text-foreground font-semibold">1,600,000원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">부대비용 합계</span>
              <span id="res-total-costs" class="font-mono text-foreground">1,675,000원</span>
            </div>
            <div class="flex justify-between border-t border-border pt-2 font-bold">
              <span>손익분기점 (비용 회수 기간)</span>
              <span id="res-bep-months" class="font-mono text-primary">약 11.2개월</span>
            </div>
          </div>
        </div>

        <!-- Cumulative Net Savings Timeline -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs space-y-3">
          <p class="font-bold text-foreground text-sm">누적 순수익 (비용 공제 후 순절감액)</p>
          <div class="space-y-2 text-xs">
            <div class="flex justify-between py-1.5 border-b border-border/50">
              <span class="text-muted-foreground">1년(12개월) 경과 시 순이익</span>
              <span id="res-net-1yr" class="font-mono font-bold text-foreground">+125,000원</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-border/50">
              <span class="text-muted-foreground">2년(24개월) 경과 시 순이익</span>
              <span id="res-net-2yr" class="font-mono font-bold text-foreground">+1,925,000원</span>
            </div>
            <div class="flex justify-between py-1.5 border-b border-border/50">
              <span class="text-muted-foreground">3년(36개월) 경과 시 순이익</span>
              <span id="res-net-3yr" class="font-mono font-bold text-primary text-sm">+3,725,000원</span>
            </div>
          </div>
          <p class="text-xs text-muted-foreground pt-1 leading-relaxed">
            ※ 금융소비자보호법에 따라 대출 실행 후 3년이 지난 대출은 중도상환수수료가 전액 면제(0원)되므로 즉시 대환이 유리합니다.
          </p>
        </div>
      </div>
    </div>

    <RelatedTools currentId="loan-refinance" />
  </div>

  <script>
    const balanceInput = document.getElementById("loan-balance") as HTMLInputElement;
    const currentRateInput = document.getElementById("current-rate") as HTMLInputElement;
    const penaltyRateInput = document.getElementById("penalty-rate") as HTMLInputElement;
    const elapsedMonthsInput = document.getElementById("elapsed-months") as HTMLInputElement;
    const newRateInput = document.getElementById("new-rate") as HTMLInputElement;
    const incidentalCostsInput = document.getElementById("incidental-costs") as HTMLInputElement;

    const balanceKo = document.getElementById("loan-balance-ko")!;
    const elapsedDisplay = document.getElementById("elapsed-months-display")!;

    const resVerdictTitle = document.getElementById("res-verdict-title")!;
    const resBepDesc = document.getElementById("res-bep-desc")!;
    const resRateDiff = document.getElementById("res-rate-diff")!;
    const resMonthlySavings = document.getElementById("res-monthly-savings")!;
    const resPenaltyFee = document.getElementById("res-penalty-fee")!;
    const resTotalCosts = document.getElementById("res-total-costs")!;
    const resBepMonths = document.getElementById("res-bep-months")!;
    const resNet1yr = document.getElementById("res-net-1yr")!;
    const resNet2yr = document.getElementById("res-net-2yr")!;
    const resNet3yr = document.getElementById("res-net-3yr")!;

    function formatKRW(val: number): string {
      return Math.round(val).toLocaleString("ko-KR") + "원";
    }

    function formatKoreanUnits(num: number): string {
      if (num <= 0) return "0원";
      const eok = Math.floor(num / 100000000);
      const man = Math.floor((num % 100000000) / 10000);
      let res = "";
      if (eok > 0) res += `${eok}억 `;
      if (man > 0) res += `${man.toLocaleString("ko-KR")}만 `;
      return res.trim() + "원";
    }

    function calculate() {
      const balance = Math.max(0, parseFloat(balanceInput.value) || 0);
      balanceKo.textContent = formatKoreanUnits(balance);

      const currentRate = Math.max(0, parseFloat(currentRateInput.value) || 0) / 100;
      const newRate = Math.max(0, parseFloat(newRateInput.value) || 0) / 100;
      const penaltyRate = Math.max(0, parseFloat(penaltyRateInput.value) || 0) / 100;
      const elapsedMonths = Math.min(36, Math.max(0, parseInt(elapsedMonthsInput.value, 10) || 0));
      const incidental = Math.max(0, parseFloat(incidentalCostsInput.value) || 0);

      elapsedDisplay.textContent = elapsedMonths >= 36 ? "36개월 (수수료 면제)" : `${elapsedMonths}개월 경과`;

      // 1. 중도상환수수료 = 대출잔액 * 약정수수료율 * (잔여일수 / 1095일)
      // 잔여 개월 비율: (36 - elapsedMonths) / 36
      let penaltyFee = 0;
      if (elapsedMonths < 36) {
        penaltyFee = Math.floor(balance * penaltyRate * ((36 - elapsedMonths) / 36));
      }
      const totalCost = penaltyFee + incidental;

      // 2. 금리 차이에 따른 월 이자 절감액
      const rateDiff = currentRate - newRate;
      const monthlyCurrentInterest = (balance * currentRate) / 12;
      const monthlyNewInterest = (balance * newRate) / 12;
      const monthlySavings = Math.floor(monthlyCurrentInterest - monthlyNewInterest);

      resRateDiff.textContent = rateDiff >= 0 
        ? `▼ ${(rateDiff * 100).toFixed(2)}%p`
        : `▲ ${Math.abs(rateDiff * 100).toFixed(2)}%p (신규 금리가 더 높음)`;
      resRateDiff.className = rateDiff >= 0 ? "font-mono font-bold text-primary" : "font-mono font-bold text-destructive";

      resMonthlySavings.textContent = `${formatKRW(monthlySavings)}`;
      resPenaltyFee.textContent = formatKRW(penaltyFee);
      resTotalCosts.textContent = formatKRW(totalCost);

      if (rateDiff <= 0 || monthlySavings <= 0) {
        resVerdictTitle.textContent = "대환 비추천 (손해)";
        resVerdictTitle.className = "text-xl sm:text-2xl font-black text-destructive";
        resBepDesc.textContent = "신규 대출 금리가 기존보다 높거나 같아 이자 절감 효과가 없습니다.";
        resBepMonths.textContent = "회수 불가";
        resNet1yr.textContent = "-";
        resNet2yr.textContent = "-";
        resNet3yr.textContent = "-";
        return;
      }

      // 3. BEP (개월수)
      const bepMonths = totalCost > 0 ? (totalCost / monthlySavings) : 0;
      resBepMonths.textContent = bepMonths <= 0 ? "즉시 이익 (비용 0원)" : `약 ${bepMonths.toFixed(1)}개월`;

      if (bepMonths <= 12) {
        resVerdictTitle.textContent = "대환 적극 추천";
        resVerdictTitle.className = "text-xl sm:text-2xl font-black text-primary";
        resBepDesc.textContent = `1년 이내(${bepMonths.toFixed(1)}개월)에 수수료와 비용을 모두 회수합니다.`;
      } else if (bepMonths <= 24) {
        resVerdictTitle.textContent = "대환 권장 (실익 있음)";
        resVerdictTitle.className = "text-xl sm:text-2xl font-black text-foreground";
        resBepDesc.textContent = `약 ${bepMonths.toFixed(1)}개월 후부터 순이익이 발생합니다.`;
      } else if (bepMonths <= 36) {
        resVerdictTitle.textContent = "신중한 검토 필요";
        resVerdictTitle.className = "text-xl sm:text-2xl font-black text-amber-500";
        resBepDesc.textContent = `비용 회수에 ${bepMonths.toFixed(1)}개월이 걸리므로 장기 유지 시에만 유리합니다.`;
      } else {
        resVerdictTitle.textContent = "대환 비추천";
        resVerdictTitle.className = "text-xl sm:text-2xl font-black text-muted-foreground";
        resBepDesc.textContent = `수수료 회수에 3년 이상 소요되어 3년 경과 후 무료 상환을 기다리는 편이 낫습니다.`;
      }

      // 4. 누적 순이익
      const net12 = monthlySavings * 12 - totalCost;
      const net24 = monthlySavings * 24 - totalCost;
      const net36 = monthlySavings * 36 - totalCost;

      function formatNet(val: number): string {
        const sign = val >= 0 ? "+" : "-";
        return `${sign}${formatKRW(Math.abs(val))}`;
      }

      resNet1yr.textContent = formatNet(net12);
      resNet2yr.textContent = formatNet(net24);
      resNet3yr.textContent = formatNet(net36);
    }

    [balanceInput, currentRateInput, penaltyRateInput, elapsedMonthsInput, newRateInput, incidentalCostsInput].forEach((el) => {
      el.addEventListener("input", calculate);
      el.addEventListener("change", calculate);
    });

    calculate();
  </script>
</Layout>
