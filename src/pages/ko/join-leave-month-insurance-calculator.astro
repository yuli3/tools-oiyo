---
// 입사·퇴사 달 4대보험료 계산기 (2026-11-23, 실무 오피스 새 계산 3종, 세운 승인). 계산: lib/kr-payroll-month-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import JoinLeaveInsurance from "../../components/tools/office/JoinLeaveInsurance";

const title = "입사·퇴사 달 4대보험료 계산기 — 첫 달·마지막 달 보험료 나오나요?";
const description = "입사일과 마지막 근무일로 국민연금·건강보험·장기요양·고용보험이 어느 달부터 어느 달까지 붙는지, 달별 근로자 부담액을 보여 줘요. 1일 입사, 월 중간 입사, 국민연금 입사 달 납부 희망까지.";
const shell = {
  introTitle: "첫 달과 마지막 달이 헷갈릴 때",
  intro: "4대보험은 하루 단위가 아니라 달 단위로 붙어요. 월 중간에 입사하면 그 달은 없고 다음 달부터, 1일에 입사하면 그 달부터예요. 퇴사하면 마지막 근무일 다음 날 자격을 잃고, 그 전날이 속한 달, 곧 퇴사한 달까지 연금·건강보험료가 붙어요.",
  howToTitle: "이렇게 써요",
  steps: ["입사일을 넣어요.", "퇴사했다면 마지막 근무일을 넣어요.", "보수월액(비과세 제외)을 넣어요.", "월 중간 입사인데 국민연금을 입사 달부터 내기로 했다면 체크해요."],
  highlightsTitle: "근거",
  highlights: [
    { title: "건강·장기요양", body: "취득일이 속한 달의 다음 달부터 잃은 날의 전날이 속한 달까지, 1일 취득이면 그 달부터(국민건강보험법 제69조②). 장기요양은 함께 징수(노인장기요양보험법 제8조)." },
    { title: "국민연금", body: "같은 원칙에 1일 취득이나 본인 희망이면 취득 달부터(국민연금법 제17조). 퇴사 다음 날 상실(제12조)." },
    { title: "고용보험", body: "월 중간 입사는 다음 달부터, 1일이면 그 달부터(보험료징수법 제16조의4). 퇴사 달은 실제 보수로 정산하므로 여기서는 '확인 필요'로 표시해요." },
