};
const faqs = [
  { q: "15일에 입사했는데 이번 달 보험료가 빠졌어요.", a: "월 중간 입사면 원칙적으로 다음 달부터예요. 국민연금은 본인이 희망하면 입사 달부터 낼 수 있어요. 고지가 늦어 다음 달에 두 달 치가 함께 나올 수도 있어요." },
  { q: "말일에 퇴사하면 그 달 보험료가 붙나요?", a: "네. 마지막 근무일 다음 날 자격을 잃고, 그 전날(마지막 근무일)이 속한 달까지 붙어요." },
  { q: "같은 달에 입사하고 퇴사하면요?", a: "1일 입사가 아니면 시작 달보다 끝 달이 앞서 연금·건강보험이 붙지 않는 것으로 계산돼요. 원문에 명시된 문구가 아니라서 공단 확인을 권해요." },
