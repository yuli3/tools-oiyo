---
// 건강 금융 묶음 3 (2026-11-02, CHOSEUN "진행"). ko-only: 한국 실손의료보험 세대별 자기부담 규칙.
import KrFinancePage from "../../components/KrFinancePage.astro";
import SilsonGenerationCalculator from "../../components/tools/SilsonGenerationCalculator";
import { compareGenerations, SILSON_AS_OF } from "../../lib/kr-silson-generations";

const title = "실손보험 세대별 보험금 계산기 — 3·4·5세대 같은 영수증 비교";
const description = "병원 영수증의 급여 본인부담금과 비급여 금액을 넣으면 3세대·4세대·5세대 실손보험 표준약관의 자기부담 규칙으로 받을 보험금을 나란히 계산해요.";

const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const [g3, g4, g5] = compareGenerations({ care: "outpatient", tier: "clinic", covered: 20_000, nonCovered: 30_000, riderItems: 0, severe: false });

const ko = {
  eyebrow: "건강 금융 도구",
  introTitle: "같은 병원비, 실손보험 세대마다 얼마나 다를까요?",
  intro: `실손보험은 가입 시기(세대)마다 환자가 직접 부담하는 공제 금액이 달라요. 예를 들어 의원에서 급여 본인부담금 2만 원과 비급여 3만 원을 냈다면 3세대는 ${won(g3.payout)}, 4세대는 ${won(g4.payout)}, 5세대(비중증)는 ${won(g5.payout)}을 받아요. 3세대는 급여와 비급여를 합쳐 병원 규모별 1만~2만 원을 빼지만, 4세대부터는 비급여를 따로 떼어 3만 원(5세대 비중증은 5만 원)을 빼기 때문이에요. 이 계산기는 보험업감독업무시행세칙 별표15 표준약관과 금융위원회 자료의 공제 규칙을 그대로 적용해요.`,
  howToTitle: "사용 방법",
  steps: [
    "가입 시기로 내 세대를 골라요. 2017년 4월~2021년 6월 가입은 3세대, 2021년 7월부터는 4세대, 2026년 5월부터는 5세대예요.",
    "진료비 영수증에서 '급여 본인부담금'과 '비급여' 금액을 옮겨 적어요. 도수치료·체외충격파·증식치료, 비급여 주사, 비급여 MRI는 따로 적어요.",
    "통원이면 병원 종류를 고르고, 5세대라면 중증 질환 치료인지 골라요. 세 세대 결과가 표로 함께 나와요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "표준약관 원문 기준", body: "3세대(2021.6.9 시행판)·4세대(2021.7.1 시행판) 별표15 조문과 5세대 금융위 출시 자료로 공제 규칙을 맞췄어요." },
    { title: "세대 비교 표", body: "같은 영수증을 세 세대 규칙으로 계산해 공제와 보험금을 나란히 보여 줘요." },
    { title: "계산 과정 공개", body: "항목마다 정액과 비율 중 어느 쪽이 적용됐는지 한 줄씩 보여 줘요." },
  ],
  relatedTitle: "관련 도구",
  related: [],
  disclaimer: `참고용 추정 계산이에요. 표준약관의 기본 공제 규칙만 적용했고 보장 한도(통원 1회·연간 한도, 입원 연간 한도), 연간 자기부담 상한, 통원 횟수 한도, 약국 처방 공제, 보장하지 않는 항목, 할인·할증, 회사별 약관 차이는 반영하지 않아요. 1·2세대와 3세대 선택형은 계산하지 않아요. 5세대 급여 진료 중 건강보험 본인부담률이 20%보다 높은 경우(예: 상급종합병원 경증 외래)는 그 비율로 더 공제될 수 있어요. 실제 보험금은 가입한 보험사가 약관과 서류로 정해요. 이 도구는 의료 상담이나 진단을 하지 않아요. 기준일 ${SILSON_AS_OF}.`,
};

const faqs = [
  { q: "내 실손보험이 몇 세대인지 어떻게 아나요?", a: "가입한 날짜로 정해져요. 2009년 9월까지는 1세대, 2009년 10월~2017년 3월은 2세대, 2017년 4월~2021년 6월은 3세대, 2021년 7월~2026년 5월 초는 4세대, 2026년 5월 6일부터 판매된 상품은 5세대예요. 보험증권이나 보험사 앱의 계약 내용에서 가입일을 확인하세요. 중간에 다른 세대로 전환했다면 전환한 세대 규칙을 따라요." },
  { q: "3세대 비급여 통원 공제는 3만 원 아닌가요?", a: "아니에요. 3세대 표준형은 급여와 비급여를 합친 금액에서 의원 1만 원, 병원 1만 5천 원, 종합·상급종합병원 2만 원과 20% 중 큰 금액을 빼요. 도수치료·비급여 주사·비급여 MRI 특약만 1회 2만 원과 30% 중 큰 금액이에요. 비급여 통원 3만 원 공제는 4세대부터 생겼어요." },
  { q: "5세대의 중증과 비중증은 어떻게 나누나요?", a: "중증은 건강보험 산정특례 대상 질환(암, 심장·뇌혈관 질환, 희귀·중증난치질환 등)과 인과관계가 분명한 합병증 치료예요. 비급여 중증 치료는 특약1(30% 공제)로, 그 밖의 비급여는 특약2(50% 공제, 통원 최소 5만 원)로 보장해요. 산정특례 등록 여부는 국민건강보험공단에서 확인할 수 있어요." },
  { q: "본인부담상한제 환급을 받으면 실손보험금은 어떻게 되나요?", a: "상한제 환급금은 공단이 돌려주는 돈이라 실손보험이 보상하지 않는 손해예요. 보험사가 환급분만큼 나중에 돌려 달라고 하거나 미리 빼고 줄 수 있어요. 세대와 약관에 따라 다르니 가입한 보험사에 확인하세요." },
  { q: "세대를 바꾸는 게 유리한가요?", a: "자주 병원에 가고 비급여 진료를 많이 받는다면 예전 세대가 보험금을 더 받는 경우가 많아요. 대신 예전 세대는 보험료가 높고 갱신 때 크게 오를 수 있어요. 보험금과 보험료를 함께 비교해야 해서 이 계산기만으로 판단하지 말고, 보험사의 전환 안내와 예상 보험료를 확인하세요." },
];
---
<KrFinancePage slug="silson-insurance-generation-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <SilsonGenerationCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 보험업감독업무시행세칙 [별표15] 실손의료보험 표준약관(3세대 2021.6.9 시행판, 4세대 2021.7.1 시행판, 국가법령정보센터), 금융위원회 4세대 출시(2021.6.29)·5세대 출시(2026.5.6) 보도자료. 기준일 {SILSON_AS_OF}.</p>
</KrFinancePage>
