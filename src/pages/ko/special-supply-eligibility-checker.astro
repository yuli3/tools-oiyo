const faqs = [{"q": "소득은 어떻게 계산해요?", "a": "세대원 모두의 전년도 근로·사업소득을 월평균으로 나눠요. 공고일 기준 세대원 수로 기준표를 골라요."}, {"q": "특별공급은 몇 번 당첨될 수 있나요?", "a": "평생 한 번이에요. 다만 신생아 특별공급 등 일부는 출산 가구에 예외가 있어 공고를 확인해요."}, {"q": "1인 가구도 생애최초를 넣을 수 있나요?", "a": "민영은 추첨 물량에서 전용 60㎡ 이하만 가능해요. 공공은 혼인 중이거나 자녀가 있어야 해요."}, {"q": "다자녀는 자녀가 몇 명이어야 해요?", "a": "2024년 3월부터 미성년 자녀(태아 포함) 2명 이상이에요."}];
