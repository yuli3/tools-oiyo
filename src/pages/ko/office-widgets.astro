---
// 세무·노무 사무소용 계산기 위젯 소개 (2026-11-23, 창의 제안 #8 첫 B2B 문의 창구).
// 결제·가입 없이 메일 문의만 받아요. 직접 만들기는 /ko/widgets/office/, 문의 메일은 lib/office-inquiry.ts.
// 자격 명칭(세무사·노무사 등)을 우리 서비스 이름으로 쓰지 않아요. 사무소가 쓰는 도구로만 소개해요.
import KrFinancePage from "../../components/KrFinancePage.astro";
import { EMBEDDABLE_TOOLS } from "../../data/embeddable-tools";
import { OFFICE_FIELDS, OFFICE_INQUIRY_EMAIL, officeInquiryMailto } from "../../lib/office-inquiry";

const title = "세무·노무 사무소 홈페이지용 계산기 위젯 — 사무소 이름과 상담 전화 버튼까지";
const description = "세무회계·노무·법무 사무소 홈페이지와 블로그에 사무소 이름, 전화번호, 대표 색을 넣은 연봉 실수령액·실업급여·연차·대출 계산기를 붙이세요. 계산을 마친 방문자에게 상담 전화 버튼이 보여요. 지금은 무료로 바로 쓰고, 맞춤 제작은 메일로 문의하세요.";
const shell = {
  introTitle: "홈페이지에 온 사람이 계산해 보고 바로 전화하게",
  intro: "사무소 홈페이지를 찾는 사람은 대개 '내 경우엔 얼마지?'가 궁금해서 와요. 그 자리에서 자기 숫자로 계산해 보고, 결과 바로 아래 사무소 전화 버튼을 보게 하면 상담 문의로 이어지기 쉬워요. 요율이 바뀌면 계산기도 같이 바뀌니 사무소가 고칠 일은 없어요.",
  howToTitle: "시작하는 방법",
  steps: [
    "아래 예시 위젯을 눌러 보고 어떤 계산기가 맞는지 골라요.",
    "바로 쓰려면 '무료로 만들기'에서 사무소 이름·전화번호·색을 넣고 코드를 복사해 홈페이지에 붙여요.",
    "출처 표시 없이 쓰거나 다른 계산기가 필요하면 아래 문의 메일을 보내요. 영업일 기준으로 답장드려요.",
  ],
  highlightsTitle: "사무소가 얻는 것",
  highlights: [
    { title: "상담 전화로 이어지는 결과 화면", body: "계산 결과 바로 아래에 사무소 이름과 전화 버튼이 보여요. 모바일에서는 누르면 바로 전화가 걸려요." },
    { title: "요율 자동 반영", body: "최저임금·4대보험·구직급여 요율이 바뀌면 위젯도 같이 바뀌어요. 1월마다 홈페이지를 고칠 필요가 없어요." },
    { title: "방문자 정보는 사무소 몫", body: "계산은 방문자의 브라우저 안에서만 해요. 입력값을 우리가 모으거나 다른 사무소에 넘기지 않아요." },
    { title: "가입·결제 없이 시작", body: "무료 위젯은 코드만 붙이면 돼요. 맞춤 제작은 메일로 범위와 비용을 먼저 안내해 드리고, 동의하실 때만 진행해요." },
  ],
  disclaimer: "위젯 계산 결과는 추정치예요. 계산 엔진은 OIYO가 만들고, 위젯을 붙인 사무소의 상담 내용과 업무는 각 사무소의 책임이에요. OIYO는 세무·노무 대리나 상담, 사무소 소개·알선을 하지 않아요.",
};
const faqs = [
  { q: "정말 무료인가요?", a: "네. 지금 있는 다섯 가지 위젯은 사무소 이름·전화번호를 넣어도 무료예요. 위젯 아래 작은 출처 링크만 남겨 주세요. 나중에 요금이 생겨도 미리 알려 드리고, 이미 붙인 무료 위젯은 그대로 작동해요." },
  { q: "맞춤 제작에는 무엇이 들어가나요?", a: "출처 표시 빼기, 사무소 로고, 종합소득세·퇴직금·4대보험처럼 사무소에 많이 묻는 계산기 추가 같은 요청을 받아요. 범위와 비용은 메일로 먼저 안내해 드려요." },
  { q: "방문자가 입력한 숫자가 사무소에 전달되나요?", a: "아니요. 위젯은 계산만 하고 입력값을 보내지 않아요. 상담은 방문자가 전화 버튼을 눌러야 이어져요." },
  { q: "네이버 블로그에도 붙일 수 있나요?", a: "네이버 블로그는 외부 iframe을 막아서 위젯이 뜨지 않아요. 사무소 홈페이지, 워드프레스, 티스토리, 아임웹·식스샵 같은 홈페이지 빌더의 HTML 블록에는 붙일 수 있어요." },
  { q: "위젯에는 어떤 문구가 들어가나요?", a: "계산기 화면에 사무소 이름과 전화번호, 홈페이지 버튼만 더해져요. 사무소 소개 문구는 각 사무소가 자기 홈페이지에서 직접 정해 주세요." },
];
const demo = `/ko/embed/salary-calculator/?${new URLSearchParams({ office: "한빛 세무회계(예시)", tel: "02-000-0000", color: "#1d4ed8" }).toString()}`;
const mailto = officeInquiryMailto({});
const input = "mt-1 min-h-11 w-full rounded-md border border-input bg-background px-3 text-base text-foreground";
const btn = "inline-flex min-h-11 items-center justify-center rounded-md border border-border px-4 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring";
const primary = "inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground hover:bg-primary/90 focus-visible:outline-2 focus-visible:outline-ring";
---
<KrFinancePage slug="office-widgets" locale="ko" title={title} description={description} shell={shell} faqs={faqs} koOnly group="money">
  <div class="flex flex-wrap gap-2">
    <a class={primary} href="/ko/widgets/office/">무료로 만들기</a>
    <a class={btn} href="#office-inquiry">맞춤 제작 문의</a>
  </div>

  <h2 class="mt-8 text-lg font-semibold">지금 붙일 수 있는 계산기</h2>
  <ul class="mt-3 grid gap-3 sm:grid-cols-2">
    {EMBEDDABLE_TOOLS.map((t) => (
      <li class="rounded-lg border border-border p-3">
        <a class="font-semibold underline underline-offset-4" href={`/ko/${t.slug}/`}>{t.name}</a>
        <p class="mt-1 text-sm text-muted-foreground">{t.blurb}</p>
      </li>
    ))}
  </ul>

  <h2 class="mt-8 text-lg font-semibold">예시: 사무소 이름이 들어간 연봉 계산기</h2>
  <p class="mt-1 text-sm text-muted-foreground">맨 위 띠와 결과 아래 전화 버튼에 사무소 정보가 들어가요. 예시 이름과 번호는 가짜예요.</p>
  <iframe src={demo} title="사무소 위젯 예시" width="100%" height="900" loading="lazy" class="mt-3 rounded-lg border border-border"></iframe>

  <h2 class="mt-8 text-lg font-semibold">무료와 맞춤 제작</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <section class="rounded-lg border border-border p-4">
      <h3 class="font-semibold">무료 위젯</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-foreground">
        <li>계산기 다섯 가지</li>
        <li>사무소 이름·전화번호·홈페이지·대표 색</li>
        <li>요율 자동 반영</li>
        <li>작은 OIYO 출처 링크가 남아요</li>
      </ul>
      <a class={`${btn} mt-3`} href="/ko/widgets/office/">직접 만들기</a>
    </section>
    <section class="rounded-lg border border-border p-4">
      <h3 class="font-semibold">맞춤 제작 (문의)</h3>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-foreground">
        <li>출처 표시 빼기, 사무소 로고</li>
        <li>사무소에 많이 묻는 계산기 추가</li>
        <li>여러 지점·여러 홈페이지에 맞춘 묶음</li>
        <li>범위와 비용은 메일로 먼저 안내해요</li>
      </ul>
      <a class={`${primary} mt-3`} href="#office-inquiry">문의하기</a>
    </section>
  </div>

  <section id="office-inquiry" class="mt-8 scroll-mt-20 rounded-lg border border-border p-4">
    <h2 class="text-lg font-semibold">맞춤 제작 문의</h2>
    <p class="mt-1 text-sm text-muted-foreground">아래 칸을 채우고 버튼을 누르면 메일 앱이 열려요. 입력값은 이 페이지에서 보내지지 않고, 메일을 직접 보낼 때만 전달돼요.</p>
    <form id="inquiry-form" class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-semibold">사무소 이름
        <input name="office" maxlength="40" autocomplete="organization" class={input} />
      </label>
      <label class="text-sm font-semibold">분야
        <select name="field" class={input}>
          {OFFICE_FIELDS.map((f) => <option value={f}>{f}</option>)}
        </select>
      </label>
      <label class="text-sm font-semibold">홈페이지(선택)
        <input name="site" type="url" placeholder="https://" class={input} />
      </label>
      <label class="text-sm font-semibold">원하는 계산기(선택)
        <input name="tools" maxlength="200" placeholder="예: 퇴직금, 종합소득세" class={input} />
      </label>
      <label class="text-sm font-semibold sm:col-span-2">더 하고 싶은 말(선택)
        <textarea name="message" rows="3" maxlength="1000" class={`${input} py-2`}></textarea>
      </label>
    </form>
    <div class="mt-3 flex flex-wrap gap-2">
      <a id="inquiry-send" class={primary} href={mailto}>메일로 문의하기</a>
      <button type="button" id="inquiry-copy" class={btn}>메일 주소 복사</button>
    </div>
    <p class="mt-2 text-sm text-foreground">메일 앱이 안 열리면 <span class="font-mono break-all">{OFFICE_INQUIRY_EMAIL}</span>로 보내 주세요.</p>
    <p aria-live="polite" id="inquiry-status" class="mt-2 text-sm text-foreground"></p>
  </section>

  <p class="mt-6 text-xs text-muted-foreground">함께 보기: <a class="underline" href="/ko/widgets/">블로그용 무료 위젯</a> · <a class="underline" href="/ko/law-guide/">법령 길잡이</a> · <a class="underline" href="/ko/tax-advisor-toolkit/">세무·회계 실무 도구 모음</a></p>

  <script>
    import { OFFICE_INQUIRY_EMAIL, officeInquiryMailto } from "../../lib/office-inquiry";
    const form = document.getElementById("inquiry-form") as HTMLFormElement;
    const send = document.getElementById("inquiry-send") as HTMLAnchorElement;
    const status = document.getElementById("inquiry-status");
    const gtag = (...a: unknown[]) => (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.(...a);
    function update() {
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) ?? "");
      send.href = officeInquiryMailto({ office: v("office"), field: v("field"), site: v("site"), tools: v("tools"), message: v("message") });
    }
    form.addEventListener("input", update);
    update();
    send.addEventListener("click", () => gtag("event", "office_inquiry_click", { field: new FormData(form).get("field") }));
    document.getElementById("inquiry-copy")?.addEventListener("click", async () => {
      gtag("event", "office_inquiry_copy");
      try {
        await navigator.clipboard.writeText(OFFICE_INQUIRY_EMAIL);
        if (status) status.textContent = "메일 주소를 복사했어요.";
      } catch {
        if (status) status.textContent = `메일 주소: ${OFFICE_INQUIRY_EMAIL}`;
      }
    });
  </script>
</KrFinancePage>
