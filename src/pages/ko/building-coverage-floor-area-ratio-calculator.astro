const faqs = [
  { q: "건폐율과 용적률은 어떻게 달라요?", a: "건폐율은 땅을 얼마나 넓게 덮는지(바닥), 용적률은 얼마나 높이 쌓는지(전체 층 바닥면적)를 나타내요. 같은 용적률이라도 건폐율을 낮추면 건물이 좁고 높아지고, 건폐율을 높이면 넓고 낮아져요." },
  { q: "지하층도 용적률에 들어가나요?", a: "아니요. 용적률을 계산하는 연면적에서는 지하층 면적, 지상층의 부속 주차장, 초고층 건축물의 피난안전구역 등이 빠져요. 그래서 지하 주차장을 넓게 만들어도 용적률은 늘지 않아요." },
  { q: "땅이 두 용도지역에 걸쳐 있으면요?", a: "가장 작은 부분이 330㎡(도로변 띠 모양 상업지역은 660㎡) 이하이면 건폐율·용적률은 각 부분 면적 비율로 가중평균하고, 그 밖의 건축 제한은 가장 넓은 부분의 용도지역을 따라요(국토계획법 제84조). 그보다 크면 부분마다 따로 적용해요. 건축물이 고도지구에 걸치는 경우 등 예외가 있으니 지자체에 확인하세요." },
  { q: "서울은 왜 법정 상한보다 낮나요?", a: "국토계획법 시행령은 범위만 정하고, 실제 값은 지자체 조례가 정해요. 서울시 도시계획조례는 제1종 일반주거 150%, 제2종 200%, 제3종 250%, 준주거 400%처럼 법정 상한보다 낮게 두고 있어요. 재건축·역세권 사업 등에서는 따로 완화를 받기도 해요." },
];
---
<KrFinancePage slug="building-coverage-floor-area-ratio-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <BuildingDensityCalculator client:load />
