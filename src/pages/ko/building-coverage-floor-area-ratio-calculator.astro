// 분양·건축 묶음 1 (2026-11-02, CHOSEUN "진행"). ko-only: 국토계획법 용도지역별 건폐율·용적률.
import KrFinancePage from "../../components/KrFinancePage.astro";
import BuildingDensityCalculator from "../../components/tools/BuildingDensityCalculator";
import { PRESALE_AS_OF } from "../../lib/kr-presale-2026";

const title = "건폐율·용적률 계산기 — 용도지역별 상한과 지을 수 있는 최대 면적";
const description = "대지면적·건축면적·지상 연면적으로 건폐율과 용적률을 계산하고, 21개 용도지역의 법정 상한(국토계획법 시행령)으로 지을 수 있는 최대 건축면적과 연면적을 확인해요.";

const ko = {
  eyebrow: "부동산 도구",
