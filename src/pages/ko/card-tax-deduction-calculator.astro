---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import RatesAsOf from "../../components/RatesAsOf.astro";
// 2026-10-17: 공제율·한도는 SSOT(src/lib/kr-rates-2026.mjs, api와 바이트 동일)에서만 읽어요.
import { KR_RATES_2026 } from "../../lib/kr-rates-2026.mjs";

const C = KR_RATES_2026.cardDeduction;
const man = (won: number) => `${(won / 10_000).toLocaleString("ko-KR")}만 원`;
const pct = (rate: number) => `${Math.round(rate * 100)}%`;
---

<Layout
  title="2026 연말정산 카드 소득공제 황금비율 계산기 — 신용카드 vs 체크카드 최적화"
  description="2026년 조세특례제한법 기준 총급여 25% 최저사용금액, 신용카드 15%·체크카드 30% 공제율, 자녀 수별 기본한도로 카드 소득공제와 절세액을 추정해요."
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
        2026 연말정산 카드 소득공제 황금비율 계산기
      </h1>
      <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
        총급여의 25%까지는 어떤 카드로 써도 공제가 없어요. 그 금액은 혜택이 큰 신용카드로 채우고, 넘는 금액을 공제율이 2배인 체크카드·현금영수증으로 쓰면 공제를 더 받을 수 있어요.
      </p>
      <RatesAsOf note={`2026년 지출분부터 기본한도가 자녀 수에 따라 올라요: 총급여 7천만 원 이하 ${man(C.baseLimitUpToTier[0])}·${man(C.baseLimitUpToTier[1])}·${man(C.baseLimitUpToTier[2])}, 초과 ${man(C.baseLimitOverTier[0])}·${man(C.baseLimitOverTier[1])}·${man(C.baseLimitOverTier[2])}(자녀 0·1·2명 이상).`} sources="조세특례제한법 제126조의2(2025-12-23 개정), 소득공제신청서 별지 제74호의6 산식" />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-card border border-border rounded-2xl p-6 shadow-xs space-y-5">
          <div>
            <label for="annual-salary" class="block text-xs font-bold text-foreground">
              총급여액 (연봉, 비과세 제외, 원)
            </label>
            <div class="mt-2 relative">
              <input
                type="number"
                id="annual-salary"
                value="50000000"
                step="1000000"
                min="10000000"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
            </div>
            <p id="salary-ko" class="mt-1 text-xs text-muted-foreground">5,000만 원 (공제 문턱: 1,250만 원)</p>
          </div>

          <div>
            <label for="children" class="block text-xs font-bold text-foreground">
              기본공제 받는 자녀·손자녀 수
            </label>
            <select
              id="children"
              class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
            >
              <option value="0" selected>없음</option>
              <option value="1">1명</option>
              <option value="2">2명 이상</option>
            </select>
          </div>

          <div>
            <label for="credit-spend" class="block text-xs font-bold text-foreground">
              신용카드 연간 사용액 (원)
            </label>
            <div class="mt-2 relative">
              <input
                type="number"
                id="credit-spend"
                value="15000000"
                step="500000"
                min="0"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
            </div>
          </div>

          <div>
            <label for="check-spend" class="block text-xs font-bold text-foreground">
              체크카드 및 현금영수증 사용액 (원)
            </label>
            <div class="mt-2 relative">
              <input
                type="number"
                id="check-spend"
                value="10000000"
                step="500000"
                min="0"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label for="culture-spend" class="block text-xs font-bold text-foreground">
                도서·공연·영화·체육시설 (원)
              </label>
              <div class="mt-2 relative">
                <input
                  type="number"
                  id="culture-spend"
                  value="1000000"
                  step="100000"
                  min="0"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
              </div>
            </div>

            <div>
              <label for="market-spend" class="block text-xs font-bold text-foreground">
                전통시장·대중교통 ({pct(C.rates.market)}, 원)
              </label>
              <div class="mt-2 relative">
                <input
                  type="number"
                  id="market-spend"
                  value="1200000"
                  step="100000"
                  min="0"
                  class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
                />
                <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Result Column -->
      <div class="lg:col-span-6 space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs">
          <p class="text-xs font-bold text-primary mb-1">
            소득공제 산출 결과
          </p>
          <div class="flex items-baseline justify-between mt-2 border-b border-border pb-4">
            <span class="text-xs text-muted-foreground">최종 소득공제 인정액</span>
            <span id="res-total-deduction" class="text-2xl sm:text-3xl font-black text-foreground font-mono">0원</span>
          </div>

          <div class="mt-4 space-y-3 text-xs">
            <div class="flex justify-between">
              <span class="text-muted-foreground">소비 문턱 (총급여 25%)</span>
              <span id="res-threshold" class="font-mono text-foreground">0원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">공제 대상 초과 소비액</span>
              <span id="res-excess-spend" class="font-mono text-foreground font-semibold">0원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">신용카드 공제액 ({pct(C.rates.credit)})</span>
              <span id="res-credit-ded" class="font-mono text-foreground">0원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">체크카드·현금 공제액 ({pct(C.rates.debitCash)})</span>
              <span id="res-check-ded" class="font-mono text-foreground font-bold text-primary">0원</span>
            </div>
            <div class="flex justify-between">
              <span class="text-muted-foreground">문화·시장·교통 추가공제</span>
              <span id="res-extra-ded" class="font-mono text-foreground">0원</span>
            </div>
            <div class="flex justify-between border-t border-border pt-2">
              <span class="font-bold text-foreground">절세액 추정 (한계세율 × 공제액)</span>
              <span id="res-tax-refund" class="font-mono font-black text-primary text-sm">0원</span>
            </div>
          </div>
        </div>

        <!-- Golden Rule Strategy Card -->
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs space-y-3">
          <p class="font-bold text-foreground text-sm">💡 2026 연말정산 최적 황금비율 가이드</p>
          <div id="golden-rule-box" class="rounded-xl bg-muted/40 p-4 text-xs leading-relaxed space-y-2">
            <p id="rule-step1" class="text-foreground font-semibold">
              1단계: 총급여 25%인 1,250만 원까지는 할인·마일리지 혜택이 큰 <strong>신용카드</strong>로 먼저 쓰세요.
            </p>
            <p id="rule-step2" class="text-foreground">
              2단계: 1,250만 원을 넘는 금액은 공제율이 2배인 <strong>체크카드(30%)</strong>나 <strong>현금영수증</strong>으로 쓰면 한도를 더 빨리 채워요.
            </p>
          </div>
          <p class="text-xs text-muted-foreground">
            ※ 절세액은 총급여에서 근로소득공제·본인 기본공제만 뺀 과세표준의 한계세율로 어림한 값이에요. 실제 환급액은 다른 공제·세액공제에 따라 달라져요. 총급여 7천만 원 초과자의 문화비는 신용카드 사용분으로 계산해요.
          </p>
        </div>
      </div>
    </div>

    <RelatedTools currentId="card-tax-deduction" />
  </div>

  <script>
    import { cardDeduction2026 } from "../../lib/kr-rates-2026.mjs";

    const salaryInput = document.getElementById("annual-salary") as HTMLInputElement;
    const childrenSelect = document.getElementById("children") as HTMLSelectElement;
    const creditInput = document.getElementById("credit-spend") as HTMLInputElement;
    const checkInput = document.getElementById("check-spend") as HTMLInputElement;
    const cultureInput = document.getElementById("culture-spend") as HTMLInputElement;
    const marketInput = document.getElementById("market-spend") as HTMLInputElement;

    const salaryKo = document.getElementById("salary-ko")!;
    const resTotalDeduction = document.getElementById("res-total-deduction")!;
    const resThreshold = document.getElementById("res-threshold")!;
    const resExcessSpend = document.getElementById("res-excess-spend")!;
    const resCreditDed = document.getElementById("res-credit-ded")!;
    const resCheckDed = document.getElementById("res-check-ded")!;
    const resExtraDed = document.getElementById("res-extra-ded")!;
    const resTaxRefund = document.getElementById("res-tax-refund")!;
    const ruleStep1 = document.getElementById("rule-step1")!;
    const ruleStep2 = document.getElementById("rule-step2")!;

    const value = (el: HTMLInputElement) => Math.max(0, parseFloat(el.value) || 0);
    function formatKRW(val: number): string {
      return Math.round(val).toLocaleString("ko-KR") + "원";
    }

    function calculate() {
      const salary = value(salaryInput);
      if (salary <= 0) return;
      // 2026-10-17: 최저사용금액 순서·공제율·자녀 수별 한도·한계세율은 SSOT 함수 하나로 계산해요
      // (api /v1/tax/card-deduction과 같은 식). 전통시장·대중교통은 둘 다 40%라 한 칸으로 받아요.
      const r = cardDeduction2026({
        annualSalary: salary,
        creditCardSpend: value(creditInput),
        checkCardSpend: value(checkInput),
        cultureSpend: value(cultureInput),
        traditionalMarketSpend: value(marketInput),
        children: Number(childrenSelect.value),
      });
      const threshold = r.threshold25Percent;
      salaryKo.textContent = `${Math.floor(salary / 10000).toLocaleString("ko-KR")}만 원 (공제 문턱: ${Math.floor(threshold / 10000).toLocaleString("ko-KR")}만 원)`;

      resTotalDeduction.textContent = formatKRW(r.totalDeduction);
      resThreshold.textContent = formatKRW(threshold);
      resExcessSpend.textContent = formatKRW(Math.max(0, r.totalSpend - threshold));
      resCreditDed.textContent = formatKRW(r.creditDeduction);
      resCheckDed.textContent = formatKRW(r.checkDeduction);
      resExtraDed.textContent = formatKRW(r.actualExtraDeduction);
      resTaxRefund.textContent = `약 ${formatKRW(r.estimatedTaxRefund)} (한계세율 ${Math.round(r.marginalRate * 100)}%)`;

      ruleStep1.innerHTML = `1단계: 총급여 25%인 <strong>${formatKRW(threshold)}</strong>까지는 부가서비스·포인트 혜택이 큰 <strong>신용카드</strong>로 먼저 쓰세요.`;
      ruleStep2.innerHTML = `2단계: <strong>${formatKRW(threshold)}</strong>을 넘는 금액은 공제율이 2배인 <strong>체크카드·현금영수증(30%)</strong>으로 쓰면 기본 한도(${formatKRW(r.baseLimit)})를 더 빨리 채워요.`;
    }

    [salaryInput, childrenSelect, creditInput, checkInput, cultureInput, marketInput].forEach((el) => {
      el.addEventListener("input", calculate);
      el.addEventListener("change", calculate);
    });

    calculate();
  </script>
</Layout>
