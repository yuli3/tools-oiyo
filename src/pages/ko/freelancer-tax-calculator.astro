---
import Layout from "../../components/Layout.astro";
---

<Layout
  title="3.3% 프리랜서 원천징수 세금 및 5월 종소세 환급금 계산기"
  description="프리랜서, 알바, 긱워커 사업소득 3.3% 원천징수 세액과 세후 실수령액 역산, 5월 종합소득세 단순경비율 적용 예상 환급금을 정밀 계산합니다."
>
  <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        국세청 단순경비율 및 소득세법 기준
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
        프리랜서 3.3% 세금 & 환급 계산기
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        3.3% 사업소득 원천징수 세액 및 세후 실수령액(역산 가능)을 계산하고, 5월 종합소득세 신고 시 돌려받을 수 있는 예상 환급금을 확인하세요.
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex items-center gap-2 p-1 bg-muted rounded-xl mb-6">
      <button
        id="tabWithholding"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all"
      >
        3.3% 원천징수 & 실수령액 계산
      </button>
      <button
        id="tabRefund"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all"
      >
        5월 종소세 환급금 시뮬레이터
      </button>
    </div>

    <!-- Mode 1: Withholding & Net Payout -->
    <div id="sectionWithholding" class="space-y-6">
      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <div>
          <label class="text-xs font-bold text-foreground block mb-2">계산 방식</label>
          <div class="flex items-center gap-4 text-xs font-semibold">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="calcDirection" value="grossToNet" checked class="text-primary focus:ring-primary" />
              <span>세전 계약금액 → 세후 수령액</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="radio" name="calcDirection" value="netToGross" class="text-primary focus:ring-primary" />
              <span>원하는 실수령액 → 세전 계약금액 역산</span>
            </label>
          </div>
        </div>

        <div>
          <label id="inputAmountLabel" for="inputAmount" class="text-xs font-bold text-foreground block mb-1.5">
            세전 계약 금액 (원)
          </label>
          <input
            type="number"
            id="inputAmount"
            value="3000000"
            step="100000"
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <span id="inputAmountKor" class="text-xs text-muted-foreground mt-1 block">300만 원</span>
        </div>
      </div>

      <!-- Result Card -->
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="text-xs font-bold text-primary uppercase tracking-wider">
          최종 정산 결과
        </div>
        <div class="flex items-baseline justify-between border-b border-primary/10 pb-4">
          <span id="resultMainLabel" class="text-sm font-semibold text-muted-foreground">세후 통장 입금액 (실수령액)</span>
          <span id="resultMainAmount" class="text-2xl sm:text-3xl font-black text-foreground">2,901,000원</span>
        </div>
        <div class="grid grid-cols-3 gap-3 text-xs">
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">소득세 (3.0%)</div>
            <div id="taxIncome" class="font-bold text-foreground mt-1 text-sm">90,000원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">지방소득세 (0.3%)</div>
            <div id="taxLocal" class="font-bold text-foreground mt-1 text-sm">9,000원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">원천징수 공제액 합계 (3.3%)</div>
            <div id="taxTotal" class="font-bold text-destructive mt-1 text-sm">-99,000원</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode 2: 5월 종소세 환급금 시뮬레이터 -->
    <div id="sectionRefund" class="space-y-6 hidden">
      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="annualRevenue" class="text-xs font-bold text-foreground block mb-1.5">
              연간 3.3% 총 수입 (원)
            </label>
            <input
              type="number"
              id="annualRevenue"
              value="24000000"
              step="1000000"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span id="annualRevenueKor" class="text-xs text-muted-foreground mt-1 block">2,400만 원</span>
          </div>

          <div>
            <label for="jobCategory" class="text-xs font-bold text-foreground block mb-1.5">
              프리랜서 업종 및 단순경비율
            </label>
            <select
              id="jobCategory"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="64.1" selected>기타 자영업 / 프리랜서 (940909) — 64.1%</option>
              <option value="61.7">작가 / 번역 / 집필 (940100) — 61.7%</option>
              <option value="58.7">프로그래머 / 개발 / 디자인 (940911) — 58.7%</option>
              <option value="73.2">학원 강사 / 과외 (940903) — 73.2%</option>
              <option value="79.4">배달대행 / 퀵서비스 (940918) — 79.4%</option>
            </select>
          </div>

          <div>
            <label for="dependentsCount" class="text-xs font-bold text-foreground block mb-1.5">
              부양가족 수 (본인 포함 기본공제 인원)
            </label>
            <input
              type="number"
              id="dependentsCount"
              value="1"
              min="1"
              max="10"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span class="text-[11px] text-muted-foreground mt-1 block">1인당 150만 원 공제</span>
          </div>
        </div>
      </div>

      <!-- Refund Result Card -->
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="text-xs font-bold text-primary uppercase tracking-wider">
          5월 종합소득세 예상 환급금
        </div>
        <div class="flex items-baseline justify-between border-b border-primary/10 pb-4">
          <span id="refundLabel" class="text-sm font-semibold text-muted-foreground">돌려받을 세금 (환급 예정액)</span>
          <span id="refundAmount" class="text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400">0원</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">기납부세액 (이미 낸 3.3%)</div>
            <div id="prepaidTax" class="font-bold text-foreground mt-1 text-sm">792,000원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">인정 필요경비</div>
            <div id="recognizedExpense" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">과세표준</div>
            <div id="refundTaxBase" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">최종 결정세액</div>
            <div id="finalCalculatedTax" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Educational Guide -->
    <div class="mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-xs leading-relaxed text-muted-foreground">
      <h2 class="text-sm font-bold text-foreground">💡 프리랜서 3.3% 세무 & 5월 환급 노하우</h2>
      <ul class="list-disc list-inside space-y-1.5">
        <li><strong>원천징수 3.3%의 구조</strong>: 국세인 사업소득세 3%와 지방자치단체에 납부하는 지방소득세 0.3%(소득세의 10%)가 합쳐져 3.3%가 원천징수됩니다.</li>
        <li><strong>단순경비율 환급 혜택</strong>: 연간 수입 3,600만 원 미만의 신규 또는 소규모 프리랜서는 장부를 작성하지 않아도 수입의 60~75%가 자동으로 필요경비로 인정되어, 이미 낸 3.3% 중 상당 부분을 5월 종합소득세 신고 때 전액 환급받는 경우가 많습니다.</li>
        <li><strong>기본공제와 세액공제</strong>: 본인 기본공제 150만 원과 표준세액공제(7만 원) 등이 적용되어 실제 과세표준이 0원이 되면 기납부세액 100%가 국세환급금으로 환급됩니다.</li>
      </ul>
    </div>
  </div>
</Layout>

<script>
  function formatWon(val: number): string {
    return Math.round(val).toLocaleString('ko-KR') + '원';
  }

  function toKoreanAmount(num: number): string {
    if (!num || num <= 0) return '0원';
    const eok = Math.floor(num / 100000000);
    const man = Math.floor((num % 100000000) / 10000);
    let str = '';
    if (eok > 0) str += `${eok}억 `;
    if (man > 0) str += `${man.toLocaleString('ko-KR')}만 `;
    return str.trim() + '원';
  }

  // Tabs
  const tabWith = document.getElementById('tabWithholding')!;
  const tabRef = document.getElementById('tabRefund')!;
  const secWith = document.getElementById('sectionWithholding')!;
  const secRef = document.getElementById('sectionRefund')!;

  tabWith.addEventListener('click', () => {
    tabWith.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all';
    tabRef.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
    secWith.classList.remove('hidden');
    secRef.classList.add('hidden');
  });

  tabRef.addEventListener('click', () => {
    tabRef.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all';
    tabWith.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
    secRef.classList.remove('hidden');
    secWith.classList.add('hidden');
  });

  // Calculate Withholding
  function calculateWithholding() {
    const isGrossToNet = (document.querySelector('input[name="calcDirection"]:checked') as HTMLInputElement).value === 'grossToNet';
    const amount = Number((document.getElementById('inputAmount') as HTMLInputElement).value) || 0;

    document.getElementById('inputAmountKor')!.textContent = toKoreanAmount(amount);

    if (isGrossToNet) {
      document.getElementById('inputAmountLabel')!.textContent = '세전 계약 금액 (원)';
      document.getElementById('resultMainLabel')!.textContent = '세후 통장 입금액 (실수령액)';

      const taxIncome = Math.floor(amount * 0.03);
      const taxLocal = Math.floor(taxIncome * 0.1);
      const taxTotal = taxIncome + taxLocal;
      const netPayout = amount - taxTotal;

      document.getElementById('resultMainAmount')!.textContent = formatWon(netPayout);
      document.getElementById('taxIncome')!.textContent = formatWon(taxIncome);
      document.getElementById('taxLocal')!.textContent = formatWon(taxLocal);
      document.getElementById('taxTotal')!.textContent = `-${formatWon(taxTotal)}`;
    } else {
      document.getElementById('inputAmountLabel')!.textContent = '원하는 실수령액 (원)';
      document.getElementById('resultMainLabel')!.textContent = '필요한 세전 계약 금액';

      const grossRequired = Math.round(amount / 0.967);
      const taxIncome = Math.floor(grossRequired * 0.03);
      const taxLocal = Math.floor(taxIncome * 0.1);
      const taxTotal = taxIncome + taxLocal;

      document.getElementById('resultMainAmount')!.textContent = formatWon(grossRequired);
      document.getElementById('taxIncome')!.textContent = formatWon(taxIncome);
      document.getElementById('taxLocal')!.textContent = formatWon(taxLocal);
      document.getElementById('taxTotal')!.textContent = `-${formatWon(taxTotal)}`;
    }
  }

  // Calculate Refund
  function calculateRefund() {
    const revenue = Number((document.getElementById('annualRevenue') as HTMLInputElement).value) || 0;
    const expenseRate = Number((document.getElementById('jobCategory') as HTMLSelectElement).value) / 100;
    const dependents = Number((document.getElementById('dependentsCount') as HTMLInputElement).value) || 1;

    document.getElementById('annualRevenueKor')!.textContent = toKoreanAmount(revenue);

    const prepaidTax = Math.floor(revenue * 0.033);
    const expense = Math.round(revenue * expenseRate);
    const businessIncome = Math.max(0, revenue - expense);

    const personalDeduction = dependents * 1500000;
    const taxBase = Math.max(0, businessIncome - personalDeduction);

    let calculatedTax = 0;
    if (taxBase <= 14000000) {
      calculatedTax = taxBase * 0.06;
    } else if (taxBase <= 50000000) {
      calculatedTax = 840000 + (taxBase - 14000000) * 0.15;
    } else {
      calculatedTax = 6240000 + (taxBase - 50000000) * 0.24;
    }

    // 표준세액공제 (7만 원)
    const finalIncomeTax = Math.max(0, calculatedTax - 70000);
    const finalTotalTax = Math.round(finalIncomeTax * 1.1); // 지방소득세 10% 포함

    const refund = prepaidTax - finalTotalTax;

    const refundElem = document.getElementById('refundAmount')!;
    const labelElem = document.getElementById('refundLabel')!;

    if (refund >= 0) {
      labelElem.textContent = '돌려받을 세금 (환급 예정액)';
      refundElem.textContent = `+${formatWon(refund)}`;
      refundElem.className = 'text-2xl sm:text-3xl font-black text-emerald-600 dark:text-emerald-400';
    } else {
      labelElem.textContent = '추가 납부할 세액';
      refundElem.textContent = formatWon(Math.abs(refund));
      refundElem.className = 'text-2xl sm:text-3xl font-black text-destructive';
    }

    document.getElementById('prepaidTax')!.textContent = formatWon(prepaidTax);
    document.getElementById('recognizedExpense')!.textContent = `${formatWon(expense)} (${(expenseRate * 100).toFixed(1)}%)`;
    document.getElementById('refundTaxBase')!.textContent = formatWon(taxBase);
    document.getElementById('finalCalculatedTax')!.textContent = formatWon(finalTotalTax);
  }

  document.querySelectorAll('input[name="calcDirection"]').forEach((r) => r.addEventListener('change', calculateWithholding));
  document.getElementById('inputAmount')?.addEventListener('input', calculateWithholding);

  ['annualRevenue', 'jobCategory', 'dependentsCount'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', calculateRefund);
    document.getElementById(id)?.addEventListener('change', calculateRefund);
  });

  calculateWithholding();
  calculateRefund();
</script>
