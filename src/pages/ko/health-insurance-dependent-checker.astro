// 건강보험 피부양자 자격 점검 (2026-11-24, 니즈: "건강보험 피부양자 자격", "피부양자 등록 누가", "피부양자 등록 기간"). 계산: lib/kr-office-checks-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import DependentCheck from "../../components/tools/office/DependentCheck";

const title = "건강보험 피부양자 자격 점검 — 관계·동거별 부양요건과 소득 2천만원·재산 기준";
const description = "부모·자녀·배우자 부모·형제자매 등 직장가입자와의 관계와 동거 여부로 부양요건을 먼저 보고, 연 소득 2천만원·사업소득·재산세 과세표준(5억4천만원·9억원, 형제자매 1억8천만원) 기준을 함께 점검해요. 90일 신고 규칙까지.";
const shell = {
