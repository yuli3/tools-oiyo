};
const faqs = [
  { q: "따로 사는 부모님도 올릴 수 있어요?", a: "부모와 함께 사는 형제자매가 없거나, 있어도 그 형제자매가 보수·소득이 없으면 부양을 인정해요(별표 1)." },
  { q: "며느리·사위는요?", a: "같이 살면 인정하고, 따로 살면 인정하지 않아요(별표 1 제6호)." },
  { q: "형제자매는 누구나 돼요?", a: "30세 미만, 65세 이상, 등록 장애인, 상이등급 국가유공자·보훈보상대상자 중 하나이고 미혼 등 조건을 갖춰야 해요. 재산 기준도 1억8천만원으로 낮아요." },
