const faqs = [{"q": "10억 집을 7억에 사면요?", "a": "차이 3억이 기준(3억)과 같아 증여 대상이지만, 기준을 빼면 증여재산은 0원이에요. 파는 사람 양도세는 시가 10억으로 다시 계산해요."}, {"q": "시가는 어떻게 정하나요?", "a": "거래일 전후 6개월(증여는 전 6개월~후 3개월) 안의 감정가, 비슷한 집 매매가 등을 써요. 아파트는 같은 단지 거래가가 주로 쓰여요."}, {"q": "비싸게 사도 문제인가요?", "a": "네. 시가보다 비싸게 사면 파는 사람이 증여를 받은 것으로 봐요(고가 양도). 기준은 같아요."}, {"q": "취득세는요?", "a": "특수관계인 간 거래가가 시가와 크게 다르면 취득세도 시가인정액으로 매겨질 수 있어요."}];
