---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="부동산 보유세 계산기 — 2026년 주택 재산세 & 종합부동산세(종부세) 정밀 모의계산"
  description="공시가격 기준 1세대 1주택자(기본공제 12억, 연령·보유 세액공제 최대 80%) 및 다주택자(공제 9억) 재산세, 도시지역분, 지방교육세, 종부세, 농어촌특별세를 한눈에 연산해요."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        2026년 보유세 개정 세법 (공정시장가액비율 60% 반영)
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-2">
        부동산 보유세 (재산세 · 종합부동산세) 계산기
      </h1>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        보유 주택의 공시가격과 보유 주택 수, 연령 및 보유기간을 입력하면 7·9월 재산세와 12월 종부세 총 부담액을 즉시 계산해요.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Form -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm space-y-5">
        <!-- Home Ownership Status -->
        <div>
          <label class="block text-xs font-bold text-foreground mb-1.5">
            주택 보유 자격 및 세대 구성
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button
              id="owner-single"
              type="button"
              class="owner-btn py-2.5 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center"
              data-type="single"
            >
              1세대 1주택 (단독명의)
              <span class="block text-[10px] font-normal text-muted-foreground mt-0.5">기본공제 12억 · 특례세율</span>
            </button>
            <button
              id="owner-multi"
              type="button"
              class="owner-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-type="multi"
            >
              다주택자 (또는 공동명의 1주택)
              <span class="block text-[10px] font-normal text-muted-foreground mt-0.5">인별 기본공제 9억원</span>
            </button>
          </div>
        </div>

        <!-- House Count (for multi) -->
        <div id="multi-count-group" class="hidden">
          <label class="block text-xs font-bold text-foreground mb-1.5">
            총 보유 주택 수
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button
              id="houses-2"
              type="button"
              class="house-btn py-2 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center"
              data-count="2"
            >
              2주택 이하 (일반세율)
            </button>
            <button
              id="houses-3"
              type="button"
              class="house-btn py-2 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-count="3"
            >
              3주택 이상 (중과세율)
            </button>
          </div>
        </div>

        <!-- Official Price Input -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="official-price" class="text-xs font-bold text-foreground">
              주택 공시가격 합계 (부동산공시가격알리미 기준)
            </label>
            <span id="price-korean" class="text-xs font-bold text-primary">10억원</span>
          </div>
          <div class="relative">
            <input
              id="official-price"
              type="number"
              min="0"
              step="1000"
              value="100000"
              class="w-full rounded-xl border border-border bg-background px-3.5 py-2.5 text-sm font-semibold text-foreground focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary pr-12"
            />
            <span class="absolute right-3.5 top-2.5 text-xs font-semibold text-muted-foreground">만원</span>
          </div>
          <!-- Quick Price Buttons -->
          <div class="flex flex-wrap gap-1.5 mt-2">
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-add="10000">+1억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-add="50000">+5억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-set="60000">6억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-set="90000">9억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-set="120000">12억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-set="150000">15억</button>
            <button type="button" class="price-pill text-[11px] px-2 py-1 rounded-md bg-muted text-muted-foreground hover:bg-primary/15 hover:text-primary transition-colors" data-set="200000">20억</button>
          </div>
          <p class="text-[11px] text-muted-foreground mt-1.5">
            * 통상 아파트 실거래 시세의 약 65%~75% 수준이 공시가격에 해당해요.
          </p>
        </div>

        <!-- 1-Homeowner Special Deduction Options -->
        <div id="single-deduction-group" class="p-4 rounded-xl bg-muted/30 border border-border/60 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-foreground">1주택자 고령자 · 장기보유 세액공제</span>
            <span id="total-deduction-badge" class="text-[11px] font-bold px-2 py-0.5 rounded bg-primary/15 text-primary">공제율 0%</span>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="owner-age" class="block text-[11px] font-semibold text-muted-foreground mb-1">
                명의자 연령 (만 나이)
              </label>
              <select
                id="owner-age"
                class="w-full rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
              >
                <option value="0">만 60세 미만 (공제 0%)</option>
                <option value="20">만 60세 ~ 64세 (공제 20%)</option>
                <option value="30">만 65세 ~ 69세 (공제 30%)</option>
                <option value="40">만 70세 이상 (공제 40%)</option>
              </select>
            </div>
            <div>
              <label for="holding-period" class="block text-[11px] font-semibold text-muted-foreground mb-1">
                주택 보유 기간
              </label>
              <select
                id="holding-period"
                class="w-full rounded-lg border border-border bg-background px-2.5 py-1.5 text-xs text-foreground focus:border-primary focus:outline-none"
              >
                <option value="0">5년 미만 (공제 0%)</option>
                <option value="20">5년 ~ 9년 (공제 20%)</option>
                <option value="40">10년 ~ 14년 (공제 40%)</option>
                <option value="50">15년 이상 (공제 50%)</option>
              </select>
            </div>
          </div>
          <p class="text-[10px] text-muted-foreground">
            * 연령별 공제와 보유기간 공제는 합산 가능하며 최대 80% 한도로 적용돼요.
          </p>
        </div>

        <!-- Urban Area Checkbox -->
        <div class="flex items-center gap-2 pt-1">
          <input
            id="include-urban"
            type="checkbox"
            checked
            class="h-4 w-4 rounded border-border text-primary focus:ring-primary"
          />
          <label for="include-urban" class="text-xs font-semibold text-foreground cursor-pointer">
            도시지역분 재산세 포함 (0.14%, 대부분의 도심 아파트 해당)
          </label>
        </div>
      </div>

      <!-- Result Panel -->
      <div class="lg:col-span-6 space-y-5">
        <!-- Main Total Card -->
        <div class="bg-card border-2 border-primary/30 rounded-2xl p-6 shadow-sm">
          <div class="text-xs font-bold text-muted-foreground uppercase tracking-wider mb-1">
            2026 연간 총 보유세 예상 부담액
          </div>
          <div class="flex items-baseline gap-2 mb-4">
            <span id="res-total-tax" class="text-3xl sm:text-4xl font-black text-primary">
              0원
            </span>
            <span class="text-xs text-muted-foreground">(재산세 + 종합부동산세 합산)</span>
          </div>

          <div class="space-y-3 pt-3 border-t border-border">
            <!-- Property Tax Summary -->
            <div class="flex justify-between items-center text-xs">
              <span class="font-bold text-foreground">1. 주택분 재산세 총합계</span>
              <span id="res-property-tax-total" class="font-extrabold text-foreground">0원</span>
            </div>
            <!-- Comprehensive Holding Tax Summary -->
            <div class="flex justify-between items-center text-xs">
              <span class="font-bold text-foreground">2. 종합부동산세 총합계</span>
              <span id="res-comp-tax-total" class="font-extrabold text-foreground">0원</span>
            </div>
          </div>
        </div>

        <!-- Breakdown Details -->
        <div class="bg-card border border-border rounded-2xl p-6 shadow-sm space-y-4">
          <h3 class="text-xs font-bold text-foreground flex items-center justify-between">
            <span>세목별 상세 내역서</span>
            <span id="comp-tax-status-badge" class="text-[11px] font-normal text-muted-foreground">종부세 과세 대상 아님</span>
          </h3>

          <!-- Property Tax Items -->
          <div class="rounded-xl bg-muted/20 p-3.5 space-y-2 text-xs">
            <div class="font-bold text-foreground flex items-center justify-between border-b border-border/60 pb-1.5">
              <span>재산세 납부액 (7월 50% / 9월 50%)</span>
              <span id="res-property-split" class="text-primary font-semibold">각 0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 재산세 본세</span>
              <span id="res-prop-base">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 도시지역분 (과표 0.14%)</span>
              <span id="res-prop-urban">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 지방교육세 (본세의 20%)</span>
              <span id="res-prop-edu">0원</span>
            </div>
          </div>

          <!-- Comprehensive Holding Tax Items -->
          <div class="rounded-xl bg-muted/20 p-3.5 space-y-2 text-xs">
            <div class="font-bold text-foreground flex items-center justify-between border-b border-border/60 pb-1.5">
              <span>종합부동산세 납부액 (12월 일시납)</span>
              <span id="res-comp-final" class="text-primary font-semibold">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 과세표준 (공시가 - 공제액) × 60%</span>
              <span id="res-comp-taxbase">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 종부세 산출세액</span>
              <span id="res-comp-raw">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 재산세 이중과세 공제액</span>
              <span id="res-comp-prop-deduct">- 0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 1주택 세액공제 (연령/보유)</span>
              <span id="res-comp-age-deduct">- 0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground text-[11px]">
              <span>- 농어촌특별세 (본세 20%)</span>
              <span id="res-comp-rural">0원</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Informational Guide -->
    <div class="mt-12 bg-card border border-border rounded-2xl p-6 sm:p-8 space-y-6">
      <h2 class="text-lg font-bold text-foreground">
        알아두면 유용한 2026년 부동산 보유세 핵심 가이드
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-muted-foreground leading-relaxed">
        <div class="space-y-2">
          <h3 class="font-bold text-foreground text-sm">💡 재산세 납부 기간과 분할 납부</h3>
          <p>
            재산세는 매년 6월 1일 기준 사실상 소유자에게 과세돼요. 세액이 20만원을 초과하면 7월 16일~31일(1/2)과 9월 16일~30일(1/2)로 나누어 고지서가 발송돼요.
          </p>
          <p>
            재산세 납부세액이 250만원을 초과하는 경우 납부기한이 지난 날부터 3개월 이내에 분할납부(분납) 신청이 가능해요.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-bold text-foreground text-sm">🏠 1세대 1주택 종부세 혜택과 공제</h3>
          <p>
            1세대 1주택 단독명의자는 공시가격 12억원까지 종부세가 전액 비과세(기본공제)돼요. 12억원을 초과하는 부분에 대해서만 공정시장가액비율(60%)을 곱해 과세표준을 산출해요.
          </p>
          <p>
            만 60세 이상 고령자 세액공제(20%~40%)와 5년 이상 장기보유 세액공제(20%~50%)는 최대 80% 한도 내에서 중복 적용되어 세부담을 획기적으로 낮출 수 있어요.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Tools Component -->
    <RelatedTools currentId="property-tax" />
  </div>
</Layout>

<script>
  // State
  let ownerType: "single" | "multi" = "single";
  let houseCount = 2; // 2 or 3
  let officialPriceWon = 1000000000; // 10억
  let ageRate = 0;
  let holdRate = 0;
  let includeUrban = true;

  function formatWon(num: number): string {
    return Math.round(num).toLocaleString("ko-KR") + "원";
  }

  function formatKoreanPrice(numWon: number): string {
    const eok = Math.floor(numWon / 100000000);
    const man = Math.floor((numWon % 100000000) / 10000);
    let str = "";
    if (eok > 0) str += `${eok}억 `;
    if (man > 0) str += `${man.toLocaleString("ko-KR")}만 `;
    if (!str) return "0원";
    return str.trim() + "원";
  }

  // Property Tax Calculation
  function calcPropertyTax(priceWon: number, isSingle: boolean, withUrban: boolean) {
    // Fair market value ratio: 60%
    const taxBase = priceWon * 0.6;
    let baseTax = 0;

    // Special rate for single home <= 9 eok
    if (isSingle && priceWon <= 900000000) {
      if (taxBase <= 60000000) {
        baseTax = taxBase * 0.0005;
      } else if (taxBase <= 150000000) {
        baseTax = 30000 + (taxBase - 60000000) * 0.001;
      } else if (taxBase <= 300000000) {
        baseTax = 120000 + (taxBase - 150000000) * 0.002;
      } else {
        baseTax = 420000 + (taxBase - 300000000) * 0.0035;
      }
    } else {
      // Standard rate
      if (taxBase <= 60000000) {
        baseTax = taxBase * 0.001;
      } else if (taxBase <= 150000000) {
        baseTax = 60000 + (taxBase - 60000000) * 0.0015;
      } else if (taxBase <= 300000000) {
        baseTax = 195000 + (taxBase - 150000000) * 0.0025;
      } else {
        baseTax = 570000 + (taxBase - 300000000) * 0.004;
      }
    }

    const urbanTax = withUrban ? taxBase * 0.0014 : 0;
    const eduTax = baseTax * 0.2;
    const totalPropTax = baseTax + urbanTax + eduTax;

    return {
      taxBase,
      baseTax,
      urbanTax,
      eduTax,
      totalPropTax,
    };
  }

  // Comprehensive Real Estate Holding Tax (종부세)
  function calcCompTax(priceWon: number, isSingle: boolean, count: number, totalDeductRate: number) {
    const exemption = isSingle ? 1200000000 : 900000000;
    const excess = priceWon - exemption;

    if (excess <= 0) {
      return {
        isSubject: false,
        taxBase: 0,
        rawTax: 0,
        propDeduct: 0,
        ageDeduct: 0,
        baseCompTax: 0,
        ruralTax: 0,
        totalCompTax: 0,
      };
    }

    // Fair market value ratio: 60%
    const taxBase = excess * 0.6;
    let rawTax = 0;

    // Rates based on 2 houses vs 3+ houses
    if (count >= 3 && !isSingle) {
      // Heavy rate for 3+ homes
      if (taxBase <= 300000000) {
        rawTax = taxBase * 0.005;
      } else if (taxBase <= 600000000) {
        rawTax = 1500000 + (taxBase - 300000000) * 0.007;
      } else if (taxBase <= 1200000000) {
        rawTax = 3600000 + (taxBase - 600000000) * 0.01;
      } else if (taxBase <= 2500000000) {
        rawTax = 9600000 + (taxBase - 1200000000) * 0.02;
      } else if (taxBase <= 5000000000) {
        rawTax = 35600000 + (taxBase - 2500000000) * 0.03;
      } else if (taxBase <= 9400000000) {
        rawTax = 110600000 + (taxBase - 5000000000) * 0.04;
      } else {
        rawTax = 286600000 + (taxBase - 9400000000) * 0.05;
      }
    } else {
      // Standard rate for <= 2 homes & single home
      if (taxBase <= 300000000) {
        rawTax = taxBase * 0.005;
      } else if (taxBase <= 600000000) {
        rawTax = 1500000 + (taxBase - 300000000) * 0.007;
      } else if (taxBase <= 1200000000) {
        rawTax = 3600000 + (taxBase - 600000000) * 0.01;
      } else if (taxBase <= 2500000000) {
        rawTax = 9600000 + (taxBase - 1200000000) * 0.013;
      } else if (taxBase <= 5000000000) {
        rawTax = 26500000 + (taxBase - 2500000000) * 0.015;
      } else if (taxBase <= 9400000000) {
        rawTax = 64000000 + (taxBase - 5000000000) * 0.02;
      } else {
        rawTax = 152000000 + (taxBase - 9400000000) * 0.027;
      }
    }

    // Property tax overlap deduction estimation (approx 0.4% * taxbase standard ratio)
    const propDeduct = taxBase * 0.0024;
    let netCompTax = Math.max(0, rawTax - propDeduct);

    // Single homeowner age/holding deduction
    let ageDeduct = 0;
    if (isSingle && totalDeductRate > 0) {
      const cappedRate = Math.min(0.8, totalDeductRate);
      ageDeduct = netCompTax * cappedRate;
      netCompTax = netCompTax - ageDeduct;
    }

    const ruralTax = netCompTax * 0.2;
    const totalCompTax = netCompTax + ruralTax;

    return {
      isSubject: true,
      taxBase,
      rawTax,
      propDeduct,
      ageDeduct,
      baseCompTax: netCompTax,
      ruralTax,
      totalCompTax,
    };
  }

  function update() {
    const isSingle = ownerType === "single";
    const totalDeductRate = isSingle ? (ageRate + holdRate) / 100 : 0;

    const prop = calcPropertyTax(officialPriceWon, isSingle, includeUrban);
    const comp = calcCompTax(officialPriceWon, isSingle, houseCount, totalDeductRate);

    const totalTax = prop.totalPropTax + comp.totalCompTax;

    // Update DOM
    const resTotalTax = document.getElementById("res-total-tax");
    if (resTotalTax) resTotalTax.textContent = formatWon(totalTax);

    const resPropTotal = document.getElementById("res-property-tax-total");
    if (resPropTotal) resPropTotal.textContent = formatWon(prop.totalPropTax);

    const resCompTotal = document.getElementById("res-comp-tax-total");
    if (resCompTotal) resCompTotal.textContent = formatWon(comp.totalCompTax);

    const resPropSplit = document.getElementById("res-property-split");
    if (resPropSplit) resPropSplit.textContent = `각 ${formatWon(prop.totalPropTax / 2)}`;

    const resPropBase = document.getElementById("res-prop-base");
    if (resPropBase) resPropBase.textContent = formatWon(prop.baseTax);

    const resPropUrban = document.getElementById("res-prop-urban");
    if (resPropUrban) resPropUrban.textContent = formatWon(prop.urbanTax);

    const resPropEdu = document.getElementById("res-prop-edu");
    if (resPropEdu) resPropEdu.textContent = formatWon(prop.eduTax);

    const badgeComp = document.getElementById("comp-tax-status-badge");
    if (badgeComp) {
      if (comp.isSubject) {
        badgeComp.textContent = "종부세 과세 대상";
        badgeComp.className = "text-[11px] font-bold text-red-500 bg-red-500/10 px-2 py-0.5 rounded";
      } else {
        badgeComp.textContent = "종부세 비과세 (공제액 이하)";
        badgeComp.className = "text-[11px] font-medium text-muted-foreground bg-muted px-2 py-0.5 rounded";
      }
    }

    const resCompFinal = document.getElementById("res-comp-final");
    if (resCompFinal) resCompFinal.textContent = formatWon(comp.totalCompTax);

    const resCompTaxbase = document.getElementById("res-comp-taxbase");
    if (resCompTaxbase) resCompTaxbase.textContent = formatWon(comp.taxBase);

    const resCompRaw = document.getElementById("res-comp-raw");
    if (resCompRaw) resCompRaw.textContent = formatWon(comp.rawTax);

    const resCompPropDeduct = document.getElementById("res-comp-prop-deduct");
    if (resCompPropDeduct) resCompPropDeduct.textContent = `- ${formatWon(comp.propDeduct)}`;

    const resCompAgeDeduct = document.getElementById("res-comp-age-deduct");
    if (resCompAgeDeduct) resCompAgeDeduct.textContent = `- ${formatWon(comp.ageDeduct)}`;

    const resCompRural = document.getElementById("res-comp-rural");
    if (resCompRural) resCompRural.textContent = formatWon(comp.ruralTax);

    const priceKorean = document.getElementById("price-korean");
    if (priceKorean) priceKorean.textContent = formatKoreanPrice(officialPriceWon);
  }

  // Event Listeners
  document.addEventListener("DOMContentLoaded", () => {
    const ownerSingleBtn = document.getElementById("owner-single");
    const ownerMultiBtn = document.getElementById("owner-multi");
    const multiGroup = document.getElementById("multi-count-group");
    const singleGroup = document.getElementById("single-deduction-group");

    ownerSingleBtn?.addEventListener("click", () => {
      ownerType = "single";
      ownerSingleBtn.className = "owner-btn py-2.5 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center";
      ownerMultiBtn!.className = "owner-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted";
      multiGroup?.classList.add("hidden");
      singleGroup?.classList.remove("hidden");
      update();
    });

    ownerMultiBtn?.addEventListener("click", () => {
      ownerType = "multi";
      ownerMultiBtn.className = "owner-btn py-2.5 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center";
      ownerSingleBtn!.className = "owner-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted";
      multiGroup?.classList.remove("hidden");
      singleGroup?.classList.add("hidden");
      update();
    });

    const houses2Btn = document.getElementById("houses-2");
    const houses3Btn = document.getElementById("houses-3");
    houses2Btn?.addEventListener("click", () => {
      houseCount = 2;
      houses2Btn.className = "house-btn py-2 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center";
      houses3Btn!.className = "house-btn py-2 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted";
      update();
    });
    houses3Btn?.addEventListener("click", () => {
      houseCount = 3;
      houses3Btn.className = "house-btn py-2 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center";
      houses2Btn!.className = "house-btn py-2 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted";
      update();
    });

    const priceInput = document.getElementById("official-price") as HTMLInputElement;
    priceInput?.addEventListener("input", (e) => {
      const val = parseFloat((e.target as HTMLInputElement).value) || 0;
      officialPriceWon = val * 10000;
      update();
    });

    document.querySelectorAll<HTMLButtonElement>(".price-pill").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.set) {
          const valMan = parseInt(btn.dataset.set, 10);
          officialPriceWon = valMan * 10000;
          if (priceInput) priceInput.value = valMan.toString();
        } else if (btn.dataset.add) {
          const addMan = parseInt(btn.dataset.add, 10);
          officialPriceWon += addMan * 10000;
          if (priceInput) priceInput.value = Math.round(officialPriceWon / 10000).toString();
        }
        update();
      });
    });

    const ageSelect = document.getElementById("owner-age") as HTMLSelectElement;
    ageSelect?.addEventListener("change", (e) => {
      ageRate = parseInt((e.target as HTMLSelectElement).value, 10) || 0;
      updateDeductionBadge();
      update();
    });

    const holdSelect = document.getElementById("holding-period") as HTMLSelectElement;
    holdSelect?.addEventListener("change", (e) => {
      holdRate = parseInt((e.target as HTMLSelectElement).value, 10) || 0;
      updateDeductionBadge();
      update();
    });

    function updateDeductionBadge() {
      const total = Math.min(80, ageRate + holdRate);
      const badge = document.getElementById("total-deduction-badge");
      if (badge) badge.textContent = `공제율 ${total}%`;
    }

    const urbanCheck = document.getElementById("include-urban") as HTMLInputElement;
    urbanCheck?.addEventListener("change", (e) => {
      includeUrban = (e.target as HTMLInputElement).checked;
      update();
    });

    update();
  });
</script>
