import T from '../../components/tools/plan/KrNpsEarlyDefer';
// Financial planning room gap (2026-11-23). Engine: lib/plan-gap-4-2026.ts. Facts: notes/plan-gap-4-facts-2026-11-23.md
const c = {
  introTitle: '국민연금, 일찍 받을까 늦춰 받을까?',
  intro: '노령연금은 출생연도에 따라 61~65세부터 받아요. 가입기간이 10년 이상이고 소득이 있는 업무를 하지 않으면 최대 5년 일찍 받을 수 있고(조기노령연금), 반대로 최대 5년 늦춰 더 많이 받을 수도 있어요(연기연금). 일찍 받으면 1년에 6%씩 줄고, 늦추면 한 달에 0.6%씩 늘어요. 이 계산기는 월액, 정한 나이까지의 합계, 합계가 역전되는 나이를 나란히 보여 줘요.',
  formulaTitle: '계산에 쓰는 규칙',
  formulas: [
    { title: '수령 나이', body: '1953~56년생 61세(조기 56세), 1957~60년생 62세(57세), 1961~64년생 63세(58세), 1965~68년생 64세(59세), 1969년생 이후 65세(60세).' },
    { title: '조기노령연금', body: '1년 일찍 94%, 2년 88%, 3년 82%, 4년 76%, 5년 70%. 공단 안내 표 기준이며 연 단위로만 계산해요.' },
    { title: '연기연금', body: '늦춘 한 달마다 0.6%(1년 7.2%)를 단리로 더해요. 전부 또는 50·60·70·80·90%만 늦출 수 있고, 늦추지 않은 몫은 제때 받아요.' },
    { title: '합계와 역전 나이', body: '물가 인상은 빼고 명목 금액으로 월별 누적 합계를 비교해요.' },
  ],
  howToTitle: '이렇게 써요',
  steps: ['출생연도와 정상 수령 나이의 월 예상 연금액(부양가족연금 제외)을 넣어요.', '일찍 받기 또는 늦춰 받기를 고르고 기간을 정해요.', '월액, 합계, 역전 나이를 비교해요.'],
  faqTitle: '자주 묻는 질문',
