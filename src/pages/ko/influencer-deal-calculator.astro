const title = "인플루언서 계약 계산기 — ROAS·본전 전환율·원천징수";
const description = "인플루언서 수수료와 예상 조회수·클릭률·구매 전환율로 예상 매출, ROAS, 남는 돈, 본전이 되는 주문 수와 전환율, 3.3%·8.8% 원천징수를 계산해요.";
const ko = {"introTitle": "계약하기 전에 남는지 보기", "intro": "인플루언서 광고는 조회수보다 실제 구매로 판단해요. 수수료와 지난 게시물 평균 조회수, 클릭률, 구매 전환율, 객단가를 넣으면 예상 매출과 원가·수수료를 뺀 남는 돈, 본전이 되려면 몇 명이 사야 하는지 보여 줘요. 지급할 때 떼는 원천징수(사업소득 3.3%, 기타소득 8.8%)와 광고 표시 의무도 함께 정리해요.", "howToTitle": "사용 방법", "steps": ["고정 수수료, 예상 조회수, 객단가를 넣어요.", "클릭률·구매 전환율·매출총이익률을 슬라이더로 맞춰요.", "받는 사람 유형을 고르고, 전환율 곡선에서 본전 지점을 확인해요."], "highlightsTitle": "주요 특징", "highlights": [{"title": "본전 전환율", "body": "클릭한 사람 중 몇 %가 사야 수수료를 회수하는지 보여 줘요."}, {"title": "원천징수 자동 계산", "body": "계속 활동하는 개인 3.3%, 일시 활동 8.8%, 사업자는 세금계산서와 부가세 10%."}, {"title": "계약 체크리스트", "body": "광고 표시, 화장품 광고 표현, 성과 집계 기준, 2차 활용 범위."}], "disclaimer": "예상치로 판단을 돕는 도구예요. 실제 성과는 쿠폰 코드·추적 링크로 집계하고, 원천징수 구분은 활동 형태에 따라 달라지니 세무 담당자와 확인하세요."};
const faqs = [{"q": "3.3%와 8.8%는 어떻게 다른가요?", "a": "계속·반복해서 활동하는 개인은 사업소득으로 3%(+지방세 0.3%), 일시적인 활동은 기타소득으로 필요경비 60%를 빼고 20%(+지방세)를 떼서 실제로 8.8%예요."}, {"q": "ROAS는 얼마면 좋은가요?", "a": "ROAS만으로는 부족해요. 매출총이익률을 곱한 금액이 광고비보다 커야 남아요. 이 도구의 '남는 돈'을 기준으로 보세요."}, {"q": "광고 표시는 꼭 해야 하나요?", "a": "네. 대가를 받은 추천·후기는 '광고' 등 경제적 이해관계를 첫머리에 표시해야 해요(표시광고법, 공정위 심사지침)."}];
---
<KrFinancePage slug="influencer-deal-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <InfluencerDeal client:load />
  <p class="mt-4 text-xs text-muted-foreground"><a class="underline" href="/ko/business-toolkit/">경영 도구 모음</a></p>
