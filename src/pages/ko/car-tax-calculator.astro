---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="자동차 취득세 & 자동차세 계산기 — 2026년 배기량별 세액 및 연납할인"
  description="차량 가격과 차종(승용·경차·전기차·하이브리드)에 따른 취득세(등록세)와 배기량(cc) 및 연식별 자동차세, 1월 연납 할인 혜택을 실시간으로 계산해보세요."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        2026년 지방세법 및 감면 혜택 반영
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-2">
        자동차 취득세 & 자동차세 계산기
      </h1>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        신차·중고차 등록 취득세(전기차·하이브리드 감면)와 배기량별 연간 자동차세, 연납 할인 절세액을 정확하게 산출해요.
      </p>
    </div>

    <!-- Tab Selector -->
    <div class="flex p-1 bg-muted rounded-xl mb-6 max-w-md mx-auto">
      <button
        id="tab-btn-acq"
        type="button"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm"
      >
        자동차 취득세 (구매·등록)
      </button>
      <button
        id="tab-btn-annual"
        type="button"
        class="flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground"
      >
        연간 자동차세 (보유·연납)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm space-y-6">
        <!-- Acquisition Tax Section -->
        <div id="section-acq" class="space-y-5">
          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              차량 구매 가격 (취득가액)
            </label>
            <div class="relative">
              <input
                id="acq-price"
                type="number"
                min="100"
                step="50"
                value="3500"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">만원</span>
            </div>
            <!-- Quick Chips -->
            <div class="flex flex-wrap gap-1.5 mt-2">
              <button type="button" class="chip-price px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="1800">1,800만 (아반떼/경차)</button>
              <button type="button" class="chip-price px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="3500">3,500만 (쏘나타/스포티지)</button>
              <button type="button" class="chip-price px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="5500">5,500만 (그랜저/아이오닉)</button>
              <button type="button" class="chip-price px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="8000">8,000만 (제네시스/외제차)</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              차량 종류
            </label>
            <select
              id="acq-type"
              class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="sedan" selected>일반 승용차 (비영업용 7%)</option>
              <option value="compact">경차 (1,000cc 미만 4%, 75만원 감면)</option>
              <option value="van">승합차 11인승 이상 / 화물차 (비영업용 5%)</option>
              <option value="commercial">영업용 차량 (택시·렌터카·화물 4%)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              친환경차 감면 혜택
            </label>
            <select
              id="acq-eco"
              class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="none" selected>일반 내연기관차 (가솔린·디젤·LPG)</option>
              <option value="hybrid">하이브리드 (최대 40만원 감면)</option>
              <option value="ev">전기차 / 수소전기차 (최대 140만원 감면)</option>
            </select>
          </div>
        </div>

        <!-- Annual Tax Section -->
        <div id="section-annual" class="space-y-5 hidden">
          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              동력원 및 배기량(cc)
            </label>
            <div class="space-y-2">
              <select
                id="annual-power"
                class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              >
                <option value="ice" selected>내연기관 (배기량 cc 기준)</option>
                <option value="ev">전기차 / 수소차 (배기량 무관 정액 13만원)</option>
              </select>

              <div id="box-cc" class="relative">
                <input
                  id="annual-cc"
                  type="number"
                  min="500"
                  max="6000"
                  step="100"
                  value="1998"
                  class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
                />
                <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">cc</span>
              </div>
            </div>
            <!-- Quick cc Chips -->
            <div id="chips-cc" class="flex flex-wrap gap-1.5 mt-2">
              <button type="button" class="chip-cc px-2 py-0.5 text-xs rounded bg-muted text-foreground" data-val="998">998cc (경차)</button>
              <button type="button" class="chip-cc px-2 py-0.5 text-xs rounded bg-muted text-foreground" data-val="1598">1,598cc (아반떼/투싼)</button>
              <button type="button" class="chip-cc px-2 py-0.5 text-xs rounded bg-muted text-foreground" data-val="1998">1,998cc (쏘나타 2.0)</button>
              <button type="button" class="chip-cc px-2 py-0.5 text-xs rounded bg-muted text-foreground" data-val="2497">2,497cc (그랜저 2.5)</button>
              <button type="button" class="chip-cc px-2 py-0.5 text-xs rounded bg-muted text-foreground" data-val="3470">3,470cc (제네시스 3.5)</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              차량 연식 (등록 후 경과 연수)
            </label>
            <select
              id="annual-age"
              class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="0" selected>신차 ~ 2년 이하 (할인 없음 100%)</option>
              <option value="3">3년 차 (5% 감면)</option>
              <option value="4">4년 차 (10% 감면)</option>
              <option value="5">5년 차 (15% 감면)</option>
              <option value="6">6년 차 (20% 감면)</option>
              <option value="7">7년 차 (25% 감면)</option>
              <option value="8">8년 차 (30% 감면)</option>
              <option value="9">9년 차 (35% 감면)</option>
              <option value="10">10년 차 (40% 감면)</option>
              <option value="11">11년 차 (45% 감면)</option>
              <option value="12">12년 차 이상 (최대 50% 반값 감면)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              납부 방식 및 연납 할인
            </label>
            <select
              id="annual-pay-month"
              class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="jan" selected>1월 연납 (1년치 일시납 4.6% 할인)</option>
              <option value="mar">3월 연납 (3.8% 할인)</option>
              <option value="jun">6월 연납 (하반기분 2.3% 할인)</option>
              <option value="regular">정기분 납부 (6월 / 12월 2회 분납, 무할인)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Result Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-foreground mb-4 flex items-center justify-between">
            <span id="res-title">자동차 취득세 계산 결과</span>
            <span id="res-badge" class="text-xs font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary">비영업용 7%</span>
          </h2>

          <div class="space-y-3.5 mb-6">
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span id="label-base" class="text-muted-foreground">산출 기준세액</span>
              <span id="res-base-tax" class="font-bold text-foreground">2,450,000원</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span id="label-edu" class="text-muted-foreground">지방교육세</span>
              <span id="res-edu-tax" class="font-bold text-foreground">0원</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span id="label-discount" class="text-muted-foreground">친환경차 감면액</span>
              <span id="res-discount" class="font-bold text-success">-0원</span>
            </div>
          </div>
        </div>

        <!-- Total Box -->
        <div class="rounded-xl bg-primary/10 border border-primary/20 p-5 text-center mt-2">
          <p id="label-total" class="text-xs font-medium text-muted-foreground mb-1">최종 납부 취득세</p>
          <p id="res-total" class="text-3xl font-black text-primary tracking-tight">
            2,450,000원
          </p>
          <p id="res-note" class="text-xs font-medium text-muted-foreground mt-2">
            차량 등록 시 위택스(Wetax) 또는 지자체 차량등록사업소에 일시 납부해요.
          </p>
        </div>
      </div>
    </div>

    <!-- Related Tools -->
    <div class="mt-10">
      <RelatedTools currentId="car-tax" />
    </div>
  </div>

  <script is:inline>
    let currentTab = 'acq';

    const tabBtnAcq = document.getElementById('tab-btn-acq');
    const tabBtnAnnual = document.getElementById('tab-btn-annual');
    const secAcq = document.getElementById('section-acq');
    const secAnnual = document.getElementById('section-annual');

    const acqPrice = document.getElementById('acq-price');
    const acqType = document.getElementById('acq-type');
    const acqEco = document.getElementById('acq-eco');

    const annualPower = document.getElementById('annual-power');
    const boxCc = document.getElementById('box-cc');
    const annualCc = document.getElementById('annual-cc');
    const chipsCc = document.getElementById('chips-cc');
    const annualAge = document.getElementById('annual-age');
    const annualPayMonth = document.getElementById('annual-pay-month');

    const resTitle = document.getElementById('res-title');
    const resBadge = document.getElementById('res-badge');
    const labelBase = document.getElementById('label-base');
    const resBaseTax = document.getElementById('res-base-tax');
    const labelEdu = document.getElementById('label-edu');
    const resEduTax = document.getElementById('res-edu-tax');
    const labelDiscount = document.getElementById('label-discount');
    const resDiscount = document.getElementById('res-discount');
    const labelTotal = document.getElementById('label-total');
    const resTotal = document.getElementById('res-total');
    const resNote = document.getElementById('res-note');

    function formatWon(num) {
      return Math.round(num).toLocaleString('ko-KR') + '원';
    }

    function calculate() {
      if (currentTab === 'acq') {
        const price = (parseFloat(acqPrice.value) || 0) * 10000;
        const type = acqType.value;
        const eco = acqEco.value;

        let rate = 0.07;
        let badge = '승용차 7%';
        let compactExemption = 0;

        if (type === 'compact') {
          rate = 0.04;
          badge = '경차 4% (75만원 감면)';
          compactExemption = 750000;
        } else if (type === 'van') {
          rate = 0.05;
          badge = '화물/승합 5%';
        } else if (type === 'commercial') {
          rate = 0.04;
          badge = '영업용 4%';
        }

        const rawTax = price * rate;
        let ecoDiscount = 0;

        if (type === 'compact') {
          ecoDiscount = Math.min(rawTax, compactExemption);
        } else if (eco === 'hybrid') {
          ecoDiscount = Math.min(rawTax, 400000);
        } else if (eco === 'ev') {
          ecoDiscount = Math.min(rawTax, 1400000);
        }

        const finalTax = Math.max(0, rawTax - ecoDiscount);

        resTitle.textContent = '자동차 취득세 계산 결과';
        resBadge.textContent = badge;
        labelBase.textContent = '취득세 산출세액';
        resBaseTax.textContent = formatWon(rawTax);
        labelEdu.textContent = '등록비용 포함 여부';
        resEduTax.textContent = '취득세에 통합 과세';
        labelDiscount.textContent = '친환경/경차 감면액';
        resDiscount.textContent = ecoDiscount > 0 ? `-${formatWon(ecoDiscount)}` : '0원';
        labelTotal.textContent = '최종 납부 취득세';
        resTotal.textContent = formatWon(finalTax);
        resNote.textContent = '취득세는 차량 등록일로부터 60일 이내(통상 등록 당일) 납부해요.';
      } else {
        // Annual Car Tax
        const power = annualPower.value;
        const ageYears = parseInt(annualAge.value, 10) || 0;
        const payMonth = annualPayMonth.value;

        let baseTax = 0;
        let eduTax = 0;

        if (power === 'ev') {
          // 전기차/수소차 정액 10만 + 교육세 3만
          baseTax = 100000;
          eduTax = 30000;
          resBadge.textContent = '전기차 정액 13만원';
        } else {
          const cc = parseInt(annualCc.value, 10) || 1998;
          let ccRate = 200;

          if (cc <= 1000) {
            ccRate = 80;
            resBadge.textContent = '1,000cc 이하 (cc당 80원)';
          } else if (cc <= 1600) {
            ccRate = 140;
            resBadge.textContent = '1,600cc 이하 (cc당 140원)';
          } else {
            ccRate = 200;
            resBadge.textContent = '1,600cc 초과 (cc당 200원)';
          }

          // 기본세
          baseTax = cc * ccRate;

          // 차령 경과 감면 (3년차부터 매년 5%, 최대 50%)
          let ageDiscountRate = 0;
          if (ageYears >= 3) {
            ageDiscountRate = Math.min(0.5, (ageYears - 2) * 0.05);
          }
          baseTax = baseTax * (1 - ageDiscountRate);

          // 지방교육세 30%
          eduTax = baseTax * 0.3;
        }

        const subtotal = baseTax + eduTax;

        // 연납 할인율 (2026년 기준 1월 연납 4.6%, 3월 3.8%, 6월 2.3%)
        let discountRate = 0;
        if (payMonth === 'jan') discountRate = 0.046;
        else if (payMonth === 'mar') discountRate = 0.038;
        else if (payMonth === 'jun') discountRate = 0.023;

        const prepaymentDiscount = subtotal * discountRate;
        const finalAnnualTax = subtotal - prepaymentDiscount;

        resTitle.textContent = '연간 자동차세 계산 결과';
        labelBase.textContent = '기본 자동차세액 (연식감면 반영)';
        resBaseTax.textContent = formatWon(baseTax);
        labelEdu.textContent = '지방교육세 (자동차세의 30%)';
        resEduTax.textContent = formatWon(eduTax);
        labelDiscount.textContent = '연납 할인 절세액';
        resDiscount.textContent = prepaymentDiscount > 0 ? `-${formatWon(prepaymentDiscount)}` : '0원';
        labelTotal.textContent = payMonth === 'regular' ? '연간 합산 세액 (6월/12월 반씩 납부)' : '연납 일시납 세액';
        resTotal.textContent = formatWon(finalAnnualTax);
        resNote.textContent = payMonth === 'regular'
          ? `정기분 1회당 납부액: ${formatWon(finalAnnualTax / 2)} (6월 및 12월 2회 분납)`
          : `1월 위택스에서 연납 신청 시 ${formatWon(prepaymentDiscount)}를 절약할 수 있어요.`;
      }
    }

    tabBtnAcq.addEventListener('click', () => {
      currentTab = 'acq';
      tabBtnAcq.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm';
      tabBtnAnnual.className = 'flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground';
      secAcq.classList.remove('hidden');
      secAnnual.classList.add('hidden');
      calculate();
    });

    tabBtnAnnual.addEventListener('click', () => {
      currentTab = 'annual';
      tabBtnAnnual.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm';
      tabBtnAcq.className = 'flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground';
      secAnnual.classList.remove('hidden');
      secAcq.classList.add('hidden');
      calculate();
    });

    annualPower.addEventListener('change', () => {
      if (annualPower.value === 'ev') {
        boxCc.classList.add('hidden');
        chipsCc.classList.add('hidden');
      } else {
        boxCc.classList.remove('hidden');
        chipsCc.classList.remove('hidden');
      }
      calculate();
    });

    document.querySelectorAll('.chip-price').forEach((chip) => {
      chip.addEventListener('click', () => {
        acqPrice.value = chip.getAttribute('data-val') || '3500';
        calculate();
      });
    });

    document.querySelectorAll('.chip-cc').forEach((chip) => {
      chip.addEventListener('click', () => {
        annualCc.value = chip.getAttribute('data-val') || '1998';
        calculate();
      });
    });

    [acqPrice, acqType, acqEco, annualPower, annualCc, annualAge, annualPayMonth].forEach((el) => {
      el.addEventListener('input', calculate);
    });

    calculate();
  </script>
</Layout>
