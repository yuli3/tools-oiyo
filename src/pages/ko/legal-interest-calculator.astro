---
// Moved from blog.oiyo.net/legal-interest-calculator/ on 2026-10-27 (W10a). Rewritten on kr-legal-2026:
// Blog labelled 12% as "연체 법정이자" for any debt; it only applies after a lawsuit is served.
import KrFinancePage from "../../components/KrFinancePage.astro";
import LegalInterestCalculator from "../../components/tools/LegalInterestCalculator";
import { LEGAL_AS_OF, legalInterest } from "../../lib/kr-legal-2026";

const title = "법정이자·지연손해금 계산기 2026 — 민사 5%, 상사 6%, 소송 후 12%";
const description = "원금과 기간을 넣으면 민사 연 5%·상사 연 6%·약정 이율로 지연이자를 일할 계산합니다. 소장이 송달된 다음 날부터 연 12%로 나눠 계산합니다.";
const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const sample = legalInterest({ principal: 10_000_000, start: "2026-01-01", end: "2026-12-31", rate: 0.05, servedOn: "2026-06-30" });

const ko = {
  introTitle: "빌려준 돈을 늦게 받으면 이자는 얼마인가요?",
  intro: `약정 이율이 없으면 민사 채권은 연 5%(민법 제379조), 상행위로 생긴 채권은 연 6%(상법 제54조)의 지연손해금을 청구할 수 있습니다. 소송을 내서 소장이나 지급명령이 송달되면 그 다음 날부터는 연 12%(소송촉진법 제3조)가 적용됩니다. 예를 들어 1,000만 원을 2026년 1월 1일부터 연말까지 못 받았고 6월 30일에 소장이 송달됐다면 앞의 181일은 5%, 뒤의 184일은 12%로 계산해 이자는 ${won(sample.interest)}입니다.`,
  howToTitle: "사용 방법",
  steps: ["원금과 이자가 붙기 시작한 날(변제기 다음 날 등), 다 갚는 날을 넣습니다.", "민사·상사·약정 이율 중 하나를 고릅니다.", "소송을 냈다면 소장·지급명령 송달일을 넣으면 구간을 나눠 계산합니다."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "12%는 소송 후에만", body: "소장·지급명령 송달 다음 날부터 연 12%로 자동 전환합니다." },
    { title: "판결문과 같은 날수", body: "\"~부터 ~까지\"처럼 시작일과 끝나는 날을 모두 셉니다." },
    { title: "계산 과정 공개", body: "구간마다 원금 × 이율 × 날수 ÷ 365를 보여 줍니다." },
  ],
  disclaimer: `참고용 계산입니다. 약정 지연손해금률, 이자제한법 상한(연 20%), 일부 변제 충당 순서, 윤년 366일 계산 여부 등은 사건마다 다를 수 있습니다. 기준일 ${LEGAL_AS_OF}.`,
};

const faqs = [
  { q: "연 12%는 언제부터 받을 수 있나요?", a: "금전 지급을 구하는 소송에서 소장이나 지급명령이 채무자에게 송달된 다음 날부터입니다. 소송 전에는 민사 5%, 상사 6% 또는 약정 이율입니다(소송촉진 등에 관한 특례법 제3조, 법정이율에 관한 규정)." },
  { q: "이자는 언제부터 붙나요?", a: "갚기로 한 날(변제기)이 있으면 그 다음 날부터, 정하지 않았으면 갚으라고 요구(이행청구)한 다음 날부터 지체 책임이 생깁니다(민법 제387조)." },
  { q: "상사 6%는 언제 쓰나요?", a: "당사자 한쪽에게라도 상행위가 되는 거래에서 생긴 채무입니다. 예를 들어 회사가 거래처에 판 물건 대금이나 상인 사이 대여금이 해당합니다." },
  { q: "약정 이율이 더 높으면요?", a: "약정한 지연이율이 있으면 그 이율을 씁니다. 다만 이자제한법상 최고이율 연 20%를 넘는 부분은 무효입니다." },
];
---
<KrFinancePage slug="legal-interest-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <LegalInterestCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 민법 제379조·제387조·제397조, 상법 제54조, 소송촉진 등에 관한 특례법 제3조 제1항, 법정이율에 관한 규정(연 12%). 기준일 {LEGAL_AS_OF}.</p>
</KrFinancePage>
