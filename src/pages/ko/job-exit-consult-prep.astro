---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import T from '../../components/tools/plan/JobExitFlow';
// 로드맵 1단계 첫 상담 흐름 (2026-11-24). Logic: lib/job-exit-flow-2026.ts (kr-desks-2026 + consult-memo-2026 재사용, 계산 없음).
const c = {
  introTitle: '퇴사·해고·월급 체불, 상담 전에 한 번에 정리',
  intro: '회사를 어떻게 나왔는지, 못 받은 돈이 있는지 고르면 할 일과 근거 조문, 확인할 계산기, 무료 창구를 한 화면에 모아 줘요. 날짜와 금액을 넣으면 고용노동부 1350이나 노무 상담에 들고 갈 상담 준비서가 만들어지고, 이 브라우저에 저장해 두었다가 다시 이어서 쓸 수 있어요.',
  formulaTitle: '이렇게 정리해요',
  formulas: [
    { title: '판단하지 않아요', body: '부당해고인지, 얼마를 받을 수 있는지는 판단하지 않아요. 조문에 적힌 기간과 할 일만 보여 주고, 금액은 이어지는 계산기에서 확인해요.' },
    { title: '기한', body: '퇴직 후 14일 안 지급(근로기준법 제36조), 해고 후 3개월 안 구제신청(제28조), 임금채권 3년(제49조)처럼 조문에 적힌 기간만 적어요.' },
    { title: '저장', body: '저장을 누를 때만 이 브라우저에 남아요. 서버로 보내지 않아요.' },
  ],
  howToTitle: '이렇게 써요',
  steps: ['회사를 나온 방식과 못 받은 돈을 골라요.', '아는 날짜와 금액을 넣어요.', '할 일과 계산기를 확인해요.', '상담 준비서를 복사하거나 인쇄해서 상담에 가져가요.'],
  faqTitle: '자주 묻는 질문',
  faqs: [
    { question: '아직 회사에 다니는데 써도 되나요?', answer: '네. 재직 중에도 임금체불 진정을 낼 수 있어요. "아직 다니고 있어요"를 고르세요.' },
    { question: '저장한 내용은 어디에 있나요?', answer: '이 기기의 이 브라우저에만 있어요. 다른 기기에서는 보이지 않고, "지우기"로 언제든 지울 수 있어요.' },
    { question: '상담은 어디서 받나요?', answer: '고용노동부 1350, 노동위원회의 무료 권리구제 대리인 제도, 대한법률구조공단 132 같은 무료 창구가 있어요.' },
  ],
  disclaimer: '일반 정보이며 법률 자문이 아니에요. 개별 사안은 무료 공식 창구나 자격사에 확인하세요.',
};
const sources: [string, string][] = [['국가법령정보센터 근로기준법', 'https://www.law.go.kr/법령/근로기준법'], ['국가법령정보센터 근로자퇴직급여 보장법', 'https://www.law.go.kr/법령/근로자퇴직급여보장법']];
---
<DebtReliefPage slug="job-exit-consult-prep" c={c} sources={sources} sourcesTitle="출처" checked="조문 확인: 2026-11-23">
  <T client:load />
</DebtReliefPage>
