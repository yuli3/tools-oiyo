---
// 생활 지원금·노동권 도구 2차 (2026-11-16). 엔진: lib/kr-welfare-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import FixedOvertimeCheck from "../../components/tools/welfare/FixedOvertimeCheck";
import { WELFARE_AS_OF } from "../../lib/kr-welfare-2026";

const title = "포괄임금 고정 연장수당 점검 — 덜 받은 시간외수당 3년치 계산";
const description = "월급에 들어 있는 고정 연장수당이 실제로 일한 연장·야간·휴일근로의 법정 수당보다 적은지 확인하고, 모자란 돈을 임금채권 소멸시효 3년까지 계산해요. 최저임금 미달도 함께 봐요.";
const ko = {"introTitle": "고정 수당보다 더 일했다면 차액을 받을 수 있어요", "intro": "포괄임금제나 고정 연장수당(시간외수당)을 받아도, 실제로 일한 연장·야간·휴일근로의 법정 수당이 더 많으면 회사는 그 차액을 줘야 해요. 고정 수당이 몇 시간 몫인지, 한 달·3년 동안 얼마가 모자란지 계산해요.", "howToTitle": "사용 방법", "steps": ["급여명세서에서 고정 연장수당과 나머지 기본급·고정수당을 나눠 넣어요.", "실제 한 달 연장·야간·휴일근로 시간을 넣어요.", "일한 시간을 바꿔 보며 고정 수당이 어디까지 덮는지 확인해요."], "highlightsTitle": "주요 특징", "highlights": [{"title": "고정 수당이 덮는 시간", "body": "고정 연장수당이 연장근로 몇 시간 값인지 그래프에 선으로 보여 줘요."}, {"title": "3년 소멸시효", "body": "임금은 3년이 지나면 청구할 수 없어서 최대 36개월까지만 합해요."}, {"title": "최저임금 점검", "body": "고정 수당을 뺀 시급이 2026년 최저임금 10,320원보다 낮은지 확인해요."}, {"title": "5인 미만 구분", "body": "5인 미만 사업장은 가산 없이 일한 시간만큼 계산해요."}], "disclaimer": "추정이에요. 감시·단속적 근로처럼 근로시간 규정이 적용되지 않는 일, 실제 근로시간 다툼이 있는 경우는 결과가 달라질 수 있어요. 출퇴근 기록을 꼭 남겨 두세요."};
const faqs = [{"q": "포괄임금 계약서에 서명했는데도 받을 수 있나요?", "a": "네. 법정 수당보다 적게 정한 부분은 근로자에게 불리해서 효력이 없어요. 실제 일한 시간의 법정 수당과 고정 수당의 차액을 청구할 수 있어요."}, {"q": "근무 시간을 어떻게 증명하나요?", "a": "출입 기록, 교통카드, 업무 메신저·메일 발송 시간, PC 로그 기록 등이 증거가 돼요. 지금부터라도 매일 기록해 두세요."}, {"q": "어디에 신고하나요?", "a": "고용노동부 노동포털(labor.moel.go.kr)이나 가까운 지방고용노동청에 임금체불 진정을 내요. 비용은 없어요."}, {"q": "퇴직했어도 되나요?", "a": "네. 퇴직 후 14일 안에 정산해야 하고, 늦으면 연 20% 지연이자가 붙어요. 3년이 지나기 전에 청구하세요."}];
---
<KrFinancePage slug="fixed-overtime-pay-checker" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <FixedOvertimeCheck client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 근로기준법 제56조·제49조·제37조, 대법원 2010. 5. 13. 선고 2008다6052 판결. 기준일 {WELFARE_AS_OF}. <a class="underline" href="/ko/benefit-rights-toolkit/">생활 지원금·노동권 도구 모음</a></p>
