---
import Layout from "../../components/Layout.astro";
---

<Layout
  title="대한민국 법정 영업일·공휴일 조회기"
  description="관공서 공휴일에 관한 규정 및 대체공휴일 픽스처를 기반으로 특정 날짜의 영업일 여부와 휴일 사유를 실시간 판별해요."
>
  <div class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
        <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
          대한민국 법정 영업일·공휴일 판별기
        </h1>
        <p class="mt-2 text-xs text-muted-foreground sm:text-sm">
          관공서 공휴일에 관한 규정 및 대체공휴일 적용 여부를 판별하여 영업일(비즈니스 데이)인지 확인해요.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <div>
          <label for="date-input" class="block text-xs font-bold text-foreground">조회할 날짜 선택</label>
          <input
            type="date"
            id="date-input"
            value="2026-10-16"
            class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
          />
        </div>

        <div id="result-box" class="rounded-lg border border-border bg-muted/20 p-5 text-center">
          <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">판정 결과</span>
          <div class="my-2">
            <span id="res-badge" class="inline-flex rounded-md border border-primary/20 bg-primary/10 px-4 py-1.5 text-base font-bold text-primary">
              정상 영업일 (Business Day)
            </span>
          </div>
          <p id="res-desc" class="mt-2 text-xs text-muted-foreground">
            2026년 10월 16일 (금요일)은 주말이나 법정 공휴일이 아닌 정상 근무일이에요.
          </p>
        </div>

        <div class="border-t border-border pt-4 text-xs text-muted-foreground">
          <p class="font-medium text-foreground">API 연동 안내:</p>
          <p class="mt-1 font-mono text-[11px] bg-muted p-2 rounded border border-border">
            GET https://api.oiyo.net/v1/kr/calendar/is-business-day?date=YYYY-MM-DD
          </p>
        </div>
      </div>

      <div class="mt-8 rounded-lg border border-border bg-muted/30 p-4 text-center text-xs text-muted-foreground">
        데이터 제공: api.oiyo.net B2A 무비용 천문·역법 게이트웨이
      </div>

    <script>
      // 공휴일 목록은 api calendar.mjs의 바이트 복사본(src/lib/kr-calendar.mjs)에서만 읽는다.
      import { getHolidays } from "../../lib/kr-calendar.mjs";

      const KNOWN_LUNAR_YEARS = [2024, 2025, 2026, 2027];

      const input = document.getElementById("date-input") as HTMLInputElement;
      const resBadge = document.getElementById("res-badge");
      const resDesc = document.getElementById("res-desc");

      const DAYS = ["일요일", "월요일", "화요일", "수요일", "목요일", "금요일", "토요일"];

      function check() {
        if (!input || !resBadge || !resDesc) return;
        const val = input.value;
        if (!val) return;

        const [y, m, d] = val.split("-").map((v) => parseInt(v, 10));
        const dt = new Date(Date.UTC(y, m - 1, d));
        const dayIdx = dt.getUTCDay();
        const dayName = DAYS[dayIdx];

        let isBiz = true;
        let reason = "";

        if (dayIdx === 0 || dayIdx === 6) {
          isBiz = false;
          reason = dayName;
        } else {
          const hit = y >= 2000 && y <= 2100 ? getHolidays(y).find((h) => h.date === val) : undefined;
          if (hit) {
            isBiz = false;
            reason = hit.name;
          }
        }

        if (isBiz) {
          resBadge.textContent = "정상 영업일 (Business Day)";
          resBadge.className = "inline-flex rounded-md border border-primary/20 bg-primary/10 px-4 py-1.5 text-base font-bold text-primary";
          resDesc.textContent = KNOWN_LUNAR_YEARS.includes(y)
            ? `${y}년 ${m}월 ${d}일 (${dayName})은 정상 영업일이에요.`
            : `${y}년 ${m}월 ${d}일 (${dayName})은 양력 공휴일과 주말 기준으로 영업일이에요. 설·추석·부처님오신날 같은 음력 공휴일은 2024~2027년만 반영돼 있어요.`;
        } else {
          resBadge.textContent = `휴일 / 비영업일 (${reason})`;
          resBadge.className = "inline-flex rounded-md border border-destructive/20 bg-destructive/10 px-4 py-1.5 text-base font-bold text-destructive";
          resDesc.textContent = `${y}년 ${m}월 ${d}일 (${dayName})은 [${reason}] 사유로 인한 휴일(비영업일)이에요.`;
        }
      }

      input?.addEventListener("change", check);
      check();
    </script>
  </div>
</Layout>
