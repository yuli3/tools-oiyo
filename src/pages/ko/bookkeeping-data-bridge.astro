// 장부 입력 자료 정리기 (2026-11-20). 세운: 세무사랑·TP·위하고·더존 같은 프로그램을 스킬·도구에 넣을지 → 프로그램을 대신하지 않고 "사이를 잇는" 도구로.
// 엔진: lib/bookkeeping-bridge-2026.ts (스킬 kr-tax-advisor의 bridge 명령과 같은 코드)
import KrFinancePage from "../../components/KrFinancePage.astro";
import BookkeepingBridge from "../../components/tools/practice/BookkeepingBridge";

const title = "장부 입력 자료 정리기 — 통장·카드 내역을 분개 표로, 세무 프로그램 엑셀 업로드 순서로";
const description = "은행 거래내역과 사업용 카드 내역을 붙여 넣으면 계정과목을 추천하고 차변·대변 분개, 카드 매입세액(공급가액·부가세), 불공제 항목, 3만 원 초과 계좌이체 증빙 확인, 중복 거래를 표시해요. 세무 프로그램의 엑셀 업로드 샘플 머리글 순서대로 CSV를 만들어 줘요.";
const ko = {
  introTitle: "통장·카드 내역을 프로그램에 넣기 전에",
  intro: "세무 프로그램(세무사랑·위하고·더존·TP 등)에 전표를 넣기 전, 내려받은 통장·카드 내역을 분개 표로 정리해요. 프로그램을 대신하지 않고, 프로그램이 받는 엑셀 순서에 맞춰 넘겨줘요.",
  howToTitle: "사용 방법",
  steps: ["통장인지 카드인지 고르고 내역을 붙여 넣어요.", "확인할 거래(계정 미정, 증빙, 불공제, 중복)를 먼저 고쳐요.", "프로그램의 엑셀 업로드 샘플 머리글을 붙여 열 순서를 맞추고 CSV를 내려받아요."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "계정 추천", body: "가맹점·적요 낱말로 계정과 매입세액 공제 여부를 골라요." },
    { title: "증빙 신호", body: "3만 원 넘는 계좌이체 경비, 기업업무추진비, 중복." },
    { title: "열 순서 맞추기", body: "프로그램 샘플 머리글을 붙이면 그 순서로 내보내요." },
    { title: "개인정보 안전", body: "서버로 보내지 않아요." },
