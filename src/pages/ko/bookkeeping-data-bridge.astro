const faqs = [
  { q: "프로그램마다 엑셀 양식이 다른데요?", a: "맞아요. 그래서 열 순서를 고정하지 않았어요. 쓰는 프로그램의 엑셀 업로드 샘플 첫 줄(머리글)을 붙여 넣으면 같은 순서로 CSV를 만들어요. 계정코드가 필요한 양식이면 회사 계정과목표에서 코드를 채우세요." },
  { q: "카드 매입세액은 다 공제되나요?", a: "아니에요. 택시·버스·철도·항공 같은 여객운송, 거래처 접대(기업업무추진비), 개별소비세 대상 승용차 관련 매입세액은 공제되지 않아요(부가가치세법 제39조·제46조). 이 도구는 이런 항목을 불공제로 표시해요." },
  { q: "3만 원 넘는 계좌이체는 왜 표시하나요?", a: "사업자에게 3만 원 넘게 지출하면 세금계산서·계산서·카드·현금영수증 같은 적격증빙을 받아야 하고, 없으면 증빙불비가산세(2%)가 붙을 수 있어요(소득세법 제160조의2, 법인세법 제116조)." },
