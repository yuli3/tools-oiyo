---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="개인사업자 vs 법인전환 세금 비교 계산기 (2026 최신 종합소득세·법인세율)"
  description="개인사업자 종합소득세율(6%~45%) 및 지역건보료와 법인세율(9%~19%) 및 대표자 급여 소득세를 비교하여 법인전환 손익분기점과 절세액을 정밀 계산해요."
>
  <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-4 inline-flex items-center gap-1">
        <span aria-hidden="true">←</span> 전체 도구 목록
      </a>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
        개인사업자 vs 법인전환 세금 비교 계산기
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        연 순이익 대비 개인사업자의 종합소득세 및 지역건강보험료와 법인전환 시 법인세, 대표자 급여 소득세, 직장건보료를 나란히 대조하여 실질 절세 효과를 진단해요.
      </p>
    </div>

    <!-- Input Form -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="netProfit" class="text-xs font-bold text-foreground block mb-1.5">
            연간 사업 순이익 (매출액 - 필요경비, 원)
          </label>
          <input
            type="number"
            id="netProfit"
            value="120000000"
            step="10000000"
            class="w-full min-h-12 rounded-lg border border-input bg-background px-3 py-2.5 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <span id="netProfitKor" class="text-xs text-muted-foreground mt-1.5 block">1억 2,000만 원</span>
        </div>

        <div>
          <label for="directorSalary" class="text-xs font-bold text-foreground block mb-1.5">
            법인 전환 시 대표자 희망 연봉 (원)
          </label>
          <input
            type="number"
            id="directorSalary"
            value="60000000"
            step="5000000"
            class="w-full min-h-12 rounded-lg border border-input bg-background px-3 py-2.5 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <span id="directorSalaryKor" class="text-xs text-muted-foreground mt-1.5 block">6,000만 원 (법인 비용인정)</span>
        </div>
      </div>
    </div>

    <!-- Comparison Verdict Banner -->
    <div id="verdictBanner" class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4 mt-6">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <h2 id="verdictTitle" class="text-base font-black text-foreground">
            진단: 법인 전환이 세금 및 건보료상 유리해요
          </h2>
          <p id="verdictDesc" class="text-xs text-muted-foreground mt-1">
            대표자 급여 분산 및 9% 법인세율 적용으로 연간 수백만 원 이상의 세무·건보 부담을 줄일 수 있어요.
          </p>
        </div>
        <div class="text-right">
          <span id="verdictLabel" class="text-xs font-bold text-muted-foreground block">연간 예상 절감액</span>
          <span id="verdictSavings" class="text-xl sm:text-2xl font-black text-primary">
            연 0원 절감
          </span>
        </div>
      </div>
    </div>

    <!-- Side-by-Side Comparison Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
      <!-- Sole Proprietor Card -->
      <div class="rounded-xl border border-border bg-card p-5 space-y-4 shadow-xs">
        <div class="flex items-center justify-between border-b border-border pb-3">
          <h3 class="text-sm font-black text-foreground">개인사업자 (유지 시)</h3>
          <span class="rounded bg-muted px-2 py-0.5 text-xs font-bold text-foreground">종합소득세율 6~45%</span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-muted-foreground">종합소득세 + 지방세</span>
            <span id="soleTaxDisplay" class="font-bold text-foreground">0원</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted-foreground">지역 건강보험료 (연간 약 8%)</span>
            <span id="soleHealthDisplay" class="font-bold text-foreground">0원</span>
          </div>
          <div class="flex justify-between border-t border-border pt-2 text-sm font-black">
            <span>총 부담액 (세금 + 건보료)</span>
            <span id="soleTotalDisplay" class="text-foreground">0원</span>
          </div>
        </div>

        <ul class="text-xs text-muted-foreground space-y-1.5 border-t border-border pt-3">
          <li>✓ 사업 통장의 자금을 대표자가 자유롭게 개인 인출 가능</li>
          <li>✕ 순이익이 커질수록 최고 49.5%(지방세 포함) 고율 누진세율 적용</li>
          <li>✕ 순이익 전액에 대해 지역건강보험료 부과</li>
        </ul>
      </div>

      <!-- Corporation Card -->
      <div class="rounded-xl border border-primary/30 bg-card p-5 space-y-4 shadow-xs">
        <div class="flex items-center justify-between border-b border-border pb-3">
          <h3 class="text-sm font-black text-primary">법인사업자 (전환 시)</h3>
          <span class="rounded bg-primary/10 px-2 py-0.5 text-xs font-bold text-primary">법인세 9~19%</span>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-muted-foreground">법인세 (순이익-급여 후 잔액)</span>
            <span id="corpTaxDisplay" class="font-bold text-foreground">0원</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted-foreground">대표자 근로소득세 + 지방세</span>
            <span id="wageTaxDisplay" class="font-bold text-foreground">0원</span>
          </div>
          <div class="flex justify-between">
            <span class="text-muted-foreground">대표자 직장 건강·국민연금</span>
            <span id="wageInsuranceDisplay" class="font-bold text-foreground">0원</span>
          </div>
          <div class="flex justify-between border-t border-border pt-2 text-sm font-black">
            <span>총 부담액 (법인세+소득세+보험)</span>
            <span id="corpTotalDisplay" class="text-primary">0원</span>
          </div>
        </div>

        <ul class="text-xs text-muted-foreground space-y-1.5 border-t border-border pt-3">
          <li>✓ 2억 이하 법인세율 9.9%(지방세 포함)로 세부담 대폭 완화</li>
          <li>✓ 대표자 급여 설정으로 근로소득공제 및 직장 건보료 적용</li>
          <li class="text-destructive font-semibold">✕ 법인 자금 무단 인출 시 가지급금 인정이자(4.6%) 과세</li>
        </ul>
      </div>
    </div>

    <!-- Statutory Explanations -->
    <div class="mt-8 rounded-xl border border-border bg-card p-6 space-y-4">
      <h3 class="text-sm font-black text-foreground">
        2026년 법인전환 판단 핵심 기준
      </h3>
      <ul class="text-xs space-y-2 text-muted-foreground leading-relaxed">
        <li>
          <strong class="text-foreground">손익분기점 (순이익 7,000만~1억 원):</strong> 순이익이 7,000만 원 미만일 때는 법인 설립 비용과 추가 세무 기장료, 자금 인출 제약을 고려할 때 개인사업자가 유리하나, 1억 원을 초과하면 최고세율 격차(45% vs 9%)로 인해 법인 전환의 절세 효과가 매우 뚜렷해져요.
        </li>
        <li>
          <strong class="text-foreground">건강보험료 직장가입자 전환 이점:</strong> 개인사업자는 사업소득 전체와 보유 부동산 등에 지역건보료가 부과되지만, 법인 전환 후에는 책정된 월 급여만을 기준으로 직장보험료가 부과되어 건보료 부담이 대폭 줄어들어요.
        </li>
        <li>
          <strong class="text-foreground">법인 자금 인출 규제 (가지급금):</strong> 법인의 자금은 대표자의 개인 돈이 아니므로 적법한 급여나 배당 없이 인출하면 가지급금으로 처리되어 연 4.6%의 인정이자가 대표자 상여로 과세되며 법인세 손금불산입 및 횡령 배임 위험이 발생해요.
        </li>
      </ul>
    </div>

    <!-- Related Tools Recommendation -->
    <RelatedTools currentId="sole-proprietor-vs-corp" />
  </div>

  <script>
    function calculateIncomeTax(taxBase: number): number {
      if (taxBase <= 0) return 0;
      if (taxBase <= 14000000) return Math.round(taxBase * 0.06);
      if (taxBase <= 50000000) return Math.round(taxBase * 0.15 - 1260000);
      if (taxBase <= 88000000) return Math.round(taxBase * 0.24 - 5760000);
      if (taxBase <= 150000000) return Math.round(taxBase * 0.35 - 15440000);
      if (taxBase <= 300000000) return Math.round(taxBase * 0.38 - 19940000);
      if (taxBase <= 500000000) return Math.round(taxBase * 0.40 - 25940000);
      if (taxBase <= 1000000000) return Math.round(taxBase * 0.42 - 35940000);
      return Math.round(taxBase * 0.45 - 65940000);
    }

    function calculateEarnedIncomeDeduction(salary: number): number {
      if (salary <= 5000000) return salary * 0.7;
      if (salary <= 15000000) return 3500000 + (salary - 5000000) * 0.4;
      if (salary <= 45000000) return 7500000 + (salary - 15000000) * 0.15;
      if (salary <= 100000000) return 12000000 + (salary - 45000000) * 0.05;
      return 14750000 + (salary - 100000000) * 0.02;
    }

    function calculateCorporateTax(taxBase: number): number {
      if (taxBase <= 0) return 0;
      let tax = 0;
      if (taxBase <= 200000000) {
        tax = taxBase * 0.09;
      } else {
        tax = 18000000 + (taxBase - 200000000) * 0.19;
      }
      return Math.round(tax * 1.1);
    }

    function update() {
      const profit = Number((document.getElementById("netProfit") as HTMLInputElement).value) || 0;
      let salary = Number((document.getElementById("directorSalary") as HTMLInputElement).value) || 0;
      if (salary > profit) salary = profit;

      (document.getElementById("netProfitKor") as HTMLElement).textContent = `${(profit / 100000000).toFixed(1)}억 원`;
      (document.getElementById("directorSalaryKor") as HTMLElement).textContent = `${Math.round(salary / 10000).toLocaleString()}만 원 (법인 비용인정)`;

      // 1. Sole Proprietor
      const soleTaxBase = Math.max(0, profit - 3000000); // 기본 인적공제 300만원 가정
      const soleIncomeTax = calculateIncomeTax(soleTaxBase);
      const soleTotalTax = Math.round(soleIncomeTax * 1.1);
      const soleHealth = Math.round(profit * 0.0801); // 건보+요양
      const soleTotal = soleTotalTax + soleHealth;

      // 2. Corporation
      const corpTaxBase = Math.max(0, profit - salary);
      const corpTax = calculateCorporateTax(corpTaxBase);

      const earnedDeduction = calculateEarnedIncomeDeduction(salary);
      const wageTaxBase = Math.max(0, salary - earnedDeduction - 3000000);
      const wageIncomeTax = calculateIncomeTax(wageTaxBase);
      const wageTotalTax = Math.round(wageIncomeTax * 1.1);
      const wageInsurance = Math.round(salary * 0.085); // 대표자 직장 4대보험

      const corpTotal = corpTax + wageTotalTax + wageInsurance;

      // 3. Difference
      const diff = soleTotal - corpTotal;
      const isCorpBetter = diff > 0;

      // DOM Updates
      (document.getElementById("soleTaxDisplay") as HTMLElement).textContent = `${soleTotalTax.toLocaleString()}원`;
      (document.getElementById("soleHealthDisplay") as HTMLElement).textContent = `${soleHealth.toLocaleString()}원`;
      (document.getElementById("soleTotalDisplay") as HTMLElement).textContent = `${soleTotal.toLocaleString()}원`;

      (document.getElementById("corpTaxDisplay") as HTMLElement).textContent = `${corpTax.toLocaleString()}원`;
      (document.getElementById("wageTaxDisplay") as HTMLElement).textContent = `${wageTotalTax.toLocaleString()}원`;
      (document.getElementById("wageInsuranceDisplay") as HTMLElement).textContent = `${wageInsurance.toLocaleString()}원`;
      (document.getElementById("corpTotalDisplay") as HTMLElement).textContent = `${corpTotal.toLocaleString()}원`;

      const verdictBanner = document.getElementById("verdictBanner") as HTMLElement;
      const verdictTitle = document.getElementById("verdictTitle") as HTMLElement;
      const verdictDesc = document.getElementById("verdictDesc") as HTMLElement;
      const verdictLabel = document.getElementById("verdictLabel") as HTMLElement;
      const verdictSavings = document.getElementById("verdictSavings") as HTMLElement;

      if (isCorpBetter) {
        verdictBanner.className = "rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4 mt-6";
        verdictTitle.textContent = "진단: 법인 전환이 세금 및 건보료상 유리해요";
        verdictDesc.textContent = `대표자 급여 분산 및 9% 법인세율 적용으로 연간 약 ${Math.abs(diff).toLocaleString()}원의 세무·건보 부담을 줄일 수 있어요.`;
        verdictLabel.textContent = "연간 예상 절감액";
        verdictSavings.className = "text-xl sm:text-2xl font-black text-primary";
        verdictSavings.textContent = `연 ${Math.abs(diff).toLocaleString()}원 절감`;
      } else {
        verdictBanner.className = "rounded-xl border border-border bg-muted/20 p-6 space-y-4 mt-6";
        verdictTitle.textContent = "진단: 개인사업자 유지가 실익상 유리해요";
        verdictDesc.textContent = "순이익 규모 대비 법인 설립·기장료·자금 인출 규제를 고려할 때 개인사업자 유지가 간편해요.";
        verdictLabel.textContent = "개인사업자 유지 이익";
        verdictSavings.className = "text-xl sm:text-2xl font-black text-foreground";
        verdictSavings.textContent = `연 ${Math.abs(diff).toLocaleString()}원 유리`;
      }
    }

    document.querySelectorAll("input").forEach((el) => {
      el.addEventListener("input", update);
      el.addEventListener("change", update);
    });

    update();
  </script>
</Layout>
