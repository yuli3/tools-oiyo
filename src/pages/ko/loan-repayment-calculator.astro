---
import Layout from "../../components/Layout.astro";
---

<Layout
  title="대출 이자 및 월별 상환액 계산기 (원리금균등·원금균등·만기일시)"
  description="대출원금, 연이자율(%), 대출기간 및 거치기간에 따른 원리금균등분할상환, 원금균등상환, 만기일시상환 방식의 총 이자, 첫 회차 및 월별 상환금액을 정밀 계산해요."
>
  <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        시중은행 공식 상환 계산 공식 적용
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
        대출 이자 및 상환액 계산기
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        대출 금액과 금리, 상환 방식을 입력하면 월 상환액과 총 이자, 그리고 회차별 원금·이자 변동을 정밀하게 산출해요.
      </p>
    </div>

    <!-- Input Card -->
    <div class="rounded-xl border border-border bg-card p-6 shadow-xs mb-8 space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="principal" class="text-xs font-bold text-foreground block mb-1.5">
            대출 원금 (원)
          </label>
          <input
            type="number"
            id="principal"
            value="100000000"
            step="1000000"
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <span id="principalKor" class="text-[11px] text-muted-foreground mt-1 block">1억 원</span>
        </div>

        <div>
          <label for="interestRate" class="text-xs font-bold text-foreground block mb-1.5">
            연이자율 (%)
          </label>
          <input
            type="number"
            id="interestRate"
            value="4.5"
            step="0.1"
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>

        <div>
          <label for="loanMonths" class="text-xs font-bold text-foreground block mb-1.5">
            대출 기간 (개월)
          </label>
          <input
            type="number"
            id="loanMonths"
            value="360"
            step="12"
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <span id="loanYearsText" class="text-[11px] text-muted-foreground mt-1 block">30년</span>
        </div>

        <div>
          <label for="graceMonths" class="text-xs font-bold text-foreground block mb-1.5">
            거치 기간 (개월, 이자만 납부)
          </label>
          <input
            type="number"
            id="graceMonths"
            value="0"
            min="0"
            class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
          />
        </div>
      </div>

      <!-- Repayment Method Selector -->
      <div>
        <label class="text-xs font-bold text-foreground block mb-2">상환 방식</label>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <label class="flex items-center gap-2 p-3 rounded-lg border border-border cursor-pointer hover:bg-muted/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <input type="radio" name="repayMethod" value="equalPI" checked class="text-primary" />
            <div class="text-xs">
              <div class="font-bold text-foreground">원리금균등</div>
              <div class="text-[10px] text-muted-foreground">매월 같은 금액 납부</div>
            </div>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-border cursor-pointer hover:bg-muted/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <input type="radio" name="repayMethod" value="equalP" class="text-primary" />
            <div class="text-xs">
              <div class="font-bold text-foreground">원금균등</div>
              <div class="text-[10px] text-muted-foreground">매월 상환액이 점차 감소</div>
            </div>
          </label>
          <label class="flex items-center gap-2 p-3 rounded-lg border border-border cursor-pointer hover:bg-muted/50 transition-colors has-[:checked]:border-primary has-[:checked]:bg-primary/5">
            <input type="radio" name="repayMethod" value="bullet" class="text-primary" />
            <div class="text-xs">
              <div class="font-bold text-foreground">만기일시상환</div>
              <div class="text-[10px] text-muted-foreground">만기에 원금 일시 상환</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Results Grid -->
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
          <div>
            <span class="text-xs font-semibold text-muted-foreground block mb-1">첫 회차 납입액</span>
            <span id="firstPayment" class="text-lg sm:text-xl font-black text-foreground font-mono">0원</span>
          </div>
          <div>
            <span class="text-xs font-semibold text-muted-foreground block mb-1">총 대출 이자</span>
            <span id="totalInterest" class="text-lg sm:text-xl font-black text-primary font-mono">0원</span>
          </div>
          <div>
            <span class="text-xs font-semibold text-muted-foreground block mb-1">총 상환 금액 (원금+이자)</span>
            <span id="totalPayment" class="text-lg sm:text-xl font-black text-foreground font-mono">0원</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Informational Guide -->
    <div class="rounded-xl border border-border bg-card p-6 space-y-4 text-xs text-muted-foreground leading-relaxed">
      <h2 class="text-sm font-bold text-foreground">💡 상환 방식별 차이점 비교</h2>
      <ul class="list-disc pl-4 space-y-1.5">
        <li><strong>원리금균등상환</strong>: 매달 납부하는 금액(원금+이자)이 동일하여 가계 지출 관리에 가장 유리하며, 주택담보대출에서 가장 많이 선택돼요.</li>
        <li><strong>원금균등상환</strong>: 매달 갚는 원금이 일정하여 시간이 지날수록 남은 원금이 빠르게 줄어들어 세 방식 중 <strong>총 이자가 가장 적어요</strong>.</li>
        <li><strong>만기일시상환</strong>: 대출 기간 동안 매달 이자만 내다가 만기에 원금 전체를 상환해요. 단기 대출이나 전세자금대출에 주로 쓰여요.</li>
      </ul>
    </div>
  </div>

  <script is:inline>
    const principalInput = document.getElementById('principal');
    const principalKor = document.getElementById('principalKor');
    const interestRateInput = document.getElementById('interestRate');
    const loanMonthsInput = document.getElementById('loanMonths');
    const loanYearsText = document.getElementById('loanYearsText');
    const graceMonthsInput = document.getElementById('graceMonths');
    const repayMethodInputs = document.querySelectorAll('input[name="repayMethod"]');

    const firstPayment = document.getElementById('firstPayment');
    const totalInterest = document.getElementById('totalInterest');
    const totalPayment = document.getElementById('totalPayment');

    function formatWon(num) {
      return Math.round(num).toLocaleString('ko-KR') + '원';
    }

    function formatKoreanUnits(amount) {
      if (amount <= 0) return '0원';
      const eok = Math.floor(amount / 100000000);
      const man = Math.floor((amount % 100000000) / 10000);
      let res = '';
      if (eok > 0) res += `${eok}억 `;
      if (man > 0) res += `${man}만 `;
      return res.trim() + '원';
    }

    function calculateLoan() {
      const P = parseFloat(principalInput.value) || 0;
      const annualR = (parseFloat(interestRateInput.value) || 0) / 100;
      const totalMonths = parseInt(loanMonthsInput.value, 10) || 0;
      const graceMonths = parseInt(graceMonthsInput.value, 10) || 0;
      const method = document.querySelector('input[name="repayMethod"]:checked').value;

      principalKor.textContent = formatKoreanUnits(P);
      const years = Math.floor(totalMonths / 12);
      const remMonths = totalMonths % 12;
      loanYearsText.textContent = remMonths > 0 ? `${years}년 ${remMonths}개월` : `${years}년`;

      if (P <= 0 || totalMonths <= 0) return;

      const r = annualR / 12; // monthly interest rate
      const repaymentMonths = Math.max(1, totalMonths - graceMonths);

      let firstPay = 0;
      let totalInt = 0;

      if (method === 'equalPI') {
        // 원리금균등: P * r * (1+r)^n / ((1+r)^n - 1)
        if (r > 0) {
          const factor = Math.pow(1 + r, repaymentMonths);
          const monthlyRepay = (P * r * factor) / (factor - 1);
          firstPay = graceMonths > 0 ? P * r : monthlyRepay;
          totalInt = (graceMonths * P * r) + (monthlyRepay * repaymentMonths - P);
        } else {
          firstPay = P / repaymentMonths;
          totalInt = 0;
        }
      } else if (method === 'equalP') {
        // 원금균등: 매월 P / n + 잔여원금 * r
        const monthlyP = P / repaymentMonths;
        const firstMonthInt = P * r;
        firstPay = graceMonths > 0 ? P * r : (monthlyP + firstMonthInt);
        // 총 이자: grace 이자 + sum(잔여원금 * r)
        const amortizingInt = (repaymentMonths + 1) * P * r / 2;
        totalInt = (graceMonths * P * r) + amortizingInt;
      } else if (method === 'bullet') {
        // 만기일시: 매월 P * r, 만기에 P 상환
        firstPay = P * r;
        totalInt = P * r * totalMonths;
      }

      firstPayment.textContent = formatWon(firstPay);
      totalInterest.textContent = formatWon(totalInt);
      totalPayment.textContent = formatWon(P + totalInt);
    }

    principalInput.addEventListener('input', calculateLoan);
    interestRateInput.addEventListener('input', calculateLoan);
    loanMonthsInput.addEventListener('input', calculateLoan);
    graceMonthsInput.addEventListener('input', calculateLoan);
    repayMethodInputs.forEach(input => input.addEventListener('change', calculateLoan));

    calculateLoan();
  </script>
</Layout>
