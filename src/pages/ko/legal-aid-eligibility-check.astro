---
// 법률구조공단 소송지원 대상 확인 (2026-11-24, 상담자 니즈: "국선변호사 비용", "변호사 무료 상담", "법률구조공단 대상"). 계산: lib/kr-expert-fees-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import LegalAidCheck from "../../components/tools/office/LegalAidCheck";

const title = "법률구조공단 소송지원 대상 확인 2026 — 중위소득 125%·150%, 임금 400만원 미만";
const description = "대한법률구조공단 소송지원을 받을 수 있는지 대상 유형과 소득으로 확인해요. 2026 기준 중위소득 125%·150% 선을 가구원 수별로 계산하고, 소득 제한 없는 대상과 체불 근로자(평균 임금 400만원 미만), 소상공인(연매출 3억원 이하)까지.";
const shell = {
  introTitle: "변호사 비용이 부담되면 먼저 확인해요",
  intro: "변호사를 찾는 검색에는 '비용'과 '무료'가 가장 많이 붙어요. 대한법률구조공단은 일정 소득 이하이거나 정해진 대상에 해당하는 사람의 소송을 지원해요. 소득은 기준 중위소득으로 판단해요. 이 도구는 공단 누리집의 '소득별 대상자'와 2026 기준 중위소득 고시를 맞춰 봐요.",
  howToTitle: "이렇게 써요",
  steps: ["나에게 맞는 대상 유형을 골라요. 여러 개면 소득 기준이 넉넉한 쪽부터 봐요.", "중위소득 기준 유형이면 가구원 수와 가구 월소득을 넣어요.", "대상이면 132로 전화하거나 가까운 공단 사무소에 상담을 신청해요."],
  highlightsTitle: "원문 기준",
  highlights: [
    { title: "2026 기준 중위소득", body: "1인 2,564,238원, 2인 4,199,292원, 3인 5,359,036원, 4인 6,494,738원(보건복지부고시 제2025-135호)." },
    { title: "125% 이하", body: "장애인, 한부모가족, 보훈 대상, 범죄피해자, 소액임차인, 개인회생·파산 신청 대상자, 전세사기 피해자, 국민 일반 등. 1인 가구 3,205,297원." },
    { title: "제한 없음·별도 기준", body: "성폭력·아동학대 피해자 등은 소득 제한 없음. 체불 근로자는 최종 3개월 평균 임금 400만원 미만, 소상공인은 연매출 3억원 이하." },
  ],
  disclaimer: "공단 누리집의 대상 목록과 소득 선만 대조해요. 공단이 어떤 소득으로 판단하는지, 변호사비용 금액은 누리집에서 확인하지 못했어요. 지원 여부는 공단 상담(132)에서 정해요.",
};
const faqs = [
  { q: "공단 지원은 완전히 무료예요?", a: "공단은 낮은 수준의 변호사비용과 송달료·인지대 같은 소송실비를 기본적으로 본인 부담으로 해요. 비용을 내주는 출연기관이 있는 대상이면 전부 또는 일부를 면제해요." },
  { q: "가구원이 8명이면요?", a: "고시는 8인 이상 가구는 1인 늘 때마다 959,198원씩 더해요(8인 10,474,348원)." },
  { q: "해고 사건도 공단에 가야 해요?", a: "노동위원회 사건은 월평균임금 300만원 미만이면 노동위원회가 무료 대리인을 붙여 주는 제도가 따로 있어요." },
];
---
<KrFinancePage slug="legal-aid-eligibility-check" locale="ko" title={title} description={description} shell={shell} faqs={faqs} koOnly group="money">
  <LegalAidCheck client:load />
  <p class="mt-4 text-sm text-muted-foreground">관련: <a class="underline underline-offset-4" href="/ko/litigation-cost-calculator/">소송비용 계산기</a> · <a class="underline underline-offset-4" href="/ko/appeal-deadline-calculator/">불복 기한 계산기</a> · <a class="underline underline-offset-4" href="/ko/pro-office/#KR/legal">실무 오피스 법무실</a></p>
</KrFinancePage>
