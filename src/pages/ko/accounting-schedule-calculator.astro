const faqs = [
  { q: "외부감사 대상은 어떻게 정해져요?", a: "직전 사업연도 말 기준으로 상장(예정) 법인, 자산 또는 매출액 500억 원 이상 회사는 대상이에요. 그 밖의 주식회사는 자산 120억, 부채 70억, 매출액 100억, 종업원 100명 중 2개 이상이면 대상이에요(외부감사법 시행령 제5조). 유한회사는 사원 50명을 더한 5개 중 3개 이상이에요." },
