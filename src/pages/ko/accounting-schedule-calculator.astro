// 결산 상각표·외부감사 대상 판정 (2026-11-20, 전문 직군 전수조사 8번). 엔진: lib/kr-accounting-schedules-2026.ts (스킬 kr-tax-advisor calc.mjs depreciation·lease·bond·audit)
import KrFinancePage from "../../components/KrFinancePage.astro";
import AccountingSchedules from "../../components/tools/advisory/AccountingSchedules";

const title = "결산 상각표 계산기 — 감가상각·리스(IFRS 16)·사채 유효이자율, 외부감사 대상 판정";
const description = "정액법·정률법·연수합계법 감가상각표(첫해 월할), K-IFRS 1116호 리스부채·사용권자산 표, 사채 유효이자율법 할인·할증차금 상각표를 만들고, 직전 사업연도 숫자로 다음 해 외부감사 대상인지 판정해요.";
const ko = {
  introTitle: "결산 분개 전에 표부터 맞춰요",
