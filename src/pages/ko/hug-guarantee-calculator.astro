---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="HUG 전세보증금 반환보증 계산기 — 126% 룰 가입 심사 & 보증료율 모의계산"
  description="공시가격의 126%(공시가 140% × 담보인정 90%) 룰에 따른 HUG 주택도시보증공사 전세반환보증 가입 가능 여부와 아파트·빌라별 보증료를 즉시 계산해요."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        2024~2026년 주택도시보증공사(HUG) 강화된 126% 룰 반영
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-2">
        HUG 전세보증금 반환보증 126% 진단기
      </h1>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        전세계약 전 보증금 떼일 걱정 없이 HUG 반환보증보험 가입이 가능한지 공시가격 기준으로 즉시 진단하고 예상 보증료를 산출해요.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Form -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm space-y-5">
        <h2 class="text-base font-bold text-foreground border-b border-border pb-3">
          1. 전세계약 및 주택 정보 입력
        </h2>

        <!-- Housing Type -->
        <div>
          <label class="block text-xs font-bold text-foreground mb-1.5">
            주택 유형
          </label>
          <div class="grid grid-cols-2 gap-2">
            <button
              id="house-apt"
              type="button"
              class="py-2.5 rounded-xl text-xs font-bold border transition-colors bg-primary text-primary-foreground border-primary"
            >
              아파트 / 주상복합
            </button>
            <button
              id="house-villa"
              type="button"
              class="py-2.5 rounded-xl text-xs font-bold border transition-colors bg-muted/30 text-muted-foreground border-border hover:bg-muted"
            >
              빌라 / 오피스텔 / 다세대
            </button>
          </div>
        </div>

        <!-- Official Housing Price (공시가격) -->
        <div>
          <label for="official-price" class="block text-xs font-bold text-foreground mb-1">
            부동산 공시가격 (공시지가)
          </label>
          <div class="relative">
            <input
              id="official-price"
              type="number"
              min="10000000"
              step="1000000"
              value="200000000"
              placeholder="예: 200000000 (2억)"
              class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground focus:border-primary focus:outline-hidden"
            />
            <span class="absolute right-4 top-2.5 text-xs text-muted-foreground">원</span>
          </div>
          <p class="text-[11px] text-muted-foreground mt-1">
            * 부동산공시가격알리미 조회 가격 (HUG 인정 주택가격 = 공시가의 140%)
          </p>
        </div>

        <!-- Jeonse Deposit (전세보증금) -->
        <div>
          <label for="deposit-amount" class="block text-xs font-bold text-foreground mb-1">
            희망 전세보증금
          </label>
          <div class="relative">
            <input
              id="deposit-amount"
              type="number"
              min="10000000"
              step="1000000"
              value="230000000"
              placeholder="예: 230000000 (2억 3천)"
              class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground focus:border-primary focus:outline-hidden"
            />
            <span class="absolute right-4 top-2.5 text-xs text-muted-foreground">원</span>
          </div>
        </div>

        <!-- Senior Lien (선순위 근저당권) -->
        <div>
          <label for="senior-lien" class="block text-xs font-bold text-foreground mb-1">
            등기부등본 선순위 채권액 (집주인 대출 근저당권)
          </label>
          <div class="relative">
            <input
              id="senior-lien"
              type="number"
              min="0"
              step="1000000"
              value="0"
              placeholder="대출 없으면 0 입력"
              class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-sm font-semibold text-foreground focus:border-primary focus:outline-hidden"
            />
            <span class="absolute right-4 top-2.5 text-xs text-muted-foreground">원</span>
          </div>
          <p class="text-[11px] text-muted-foreground mt-1">
            * 등기부등본 을구에 설정된 채권최고액 합계
          </p>
        </div>

        <!-- Discount / Subsidy -->
        <div>
          <label for="discount-type" class="block text-xs font-bold text-foreground mb-1">
            보증료 감면 할인 대상
          </label>
          <select
            id="discount-type"
            class="w-full rounded-xl border border-border bg-background px-4 py-2.5 text-xs font-semibold text-foreground focus:border-primary focus:outline-hidden"
          >
            <option value="none">일반 (할인 없음)</option>
            <option value="youth">청년 가구 (만 19~34세, 연소득 4천~5천 이하) — 50% 할인</option>
            <option value="newlywed">신혼부부 (혼인 7년 이내, 소득 6천 이하) — 40% 할인</option>
            <option value="multi-child">다자녀 가구 (미성년 자녀 2인 이상) — 40% 할인</option>
          </select>
        </div>
      </div>

      <!-- Result Card -->
      <div class="lg:col-span-6 space-y-6">
        <!-- Verdict Box -->
        <div id="hug-verdict-card" class="bg-card border rounded-2xl p-6 shadow-sm border-border">
          <div class="flex items-center gap-2 mb-2">
            <span id="hug-verdict-badge" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/10 text-primary">
              가입 가능 (안전)
            </span>
          </div>
          <h3 id="hug-verdict-title" class="text-base font-bold text-foreground mb-1">
            HUG 전세반환보증보험 가입이 가능해요!
          </h3>
          <p id="hug-verdict-desc" class="text-xs text-muted-foreground leading-relaxed">
            전세보증금이 공시가격의 126% 이내이며 선순위 채권 및 부채비율 요건을 충족해요.
          </p>
        </div>

        <!-- 126% Rule Metrics Box -->
        <div class="bg-card border border-border rounded-2xl p-6 shadow-sm space-y-3 text-xs">
          <h4 class="font-bold text-foreground text-sm border-b border-border pb-2">
            126% 기준 세부 심사 분석
          </h4>
          <div class="flex justify-between text-muted-foreground">
            <span>HUG 산정 주택가격 (공시가 × 140%)</span>
            <span id="res-calc-house-price" class="font-bold text-foreground">280,000,000 원</span>
          </div>
          <div class="flex justify-between text-muted-foreground">
            <span>최대 보증가능 전세금 (주택가 × 90% = 공시가 126%)</span>
            <span id="res-max-deposit" class="font-bold text-primary">252,000,000 원</span>
          </div>
          <div class="flex justify-between text-muted-foreground">
            <span>내 전세보증금의 공시가 대비 비율</span>
            <span id="res-deposit-ratio" class="font-bold text-foreground">115.0 % (통과)</span>
          </div>
          <div class="flex justify-between text-muted-foreground">
            <span>선순위 채권 한도 (주택가의 60% 이내)</span>
            <span id="res-senior-limit" class="font-semibold text-foreground">168,000,000 원</span>
          </div>
          <div class="flex justify-between text-muted-foreground">
            <span>총 부채비율 (선순위 + 전세금 / 주택가)</span>
            <span id="res-debt-ratio" class="font-bold text-foreground">82.1 % (90% 이하 충족)</span>
          </div>
        </div>

        <!-- Premium Calculation Box -->
        <div class="bg-card border border-border rounded-2xl p-6 shadow-sm">
          <span class="text-xs font-bold text-muted-foreground">2년 계약 기준 HUG 예상 보증료</span>
          <div class="mt-2 flex items-baseline gap-2">
            <span id="res-total-fee" class="text-3xl font-extrabold text-foreground">588,800</span>
            <span class="text-sm font-bold text-foreground">원 (총 2년분)</span>
          </div>
          <div class="mt-4 flex justify-between text-xs text-muted-foreground border-t border-border pt-3">
            <span>적용 보증료율</span>
            <span id="res-fee-rate" class="font-semibold text-foreground">연 0.128%</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Legal Background & Guide -->
    <div class="mt-12 space-y-6">
      <h2 class="text-xl font-bold text-foreground">HUG 전세반환보증 '126% 룰'이란?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-muted-foreground leading-relaxed">
        <div class="bg-card border border-border rounded-xl p-5 space-y-2">
          <h3 class="font-bold text-foreground text-sm">126% 공식의 산출 근거</h3>
          <p>
            국토교통부와 HUG는 무자본 갭투자와 깡통전세를 근절하기 위해 <strong>주택 공시가격의 140%만 주택가격으로 인정</strong>하고,
            여기에 <strong>전세가율(담보인정비율)을 90% 이하</strong>로 강화했어요.
          </p>
          <p class="font-mono bg-muted/40 p-2 rounded-lg text-foreground font-bold">
            140% (주택가격 인정) × 90% (담보비율) = 126%
          </p>
          <p>따라서 전세보증금이 <strong>공시가격의 1.26배를 단 1원이라도 초과하면 보증보험 가입이 거절</strong>돼요.</p>
        </div>
        <div class="bg-card border border-border rounded-xl p-5 space-y-2">
          <h3 class="font-bold text-foreground text-sm">전세계약 전 필수 체크리스트</h3>
          <ul class="list-disc list-inside space-y-1">
            <li><strong>특약 명시</strong>: "임대차계약 체결 후 HUG 보증보험 가입 불가 시 계약을 무효로 하고 계약금 전액을 반환한다"는 특약을 필수 기재하세요.</li>
            <li><strong>빌라·오피스텔 주의</strong>: 시세가 불투명한 신축 빌라의 경우 공시가격이 매우 낮게 책정되어 있어 126% 기준을 넘기기 쉬워요.</li>
            <li><strong>지자체 보증료 지원</strong>: 청년 및 신혼부부는 지자체에서 최대 30만 원까지 보증료를 실비 환급 지원해 줘요.</li>
          </ul>
        </div>
      </div>
    </div>

    <RelatedTools currentId="hug-guarantee" />
  </div>

  <script is:inline>
    (function () {
      let isApt = true;

      const houseAptBtn = document.getElementById("house-apt");
      const houseVillaBtn = document.getElementById("house-villa");
      const officialPriceInput = document.getElementById("official-price");
      const depositAmountInput = document.getElementById("deposit-amount");
      const seniorLienInput = document.getElementById("senior-lien");
      const discountSelect = document.getElementById("discount-type");

      const verdictCard = document.getElementById("hug-verdict-card");
      const verdictBadge = document.getElementById("hug-verdict-badge");
      const verdictTitle = document.getElementById("hug-verdict-title");
      const verdictDesc = document.getElementById("hug-verdict-desc");

      const resCalcHousePrice = document.getElementById("res-calc-house-price");
      const resMaxDeposit = document.getElementById("res-max-deposit");
      const resDepositRatio = document.getElementById("res-deposit-ratio");
      const resSeniorLimit = document.getElementById("res-senior-limit");
      const resDebtRatio = document.getElementById("res-debt-ratio");
      const resTotalFee = document.getElementById("res-total-fee");
      const resFeeRate = document.getElementById("res-fee-rate");

      houseAptBtn?.addEventListener("click", () => {
        isApt = true;
        houseAptBtn.className = "py-2.5 rounded-xl text-xs font-bold border transition-colors bg-primary text-primary-foreground border-primary";
        houseVillaBtn.className = "py-2.5 rounded-xl text-xs font-bold border transition-colors bg-muted/30 text-muted-foreground border-border hover:bg-muted";
        calculate();
      });

      houseVillaBtn?.addEventListener("click", () => {
        isApt = false;
        houseVillaBtn.className = "py-2.5 rounded-xl text-xs font-bold border transition-colors bg-primary text-primary-foreground border-primary";
        houseAptBtn.className = "py-2.5 rounded-xl text-xs font-bold border transition-colors bg-muted/30 text-muted-foreground border-border hover:bg-muted";
        calculate();
      });

      function formatNum(n) {
        return Math.round(n).toLocaleString();
      }

      function calculate() {
        const officialPrice = Math.max(0, parseFloat(officialPriceInput.value) || 0);
        const deposit = Math.max(0, parseFloat(depositAmountInput.value) || 0);
        const seniorLien = Math.max(0, parseFloat(seniorLienInput.value) || 0);
        const discountVal = discountSelect.value;

        // 1. 산정 주택가격 = 공시가 × 140%
        const calcHousePrice = officialPrice * 1.4;
        // 2. 최대 보증가능 전세금 = 공시가 × 126% (주택가 × 90%)
        const maxDeposit = officialPrice * 1.26;
        // 3. 선순위 채권 한도 = 주택가 × 60%
        const seniorLimit = calcHousePrice * 0.6;
        // 4. 총 부채비율 = (선순위 + 전세금) / 주택가
        const debtRatio = calcHousePrice > 0 ? ((seniorLien + deposit) / calcHousePrice) * 100 : 0;
        const depositRatio = officialPrice > 0 ? (deposit / officialPrice) * 100 : 0;

        resCalcHousePrice.textContent = `${formatNum(calcHousePrice)} 원`;
        resMaxDeposit.textContent = `${formatNum(maxDeposit)} 원`;
        resSeniorLimit.textContent = `${formatNum(seniorLimit)} 원`;
        resDepositRatio.textContent = `${depositRatio.toFixed(1)} % (${deposit <= maxDeposit ? '통과' : '초과 탈락'})`;
        resDebtRatio.textContent = `${debtRatio.toFixed(1)} % (${debtRatio <= 90 ? '통과' : '초과 탈락'})`;

        // 가입 심사 판정
        let isEligible = true;
        let rejectReason = "";

        if (deposit > maxDeposit) {
          isEligible = false;
          rejectReason = `전세보증금이 공시가격의 126%(${formatNum(maxDeposit)}원)를 초과하여 HUG 보증 가입이 불가능해요.`;
        } else if (seniorLien > seniorLimit) {
          isEligible = false;
          rejectReason = `선순위 채권(${formatNum(seniorLien)}원)이 주택가격의 60%(${formatNum(seniorLimit)}원)를 초과하여 가입이 거절돼요.`;
        } else if (debtRatio > 90) {
          isEligible = false;
          rejectReason = `선순위 채권과 전세보증금 합산액의 부채비율(${debtRatio.toFixed(1)}%)이 90%를 초과하여 가입이 거절돼요.`;
        }

        if (isEligible) {
          verdictCard.className = "bg-primary/5 border border-primary/30 rounded-2xl p-6 shadow-sm";
          verdictBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-primary/15 text-primary";
          verdictBadge.textContent = "HUG 보증 가입 가능";
          verdictTitle.textContent = "HUG 전세반환보증보험 가입이 가능해요!";
          verdictDesc.textContent = "전세보증금이 126% 기준 이내이며 선순위 채권 및 총부채비율 요건을 모두 충족해요.";
        } else {
          verdictCard.className = "bg-destructive/5 border border-destructive/30 rounded-2xl p-6 shadow-sm";
          verdictBadge.className = "px-2.5 py-0.5 rounded-full text-xs font-bold bg-destructive/15 text-destructive";
          verdictBadge.textContent = "가입 불가 (위험)";
          verdictTitle.textContent = "HUG 보증보험 가입이 거절되는 전세계약이에요.";
          verdictDesc.textContent = rejectReason;
        }

        // 보증료율 계산
        let baseRate = 0.00128; // 0.128%
        if (isApt) {
          baseRate = debtRatio <= 80 ? 0.00115 : 0.00128;
        } else {
          baseRate = debtRatio <= 80 ? 0.00139 : 0.00154;
        }

        // 감면율
        let discountRate = 0;
        if (discountVal === "youth") discountRate = 0.5;
        else if (discountVal === "newlywed" || discountVal === "multi-child") discountRate = 0.4;

        // 2년 계약 보증료 = 보증금 × 연이율 × 2 × (1 - 감면율)
        const totalFee = deposit * baseRate * 2 * (1 - discountRate);

        resFeeRate.textContent = `연 ${(baseRate * 100).toFixed(3)}% ${discountRate > 0 ? `(${Math.round(discountRate * 100)}% 감면 적용)` : ''}`;
        resTotalFee.textContent = formatNum(totalFee);
      }

      [officialPriceInput, depositAmountInput, seniorLienInput, discountSelect].forEach((el) => {
        el?.addEventListener("input", calculate);
      });

      calculate();
    })();
  </script>
</Layout>
