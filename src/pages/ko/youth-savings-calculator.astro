---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="청년도약계좌 & 청년주택드림 계산기 — 정부기여금 및 만기 수령액 시뮬레이션"
  description="2026년 최신 청년도약계좌 정부 기여금 매칭(최대 월 2.4만원)과 15.4% 비과세 혜택, 청년주택드림 청약통장 4.5% 우대이자 및 만기 목돈 형성 실수령액을 실시간 계산해보세요."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        2026년 청년 금융 정책 반영
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-2">
        청년도약계좌 & 청년주택드림 계산기
      </h1>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        월 납입액과 소득 구간에 따른 정부 기여금 매칭, 15.4% 비과세 절세액, 5년 만기 5,000만원 형성 실수령액을 한눈에 비교하세요.
      </p>
    </div>

    <!-- Tab Selector -->
    <div class="flex p-1 bg-muted rounded-xl mb-6 max-w-md mx-auto">
      <button
        id="tab-btn-jump"
        type="button"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm"
      >
        청년도약계좌 (5년 5천만원)
      </button>
      <button
        id="tab-btn-dream"
        type="button"
        class="flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground"
      >
        청년주택드림 (청약+저리대출)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm space-y-6">
        <!-- Youth Jump Section -->
        <div id="section-jump" class="space-y-5">
          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              월 납입금액
            </label>
            <div class="relative">
              <input
                id="jump-monthly"
                type="number"
                min="10"
                max="70"
                step="5"
                value="70"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">만원 / 월 (최대 70만)</span>
            </div>
            <!-- Quick Chips -->
            <div class="flex flex-wrap gap-1.5 mt-2">
              <button type="button" class="chip-jump px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="70">최대 70만원</button>
              <button type="button" class="chip-jump px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="50">50만원</button>
              <button type="button" class="chip-jump px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="30">30만원</button>
              <button type="button" class="chip-jump px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="10">10만원</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              총급여 (연간 소득 구간)
            </label>
            <select
              id="jump-income"
              class="w-full rounded-xl border border-input bg-background px-3 py-2.5 text-sm font-medium text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="2400">2,400만원 이하 (매칭 6.0%, 월 최대 2.4만)</option>
              <option value="3600" selected>2,400만 ~ 3,600만원 이하 (매칭 4.6%, 월 최대 2.3만)</option>
              <option value="4800">3,600만 ~ 4,800만원 이하 (매칭 3.7%, 월 최대 2.2만)</option>
              <option value="6000">4,800만 ~ 6,000만원 이하 (매칭 3.0%, 월 최대 2.1만)</option>
              <option value="7500">6,000만 ~ 7,500만원 (정부기여금 없음, 비과세 적용)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              은행 금리 (기본+우대금리)
            </label>
            <div class="relative">
              <input
                id="jump-rate"
                type="number"
                step="0.1"
                min="3.0"
                max="8.0"
                value="5.5"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">% (연간)</span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">시중은행 3년 고정 + 2년 변동금리 (평균 5.5%~6.0%)</p>
          </div>
        </div>

        <!-- Youth Dream Section -->
        <div id="section-dream" class="space-y-5 hidden">
          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              월 청약 납입금액
            </label>
            <div class="relative">
              <input
                id="dream-monthly"
                type="number"
                min="2"
                max="100"
                step="5"
                value="20"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">만원 / 월 (최대 100만)</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-2">
              <button type="button" class="chip-dream px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="50">50만원</button>
              <button type="button" class="chip-dream px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="25">인정 한도 25만원</button>
              <button type="button" class="chip-dream px-2.5 py-1 text-xs rounded-md bg-muted hover:bg-primary/20 text-foreground font-medium" data-val="10">10만원</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              가입 및 유지 기간
            </label>
            <div class="relative">
              <input
                id="dream-years"
                type="number"
                min="1"
                max="10"
                value="3"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">년 (1~10년)</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-foreground mb-1.5">
              청년 우대 이율 (최고 연 4.5%)
            </label>
            <div class="relative">
              <input
                id="dream-rate"
                type="number"
                step="0.1"
                min="2.0"
                max="6.0"
                value="4.5"
                class="w-full rounded-xl border border-input bg-background px-4 py-2.5 text-base font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
              />
              <span class="absolute right-4 top-2.5 text-sm text-muted-foreground">%</span>
            </div>
            <p class="text-xs text-muted-foreground mt-1">2년 이상 가입 유지 시 최고 연 4.5% 우대금리 적용</p>
          </div>
        </div>
      </div>

      <!-- Result Summary Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-foreground mb-4 flex items-center justify-between">
            <span>만기 예상 수령액 시뮬레이션</span>
            <span id="badge-mode" class="text-xs font-semibold px-2 py-0.5 rounded bg-primary/10 text-primary">5년 만기</span>
          </h2>

          <div class="space-y-3.5 mb-6">
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span class="text-muted-foreground">본인 납입 원금 총액</span>
              <span id="res-principal" class="font-bold text-foreground">42,000,000원</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span class="text-muted-foreground">은행 약정 이자 (세전)</span>
              <span id="res-interest" class="font-bold text-foreground">5,801,250원</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span id="label-bonus" class="text-muted-foreground">정부 매칭 기여금 총액</span>
              <span id="res-bonus" class="font-bold text-success">1,380,000원</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-border/50 text-sm">
              <span class="text-muted-foreground">이자소득세 (15.4% 비과세 절세)</span>
              <span id="res-tax-saved" class="font-bold text-primary">+893,392원 비과세</span>
            </div>
          </div>
        </div>

        <!-- Total Highlight Box -->
        <div class="rounded-xl bg-primary/10 border border-primary/20 p-5 text-center mt-2">
          <p class="text-xs font-medium text-muted-foreground mb-1">만기 시 최종 통장 수령액</p>
          <p id="res-total" class="text-3xl font-black text-primary tracking-tight">
            49,181,250원
          </p>
          <p id="res-profit-rate" class="text-xs font-semibold text-muted-foreground mt-2">
            실질 수익률: 원금 대비 <span class="text-success font-bold">+17.1%</span> (연 6.8% 환산)
          </p>
        </div>
      </div>
    </div>

    <!-- Policy Info Guide -->
    <div class="mt-12 bg-card border border-border rounded-2xl p-6 sm:p-8 space-y-6">
      <h3 class="text-lg font-bold text-foreground">💡 2026년 청년 금융 혜택 핵심 가이드</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-muted-foreground">
        <div class="space-y-2">
          <h4 class="font-bold text-foreground text-sm">청년도약계좌 꿀팁</h4>
          <ul class="list-disc list-inside space-y-1 text-xs">
            <li>만 19세~34세, 개인소득 7,500만원 이하 & 가구소득 중위 250% 이하 가입 가능.</li>
            <li>3년 이상 유지 후 부득이하게 중도해지 시에도 정부 기여금 일부 및 비과세 혜택 유지.</li>
            <li>육아휴직급여 수급 청년도 소득 증빙 인정으로 가입 대상 포함.</li>
          </ul>
        </div>
        <div class="space-y-2">
          <h4 class="font-bold text-foreground text-sm">청년주택드림 청약통장 꿀팁</h4>
          <ul class="list-disc list-inside space-y-1 text-xs">
            <li>연소득 5,000만원 이하 무주택 청년 대상 최고 연 4.5% 우대이자.</li>
            <li>기존 청약통장에서 청년주택드림으로 전환 시 기존 납입 회차와 인정 금액 100% 연속 승계.</li>
            <li>청약 당첨 시 최저 연 2.2% 금리로 분양가 80%까지 최장 40년 주택드림대출 지원.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <RelatedTools currentId="youth-savings" />
    </div>
  </div>

  <script is:inline>
    let currentTab = 'jump';

    const tabBtnJump = document.getElementById('tab-btn-jump');
    const tabBtnDream = document.getElementById('tab-btn-dream');
    const secJump = document.getElementById('section-jump');
    const secDream = document.getElementById('section-dream');

    const jumpMonthly = document.getElementById('jump-monthly');
    const jumpIncome = document.getElementById('jump-income');
    const jumpRate = document.getElementById('jump-rate');

    const dreamMonthly = document.getElementById('dream-monthly');
    const dreamYears = document.getElementById('dream-years');
    const dreamRate = document.getElementById('dream-rate');

    const badgeMode = document.getElementById('badge-mode');
    const resPrincipal = document.getElementById('res-principal');
    const resInterest = document.getElementById('res-interest');
    const labelBonus = document.getElementById('label-bonus');
    const resBonus = document.getElementById('res-bonus');
    const resTaxSaved = document.getElementById('res-tax-saved');
    const resTotal = document.getElementById('res-total');
    const resProfitRate = document.getElementById('res-profit-rate');

    function formatWon(num) {
      return Math.round(num).toLocaleString('ko-KR') + '원';
    }

    function calculate() {
      if (currentTab === 'jump') {
        const monthly = (parseFloat(jumpMonthly.value) || 70) * 10000;
        const income = parseInt(jumpIncome.value, 10);
        const rate = (parseFloat(jumpRate.value) || 5.5) / 100;
        const months = 60; // 5년

        // 1. Principal
        const principal = monthly * months;

        // 2. Interest (단리 적금 공식: Sum P * r * (months - i + 1) / 12)
        const interest = monthly * rate * (months * (months + 1) / 24);

        // 3. Government Matching Contribution
        // 2400만 이하: 6.0% (월 최대 2.4만)
        // 3600만 이하: 4.6% (월 최대 2.3만)
        // 4800만 이하: 3.7% (월 최대 2.2만)
        // 6000만 이하: 3.0% (월 최대 2.1만)
        // 7500만 이하: 0%
        let matchingRate = 0;
        let monthlyCap = 0;

        if (income <= 2400) {
          matchingRate = 0.06;
          monthlyCap = 24000;
        } else if (income <= 3600) {
          matchingRate = 0.046;
          monthlyCap = 23000;
        } else if (income <= 4800) {
          matchingRate = 0.037;
          monthlyCap = 22000;
        } else if (income <= 6000) {
          matchingRate = 0.030;
          monthlyCap = 21000;
        }

        const monthlyGovBonus = Math.min(monthly * matchingRate, monthlyCap);
        const totalGovBonus = monthlyGovBonus * months;

        // 4. Tax saved (15.4% of interest)
        const taxSaved = interest * 0.154;

        // 5. Total
        const total = principal + interest + totalGovBonus;
        const profitPct = ((total - principal) / principal * 100).toFixed(1);

        badgeMode.textContent = '5년 만기 (60개월)';
        labelBonus.textContent = '정부 매칭 기여금 총액';
        resPrincipal.textContent = formatWon(principal);
        resInterest.textContent = formatWon(interest);
        resBonus.textContent = formatWon(totalGovBonus);
        resTaxSaved.textContent = `+${formatWon(taxSaved)} 전액 비과세`;
        resTotal.textContent = formatWon(total);
        resProfitRate.innerHTML = `실질 수익률: 원금 대비 <span class="text-success font-bold">+${profitPct}%</span> (비과세 혜택 포함)`;
      } else {
        // Dream Housing Account
        const monthly = (parseFloat(dreamMonthly.value) || 20) * 10000;
        const years = parseInt(dreamYears.value, 10) || 3;
        const months = years * 12;
        const rate = (parseFloat(dreamRate.value) || 4.5) / 100;

        const principal = monthly * months;
        const interest = monthly * rate * (months * (months + 1) / 24);
        const taxSaved = interest * 0.154; // 비과세 혜택
        const total = principal + interest;
        const profitPct = ((interest) / principal * 100).toFixed(1);

        badgeMode.textContent = `${years}년 가입 (${months}개월)`;
        labelBonus.textContent = '청약 당첨 연계 혜택';
        resPrincipal.textContent = formatWon(principal);
        resInterest.textContent = formatWon(interest);
        resBonus.textContent = '연 2.2% 저리 주택드림대출 연계';
        resTaxSaved.textContent = `+${formatWon(taxSaved)} 비과세 적용`;
        resTotal.textContent = formatWon(total);
        resProfitRate.innerHTML = `이자 수익률: 원금 대비 <span class="text-success font-bold">+${profitPct}%</span> (우대금리 ${dreamRate.value}%)`;
      }
    }

    tabBtnJump.addEventListener('click', () => {
      currentTab = 'jump';
      tabBtnJump.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm';
      tabBtnDream.className = 'flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground';
      secJump.classList.remove('hidden');
      secDream.classList.add('hidden');
      calculate();
    });

    tabBtnDream.addEventListener('click', () => {
      currentTab = 'dream';
      tabBtnDream.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg transition-all bg-card text-foreground shadow-sm';
      tabBtnJump.className = 'flex-1 py-2 text-xs sm:text-sm font-medium rounded-lg transition-all text-muted-foreground hover:text-foreground';
      secDream.classList.remove('hidden');
      secJump.classList.add('hidden');
      calculate();
    });

    document.querySelectorAll('.chip-jump').forEach((chip) => {
      chip.addEventListener('click', () => {
        jumpMonthly.value = chip.getAttribute('data-val') || '70';
        calculate();
      });
    });

    document.querySelectorAll('.chip-dream').forEach((chip) => {
      chip.addEventListener('click', () => {
        dreamMonthly.value = chip.getAttribute('data-val') || '20';
        calculate();
      });
    });

    [jumpMonthly, jumpIncome, jumpRate, dreamMonthly, dreamYears, dreamRate].forEach((el) => {
      el.addEventListener('input', calculate);
    });

    calculate();
  </script>
</Layout>
