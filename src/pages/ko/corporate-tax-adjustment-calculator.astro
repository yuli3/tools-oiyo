const faqs = [
  { q: "2026년 법인세율은 얼마인가요?", a: "2026-01-01 이후 시작하는 사업연도부터 과세표준 2억 원 이하 10%, 200억 원 이하 20%, 3,000억 원 이하 22%, 초과 25%예요(법인세법 제55조, 2025-12-02 국회 통과). 지방소득세는 같은 구간에 1/10 세율이에요." },
  { q: "업무추진비(접대비)는 얼마까지 비용이 되나요?", a: "기본 한도는 1,200만 원(중소기업 3,600만 원)에 사업연도 월수를 곱하고 12로 나눠요. 여기에 매출 100억 원까지 0.3%, 500억 원까지 0.2%, 초과분 0.03%를 더해요. 특수관계인 매출분은 그 10%만 쳐요(법인세법 제25조)." },
  { q: "최저한세가 뭔가요?", a: "세액공제·감면을 받아도 일정 세액은 내도록 하는 장치예요. 중소기업은 과세표준의 7%, 그 밖의 법인은 10%·12%·17%예요(조세특례제한법 제132조). 그보다 낮아지게 하는 공제는 잘려요." },
