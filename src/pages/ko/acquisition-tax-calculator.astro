---
import Layout from "../../components/Layout.astro";
---

<Layout
  title="부동산 취득세 및 양도소득세 간편 계산기 (2026 최신 주택 세법)"
  description="주택 매매가액, 보유 주택수, 전용면적, 생애최초 여부에 따른 취득세·지방교육세·농특세 합계와 양도소득세 비과세·장기보유특별공제 세액을 정밀 계산해요."
>
  <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        지방세법 및 소득세법 최신 개정 세율 반영
      </div>
      <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-foreground">
        부동산 취득세 & 양도세 계산기
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        주택 취득 시 납부하는 취득세(생애최초 감면 포함)와 매도 시 발생하는 양도소득세(1세대 1주택 비과세 및 장특공제)를 한번에 정밀 산출해요.
      </p>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="flex items-center gap-2 p-1 bg-muted rounded-xl mb-6">
      <button
        id="tabAcquisition"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all"
      >
        주택 취득세 계산
      </button>
      <button
        id="tabCapitalGains"
        class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all"
      >
        양도소득세 계산
      </button>
    </div>

    <!-- Mode 1: Acquisition Tax Section -->
    <div id="sectionAcquisition" class="space-y-6">
      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="acqPrice" class="text-xs font-bold text-foreground block mb-1.5">
              취득가액 (매매가, 원)
            </label>
            <input
              type="number"
              id="acqPrice"
              value="650000000"
              step="10000000"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span id="acqPriceKor" class="text-xs text-muted-foreground mt-1 block">6억 5,000만 원</span>
          </div>

          <div>
            <label for="houseCount" class="text-xs font-bold text-foreground block mb-1.5">
              보유 주택수 (취득 후 기준)
            </label>
            <select
              id="houseCount"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="1" selected>1주택 (무주택자의 신규 취득)</option>
              <option value="2_non_reg">2주택 (일시적 2주택 또는 비조정)</option>
              <option value="2_reg">2주택 (조정대상지역 중과 8%)</option>
              <option value="3_non_reg">3주택 (비조정 중과 8%)</option>
              <option value="3_reg">3주택 (조정 중과 12%)</option>
              <option value="4_multi">4주택 이상 / 법인 (12%)</option>
            </select>
          </div>

          <div>
            <label for="areaType" class="text-xs font-bold text-foreground block mb-1.5">
              전용면적 구분
            </label>
            <select
              id="areaType"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            >
              <option value="under85" selected>국민주택규모 이하 (85㎡ 이하, 농특세 비과세)</option>
              <option value="over85">국민주택규모 초과 (85㎡ 초과, 농특세 부과)</option>
            </select>
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-foreground">
              <input type="checkbox" id="firstHomeDiscount" class="rounded border-input text-primary focus:ring-primary w-4 h-4" />
              <span>생애최초 주택구입 감면 (최대 200만 원 감면)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Acquisition Result Card -->
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="text-xs font-bold text-primary uppercase tracking-wider">
          총 납부 예상 세액
        </div>
        <div class="flex items-baseline justify-between border-b border-primary/10 pb-4">
          <span class="text-sm font-semibold text-muted-foreground">합계 세액</span>
          <span id="acqTotalTax" class="text-2xl sm:text-3xl font-black text-foreground">0원</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">취득세 (본세)</div>
            <div id="acqMainTax" class="font-bold text-foreground mt-1 text-sm">0원</div>
            <div id="acqRateBadge" class="text-[10px] text-primary font-mono mt-0.5">1.33%</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">지방교육세</div>
            <div id="acqEduTax" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">농어촌특별세</div>
            <div id="acqRuralTax" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">생애최초 감면액</div>
            <div id="acqDiscountAmount" class="font-bold text-emerald-600 dark:text-emerald-400 mt-1 text-sm">-0원</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mode 2: Capital Gains Tax Section -->
    <div id="sectionCapitalGains" class="space-y-6 hidden">
      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="salePrice" class="text-xs font-bold text-foreground block mb-1.5">
              양도가액 (매도가, 원)
            </label>
            <input
              type="number"
              id="salePrice"
              value="1500000000"
              step="10000000"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span id="salePriceKor" class="text-xs text-muted-foreground mt-1 block">15억 원</span>
          </div>

          <div>
            <label for="buyPrice" class="text-xs font-bold text-foreground block mb-1.5">
              취득가액 (취득 시 가격, 원)
            </label>
            <input
              type="number"
              id="buyPrice"
              value="900000000"
              step="10000000"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
            <span id="buyPriceKor" class="text-xs text-muted-foreground mt-1 block">9억 원</span>
          </div>

          <div>
            <label for="necessaryExpenses" class="text-xs font-bold text-foreground block mb-1.5">
              필요경비 (중개보수·인테리어자본적지출 등)
            </label>
            <input
              type="number"
              id="necessaryExpenses"
              value="30000000"
              step="1000000"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>

          <div>
            <label for="holdingYears" class="text-xs font-bold text-foreground block mb-1.5">
              보유 기간 (년)
            </label>
            <input
              type="number"
              id="holdingYears"
              value="5"
              min="1"
              max="30"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>

          <div>
            <label for="residingYears" class="text-xs font-bold text-foreground block mb-1.5">
              실거주 기간 (년, 1세대 1주택 장특공제)
            </label>
            <input
              type="number"
              id="residingYears"
              value="3"
              min="0"
              max="30"
              class="w-full rounded-lg border border-input bg-background px-3 py-2 text-sm font-semibold text-foreground focus:outline-none focus:ring-2 focus:ring-primary"
            />
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-foreground">
              <input type="checkbox" id="singleHomeTaxExempt" checked class="rounded border-input text-primary focus:ring-primary w-4 h-4" />
              <span>1세대 1주택 비과세 요건 충족 (12억 초과분만 과세)</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Capital Gains Result Card -->
      <div class="rounded-xl border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="text-xs font-bold text-primary uppercase tracking-wider">
          양도소득세 납부 예상 세액
        </div>
        <div class="flex items-baseline justify-between border-b border-primary/10 pb-4">
          <span class="text-sm font-semibold text-muted-foreground">총 세액 (양도세 + 지방소득세 10%)</span>
          <span id="cgTotalTax" class="text-2xl sm:text-3xl font-black text-foreground">0원</span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">양도차익</div>
            <div id="cgGain" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">장기보유특별공제</div>
            <div id="cgSpecialDeduction" class="font-bold text-emerald-600 dark:text-emerald-400 mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">과세표준</div>
            <div id="cgTaxBase" class="font-bold text-foreground mt-1 text-sm">0원</div>
          </div>
          <div class="bg-card p-3 rounded-lg border border-border">
            <div class="text-muted-foreground">적용 세율</div>
            <div id="cgRateApplied" class="font-bold text-primary mt-1 text-sm">0%</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Educational Tax Explanation Guide -->
    <div class="mt-8 rounded-xl border border-border bg-card p-6 space-y-4 text-xs leading-relaxed text-muted-foreground">
      <h2 class="text-sm font-bold text-foreground">💡 2026 주택 세무 상식 & 절세 팁</h2>
      <ul class="list-disc list-inside space-y-1.5">
        <li><strong>취득세 사다리 세율</strong>: 1주택자의 경우 6억 원 이하는 1%, 6억 초과 9억 원 이하는 [취득가액(억원) × 2/3 - 3]%로 세분화되며, 9억 원 초과는 3%가 적용돼요.</li>
        <li><strong>생애최초 감면</strong>: 세대원 모두 주택을 소유한 사실이 없고 주택가액 12억 원 이하 취득 시 최대 200만 원 한도 내에서 취득세가 감면돼요.</li>
        <li><strong>1세대 1주택 고가주택 양도세</strong>: 실거래가 12억 원 이하 주택은 전액 비과세되며, 12억 원 초과분에 대해서만 <code>(양도가액 - 12억원) / 양도가액</code> 비율로 안분하여 과세돼요.</li>
        <li><strong>표준 소득세 누진세율</strong>: 과세표준 1,400만원 이하 6%, 5,000만원 이하 15%, 8,800만원 이하 24%, 1.5억원 이하 35%, 3억원 이하 38%, 5억원 이하 40%, 10억원 이하 42%, 10억원 초과 45% 누진세율이 적용돼요.</li>
      </ul>
    </div>
  </div>
</Layout>

<script>
  function formatWon(val: number): string {
    return Math.round(val).toLocaleString('ko-KR') + '원';
  }

  function toKoreanAmount(num: number): string {
    if (!num || num <= 0) return '0원';
    const eok = Math.floor(num / 100000000);
    const man = Math.floor((num % 100000000) / 10000);
    let str = '';
    if (eok > 0) str += `${eok}억 `;
    if (man > 0) str += `${man.toLocaleString('ko-KR')}만 `;
    return str.trim() + '원';
  }

  // DOM Elements
  const tabAcq = document.getElementById('tabAcquisition')!;
  const tabCg = document.getElementById('tabCapitalGains')!;
  const secAcq = document.getElementById('sectionAcquisition')!;
  const secCg = document.getElementById('sectionCapitalGains')!;

  tabAcq.addEventListener('click', () => {
    tabAcq.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all';
    tabCg.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
    secAcq.classList.remove('hidden');
    secCg.classList.add('hidden');
  });

  tabCg.addEventListener('click', () => {
    tabCg.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg bg-card text-foreground shadow-xs transition-all';
    tabAcq.className = 'flex-1 py-2 text-xs sm:text-sm font-bold rounded-lg text-muted-foreground hover:text-foreground transition-all';
    secCg.classList.remove('hidden');
    secAcq.classList.add('hidden');
  });

  // Calculate Acquisition Tax
  function calculateAcqTax() {
    const price = Number((document.getElementById('acqPrice') as HTMLInputElement).value) || 0;
    const houseType = (document.getElementById('houseCount') as HTMLSelectElement).value;
    const areaType = (document.getElementById('areaType') as HTMLSelectElement).value;
    const firstHome = (document.getElementById('firstHomeDiscount') as HTMLInputElement).checked;

    document.getElementById('acqPriceKor')!.textContent = toKoreanAmount(price);

    let baseRate = 0.01;
    if (houseType === '1') {
      if (price <= 600000000) {
        baseRate = 0.01;
      } else if (price <= 900000000) {
        baseRate = (price * (2 / 300000000) - 3) / 100;
      } else {
        baseRate = 0.03;
      }
    } else if (houseType === '2_non_reg') {
      if (price <= 600000000) baseRate = 0.01;
      else if (price <= 900000000) baseRate = (price * (2 / 300000000) - 3) / 100;
      else baseRate = 0.03;
    } else if (houseType === '2_reg' || houseType === '3_non_reg') {
      baseRate = 0.08;
    } else {
      baseRate = 0.12;
    }

    let mainTax = price * baseRate;
    let discount = 0;
    if (firstHome && price <= 1200000000) {
      discount = Math.min(mainTax, 2000000);
      mainTax = Math.max(0, mainTax - discount);
    }

    const eduRate = baseRate <= 0.03 ? baseRate * 0.1 : 0.004;
    const eduTax = price * eduRate;

    const ruralRate = areaType === 'over85' ? (baseRate >= 0.08 ? 0.01 : 0.002) : 0;
    const ruralTax = price * ruralRate;

    const totalTax = mainTax + eduTax + ruralTax;

    document.getElementById('acqTotalTax')!.textContent = formatWon(totalTax);
    document.getElementById('acqMainTax')!.textContent = formatWon(mainTax);
    document.getElementById('acqRateBadge')!.textContent = (baseRate * 100).toFixed(2) + '%';
    document.getElementById('acqEduTax')!.textContent = formatWon(eduTax);
    document.getElementById('acqRuralTax')!.textContent = formatWon(ruralTax);
    document.getElementById('acqDiscountAmount')!.textContent = discount > 0 ? `-${formatWon(discount)}` : '0원';
  }

  // Calculate Capital Gains Tax
  function calculateCgTax() {
    const sale = Number((document.getElementById('salePrice') as HTMLInputElement).value) || 0;
    const buy = Number((document.getElementById('buyPrice') as HTMLInputElement).value) || 0;
    const expenses = Number((document.getElementById('necessaryExpenses') as HTMLInputElement).value) || 0;
    const holdY = Number((document.getElementById('holdingYears') as HTMLInputElement).value) || 0;
    const liveY = Number((document.getElementById('residingYears') as HTMLInputElement).value) || 0;
    const isSingleExempt = (document.getElementById('singleHomeTaxExempt') as HTMLInputElement).checked;

    document.getElementById('salePriceKor')!.textContent = toKoreanAmount(sale);
    document.getElementById('buyPriceKor')!.textContent = toKoreanAmount(buy);

    const totalGain = Math.max(0, sale - buy - expenses);

    if (totalGain <= 0) {
      document.getElementById('cgTotalTax')!.textContent = '0원';
      document.getElementById('cgGain')!.textContent = '0원';
      document.getElementById('cgSpecialDeduction')!.textContent = '0원';
      document.getElementById('cgTaxBase')!.textContent = '0원';
      document.getElementById('cgRateApplied')!.textContent = '0%';
      return;
    }

    let taxableGain = totalGain;
    if (isSingleExempt) {
      if (sale <= 1200000000) {
        // Full exemption
        document.getElementById('cgTotalTax')!.textContent = '0원 (전액 비과세)';
        document.getElementById('cgGain')!.textContent = formatWon(totalGain);
        document.getElementById('cgSpecialDeduction')!.textContent = '0원';
        document.getElementById('cgTaxBase')!.textContent = '0원';
        document.getElementById('cgRateApplied')!.textContent = '0%';
        return;
      }
      taxableGain = totalGain * ((sale - 1200000000) / sale);
    }

    // 장기보유특별공제
    let deductionRate = 0;
    if (isSingleExempt) {
      const holdPart = Math.min(0.40, Math.max(0, holdY >= 3 ? holdY * 0.04 : 0));
      const livePart = Math.min(0.40, Math.max(0, liveY >= 2 ? liveY * 0.04 : 0));
      deductionRate = Math.min(0.80, holdPart + livePart);
    } else {
      deductionRate = Math.min(0.30, Math.max(0, holdY >= 3 ? (holdY - 2) * 0.02 : 0));
    }

    const specialDeduction = taxableGain * deductionRate;
    const basicDeduction = 2500000;
    const taxBase = Math.max(0, taxableGain - specialDeduction - basicDeduction);

    // Standard progressive tax brackets
    let tax = 0;
    let effectiveRateStr = '6%';
    if (taxBase <= 14000000) {
      tax = taxBase * 0.06;
      effectiveRateStr = '6%';
    } else if (taxBase <= 50000000) {
      tax = 840000 + (taxBase - 14000000) * 0.15;
      effectiveRateStr = '15%';
    } else if (taxBase <= 88000000) {
      tax = 6240000 + (taxBase - 50000000) * 0.24;
      effectiveRateStr = '24%';
    } else if (taxBase <= 150000000) {
      tax = 15360000 + (taxBase - 88000000) * 0.35;
      effectiveRateStr = '35%';
    } else if (taxBase <= 300000000) {
      tax = 37060000 + (taxBase - 150000000) * 0.38;
      effectiveRateStr = '38%';
    } else if (taxBase <= 500000000) {
      tax = 94060000 + (taxBase - 300000000) * 0.40;
      effectiveRateStr = '40%';
    } else if (taxBase <= 1000000000) {
      tax = 174060000 + (taxBase - 500000000) * 0.42;
      effectiveRateStr = '42%';
    } else {
      tax = 384060000 + (taxBase - 1000000000) * 0.45;
      effectiveRateStr = '45%';
    }

    const localTax = tax * 0.10;
    const totalTax = tax + localTax;

    document.getElementById('cgTotalTax')!.textContent = formatWon(totalTax);
    document.getElementById('cgGain')!.textContent = formatWon(taxableGain);
    document.getElementById('cgSpecialDeduction')!.textContent = `${formatWon(specialDeduction)} (${(deductionRate * 100).toFixed(0)}%)`;
    document.getElementById('cgTaxBase')!.textContent = formatWon(taxBase);
    document.getElementById('cgRateApplied')!.textContent = effectiveRateStr;
  }

  // Wire events
  ['acqPrice', 'houseCount', 'areaType', 'firstHomeDiscount'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', calculateAcqTax);
    document.getElementById(id)?.addEventListener('change', calculateAcqTax);
  });

  ['salePrice', 'buyPrice', 'necessaryExpenses', 'holdingYears', 'residingYears', 'singleHomeTaxExempt'].forEach((id) => {
    document.getElementById(id)?.addEventListener('input', calculateCgTax);
    document.getElementById(id)?.addEventListener('change', calculateCgTax);
  });

  calculateAcqTax();
  calculateCgTax();
</script>
