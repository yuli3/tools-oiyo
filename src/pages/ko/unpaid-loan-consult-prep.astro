---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import T from '../../components/tools/plan/CasePrepFlow';
// AI 전문가 집중 계획 3번 상황 (2026-11-24). Logic: lib/case-prep-2026.ts (kr-desks-2026 lend + consult-memo-2026 재사용, 계산 없음).
const c = {
  introTitle: '빌려준 돈을 못 받을 때, 상담 전에 한 번에 정리',
  intro: '어떤 돈인지, 증거가 있는지, 상대가 연락되는지 고르면 먼저 확인할 것과 내용증명 → 지급명령 → 소송 순서의 할 일, 근거 조문, 무료 창구를 한 화면에 모아 줘요. 날짜와 금액을 넣으면 법률구조공단 상담이나 법무사 상담에 가져갈 준비서가 만들어지고, 이 브라우저에 저장해 두었다가 이어서 쓸 수 있어요.',
  formulaTitle: '이렇게 정리해요',
  formulas: [
    { title: '판단하지 않아요', body: '이길 수 있는지, 얼마를 받을 수 있는지는 판단하지 않아요. 조문에 적힌 기간과 절차만 보여 주고, 이자와 시효는 이어지는 계산기에서 확인해요.' },
    { title: '시효', body: '내용증명만으로는 시효가 멈추지 않아요. 6개월 안에 지급명령·소송 같은 절차를 밟아야 해요(민법 제174조).' },
    { title: '저장', body: '저장을 누를 때만 이 브라우저에 남아요. 서버로 보내지 않아요.' },
  ],
  howToTitle: '이렇게 써요',
  steps: ['어떤 돈인지, 증거와 상대 상황을 골라요.', '아는 날짜와 금액을 넣어요.', '먼저 확인할 것과 할 일을 읽어요.', '상담 준비서를 복사하거나 인쇄해서 상담에 가져가요.'],
  faqTitle: '자주 묻는 질문',
  faqs: [
    { question: '차용증이 없어도 되나요?', answer: '이체 내역과 문자·카톡도 증거가 될 수 있어요. 다만 빌려준 돈이라는 내용이 함께 있어야 다툼이 줄어요.' },
    { question: '회사에서 못 받은 월급도 여기서 정리하나요?', answer: '월급·퇴직금은 "퇴사·해고·체불 상담 준비서"가 더 맞아요. 고용노동부 진정과 대지급금을 함께 볼 수 있어요.' },
    { question: '저장한 내용은 어디에 있나요?', answer: '이 기기의 이 브라우저에만 있어요. "지우기"로 언제든 지울 수 있어요.' },
  ],
  disclaimer: '일반 정보이며 법률 자문이 아니에요. 개별 사안은 무료 공식 창구나 자격사에 확인하세요.',
};
const sources: [string, string][] = [['국가법령정보센터 민법', 'https://www.law.go.kr/법령/민법'], ['국가법령정보센터 민사소송법', 'https://www.law.go.kr/법령/민사소송법'], ['국가법령정보센터 소액사건심판규칙', 'https://www.law.go.kr/법령/소액사건심판규칙']];
---
<DebtReliefPage slug="unpaid-loan-consult-prep" c={c} sources={sources} sourcesTitle="출처" checked="조문 확인: 2026-11-24">
  <T client:load flow="lend" />
</DebtReliefPage>
