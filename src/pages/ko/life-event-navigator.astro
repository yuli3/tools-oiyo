---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import KrDesk from '../../components/tools/plan/KrDesk';
// 2026-11-23 brainstorm. Data: lib/kr-desks-2026.ts (no calculation; deadlines from statutes, amounts in linked calculators).
const c = {
  introTitle: '이런 일이 생기면 무엇부터 해야 할까?',
  intro: '결혼, 출산, 이사, 집 사기, 교통사고, 이직·퇴사, 은퇴, 가족이 돌아가셨을 때는 신고 기한이 있는 일과 놓치기 쉬운 지원이 한꺼번에 몰려요. 상황을 고르면 할 일을 시간 순서로 보여 주고, 기한에는 근거 법령을 붙였어요. 금액은 이어지는 계산기에서 확인할 수 있어요.',
  formulaTitle: '이렇게 정리했어요',
  formulas: [
    { title: '기한', body: '출생신고 1개월, 전입신고 14일, 퇴직금 지급 14일, 상속포기·한정승인 3개월, 상속세 신고 6개월처럼 법령에 적힌 기한만 적어요.' },
    { title: '이어지는 도구', body: '급여·세금·보험료 같은 금액은 각 계산기에서 계산해요.' },
    { title: '무료 창구', body: '정부24, 복지로 129, 대한법률구조공단 132 같은 공식 창구를 함께 안내해요.' },
  ],
  howToTitle: '이렇게 써요',
  steps: ['무슨 일이 있었는지 적거나 상황을 골라요.', '할 일을 하나씩 체크해요.', '필요한 계산기로 넘어가 금액을 확인해요.'],
  faqTitle: '자주 묻는 질문',
  faqs: [
    { question: '기한을 넘기면 어떻게 되나요?', answer: '신고 종류마다 과태료나 불이익이 달라요. 이어지는 도구나 무료 창구에서 바로 확인하세요.' },
    { question: '체크한 내용이 저장되나요?', answer: '아니요. 이 화면에서만 쓰이고 어디에도 보내지 않아요.' },
  ],
  disclaimer: '일반 정보이며 법률·세무 자문이 아니에요. 개별 사안은 무료 공식 창구나 자격사에 확인하세요.',
};
const sources: [string, string][] = [['국가법령정보센터', 'https://www.law.go.kr/']];
---
<DebtReliefPage slug="life-event-navigator" c={c} sources={sources} sourcesTitle="출처" checked="조문 확인: 2026-11-23">
  <KrDesk client:load kind="event" />
</DebtReliefPage>
