---
// 양도소득세 필요경비 점검 (2026-11-23, 전문가 니즈 조사: "중개수수료 필요경비", "법무사 비용 양도세" 연관검색어). 계산: lib/kr-free-expert-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import NecessaryExpenseCheck from "../../components/tools/office/NecessaryExpenseCheck";

const title = "양도소득세 필요경비 점검 — 중개보수·취득세·인테리어 비용 넣을 수 있나";
const description = "집이나 땅을 팔 때 쓴 비용이 소득세법 시행령 제163조 필요경비 목록에 있는지 골라서 바로 확인해요. 팔 때 소개비, 신고서·계약서 작성비, 명도비, 자본적 지출, 취득세, 국민주택채권 매각차손까지.";
const shell = {
  introTitle: "영수증을 버리기 전에 확인해요",
  intro: "부동산 중개인과 세무 상담에서 자주 나오는 질문이 '이 비용도 빼 주나요?'예요. 양도차익에서 빼는 필요경비는 취득가액, 자본적 지출액, 양도비로 나뉘고, 시행령 제163조가 항목을 적어 두었어요. 이 도구는 쓴 비용을 원문 목록과 맞춰 보고, 원문에 없거나 해석이 필요한 항목은 그렇게 표시해요.",
  howToTitle: "이렇게 써요",
  steps: ["살 때, 가지고 있을 때, 팔 때 쓴 비용을 모두 골라요.", "초록은 원문 목록에 있는 항목, 파랑은 확인이 필요한 항목, 주황은 목록에 없는 항목이에요.", "목록에 있는 항목도 증명서류를 받아 두었거나 계좌이체로 확인돼야 해요."],
  highlightsTitle: "원문 기준",
  highlights: [
    { title: "팔 때 비용(양도비)", body: "공증비용·인지대·소개비, 신고서·계약서 작성비용, 명도비용, 증권거래세(제163조⑤1), 국민주택채권 만기 전 매각차손(⑤2)." },
    { title: "가지고 있을 때 비용", body: "자본적 지출, 용도변경·개량·이용편의 비용, 소유권 소송비용, 개발부담금·재건축부담금(제163조③)." },
    { title: "살 때 비용", body: "매입가액에 취득세·등록면허세 기타 부대비용을 더해요(시행령 제89조①1)." },
  ],
  disclaimer: "원문 목록 대조만 해요. 세액을 계산하거나 개별 영수증을 인정해 주지 않아요. 판단이 갈리는 항목은 국세상담센터 126이나 세무 전문가에게 확인하세요.",
};
const faqs = [
  { q: "도배·장판 비용도 빼 주나요?", a: "제163조③은 자본적 지출과 용도변경·개량·이용편의 비용을 적어요. 현상을 유지하는 수선비는 목록에 없어요." },
  { q: "영수증이 없으면요?", a: "자본적 지출과 양도비는 증명서류를 받아 보관하거나 금융거래 증명으로 지출이 확인되는 경우만 인정돼요." },
  { q: "취득가액을 모르면요?", a: "매매사례가액·감정가액·환산취득가액을 쓰고, 실제 비용 대신 취득 당시 기준시가 × 3% 같은 정해진 금액을 더해요(소득세법 제97조②2)." },
