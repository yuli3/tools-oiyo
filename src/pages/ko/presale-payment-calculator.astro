---
// 분양·건축 묶음 1 (2026-11-02, CHOSEUN "진행"). ko-only: 한국 아파트 분양 대금 구조.
import KrFinancePage from "../../components/KrFinancePage.astro";
import PresalePaymentCalculator from "../../components/tools/PresalePaymentCalculator";
import { presaleSchedule, PRESALE_AS_OF } from "../../lib/kr-presale-2026";

const title = "아파트 분양 대금 계산기 — 계약금·중도금·잔금 일정과 입주 때 필요한 돈";
const description = "분양가와 계약금·중도금·잔금 비율, 중도금 대출 이자 방식(무이자·이자후불제·유이자)을 넣으면 회차별 납부 일정과 입주 때 필요한 돈, 취득세까지 계산해요.";

const eok = (n: number) => `${(n / 100_000_000).toFixed(2).replace(/\.?0+$/, "")}억 원`;
const man = (n: number) => `${Math.round(n / 10_000).toLocaleString("ko-KR")}만 원`;
const ex = presaleSchedule({ price: 600_000_000, depositRate: 0.1, midRate: 0.6, midCount: 6, months: 35, loanShare: 1, loanRate: 0.045, interestMode: "deferred", options: 15_000_000, over85: false });

const ko = {
  eyebrow: "부동산 도구",
  introTitle: "당첨 뒤 3년, 언제 얼마가 필요할까요?",
  intro: `아파트를 분양받으면 분양가를 한 번에 내지 않고 계약금, 중도금, 잔금으로 나눠 내요. 흔한 구조는 계약금 10%, 중도금 60%(보통 6회), 잔금 30%예요. 6억 원짜리 아파트라면 계약 때 ${eok(ex.deposit)}을 현금으로 내고, 중도금 ${eok(ex.midTotal)}은 대부분 집단대출로 내요. 이자후불제라면 금리 4.5%에서 입주 때 ${man(ex.interestTotal)} 정도의 이자를 한 번에 내야 하고, 잔금·옵션·취득세까지 합치면 입주 때 ${eok(ex.moveIn)}이 필요해요. 여기에 중도금 대출 ${eok(ex.loanToRefinance)}은 입주 때 갚거나 잔금대출(주택담보대출)로 바꿔야 해요. 입주자모집공고에 적힌 비율과 회차를 넣어 내 일정을 미리 그려 보세요.`,
  howToTitle: "사용 방법",
  steps: [
    "입주자모집공고의 분양가(옵션 제외)와 계약금·중도금·잔금 비율을 고르세요.",
    "중도금 회차와 계약부터 입주 예정월까지 개월 수를 넣어요.",
    "중도금 대출 이자 방식과 금리, 발코니 확장·옵션 금액을 넣으면 회차별 일정과 입주 자금이 나와요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "회차별 일정표", body: "계약금부터 잔금까지 언제, 얼마를, 현금과 대출로 각각 내는지 표로 보여 줘요." },
    { title: "이자 방식 세 가지", body: "무이자, 이자후불제(입주 때 일괄), 유이자(매달 본인 납부)를 바꿔 가며 비교해요." },
    { title: "입주 자금 한눈에", body: "잔금·옵션·후불 이자·취득세를 합친 입주 자금과, 따로 갚거나 바꿔야 하는 중도금 대출을 나눠 보여 줘요." },
  ],
  relatedTitle: "관련 도구",
  related: [],
  disclaimer: `참고용 추정 계산이에요. 중도금 회차는 계약과 입주 사이에 고르게 나눠 낸다고 가정했고, 이자는 회차별 대출 실행일부터 입주일까지 단리로 계산했어요. 실제 납부일·금리(변동)·보증 수수료·인지세·대출 한도는 입주자모집공고와 대출 약정서를 따라요. 취득세는 1주택 표준세율(분양가+옵션 기준)이에요. 다주택·조정대상지역 중과, 생애최초 감면은 넣지 않았어요. 기준일 ${PRESALE_AS_OF}.`,
};

const faqs = [
  { q: "이자후불제와 무이자는 뭐가 다른가요?", a: "무이자는 중도금 대출 이자를 시행사가 내 줘서 수분양자가 낼 이자가 없어요. 이자후불제는 이자를 미뤄 두었다가 입주(잔금) 때 한 번에 내는 방식이라, 입주 자금이 그만큼 늘어나요. 유이자는 이자를 대출 기간 동안 매달 직접 내요." },
  { q: "중도금 대출은 입주 때 어떻게 되나요?", a: "입주 전까지 중도금 대출을 갚거나 잔금대출(주택담보대출)로 바꿔야 해요. 잔금대출 한도는 그때의 시세·LTV·DSR로 다시 정해지니, 중도금 대출만큼 다 나오지 않을 수 있어요. DSR 계산기로 미리 확인해 보세요." },
  { q: "계약금이 20%면 무엇이 달라지나요?", a: "계약할 때 필요한 현금이 두 배가 되고 잔금 비율이 줄어요. 당첨 직후 짧은 기간에 큰돈이 필요하니 계약금 마련 계획을 먼저 세우세요." },
  { q: "발코니 확장비에도 취득세가 붙나요?", a: "붙어요. 분양 계약과 함께 낸 발코니 확장·유상 옵션 비용은 취득가액에 들어가서 취득세 계산 기준이 커져요. 이 계산기도 분양가에 옵션을 더해 취득세를 계산해요." },
  { q: "분양권을 팔면 세금은요?", a: "분양권 양도는 보유 기간에 따라 1년 미만 70%, 그 이후 60%의 양도소득세율이 적용되고, 전매 제한 기간에는 팔 수 없어요. 이 계산기는 입주까지 보유하는 경우만 계산해요." },
];
---
<KrFinancePage slug="presale-payment-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <PresalePaymentCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 주택공급에 관한 규칙(입주자모집공고의 분양대금 납부 일정), 지방세법 제11조(주택 취득세 표준세율). 기준일 {PRESALE_AS_OF}.</p>
</KrFinancePage>
