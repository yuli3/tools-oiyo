---
// 2026-11-16: 생활 지원금·노동권 도구 모음. Gemini가 만들던 공익 도구를 Claude가 이어받아 정리했어요.
import KrFinancePage from "../../components/KrFinancePage.astro";
import { welfareTools } from "../../data/welfare-tools";
import { WELFARE_AS_OF } from "../../lib/kr-welfare-2026";

const title = "생활 지원금·노동권 도구 모음 — 근로장려금·출산휴가·해고예고·휴업수당·대지급금·산재·통상임금";
const description = "받을 수 있는 돈을 놓치지 않게 돕는 계산기를 모았어요. 근로·자녀장려금, 출산휴가 급여, 체불 대지급금, 산재 휴업급여, 월세 세액공제, 퇴직연금 DB·DC, 통상임금·포괄임금 점검, 종부세·주택임대소득세, 부양가족 공제, 주식 대주주 양도세, 가족 차용·무상 거주·저가 거래 증여, 상가 임대료 5% 상한과 신청 방법, MCP·Claude 스킬까지 있어요.";
const tools = welfareTools.filter((t) => t.slug !== "benefit-rights-toolkit");
const situations = [
  ["소득이 적은데 일하고 있어요", "work-child-incentive-calculator", "근로장려금·자녀장려금은 5월에 신청해요. 3월·9월 반기 신청도 돼요."],
  ["아이가 곧 태어나요", "maternity-leave-pay-calculator", "출산휴가 급여와 배우자 출산휴가, 그다음엔 육아휴직 급여를 확인해요."],
  ["월급·퇴직금을 못 받았어요", "unpaid-wage-guarantee-calculator", "노동청 진정부터 하고, 나라가 먼저 주는 대지급금을 신청해요."],
  ["일하다 다쳤어요", "industrial-accident-leave-pay-calculator", "회사 동의 없이도 근로복지공단에 산재를 신청할 수 있어요."],
  ["월세를 살아요", "monthly-rent-tax-credit-calculator", "연말정산에서 월세의 15~17%를 돌려받아요. 놓쳤으면 5년 안에 경정청구해요."],
  ["퇴직연금을 바꿀지 고민돼요", "retirement-pension-db-dc-calculator", "임금 상승률과 수익률을 비교해 갈림길을 확인해요."],
  ["상여금이 있는데 수당이 적은 것 같아요", "ordinary-wage-calculator", "2024년 12월 판결로 재직 조건 상여도 통상임금이에요. 시급부터 다시 계산해요."],
  ["야근이 많은데 시간외수당은 늘 같아요", "fixed-overtime-pay-checker", "고정 수당이 덮는 시간을 넘게 일했다면 차액을 3년치까지 받을 수 있어요."],
  ["12월 종부세 고지서가 걱정돼요", "comprehensive-real-estate-tax-calculator", "공시가격 합계가 1주택 12억·그 밖 9억 원을 넘는지부터 봐요."],
  ["부모님 돌봄 비용이 걱정돼요", "long-term-care-copay-calculator", "장기요양등급을 받으면 집에서 돌봄은 15%, 요양원은 20%만 내요. 한도와 식사비를 같이 봐요."],
  ["집을 세놓고 월세를 받아요", "housing-rental-income-tax-calculator", "2주택부터 월세에 세금이 붙어요. 5월 신고 전에 분리과세와 종합과세를 비교해요."],
  ["연말정산에 부모님을 올려도 될까요", "dependent-deduction-checker", "부모님은 60세 이상, 소득금액 100만 원(월급만 있으면 500만 원) 이하면 따로 살아도 올릴 수 있어요."],
  ["갑자기 해고 통보를 받았어요", "dismissal-notice-pay-calculator", "30일 전에 듣지 못했다면 30일분 통상임금을 받을 수 있어요. 해고가 부당한지는 3개월 안에 따로 다퉈요."],
  ["회사가 일이 없다며 쉬라고 해요", "shutdown-allowance-calculator", "회사 사정으로 쉬면 평균임금의 70% 이상을 받아야 해요(5명 이상 사업장)."],
  ["아이 때문에 일을 줄이고 싶어요", "reduced-hours-childcare-pay-calculator", "주 15~35시간으로 줄이면 줄어든 월급 일부를 고용보험이 채워 줘요. 처음 10시간분은 100%예요."],
  ["수습이라 최저임금보다 적게 받아요", "probation-minimum-wage-checker", "1년 이상 계약·3개월 안·단순노무 아님일 때만 90%까지 줄일 수 있어요."],
  ["남은 연차를 돈으로 받을 수 있을까요", "annual-leave-promotion-planner", "회사가 사용촉진을 날짜에 맞춰 서면으로 안 했다면 수당을 청구할 수 있어요."],
  ["스스로 그만뒀는데 실업급여를 받을 수 있을까요", "voluntary-quit-unemployment-checker", "임금체불 2개월, 직장 내 괴롭힘, 통근 왕복 3시간 같은 정당한 사유가 있으면 자진퇴사여도 받을 수 있어요."],
  ["원청이 하도급대금을 안 줘요", "subcontract-direct-payment-checker", "2회분 이상 밀렸거나 원청이 파산했으면 요청해서 발주자에게 직접 받을 수 있어요."],
  ["부모님께 돈을 빌려 집을 사요", "family-loan-interest-checker", "무이자면 원금 약 2억 1,700만 원까지는 이자 차이가 증여가 아니에요. 차용증과 상환 기록은 꼭 남겨요."],
  ["부모님 집에 공짜로 살아요", "parent-house-free-use-gift-checker", "집값이 약 13억 2천만 원을 넘고 부모님과 따로 살면 5년치 사용료가 증여로 잡혀요."],
  ["가족에게 집을 싸게 사고팔아요", "family-low-price-sale-checker", "시가와 3억 원(또는 30%) 넘게 차이 나면 증여세, 5% 넘게 차이 나면 파는 사람 양도세가 다시 계산돼요."],
  ["상가 건물주가 월세를 많이 올려 달래요", "commercial-rent-increase-checker", "환산보증금이 지역 기준 이하면 5%까지만, 1년에 한 번만 올릴 수 있어요."],
  ["중소기업에 막 취업했어요", "sme-youth-income-tax-reduction-calculator", "34세 이하(병역 기간 빼고)면 5년 동안 소득세 90%를 덜 내요. 회사에 신청서부터 내요."],
  ["가게를 하는데 종합소득세가 많아요", "yellow-umbrella-deduction-calculator", "노란우산공제에 넣은 돈은 사업소득금액 4천만 원 이하면 600만 원까지 소득에서 빼 줘요."],
  ["창업하는데 간이과세가 나을까요", "general-vs-simplified-vat-calculator", "매출 1억 400만 원 미만이면 간이를 고를 수 있어요. 인테리어 매입이 크면 일반과세 환급이 나을 수 있어요."],
  ["사업용 차를 사거나 리스하려고 해요", "business-car-expense-calculator", "운행기록부가 없으면 1년 1,500만 원까지만 비용이에요. 감가상각은 연 800만 원까지예요."],
  ["미국 주식을 직접 살까, 국내 ETF로 살까", "overseas-stock-vs-etf-tax-calculator", "1년 이익이 약 833만 원보다 적으면 직접 투자, 크면 국내 상장 ETF가 세금이 적어요."],
  ["한 종목에 크게 투자했어요", "stock-major-shareholder-tax-calculator", "작년 말 한 종목을 50억 원 넘게 가졌으면 올해 판 이익에 양도세가 붙어요. 연말 보유를 미리 확인해요."],
];
const more = [
  ["/ko/unemployment-benefits-calculator/", "실업급여 계산기"],
  ["/ko/parental-leave-calculator/", "육아휴직 급여 계산기"],
  ["/ko/benefit-finder/", "생애주기 혜택 찾기"],
  ["/ko/severance-calculator/", "퇴직금 계산기"],
  ["/ko/overtime-pay-calculator/", "연장근로수당 계산기"],
  ["/ko/property-tax-calculator/", "재산세 계산기"],
  ["/ko/copay-cap-refund-calculator/", "본인부담상한제 환급 계산기"],
];
const mcpTools = [
  ["calculate_kr_work_child_incentive", "근로·자녀장려금 예상액"],
  ["calculate_kr_maternity_leave_pay", "출산전후휴가·배우자 출산휴가 급여"],
  ["calculate_kr_wage_guarantee", "간이·도산 대지급금"],
  ["calculate_kr_injury_leave_pay", "산재 휴업급여"],
  ["calculate_kr_monthly_rent_credit", "월세 세액공제"],
  ["compare_kr_retirement_pension", "퇴직연금 DB형 vs DC형"],
  ["calculate_kr_ordinary_wage", "통상임금·연장수당(2024 판결 전후)"],
  ["check_kr_fixed_overtime_pay", "포괄임금 고정 연장수당 부족액"],
  ["calculate_kr_comprehensive_real_estate_tax", "종합부동산세(주택분)"],
  ["calculate_kr_housing_rental_income_tax", "주택임대소득세(분리 vs 종합)"],
  ["calculate_kr_long_term_care_copay", "노인장기요양 본인부담금"],
  ["check_kr_dependent_deduction", "부양가족 기본공제 판정과 줄어드는 세금"],
  ["calculate_kr_stock_major_shareholder_tax", "상장주식 대주주 판정과 양도세"],
  ["calculate_kr_dismissal_notice_pay", "해고예고수당"],
  ["calculate_kr_shutdown_allowance", "휴업수당"],
  ["calculate_kr_reduced_hours_childcare_pay", "육아기 근로시간 단축 급여"],
  ["check_kr_probation_minimum_wage", "수습 최저임금 감액 점검"],
  ["plan_kr_annual_leave_promotion", "연차 사용촉진 일정"],
  ["check_kr_voluntary_quit_unemployment", "자진퇴사 실업급여 정당 사유"],
  ["check_kr_subcontract_direct_payment", "하도급대금 직접 지급·지연이자"],
  ["check_kr_family_loan_interest", "가족 차용 적정이자(4.6%)와 증여"],
  ["check_kr_parent_house_free_use", "부모 집 무상 거주·무상 담보 증여"],
  ["check_kr_family_low_price_sale", "가족 간 저가 양수도 증여·양도세 시가"],
  ["check_kr_commercial_rent_increase", "상가 임대료 5% 상한"],
  ["calculate_kr_sme_youth_tax_reduction", "중소기업 취업 청년 소득세 감면"],
  ["calculate_kr_yellow_umbrella_deduction", "노란우산공제 소득공제 절세액"],
  ["compare_kr_general_vs_simplified_vat", "일반과세 vs 간이과세 부가세"],
  ["calculate_kr_business_car_expense", "업무용 승용차 비용 한도"],
  ["compare_kr_overseas_stock_vs_etf_tax", "해외주식 직접 vs 국내 상장 해외ETF 세금"],
];
const titleOf = (slug: string) => welfareTools.find((t) => t.slug === slug)?.title ?? slug;
---
<KrFinancePage slug="benefit-rights-toolkit" locale="ko" title={title} description={description} koOnly>
  <section>
    <h2 class="text-lg font-bold text-foreground">바로 쓰는 계산기</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">모든 도구는 질문에 답하는 <b>쉬운 설명</b>과 숫자를 직접 넣는 <b>전문가</b> 모드가 있고, 가정을 바꾸면 그래프가 바로 움직여요. 결과 아래에는 어디서·언제 신청하는지 적어 두었어요. 입력은 이 브라우저 안에서만 계산·저장해요.</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {tools.map((t) => (
        <li class="rounded-md border border-border bg-background p-4">
          <a href={`/ko/${t.slug}/`} class="text-base font-semibold text-foreground underline-offset-4 hover:underline">{t.title}</a>
          <p class="mt-1 text-sm leading-6 text-muted-foreground">{t.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">지금 상황에서 무엇부터</h2>
    <dl class="mt-3 space-y-3">
      {situations.map(([s, slug, d]) => (
        <div><dt class="text-sm font-semibold text-foreground">{s} → <a class="underline" href={`/ko/${slug}/`}>{titleOf(slug)}</a></dt><dd class="text-sm leading-6 text-muted-foreground">{d}</dd></div>
      ))}
    </dl>
    <p class="mt-4 text-sm text-muted-foreground">함께 보면 좋아요: {more.map(([href, label], i) => <>{i > 0 && " · "}<a class="underline" href={href}>{label}</a></>)}</p>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">AI 에이전트에서 같은 계산 쓰기 (MCP)</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">Claude·Cursor·ChatGPT 같은 MCP 클라이언트에 아래 주소를 원격 서버로 추가하면 같은 계산을 도구로 불러요. 공식 MCP Registry 이름은 <code>io.github.yuli3/oiyo-calculations</code>예요.</p>
    <pre class="mt-3 overflow-x-auto rounded-md border border-border bg-muted px-3 py-2 text-xs"><code>https://api.oiyo.net/mcp</code></pre>
    <ul class="mt-3 space-y-1 text-sm text-muted-foreground">
      {mcpTools.map(([name, label]) => <li><code class="text-foreground">{name}</code> · {label}</li>)}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">Claude 스킬: 지원금·노동권 길잡이</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">Claude에 올리면 상황을 듣고 받을 수 있는 제도를 고르고, 필요한 정보만 물어 같은 공식으로 계산한 뒤 "얼마·어디서·언제까지"가 있는 안내문을 써 줘요. 사회복지사·노무사·상담센터에서 상담 메모를 만들 때도 쓸 수 있어요.</p>
    <p class="mt-3"><a href="/downloads/oiyo-kr-benefits-navigator-skill.zip" download class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground">스킬 내려받기 (.zip)</a></p>
    <p class="mt-2 text-xs text-muted-foreground">Claude 설정 → 기능 → 스킬에서 zip 파일을 올리거나, Claude Code에서는 압축을 풀어 <code>~/.claude/skills/</code>에 두면 돼요.</p>
  </section>

  <p class="mt-8 text-xs text-muted-foreground">모든 결과는 {WELFARE_AS_OF} 기준 추정이에요. 실제 지급액은 국세청·고용센터·근로복지공단이 정해요. 법률 자문이 아니며, 어려운 사건은 1350(고용노동부), 132(대한법률구조공단)에 무료로 상담하세요.</p>
</KrFinancePage>
