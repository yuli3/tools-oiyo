const faqs = [
  { q: "퇴사했는데 회사가 연말정산을 안 했어요.", a: "퇴직하는 달 급여를 줄 때 정산하는 것이 원칙이에요. 근로소득원천징수영수증을 회사에 요청하고, 다음 해 5월 종합소득세 신고 때 함께 정산하면 돼요." },
  { q: "실업급여도 소득에 들어가나요?", a: "구직급여는 비과세라 총급여에 넣지 않아요." },
