---
// 세무·회계 실무자용 도구 3 (2026-11-14). 엔진: lib/kr-advisory-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import IncorporationConversion from "../../components/tools/advisory/IncorporationConversion";
import { ADVISORY_AS_OF, ACQUISITION_RELIEF_UNTIL } from "../../lib/kr-advisory-2026";

const title = "개인사업자 법인전환 계산기 2026 — 양도세 이월과세·취득세 감면·최소 자본금";
const description = "현물출자나 사업양수도로 법인전환할 때 필요한 최소 자본금, 이월과세로 미루는 양도소득세, 취득세 50% 감면액을 한 번에 계산해요.";

const ko = {
  introTitle: "법인전환할 때 드는 세금과 줄어드는 세금",
  intro: `개인사업자가 사업용 부동산을 가진 채 법인으로 바꾸면 부동산을 법인에 넘기는 순간 양도소득세와 취득세가 생겨요. 현물출자나 사업양수도로 전환하고 새 법인 자본금이 기존 사업장의 순자산가액(시가) 이상이면 양도세는 이월과세로 미루고(조세특례제한법 제32조), 취득세는 ${ACQUISITION_RELIEF_UNTIL} 취득분까지 50% 감면돼요(지방세특례제한법 제57조의2 제4항). 소비성서비스업은 둘 다 안 되고, 부동산임대·공급업은 취득세 감면이 안 돼요.`,
  howToTitle: "사용 방법",
  steps: ["업종을 골라요.", "사업용 부동산 시가·취득가액·보유 기간, 다른 사업용 자산과 부채를 넣어요.", "최소 자본금, 미루는 양도세, 취득세 감면액을 확인해요."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "자본금 요건", body: "순자산가액(시가 자산 − 부채, 영업권 제외) 이상 자본금이 필요해요(시행령 제29조 제5항)." },
    { title: "이월과세 금액", body: "장기보유특별공제(표1)와 기본공제 250만 원을 반영한 양도세·지방소득세를 보여 줘요." },
    { title: "취득세 50% 감면", body: "2025년부터 감면율이 75%에서 50%로 줄었어요. 감면분의 20%는 농어촌특별세로 내요." },
  ],
  disclaimer: `실무 검토용 추정이에요. 영업권 대가(기타소득·양도소득), 부가가치세(포괄양수도), 과밀억제권역 취득세 중과, 지방교육세·농특세 10%, 감정평가·등기 비용은 넣지 않았어요. 5년 사후관리 위반 시 이월과세액과 감면 취득세가 추징돼요. 기준일 ${ADVISORY_AS_OF}.`,
};

const faqs = [
  { q: "이월과세는 세금이 없어지는 건가요?", a: "아니에요. 개인이 낼 양도소득세를 법인이 나중에 그 자산을 팔 때 법인세로 내도록 미루는 제도예요. 법인이 계속 보유하면 납부 시점이 계속 뒤로 밀려요." },
  { q: "자본금은 얼마 이상이어야 하나요?", a: "법인전환일 현재 시가로 평가한 사업장 자산에서 부채를 뺀 순자산가액 이상이어야 해요. 사업양수도 방식이면 기존 사업자가 발기인이 되어 순자산가액 이상을 출자해 법인을 세우고, 설립일부터 3개월 안에 사업의 모든 권리·의무를 법인에 포괄 양도해야 해요(시행령 제29조 제2항)." },
  { q: "주택도 이월과세가 되나요?", a: "안 돼요. 2021년부터 주택과 주택을 취득할 수 있는 권리는 이월과세 대상에서 빠졌어요(조세특례제한법 제32조 제1항)." },
  { q: "5년 안에 주식을 팔면요?", a: "법인 설립등기일부터 5년 안에 사업을 폐지하거나 전환으로 받은 주식의 50% 이상을 처분하면, 미뤄 둔 양도세를 그 달 말일부터 2개월 안에 개인이 내야 해요(제32조 제5항)." },
];
---
<KrFinancePage slug="incorporation-conversion-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <IncorporationConversion client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 조세특례제한법 제32조, 시행령 제29조, 소득세법 제95조·제103조·제104조, 지방세특례제한법 제57조의2 제4항, 농어촌특별세법 제5조 제1항 제1호. 기준일 {ADVISORY_AS_OF}. <a class="underline" href="/ko/tax-advisor-toolkit/">세무·회계 실무 도구 모음</a></p>
</KrFinancePage>
