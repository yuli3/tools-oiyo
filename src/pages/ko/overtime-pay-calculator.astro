---
// 2026-11-16: 쉬운 설명/전문가 모드와 가정 그래프로 다시 만들었어요. 공식은 통상임금·포괄임금 도구와 같은
// premiumPay(lib/kr-welfare-2026.ts) 하나예요(예전 페이지 안 스크립트의 같은 공식은 지웠어요).
import KrFinancePage from "../../components/KrFinancePage.astro";
import OvertimePay from "../../components/tools/welfare/OvertimePay";
import { KR_RATES_2026 } from "../../lib/kr-rates-2026.mjs";

const MIN_WAGE = KR_RATES_2026.minimumWage;
const title = "연장·야간·휴일수당 가산수당 계산기";
const description = "근로기준법 제56조에 따른 연장근로(1.5배), 야간근로(0.5배 가산), 휴일근로(8시간 이내 1.5배 / 8시간 초과 2.0배) 가산수당을 계산하고, 시간과 시급을 바꾸면 수당이 어떻게 바뀌는지 그래프로 보여 줘요.";
const ko = {
  introTitle: "시급과 일한 시간만 있으면 돼요",
  intro: "직원 5명 이상 회사에서 연장근로는 시급의 1.5배, 밤 10시~아침 6시 근로는 0.5배를 더, 휴일근로는 8시간까지 1.5배·넘는 시간은 2배를 받아요. 5명 미만 회사는 가산 없이 일한 시간만큼 받아요.",
  howToTitle: "사용 방법",
  steps: ["시급(시간급 통상임금)을 넣어요. 상여금·고정수당이 있으면 통상임금 계산기로 먼저 구해요.", "한 달 연장·야간·휴일근로 시간을 넣어요.", "시간과 시급을 바꿔 보며 수당이 어떻게 바뀌는지 그래프로 봐요."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "근로기준법 제56조 가산율", body: "연장 1.5배, 야간 0.5배 가산, 휴일 8시간 이내 1.5배·초과 2배." },
    { title: "5인 미만 비교", body: "같은 시간을 일했을 때 5인 이상과 5인 미만 회사의 차이를 나란히 보여 줘요." },
    { title: "통상임금·포괄임금과 같은 공식", body: "통상임금 계산기, 포괄임금 점검과 한 엔진을 써서 결과가 서로 맞아요." },
    { title: "API·MCP", body: "AI 에이전트나 급여 프로그램에서 api.oiyo.net으로 같은 공식을 불러 쓸 수 있어요(아래 주소)." },
  ],
  disclaimer: "추정이에요. 연장근로와 야간근로가 겹치면 두 가산을 모두 받아요(연장 1.5배 + 야간 0.5배). 감시·단속적 근로처럼 근로시간 규정이 적용되지 않는 일은 다를 수 있어요.",
};
const faqs = [
  { q: "연장과 야간이 겹치면 어떻게 되나요?", a: "둘 다 받아요. 밤 10시 이후 연장근로 1시간은 연장 1.5배에 야간 0.5배를 더해 시급의 2배예요. 겹친 시간은 연장과 야간 칸에 모두 넣으세요." },
  { q: "시급은 기본급 ÷ 209로 하면 되나요?", a: "매달 고정으로 받는 수당과 정기상여금(재직 조건이 있어도)도 통상임금이라 시급이 더 높아요. 통상임금 계산기로 구하는 게 정확해요." },
  { q: "5인 미만 회사도 연장수당을 주나요?", a: "가산(50%)은 없지만 일한 시간만큼의 임금은 줘야 해요." },
  { q: "덜 받은 수당은 언제까지 청구하나요?", a: "임금은 3년이 지나면 청구할 수 없어요. 고용노동부 노동포털에 진정을 내거나 1350으로 상담하세요." },
];
---
<KrFinancePage slug="overtime-pay-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <OvertimePay client:load />
  <code class="mt-4 block break-all rounded-md border border-border bg-muted px-3 py-2 font-mono text-xs text-foreground">GET https://api.oiyo.net/v1/labor/kr/overtime-pay?hourlyWage={MIN_WAGE}&amp;overtimeHours=10&amp;nightHours=5</code>
  <p class="mt-4 text-xs text-muted-foreground">근거: 근로기준법 제56조·제11조. <a class="underline" href="/ko/ordinary-wage-calculator/">통상임금 계산기</a> · <a class="underline" href="/ko/fixed-overtime-pay-checker/">포괄임금 고정 연장수당 점검</a> · <a class="underline" href="/ko/benefit-rights-toolkit/">생활 지원금·노동권 도구 모음</a></p>
</KrFinancePage>
