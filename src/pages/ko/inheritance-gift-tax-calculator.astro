---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import RatesAsOf from "../../components/RatesAsOf.astro";
// 2026-10-17: 세율·공제·할증 값은 SSOT(src/lib/kr-rates-2026.mjs, api와 바이트 동일)에서만 읽어요.
import { KR_RATES_2026 } from "../../lib/kr-rates-2026.mjs";

const G = KR_RATES_2026.inheritanceGift;
const manwon = (won: number) => {
  const eok = Math.floor(won / 100_000_000);
  const man = Math.floor((won % 100_000_000) / 10_000);
  return `${eok ? `${eok}억 ` : ""}${man ? `${man.toLocaleString("ko-KR")}만 ` : ""}원`.replace(/^ 원$/, "0원");
};
const pctText = (rate: number) => `${Math.round(rate * 100)}%`;
const bracketRows = G.brackets.map(([upper, rate, progressive], i) => {
  const lower = i === 0 ? 0 : G.brackets[i - 1][0];
  const range = upper === Infinity ? `${manwon(lower)} 초과` : i === 0 ? `${manwon(upper)} 이하` : `${manwon(lower)} 초과 ~ ${manwon(upper)} 이하`;
  return { range, rate: pctText(rate), progressive: progressive ? manwon(progressive) : "0원" };
});
---

<Layout
  title="2026 상속세 & 증여세 모의 계산기 — 과세표준 누진세율 및 공제 시뮬레이션"
  description="2026년 상속세 및 증여세법 기준 배우자·자녀 공제, 혼인·출산 증여공제, 5단계 누진세율(10~50%), 세대생략 할증, 신고세액공제(3%)로 상속세와 증여세를 모의 계산해요."
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
        2026 상속세 & 증여세 모의 계산기
      </h1>
      <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
        재산가액, 관계별 공제 한도, 5단계 누진세율, 신고세액공제(3%)로 낼 세금을 바로 계산해요. 10년 안에 받은 다른 증여와 재산 평가는 넣지 않은 모의 계산이에요.
      </p>
      <RatesAsOf note="2024·2025년 정부가 낸 최고세율 40%·자녀공제 5억 원 개정안은 국회를 통과하지 않아 2026년에도 10~50% 세율이 그대로예요." sources="상속세 및 증여세법 제19·21·26·27·53·53조의2·57·69조(2026-01-02 시행), 국세청 증여세 개요" />
    </div>

    <!-- Mode Selector Tab -->
    <div class="mb-6 flex rounded-xl border border-border bg-muted/30 p-1">
      <button
        type="button"
        id="btn-mode-gift"
        class="flex-1 rounded-lg py-3 text-sm font-bold transition-all bg-card text-foreground shadow-xs"
      >
        증여세 계산 (생전 증여)
      </button>
      <button
        type="button"
        id="btn-mode-inheritance"
        class="flex-1 rounded-lg py-3 text-sm font-medium text-muted-foreground transition-all hover:text-foreground"
      >
        상속세 계산 (사후 상속)
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-xs space-y-5">
        <div>
          <label for="asset-value" class="block text-xs font-bold text-foreground">
            재산가액 (원)
          </label>
          <div class="mt-2 relative">
            <input
              type="number"
              id="asset-value"
              value="500000000"
              step="10000000"
              min="0"
              class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
            />
            <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
          </div>
          <p id="asset-value-ko" class="mt-1 text-xs text-muted-foreground">5억 원</p>
        </div>

        <div>
          <label for="debt-value" class="block text-xs font-bold text-foreground">
            채무 및 부담부 금액 (원)
          </label>
          <div class="mt-2 relative">
            <input
              type="number"
              id="debt-value"
              value="0"
              step="5000000"
              min="0"
              class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
            />
            <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
          </div>
          <p class="mt-1 text-xs text-muted-foreground">전세보증금이나 담보대출 등 수증인/상속인이 승계하는 채무액</p>
        </div>

        <!-- Gift Specific: Relationship -->
        <div id="gift-relation-section">
          <label for="gift-relation" class="block text-xs font-bold text-foreground">
            수증자(받는 사람)와의 관계
          </label>
          <select
            id="gift-relation"
            class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
          >
            <option value="spouse" selected>배우자에게서 받음 (10년 {manwon(G.giftDeductions.spouse)} 공제)</option>
            <option value="child_adult">성년 자녀·손자녀가 부모·조부모에게서 받음 (10년 {manwon(G.giftDeductions.child_adult)})</option>
            <option value="child_minor">미성년 자녀·손자녀가 받음 (10년 {manwon(G.giftDeductions.child_minor)})</option>
            <option value="parent">부모가 자녀에게서 받음 (10년 {manwon(G.giftDeductions.parent)})</option>
            <option value="other_relative">기타 친족(6촌 혈족·4촌 인척, 10년 {manwon(G.giftDeductions.other_relative)})</option>
            <option value="other">타인 (공제 0원)</option>
          </select>
          <div id="marriage-birth-row" class="mt-3 flex items-start gap-3">
            <input type="checkbox" id="marriage-birth" class="mt-0.5 h-4 w-4 rounded border-input text-primary focus:ring-primary" />
            <label for="marriage-birth" class="text-xs text-foreground cursor-pointer">
              혼인·출산 증여공제 {manwon(G.marriageBirthDeduction)} 함께 적용 (부모·조부모에게서 혼인신고 전후 2년 또는 출생 2년 안에 받은 경우, 평생 합산 한도)
            </label>
          </div>
        </div>

        <!-- Inheritance Specific: Deductions -->
        <div id="inheritance-deduction-section" class="hidden space-y-4">
          <div>
            <label class="block text-xs font-bold text-foreground">배우자 상속 여부</label>
            <div class="mt-2 grid grid-cols-2 gap-3">
              <button
                type="button"
                id="btn-spouse-yes"
                class="rounded-lg border border-primary bg-primary/10 py-3 text-xs font-bold text-primary transition-all text-center"
              >
                배우자 있음 (최소 {manwon(G.spouseInheritanceMin)} 공제)
              </button>
              <button
                type="button"
                id="btn-spouse-no"
                class="rounded-lg border border-border bg-background py-3 text-xs font-medium text-muted-foreground transition-all hover:bg-muted/50 text-center"
              >
                배우자 없음 (0원)
              </button>
            </div>
          </div>
          <div class="rounded-lg bg-muted/40 p-3 text-xs text-muted-foreground leading-relaxed">
            일괄공제 {manwon(G.inheritanceLumpSum)}과 배우자상속공제(법정상속분 안에서 최소 {manwon(G.spouseInheritanceMin)}~최대 {manwon(G.spouseInheritanceMax)})를 넣어요. 이 계산기는 배우자공제를 최소액으로 잡아서, 배우자와 자녀가 함께 상속받으면 10억 원까지는 상속세가 없다고 보여 줘요. 금융재산·동거주택 공제는 넣지 않았어요.
          </div>
        </div>

        <!-- Generation Skip Checkbox -->
        <div class="flex items-center gap-3 pt-2">
          <input
            type="checkbox"
            id="generation-skip"
            class="h-4 w-4 rounded border-input text-primary focus:ring-primary"
          />
          <label for="generation-skip" class="text-xs font-semibold text-foreground cursor-pointer">
            세대생략 증여·상속 (손자녀에게 바로 넘기면 {pctText(G.generationSkipSurcharge)} 할증, 미성년자가 20억 원 넘게 받으면 {pctText(G.generationSkipSurchargeMinorLarge)})
          </label>
        </div>

        <!-- Report Credit Checkbox -->
        <div class="flex items-center gap-3">
          <input
            type="checkbox"
            id="report-credit"
            checked
            class="h-4 w-4 rounded border-input text-primary focus:ring-primary"
          />
          <label for="report-credit" class="text-xs font-semibold text-foreground cursor-pointer">
            신고기한 안에 신고 ({pctText(G.filingCredit)} 신고세액공제)
          </label>
        </div>
      </div>

      <!-- Result Panel -->
      <div class="lg:col-span-6 space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs">
          <p id="res-badge" class="text-xs font-bold text-primary mb-1">
            증여세 모의 산출 결과
          </p>
          <div class="flex items-baseline justify-between mt-2 border-b border-border pb-4">
            <span class="text-xs text-muted-foreground">최종 납부 예상세액</span>
            <span id="res-final-tax" class="text-2xl sm:text-3xl font-black text-foreground font-mono">0원</span>
          </div>

          <div class="mt-4 space-y-2.5 text-xs">
            <div class="flex justify-between text-muted-foreground">
              <span>과세가액 (재산 - 채무)</span>
              <span id="res-tax-base-value" class="font-mono text-foreground">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>인적·재산 공제 합계</span>
              <span id="res-deduction-value" class="font-mono text-foreground text-primary">-0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>과세표준</span>
              <span id="res-taxable-base" class="font-mono text-foreground font-semibold">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>적용 한계세율 / 누진공제</span>
              <span id="res-bracket-info" class="font-mono text-foreground">0% (0원)</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>산출세액</span>
              <span id="res-calculated-tax" class="font-mono text-foreground">0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span id="res-skip-label">세대생략 할증액</span>
              <span id="res-skip-surcharge" class="font-mono text-foreground">+0원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>신고세액공제 ({pctText(G.filingCredit)})</span>
              <span id="res-report-credit-val" class="font-mono text-foreground text-primary">-0원</span>
            </div>
          </div>
        </div>

        <!-- 2026 Tax Brackets Table -->
        <div class="rounded-2xl border border-border bg-card p-5 text-xs space-y-3">
          <p class="font-bold text-foreground text-sm">2026년 상속·증여세 법정 세율표</p>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-muted-foreground">
              <thead>
                <tr class="border-b border-border text-foreground font-bold">
                  <th class="py-1.5 pr-2">과세표준 구간</th>
                  <th class="py-1.5 px-2">세율</th>
                  <th class="py-1.5 pl-2 text-right">누진공제액</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-border/50">
                {bracketRows.map((row) => (
                  <tr>
                    <td class="py-1.5 pr-2">{row.range}</td>
                    <td class="py-1.5 px-2 font-mono">{row.rate}</td>
                    <td class="py-1.5 pl-2 text-right font-mono">{row.progressive}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <RelatedTools currentId="inheritance-gift" />
  </div>

  <script>
    import { inheritanceGiftTax2026 } from "../../lib/kr-rates-2026.mjs";

    let mode: "gift" | "inheritance" = "gift";
    let hasSpouse = true;

    const btnModeGift = document.getElementById("btn-mode-gift")!;
    const btnModeInheritance = document.getElementById("btn-mode-inheritance")!;
    const giftSection = document.getElementById("gift-relation-section")!;
    const inheritanceSection = document.getElementById("inheritance-deduction-section")!;

    const assetInput = document.getElementById("asset-value") as HTMLInputElement;
    const debtInput = document.getElementById("debt-value") as HTMLInputElement;
    const relationSelect = document.getElementById("gift-relation") as HTMLSelectElement;
    const skipCheckbox = document.getElementById("generation-skip") as HTMLInputElement;
    const reportCreditCheckbox = document.getElementById("report-credit") as HTMLInputElement;
    const marriageBirthCheckbox = document.getElementById("marriage-birth") as HTMLInputElement;
    const marriageBirthRow = document.getElementById("marriage-birth-row")!;
    const resSkipLabel = document.getElementById("res-skip-label")!;

    const btnSpouseYes = document.getElementById("btn-spouse-yes")!;
    const btnSpouseNo = document.getElementById("btn-spouse-no")!;

    const assetKoDisplay = document.getElementById("asset-value-ko")!;
    const resBadge = document.getElementById("res-badge")!;
    const resFinalTax = document.getElementById("res-final-tax")!;
    const resTaxBaseValue = document.getElementById("res-tax-base-value")!;
    const resDeductionValue = document.getElementById("res-deduction-value")!;
    const resTaxableBase = document.getElementById("res-taxable-base")!;
    const resBracketInfo = document.getElementById("res-bracket-info")!;
    const resCalculatedTax = document.getElementById("res-calculated-tax")!;
    const resSkipSurcharge = document.getElementById("res-skip-surcharge")!;
    const resReportCreditVal = document.getElementById("res-report-credit-val")!;

    function formatKRW(val: number): string {
      return Math.round(val).toLocaleString("ko-KR") + "원";
    }

    function formatKoreanUnits(num: number): string {
      if (num <= 0) return "0원";
      const eok = Math.floor(num / 100000000);
      const man = Math.floor((num % 100000000) / 10000);
      let res = "";
      if (eok > 0) res += `${eok}억 `;
      if (man > 0) res += `${man.toLocaleString("ko-KR")}만 `;
      return res.trim() + "원";
    }

    function calculate() {
      const asset = Math.max(0, parseFloat(assetInput.value) || 0);
      const debt = Math.max(0, parseFloat(debtInput.value) || 0);
      assetKoDisplay.textContent = formatKoreanUnits(asset);

      const relation = relationSelect.value;
      const canUseMarriageBirth = relation === "child_adult" || relation === "child_minor";
      marriageBirthRow.classList.toggle("hidden", !canUseMarriageBirth);

      // 2026-10-17: 공제·세율·할증·신고세액공제는 SSOT 함수 하나로 계산해요(api /v1/tax/inheritance-gift와 같은 식).
      const r = inheritanceGiftTax2026({
        mode,
        assetValue: asset,
        debtValue: debt,
        relationship: relation,
        marriageBirthDeduction: canUseMarriageBirth && marriageBirthCheckbox.checked ? Infinity : 0,
        hasSpouse,
        isGenerationSkipping: skipCheckbox.checked,
        hasVoluntaryReporting: reportCreditCheckbox.checked,
      });
      const netValue = r.netAssetValue;
      const taxableBase = r.taxableBase;
      const calculatedTax = r.calculatedTax;
      const surcharge = r.generationSkipSurcharge;
      const reportCredit = r.voluntaryReportCredit;
      const finalTax = r.finalTax;

      resBadge.textContent = mode === "gift" ? "증여세 모의 산출 결과" : "상속세 모의 산출 결과";
      resFinalTax.textContent = formatKRW(finalTax);
      resTaxBaseValue.textContent = formatKRW(netValue);
      resDeductionValue.textContent = `-${formatKRW(r.deductionAmount)}`;
      resTaxableBase.textContent = formatKRW(taxableBase);
      resBracketInfo.textContent = `${Math.round(r.bracketRate * 100)}% (-${formatKRW(r.progressiveDeduction)})`;
      resSkipLabel.textContent = r.generationSkipSurchargeRate ? `세대생략 할증액 (${Math.round(r.generationSkipSurchargeRate * 100)}%)` : "세대생략 할증액";
      resCalculatedTax.textContent = formatKRW(calculatedTax);
      resSkipSurcharge.textContent = `+${formatKRW(surcharge)}`;
      resReportCreditVal.textContent = `-${formatKRW(reportCredit)}`;
    }

    btnModeGift.addEventListener("click", () => {
      mode = "gift";
      btnModeGift.classList.add("bg-card", "text-foreground", "font-bold", "shadow-xs");
      btnModeGift.classList.remove("text-muted-foreground", "font-medium");
      btnModeInheritance.classList.remove("bg-card", "text-foreground", "font-bold", "shadow-xs");
      btnModeInheritance.classList.add("text-muted-foreground", "font-medium");
      giftSection.classList.remove("hidden");
      inheritanceSection.classList.add("hidden");
      calculate();
    });

    btnModeInheritance.addEventListener("click", () => {
      mode = "inheritance";
      btnModeInheritance.classList.add("bg-card", "text-foreground", "font-bold", "shadow-xs");
      btnModeInheritance.classList.remove("text-muted-foreground", "font-medium");
      btnModeGift.classList.remove("bg-card", "text-foreground", "font-bold", "shadow-xs");
      btnModeGift.classList.add("text-muted-foreground", "font-medium");
      inheritanceSection.classList.remove("hidden");
      giftSection.classList.add("hidden");
      calculate();
    });

    btnSpouseYes.addEventListener("click", () => {
      hasSpouse = true;
      btnSpouseYes.classList.add("border-primary", "bg-primary/10", "text-primary", "font-bold");
      btnSpouseYes.classList.remove("border-border", "bg-background", "text-muted-foreground", "font-medium");
      btnSpouseNo.classList.remove("border-primary", "bg-primary/10", "text-primary", "font-bold");
      btnSpouseNo.classList.add("border-border", "bg-background", "text-muted-foreground", "font-medium");
      calculate();
    });

    btnSpouseNo.addEventListener("click", () => {
      hasSpouse = false;
      btnSpouseNo.classList.add("border-primary", "bg-primary/10", "text-primary", "font-bold");
      btnSpouseNo.classList.remove("border-border", "bg-background", "text-muted-foreground", "font-medium");
      btnSpouseYes.classList.remove("border-primary", "bg-primary/10", "text-primary", "font-bold");
      btnSpouseYes.classList.add("border-border", "bg-background", "text-muted-foreground", "font-medium");
      calculate();
    });

    [assetInput, debtInput, relationSelect, skipCheckbox, reportCreditCheckbox, marriageBirthCheckbox].forEach((el) => {
      el.addEventListener("input", calculate);
      el.addEventListener("change", calculate);
    });

    calculate();
  </script>
</Layout>
