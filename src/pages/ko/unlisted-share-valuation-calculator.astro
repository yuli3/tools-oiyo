---
// 세무·회계 실무자용 도구 1 (2026-11-14). 엔진: lib/kr-advisory-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import UnlistedShareValuation from "../../components/tools/advisory/UnlistedShareValuation";
import { ADVISORY_AS_OF } from "../../lib/kr-advisory-2026";

const title = "비상장주식 평가 계산기 2026 — 상증법 보충적 평가(순손익 3 : 순자산 2)";
const description = "최근 3년 순손익액과 순자산가액으로 상속세 및 증여세법 보충적 평가액을 계산해요. 부동산과다법인 2:3, 순자산가치 80% 하한, 최대주주 할증 20%를 반영해요.";

const ko = {
  introTitle: "시가가 없는 비상장주식은 이렇게 평가해요",
  intro: "상속·증여 때 비상장주식은 먼저 시가(매매사례가액·감정가액 등)를 찾고, 없으면 보충적 평가를 써요. 1주당 순손익가치(최근 3년 순손익을 3·2·1로 가중평균한 뒤 10%로 나눈 값)와 순자산가치를 3 : 2로 가중평균하고, 부동산 등이 자산의 50% 이상이면 2 : 3으로 바꿔요. 결과가 순자산가치의 80%보다 낮으면 80%를 써요. 최대주주 등의 주식은 20% 할증하지만 중소기업과 매출 5천억 원 미만 중견기업은 빠져요.",
  howToTitle: "사용 방법",
  steps: ["발행주식총수와 평가할 보유 주식 수를 넣어요.", "최근 3개 사업연도 순손익액과 평가기준일 순자산가액을 넣어요.", "부동산 등 비율, 순자산가치만 평가하는 사유, 최대주주 할증 여부를 골라요."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "가중치 자동 판정", body: "부동산 등 비율 50% 이상이면 2 : 3, 80% 이상이면 순자산가치만 적용해요(시행령 제54조)." },
    { title: "하한과 음수 처리", body: "가중평균 순손익이 음수면 0으로 보고, 순자산가치 80% 하한을 적용해요(시행령 제54조·제56조)." },
    { title: "최대주주 할증", body: "할증 20%와 제외 대상(중소·중견기업, 3년 연속 결손 등)을 한 번에 반영해요(법 제63조 제3항, 시행령 제53조)." },
  ],
  disclaimer: `실무 검토용 추정이에요. 순손익액(각 사업연도 소득 ± 세무조정)과 순자산가액(시가 평가·영업권)은 직접 산정해 넣어야 해요. 추정이익 평가, 증자·감자 환산, 평가심의위원회 심의는 반영하지 않았어요. 2024·2026 세법개정안의 할증 폐지는 국회를 통과하지 않아 반영하지 않았어요. 기준일 ${ADVISORY_AS_OF}.`,
};

const faqs = [
  { q: "순손익가치환원율 10%는 바뀌나요?", a: "기획재정부령(시행규칙 제17조)으로 정하며 2026년 현재 10%예요." },
  { q: "순자산가치만으로 평가하는 경우는요?", a: "사업개시 전이거나 개시 후 3년 미만인 법인, 휴·폐업·청산 중인 법인, 자산 중 부동산 등 또는 주식 등 비율이 80% 이상인 법인, 정관상 존속기한이 3년 이내인 법인 등이에요(시행령 제54조 제4항)." },
  { q: "최대주주 할증은 폐지됐나요?", a: "아니에요. 2024년 세법개정안과 2026년 국회 발의안에 폐지가 들어 있었지만 2026년 11월 현재 법률은 그대로예요. 중소기업과 직전 3년 평균 매출 5천억 원 미만 중견기업은 이미 할증에서 빠져요." },
  { q: "DCF로 평가하면 안 되나요?", a: "세법은 보충적 평가가 원칙이에요. 보충적 평가가 불합리하면 납세자가 평가심의위원회에 현금흐름할인법 등으로 심의를 신청할 수 있어요(시행령 제54조 제6항)." },
];
---
<KrFinancePage slug="unlisted-share-valuation-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <UnlistedShareValuation client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 상속세 및 증여세법 제60조·제63조 제1항 제1호 나목·제3항, 시행령 제53조 제6항~제8항·제54조·제56조·제59조, 시행규칙 제17조. 기준일 {ADVISORY_AS_OF}. <a class="underline" href="/ko/tax-advisor-toolkit/">세무·회계 실무 도구 모음</a></p>
</KrFinancePage>
