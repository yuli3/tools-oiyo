---
// 생활 지원금·노동권 도구 (2026-11-16). 엔진: lib/kr-welfare-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import WageGuarantee from "../../components/tools/welfare/WageGuarantee";
import { WELFARE_AS_OF } from "../../lib/kr-welfare-2026";

const title = "체불임금 대지급금 계산기 2026 — 간이·도산 대지급금 상한과 6개월 확대 반영";
const description = "월급·퇴직금을 못 받았을 때 근로복지공단이 먼저 주는 대지급금을 계산해요. 간이(임금 700만·퇴직금 700만·합계 1,000만 원)와 도산(나이별 월 상한, 2026-08-20부터 6개월분)을 비교해요.";
const ko = {"introTitle": "회사가 월급을 안 줄 때, 나라가 먼저 주는 돈", "intro": "대지급금은 회사가 주지 못한 임금과 퇴직금을 근로복지공단이 먼저 주고, 나중에 회사에서 받아 가는 제도예요. 회사가 그대로 있으면 간이대지급금(퇴직자 최대 1,000만 원), 회사가 망하거나 문을 닫았으면 도산대지급금(나이별 월 상한)을 받아요. 2026년 8월 20일부터 도산대지급금은 마지막 3개월이 아니라 6개월분 임금까지 받아요.", "howToTitle": "사용 방법", "steps": ["지금 상황(퇴직·도산·재직)을 골라요.", "한 달 월급, 못 받은 달 수, 그만둘 때 나이, 못 받은 퇴직금을 넣어요.", "나라가 먼저 주는 몫과 남는 체불, 간이·도산 중 무엇이 큰지 그래프로 봐요."], "highlightsTitle": "주요 특징", "highlights": [{"title": "2026-08-20 개정 반영", "body": "도산대지급금 임금 6개월분, 최대 3,150만 원(40대)."}, {"title": "나이별 월 상한", "body": "30세 미만 220만, 30대 310만, 40대 350만, 50대 330만, 60세 이상 230만 원."}, {"title": "간이·도산 비교", "body": "같은 체불로 두 제도를 나란히 비교해 어느 쪽이 유리한지 보여 줘요."}, {"title": "남는 체불 안내", "body": "대지급금 밖의 몫은 민사소송·강제집행으로 받아야 한다는 점과 무료 법률구조를 알려 줘요."}], "disclaimer": "2026년 11월 기준 추정이에요. 휴업수당·출산휴가 급여의 상한, 재직자 간이대지급금의 소득 요건 등 세부 조건은 근로복지공단이 확인해요. 체불 금액은 노동청 확인서·판결 금액이 기준이에요."};
const faqs = [{"q": "간이대지급금은 어떻게 받나요?", "a": "노동청에 진정 → 체불임금등·사업주 확인서 발급 → 법원 지급명령·소송 등 → 판결 확정 뒤 근로복지공단에 신청해요. 퇴직 다음 날부터 2년 안에 소송 등을 시작해야 해요."}, {"q": "도산 인정은 무엇인가요?", "a": "법원의 회생개시·파산선고가 없어도, 상시 300명 이하 사업장이 사업을 그만두고 임금을 줄 능력이 없으면 노동청이 도산을 인정할 수 있어요."}, {"q": "6개월 확대는 언제부터인가요?", "a": "회생개시·파산선고·도산등사실인정이 2026년 8월 20일 이후인 경우부터예요. 그 전이면 3개월분이에요."}, {"q": "대지급금을 받으면 회사 책임이 없어지나요?", "a": "아니요. 근로복지공단이 그 금액만큼 회사에 대신 청구하고, 남은 체불은 근로자가 계속 청구할 수 있어요."}];
---
<KrFinancePage slug="unpaid-wage-guarantee-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <WageGuarantee client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 임금채권보장법 제7조·제7조의2, 시행령 제7조·제9조, 고용노동부 대지급금 상한액 고시(2026-08-20 개정). 기준일 {WELFARE_AS_OF}. <a class="underline" href="/ko/benefit-rights-toolkit/">생활 지원금·노동권 도구 모음</a></p>
</KrFinancePage>
