---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="부동산 평수 ↔ ㎡ 면적 변환기 (아파트 평형 계산기)"
  description="계량에 관한 법률 기준 1평(3.305785㎡) 및 1㎡(0.3025평) 양방향 정밀 환산. 59㎡·84㎡·114㎡ 아파트 전용/공급면적 인기 평형 칩을 제공합니다."
>
  <div class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
        계량에 관한 법률 법정 단위 공식 (1평 = 400/121 ㎡)
      </div>
      <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
        부동산 평수 ↔ ㎡ 면적 변환기
      </h1>
      <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
        아파트 분양 및 부동산 매매 시 자주 쓰이는 제곱미터(㎡)와 평(坪)을 오차 없이 양방향으로 즉시 환산합니다. (전용 59㎡, 84㎡ 국민평형 조견표 포함)
      </p>
    </div>

    <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
      <!-- 변환 방향 선택 -->
      <div>
        <label class="block text-xs font-bold text-foreground">변환 방향</label>
        <div class="mt-2 grid grid-cols-2 gap-2">
          <button
            type="button"
            id="btn-mode-pyeong"
            class="mode-btn rounded-lg border border-primary bg-primary/10 px-4 py-2.5 text-xs font-bold text-primary transition-colors"
            data-mode="pyeong-to-m2"
          >
            평(坪) → 제곱미터(㎡)
          </button>
          <button
            type="button"
            id="btn-mode-m2"
            class="mode-btn rounded-lg border border-border bg-background px-4 py-2.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted"
            data-mode="m2-to-pyeong"
          >
            제곱미터(㎡) → 평(坪)
          </button>
        </div>
      </div>

      <!-- 면적 수치 입력 -->
      <div>
        <div class="flex items-center justify-between">
          <label id="input-label" for="area-input" class="block text-xs font-bold text-foreground">
            면적 입력 (평)
          </label>
          <span id="unit-badge" class="font-mono text-xs text-muted-foreground">평 (坪)</span>
        </div>
        <div class="mt-2 relative">
          <input
            type="number"
            id="area-input"
            value="32"
            step="0.1"
            min="0"
            class="w-full rounded-lg border border-input bg-background px-4 py-3 text-lg font-bold font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
          />
        </div>
      </div>

      <!-- 인기 평형 & 규격 칩 -->
      <div>
        <span class="block text-xs font-semibold text-muted-foreground mb-2">자주 찾는 아파트 평형 빠른 선택:</span>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="10" data-mode="pyeong-to-m2">10평 (원룸)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="18" data-mode="pyeong-to-m2">18평 (투룸)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="24" data-mode="pyeong-to-m2">24평 (전용 59㎡형)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="32" data-mode="pyeong-to-m2">32평 (국민평형 84㎡형)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="43" data-mode="pyeong-to-m2">43평 (대형 114㎡형)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="59" data-mode="m2-to-pyeong">59㎡ (구 24평형)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="84" data-mode="m2-to-pyeong">84㎡ (구 34평형)</button>
          <button type="button" class="preset-chip rounded-md border border-border bg-muted/40 px-2.5 py-1 text-xs font-medium text-foreground hover:border-primary/50" data-value="114" data-mode="m2-to-pyeong">114㎡ (구 45평형)</button>
        </div>
      </div>

      <!-- 환산 결과 박스 -->
      <div class="rounded-lg border border-primary/20 bg-primary/5 p-6 space-y-4">
        <div class="text-center pb-4 border-b border-border/60">
          <span id="res-heading" class="text-xs font-medium text-muted-foreground">환산된 면적</span>
          <div class="mt-1 flex items-baseline justify-center gap-1.5">
            <span id="res-primary-val" class="text-4xl font-black tracking-tight text-primary font-mono sm:text-5xl">105.79</span>
            <span id="res-primary-unit" class="text-xl font-bold text-foreground">㎡</span>
          </div>
          <p id="res-sub-desc" class="mt-2 text-xs text-muted-foreground">
            정밀 환산값: <span id="res-exact-val" class="font-mono font-bold text-foreground">105.7851 ㎡</span>
          </p>
        </div>

        <div class="space-y-2 text-xs">
          <div class="flex justify-between font-medium text-muted-foreground">
            <span>정방형(정사각형) 가상 크기</span>
            <span id="res-dimensions" class="font-mono text-foreground font-bold">약 10.28m × 10.28m</span>
          </div>
          <div class="flex justify-between font-medium text-muted-foreground">
            <span>적용 법정 환산율</span>
            <span id="res-formula-rate" class="font-mono text-foreground font-bold">1평 = 3.305785 ㎡</span>
          </div>
          <div class="flex justify-between font-bold text-primary pt-2 border-t border-border/60">
            <span>환산 산출식</span>
            <span id="res-formula-text" class="font-mono text-[11px]">32평 × 3.305785</span>
          </div>
        </div>
      </div>

      <!-- B2A API 안내 -->
      <div class="border-t border-border pt-4 text-xs text-muted-foreground">
        <p class="font-medium text-foreground">api.oiyo.net B2A 무비용 연동 엔드포인트:</p>
        <p class="mt-1 font-mono text-[11px] bg-muted p-2 rounded border border-border break-all">
          GET https://api.oiyo.net/v1/math/units/convert?value=84&from=m2&to=pyeong
        </p>
      </div>
    </div>

    <!-- 법적/실무 상식 카드 -->
    <div class="mt-6 rounded-xl border border-border bg-card p-5 space-y-3 text-xs leading-relaxed text-muted-foreground">
      <h2 class="text-sm font-bold text-foreground">📌 아파트 전용면적 vs 공급면적(분양평수) 차이</h2>
      <ul class="list-disc list-inside space-y-1.5 pl-1">
        <li><strong>전용면적</strong>: 방, 거실, 주방, 화장실 등 입주자가 독점적으로 사용하는 실내 바닥 면적(등기부등본 및 계약서 기준). 발코니는 서비스 면적으로 제외됩니다.</li>
        <li><strong>공급면적 (분양면적)</strong>: 전용면적에 계단, 복도, 엘리베이터 등 '주거공용면적'을 더한 면적입니다. 시중에서 흔히 부르는 '32평형', '34평형'은 이 공급면적을 평수로 환산한 값입니다.</li>
        <li><strong>국민주택규모 (84㎡)</strong>: 전용면적 84㎡는 약 25.4평이며, 복도·계단을 포함한 공급면적 기준으로는 통상 32~34평형 아파트에 해당합니다.</li>
      </ul>
    </div>

    <div class="mt-8 rounded-lg border border-border bg-muted/30 p-4 text-center text-xs text-muted-foreground">
      근거 법령: 대한민국 계량에 관한 법률 시행령 제2조 및 산업통상자원부 법정계량단위 규정 (1평 = 400/121 ㎡)
    </div>

    <RelatedTools currentId="pyeong-sqm" />

    <script>
      const PYEONG_TO_M2 = 400 / 121; // 3.305785123966942
      const M2_TO_PYEONG = 121 / 400; // 0.3025

      let mode = "pyeong-to-m2";
      const areaInput = document.getElementById("area-input") as HTMLInputElement;
      const inputLabel = document.getElementById("input-label")!;
      const unitBadge = document.getElementById("unit-badge")!;
      const btnModePyeong = document.getElementById("btn-mode-pyeong") as HTMLButtonElement;
      const btnModeM2 = document.getElementById("btn-mode-m2") as HTMLButtonElement;

      const resHeading = document.getElementById("res-heading")!;
      const resPrimaryVal = document.getElementById("res-primary-val")!;
      const resPrimaryUnit = document.getElementById("res-primary-unit")!;
      const resExactVal = document.getElementById("res-exact-val")!;
      const resDimensions = document.getElementById("res-dimensions")!;
      const resFormulaRate = document.getElementById("res-formula-rate")!;
      const resFormulaText = document.getElementById("res-formula-text")!;
      const presetChips = document.querySelectorAll<HTMLButtonElement>(".preset-chip");

      function calculate() {
        const val = Math.max(0, parseFloat(areaInput.value) || 0);

        if (mode === "pyeong-to-m2") {
          const m2Exact = val * PYEONG_TO_M2;
          const sideLength = Math.sqrt(m2Exact);

          resPrimaryVal.textContent = m2Exact.toLocaleString("ko-KR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          resPrimaryUnit.textContent = "㎡";
          resExactVal.textContent = `${m2Exact.toFixed(4)} ㎡`;
          resDimensions.textContent = `약 ${sideLength.toFixed(2)}m × ${sideLength.toFixed(2)}m`;
          resFormulaRate.textContent = "1평 = 약 3.3058 ㎡ (400/121)";
          resFormulaText.textContent = `${val}평 × 3.305785 = ${m2Exact.toFixed(2)}㎡`;
        } else {
          const pyeongExact = val * M2_TO_PYEONG;
          const sideLength = Math.sqrt(val);

          resPrimaryVal.textContent = pyeongExact.toLocaleString("ko-KR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          resPrimaryUnit.textContent = "평 (坪)";
          resExactVal.textContent = `${pyeongExact.toFixed(4)} 평`;
          resDimensions.textContent = `약 ${sideLength.toFixed(2)}m × ${sideLength.toFixed(2)}m`;
          resFormulaRate.textContent = "1㎡ = 0.3025 평 (121/400)";
          resFormulaText.textContent = `${val}㎡ × 0.3025 = ${pyeongExact.toFixed(2)}평`;
        }
      }

      function setMode(newMode: string) {
        mode = newMode;
        if (mode === "pyeong-to-m2") {
          btnModePyeong.className = "mode-btn rounded-lg border border-primary bg-primary/10 px-4 py-2.5 text-xs font-bold text-primary transition-colors";
          btnModeM2.className = "mode-btn rounded-lg border border-border bg-background px-4 py-2.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted";
          inputLabel.textContent = "면적 입력 (평)";
          unitBadge.textContent = "평 (坪)";
        } else {
          btnModeM2.className = "mode-btn rounded-lg border border-primary bg-primary/10 px-4 py-2.5 text-xs font-bold text-primary transition-colors";
          btnModePyeong.className = "mode-btn rounded-lg border border-border bg-background px-4 py-2.5 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted";
          inputLabel.textContent = "면적 입력 (제곱미터)";
          unitBadge.textContent = "제곱미터 (㎡)";
        }
        calculate();
      }

      btnModePyeong.addEventListener("click", () => setMode("pyeong-to-m2"));
      btnModeM2.addEventListener("click", () => setMode("m2-to-pyeong"));
      areaInput.addEventListener("input", calculate);

      presetChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const chipMode = chip.getAttribute("data-mode")!;
          const chipVal = chip.getAttribute("data-value")!;
          setMode(chipMode);
          areaInput.value = chipVal;
          calculate();
        });
      });

      calculate();
    </script>
  </div>
</Layout>
