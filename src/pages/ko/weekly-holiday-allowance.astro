---
import Layout from "../../components/Layout.astro";
---

<Layout
  title="2026 주휴수당 & 알바 시급 계산기"
  description="근로기준법 제55조에 따른 주휴수당 지급 조건(주 15시간 이상)과 2026년 최저시급(10,030원) 기준 주휴수당, 주급, 월급 실수령액을 즉시 계산합니다."
>
  <div class="mx-auto w-full max-w-2xl px-4 py-8 sm:px-8">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
        <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary mb-3">
          2026년 최저시급(10,030원) 반영
        </div>
        <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
          주휴수당 & 알바 시급 계산기
        </h1>
        <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
          1주일 소정근로시간 15시간 이상 근무 시 법적으로 보장되는 주휴수당과 주휴수당 포함 실질 시급, 월 환산 급여를 즉시 산출합니다.
        </p>
      </div>

      <div class="rounded-xl border border-border bg-card p-6 shadow-xs space-y-6">
        <!-- 기본 시급 입력 -->
        <div>
          <label for="hourly-wage" class="block text-xs font-bold text-foreground">시급 (원)</label>
          <div class="mt-2 relative">
            <input
              type="number"
              id="hourly-wage"
              value="10030"
              step="100"
              min="10030"
              class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
            />
            <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
          </div>
          <p class="mt-1 text-[11px] text-muted-foreground">2026년 법정 최저시급은 10,030원입니다.</p>
        </div>

        <!-- 1주 근무 시간 -->
        <div>
          <div class="flex justify-between items-center">
            <label for="weekly-hours" class="block text-xs font-bold text-foreground">1주일 총 근무시간</label>
            <span id="hours-display" class="text-xs font-mono font-bold text-primary">20시간</span>
          </div>
          <input
            type="range"
            id="weekly-hours"
            min="5"
            max="52"
            value="20"
            step="1"
            class="mt-2 w-full accent-primary cursor-pointer"
          />
          <div class="flex justify-between text-[10px] text-muted-foreground mt-1">
            <span>5시간 (미적용)</span>
            <span class="font-bold text-foreground">15시간 (지급 기준)</span>
            <span>40시간 (법정상한)</span>
            <span>52시간</span>
          </div>
        </div>

        <!-- 공제 유형 선택 -->
        <div>
          <label class="block text-xs font-bold text-foreground">세금 및 4대보험 공제 방식</label>
          <div class="mt-2 grid grid-cols-3 gap-2">
            <button
              type="button"
              data-tax="none"
              class="tax-btn rounded-lg border border-primary bg-primary/10 px-3 py-2.5 text-xs font-bold text-primary text-center transition-colors"
            >
              세전 (0%)
            </button>
            <button
              type="button"
              data-tax="freelance"
              class="tax-btn rounded-lg border border-border bg-background px-3 py-2.5 text-xs font-medium text-muted-foreground text-center transition-colors hover:bg-muted/50"
            >
              사업소득 (3.3%)
            </button>
            <button
              type="button"
              data-tax="four"
              class="tax-btn rounded-lg border border-border bg-background px-3 py-2.5 text-xs font-medium text-muted-foreground text-center transition-colors hover:bg-muted/50"
            >
              4대보험 (~9.4%)
            </button>
          </div>
        </div>

        <!-- 결과 상자 -->
        <div class="rounded-lg border border-border bg-muted/20 p-5 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">산출 내역</span>
            <span id="status-badge" class="inline-flex rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary">
              주휴수당 적용 대상
            </span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-center sm:grid-cols-3">
            <div class="rounded-md border border-border bg-card p-3">
              <span class="text-[11px] text-muted-foreground block">주휴 유급시간</span>
              <span id="res-allowance-hours" class="text-base font-extrabold text-foreground sm:text-lg">4시간</span>
              <span class="text-[10px] text-muted-foreground block">(근무시간 / 40) × 8</span>
            </div>
            <div class="rounded-md border border-border bg-card p-3">
              <span class="text-[11px] text-muted-foreground block">1주 주휴수당</span>
              <span id="res-weekly-allowance" class="text-base font-extrabold text-foreground sm:text-lg">40,120원</span>
              <span class="text-[10px] text-primary font-medium block">주휴 시간 × 시급</span>
            </div>
            <div class="col-span-2 sm:col-span-1 rounded-md border border-primary/30 bg-primary/10 p-3">
              <span class="text-[11px] text-primary font-semibold block">실질 환산 시급</span>
              <span id="res-effective-hourly" class="text-base font-black text-primary sm:text-lg">12,036원</span>
              <span class="text-[10px] text-primary/80 block">+20% 가산 효과</span>
            </div>
          </div>

          <div class="rounded-md border border-border bg-background p-3 text-xs space-y-2">
            <div class="flex justify-between text-muted-foreground">
              <span>기본 주급 (근무시간 × 시급):</span>
              <span id="res-base-weekly" class="font-mono font-medium text-foreground">200,600원</span>
            </div>
            <div class="flex justify-between text-muted-foreground">
              <span>주휴 포함 총 주급:</span>
              <span id="res-total-weekly" class="font-mono font-bold text-foreground">240,720원</span>
            </div>
            <div class="border-t border-border pt-1.5 flex justify-between text-sm">
              <span class="font-bold text-foreground">예상 월 수령액 (4.345주 기준):</span>
              <span id="res-monthly" class="font-extrabold text-primary">1,045,920원</span>
            </div>
          </div>
        </div>

        <!-- 법적 규정 설명 -->
        <div class="border-t border-border pt-4 text-xs space-y-2 text-muted-foreground">
          <p class="font-bold text-foreground">📌 근로기준법 주휴수당 기준:</p>
          <ul class="list-disc list-inside space-y-1 pl-1 text-[11px] leading-relaxed">
            <li><strong>지급 조건</strong>: 1주 소정근로시간이 <strong>15시간 이상</strong>이고, 정해진 근무일에 <strong>결근 없이 개근</strong>해야 합니다 (지각·조퇴는 결근이 아니므로 수당 발생).</li>
            <li><strong>계산 공식</strong>: 주 40시간 미만은 <code>(1주 총 근무시간 ÷ 40) × 8 × 시급</code>, 주 40시간 이상은 <code>8시간 × 시급</code>으로 상한이 고정됩니다.</li>
            <li>5인 미만 영세 사업장이나 단기 아르바이트 근로자에게도 주휴수당은 <strong>예외 없이 법적으로 강제 적용</strong>됩니다.</li>
          </ul>
        </div>

        <!-- API 연동 안내 -->
        <div class="border-t border-border pt-4 text-xs text-muted-foreground">
          <p class="font-medium text-foreground">API 연동 안내:</p>
          <p class="mt-1 font-mono text-[11px] bg-muted p-2 rounded border border-border">
            GET https://api.oiyo.net/v1/labor/kr/weekly-allowance?hourlyWage=10030&hours=20
          </p>
        </div>
      </div>
    </main>

    <footer class="border-t border-border bg-muted/30 px-4 py-6 text-center text-xs text-muted-foreground">
      <p>근거 법령: 대한민국 근로기준법 제55조 및 시행령 제30조 · OIYO tools</p>
    </footer>

    <script>
      let taxMode = "none"; // "none" | "freelance" | "four"
      const hourlyWageInput = document.getElementById("hourly-wage") as HTMLInputElement;
      const weeklyHoursInput = document.getElementById("weekly-hours") as HTMLInputElement;
      const hoursDisplay = document.getElementById("hours-display")!;
      const taxButtons = document.querySelectorAll<HTMLButtonElement>(".tax-btn");

      const statusBadge = document.getElementById("status-badge")!;
      const resAllowanceHours = document.getElementById("res-allowance-hours")!;
      const resWeeklyAllowance = document.getElementById("res-weekly-allowance")!;
      const resEffectiveHourly = document.getElementById("res-effective-hourly")!;
      const resBaseWeekly = document.getElementById("res-base-weekly")!;
      const resTotalWeekly = document.getElementById("res-total-weekly")!;
      const resMonthly = document.getElementById("res-monthly")!;

      function calculate() {
        const hourly = parseFloat(hourlyWageInput.value) || 10030;
        const hours = parseFloat(weeklyHoursInput.value) || 0;

        hoursDisplay.textContent = hours + "시간";

        const isEligible = hours >= 15;

        let allowanceHours = 0;
        if (isEligible) {
          if (hours >= 40) {
            allowanceHours = 8;
          } else {
            allowanceHours = (hours / 40) * 8;
          }
        }

        const baseWeekly = hours * hourly;
        const weeklyAllowance = allowanceHours * hourly;
        const totalWeekly = baseWeekly + weeklyAllowance;
        const effectiveHourly = hours > 0 ? totalWeekly / hours : hourly;

        // 월 환산: 주 4.345주 곱
        let rawMonthly = totalWeekly * 4.345;

        // 세금 공제
        let taxRate = 0;
        if (taxMode === "freelance") {
          taxRate = 0.033;
        } else if (taxMode === "four") {
          taxRate = 0.094; // 약 9.4% 근로자부담분
        }
        const netMonthly = Math.floor(rawMonthly * (1 - taxRate));

        if (isEligible) {
          statusBadge.textContent = "주휴수당 적용 대상";
          statusBadge.className = "inline-flex rounded-md border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-bold text-primary";
        } else {
          statusBadge.textContent = "주 15시간 미만 (주휴수당 미적용)";
          statusBadge.className = "inline-flex rounded-md border border-muted-foreground/20 bg-muted px-2.5 py-0.5 text-xs font-medium text-muted-foreground";
        }

        resAllowanceHours.textContent = allowanceHours.toFixed(1) + "시간";
        resWeeklyAllowance.textContent = Math.floor(weeklyAllowance).toLocaleString() + "원";
        resEffectiveHourly.textContent = Math.floor(effectiveHourly).toLocaleString() + "원";
        resBaseWeekly.textContent = Math.floor(baseWeekly).toLocaleString() + "원";
        resTotalWeekly.textContent = Math.floor(totalWeekly).toLocaleString() + "원";
        resMonthly.textContent = netMonthly.toLocaleString() + "원";
      }

      taxButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          taxButtons.forEach((b) => {
            b.classList.remove("border-primary", "bg-primary/10", "text-primary", "font-bold");
            b.classList.add("border-border", "bg-background", "text-muted-foreground", "font-medium");
          });
          btn.classList.add("border-primary", "bg-primary/10", "text-primary", "font-bold");
          btn.classList.remove("border-border", "bg-background", "text-muted-foreground", "font-medium");
          taxMode = btn.getAttribute("data-tax") || "none";
          calculate();
        });
      });

      hourlyWageInput.addEventListener("input", calculate);
      weeklyHoursInput.addEventListener("input", calculate);

      calculate();
    </script>
  </div>
</Layout>
