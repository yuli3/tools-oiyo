const faqs = [{"q": "2억까지 무이자로 빌려도 되나요?", "a": "이자 차이만 보면 원금 약 2억 1,739만 원까지는 연 1천만 원 미만이라 증여가 아니에요. 다만 원금을 갚지 않으면 원금 전체가 증여가 될 수 있어요."}, {"q": "이자율은 몇 %로 정해야 하나요?", "a": "4.6%로 정하면 문제가 없고, 더 낮게 정하려면 덜 낸 이자가 연 1천만 원 미만이 되도록 해요. 이 계산기가 원금별 최저 이자율을 알려 줘요."}, {"q": "차용증만 쓰면 되나요?", "a": "차용증에 더해 정해진 날 계좌로 이자와 원금을 갚은 기록, 자녀가 갚을 수 있는 소득이 있어야 해요. 공증이나 내용증명으로 작성일을 남기면 좋아요."}, {"q": "부모님이 받은 이자에도 세금이 있나요?", "a": "네. 개인 간 이자는 비영업대금이익이라 25%(지방소득세 포함 27.5%)를 원천징수해 신고해야 해요."}];
