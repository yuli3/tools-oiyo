---
// 경영 도구 1 (2026-11-14). 엔진: lib/biz-strategy.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import DecisionTree from "../../components/tools/biz/DecisionTree";

const title = "의사결정 트리 계산기 — 기대값·손익분기 확률·리스크까지 그림으로";
const description = "선택지마다 성공 확률과 결과를 넣으면 의사결정 트리를 그리고 기대값, 손실 확률, 1등이 바뀌는 확률을 바로 보여 줘요. 전문가 모드에서는 결정·확률 노드를 겹겹이 쌓아요.";

const ko = {
  introTitle: "감이 아니라 같은 기준으로 선택지를 비교해요",
  intro: "의사결정 트리는 '고르는 지점(□)'과 '운에 달린 지점(○)'을 나눠 그리고, 끝에서부터 거꾸로 계산해요. 운에 달린 지점은 확률로 평균 내고, 고르는 지점은 가장 큰 값을 골라요. 이렇게 나온 기대값이 같은 결정을 여러 번 했을 때의 평균이에요. 기대값만 보면 위험한 선택을 할 수 있으니, 손해 볼 확률과 최악의 결과도 같이 보여 줘요.",
  howToTitle: "사용 방법",
  steps: ["결정할 질문과 선택지 2~4개를 적어요.", "선택지마다 잘될 확률, 잘될 때·안될 때 결과, 시작 비용을 넣어요.", "결론 문장과 트리, '1등이 바뀌는 확률'을 보고 확률 슬라이더를 움직여 봐요.", "전문가 모드에서 트리로 옮겨 단계별 결정(예: 시범 운영 후 확장)을 더해요."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "손익분기 확률", body: "지금 1등 선택지의 성공 확률이 몇 %보다 낮아지면 다른 선택지가 나아지는지 알려 줘요." },
    { title: "리스크 프로필", body: "최선의 길을 따를 때 나올 수 있는 결과와 확률, 손실 확률을 막대로 보여 줘요." },
    { title: "여러 단계 트리", body: "확률 노드 뒤에 다시 결정을 넣어 '정보를 보고 나서 고르기'의 가치를 계산해요." },
  ],
  disclaimer: "확률과 금액은 직접 넣은 가정이에요. 결과는 판단을 돕는 참고값이며, 회사가 손실을 버틸 수 있는지(현금·런웨이)도 함께 보세요.",
};

const faqs = [
  { q: "확률은 어떻게 정하나요?", a: "과거 비슷한 사례의 성공 비율, 시장 조사, 팀원 여러 명의 추정 평균을 써요. 정확하지 않아도 괜찮아요. '1등이 바뀌는 확률'보다 확실히 높은지 낮은지만 판단하면 되는 경우가 많아요." },
  { q: "기대값이 가장 큰 선택이 항상 정답인가요?", a: "아니에요. 한 번 실패하면 회사가 버티지 못하는 결정이라면 기대값이 조금 낮아도 손실 확률이 작은 선택이 나을 수 있어요. 그래서 최악의 결과와 손실 확률을 같이 보여 줘요." },
  { q: "이미 쓴 돈은 넣어야 하나요?", a: "넣지 않아요. 이미 쓴 돈(매몰비용)은 어떤 선택을 해도 돌아오지 않아요. 지금부터 들어갈 돈과 얻을 돈만 비교해요." },
];
---
<KrFinancePage slug="decision-tree-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <DecisionTree client:load />
  <p class="mt-4 text-xs text-muted-foreground"><a class="underline" href="/ko/business-toolkit/">경영 도구 모음</a></p>
</KrFinancePage>
