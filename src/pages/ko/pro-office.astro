---
// 전문가 사무소 허브 (2026-11-23, 세운 요청). 새 계산 없음: 기존 도구·MCP·Claude 스킬을 건물 → 층(나라) → 방(세무·노무·행정·법무·재무설계)으로 묶었어요.
// 자격 명칭을 이름에 쓰지 않아요. 실제 자격사 사무소가 아니라 상담 전 정리용 도구 모음이에요.
import KrFinancePage from "../../components/KrFinancePage.astro";
import ProOffice from "../../components/tools/office/ProOffice";
import { officeFloors, OFFICE_AS_OF, OFFICE_SLUGS } from "../../data/pro-office";
import { OFFICE_COPY } from "../../data/pro-office-copy";

const title = "실무 오피스 — 세무·노무·행정·법무·재무설계 도구를 나라별 사무소처럼";
const description = "1층 안내 데스크에서 나라(층)를 고르고 세무실·노무실·행정·생활실·법무실·재무설계실에 들어가 접수 질문, 계산 도구, Claude 스킬·MCP, 한 장짜리 상담 결과지 인쇄까지. 한국 본관과 해외 11개국 층.";
const floors = officeFloors("ko");
const shell = {
  introTitle: "상담 전에 들르는 사무소",
  intro: "세무·노무·행정·법무·재무설계 실무자와 그 고객이 쓰는 도구를 사무소처럼 배치했어요. 한국 본관은 직업별 역량 지도에서, 해외 층은 각 나라 공식 자료로 만든 현지어 도구에서 가져왔어요. 방마다 결론을 바꾸는 접수 질문, 계산·확인 도구, AI 도구, 인쇄용 상담 결과지가 있어요.",
  howToTitle: "이렇게 써요",
  steps: ["층별 안내판에서 나라를 골라요.", "세무실·노무실·행정·생활실·법무실 중 하나에 들어가요.", "접수 질문을 체크하고, 쓸 도구를 열고 결과지에 넣을 도구를 체크해요.", "상담 결과지를 인쇄해 기록으로 남겨요."],
  highlightsTitle: "방마다 있는 것",
  highlights: [
    { title: "① 접수", body: "누구의 일인지, 언제인지, 어떤 서류가 있는지, 기한이 남았는지처럼 결론을 바꾸는 사실을 먼저 물어요." },
    { title: "② 상담 테이블", body: "그 방의 계산·확인 도구를 고객용·실무자용으로 나눠 보여 주고, 자주 쓰는 도구는 즐겨찾기로 1층 로비에 꽂아 둬요." },
    { title: "③ 서가", body: "같은 공식을 쓰는 Claude 스킬 내려받기와 MCP 서버 주소, 방에서 부를 수 있는 MCP 도구 이름." },
    { title: "④ 상담 결과지", body: "체크한 접수 항목, 쓴 도구, 메모, 무료 공식 창구를 한 장으로 인쇄해요. 입력값은 브라우저에만 있어요." },
  ],
  disclaimer: "일반 정보와 계산 도구예요. 세무·법률 자문, 신고·소송 대리가 아니에요. 개별 사안은 자격사나 무료 공식 창구에 확인하세요.",
};
const faqs = [
  { q: "세무사·노무사 사무소인가요?", a: "아니에요. 자격사 사무소가 아니라 무료 도구와 일반 정보예요. 상담·대리·신고를 하지 않고, 방마다 무료 공식 창구를 적어 뒀어요." },
  { q: "세무사랑·Tax Partners 같은 프로그램을 대신하나요?", a: "아니에요. 신고서 작성·전자신고·장부는 그 프로그램에서 하고, 여기는 상담 자리에서 사실을 정리하고 숫자를 미리 잡아 보는 보충 도구예요." },
  { q: "다른 나라 손님이 오면요?", a: "해외 층에 일본·미국·중국·대만·영국·독일·프랑스·스페인·싱가포르·캐나다·호주 도구가 그 나라 말로 있어요. 같은 사무소의 영어·일본어·프랑스어·스페인어·중국어판도 있어요." },
];
const other = [["en", "English"], ["ja", "日本語"], ["fr", "Français"], ["es", "Español"], ["zh", "中文"]] as const;
---
<KrFinancePage slug="pro-office" locale="ko" title={title} description={description} shell={shell} faqs={faqs} koOnly group="money">
  <ProOffice client:load locale="ko" floors={floors} copy={OFFICE_COPY.ko} asOf={OFFICE_AS_OF} />
  <p class="mt-4 text-sm text-muted-foreground">다른 언어: {other.map(([l, n], i) => (<>{i ? " · " : ""}<a class="underline underline-offset-4" href={`/${l}/${OFFICE_SLUGS[l]}/`}>{n}</a></>))} · 관련: <a class="underline underline-offset-4" href="/ko/pro-competency-map/">전문 직업 역량 지도</a> · <a class="underline underline-offset-4" href="/ko/law-guide/">법령 길잡이</a> · <a class="underline underline-offset-4" href="/ko/tax-advisor-toolkit/">세무·회계 실무 도구 모음</a></p>
</KrFinancePage>
