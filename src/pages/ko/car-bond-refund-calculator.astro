---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
import { CAR_BOND_REGIONS, SIZE_CLASSES, BOND_TERMS, CAR_BOND_VERIFIED_ON } from "../../lib/car-bond-2026.mjs";

const pct = (r: number | null) => (r === null ? "확인 필요" : r === 0 ? "면제" : `${+(r * 100).toFixed(1)}%`);
---

<Layout
  title="자동차 공채 매입·할인 매도 계산기 — 2026년 시·도별 면제 기준"
  description="2026년 자동차 신규등록 시 시·도별 공채(도시철도채권·지역개발채권) 매입금액과 즉시 할인 매도 부담금, 만기 상환액을 공식 자료 기준으로 추정해요. 확인되지 않은 지역은 '확인 필요'로 보여 줘요."
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="mb-6">
      <a href="/" class="text-xs font-semibold text-muted-foreground hover:text-primary transition-colors mb-3 inline-block">← 전체 도구 목록</a>
      <h1 class="text-2xl font-black tracking-tight text-foreground sm:text-3xl">
        자동차 공채 매입·할인 매도 계산기
      </h1>
      <p class="mt-2 text-xs text-muted-foreground sm:text-sm leading-relaxed">
        비사업용 승용차를 새로 등록할 때 사야 하는 공채 금액과, 바로 팔 때 내는 할인료, 만기까지 들고 있을 때 받는 금액을 추정해요.
        이전등록(중고차)·사업용·승합·화물은 다루지 않아요.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-card border border-border rounded-2xl p-6 shadow-xs space-y-5">
          <div>
            <label for="car-price" class="block text-xs font-bold text-foreground">
              취득세 과세표준 (부가가치세 제외 차량 공급가액, 원)
            </label>
            <div class="mt-2 relative">
              <input
                type="number"
                id="car-price"
                value="35000000"
                step="1000000"
                min="0"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">원</span>
            </div>
            <p id="car-price-ko" class="mt-1 text-xs text-muted-foreground">3,500만 원</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="region-select" class="block text-xs font-bold text-foreground">등록 시·도</label>
              <select
                id="region-select"
                class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              >
                {CAR_BOND_REGIONS.map((r) => <option value={r.id} selected={r.id === "seoul"}>{r.name}</option>)}
              </select>
            </div>
            <div>
              <label for="size-select" class="block text-xs font-bold text-foreground">크기 구분</label>
              <select
                id="size-select"
                class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              >
                {SIZE_CLASSES.map((s) => <option value={s.id} selected={s.id === "mid"}>{s.label}</option>)}
              </select>
            </div>
          </div>

          <div>
            <label for="fuel-select" class="block text-xs font-bold text-foreground">동력</label>
            <select
              id="fuel-select"
              class="mt-2 w-full rounded-lg border border-input bg-background px-4 py-3 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
            >
              <option value="ice" selected>내연기관 (휘발유·경유·LPG)</option>
              <option value="ev">전기·수소차 (크기는 길이·너비·높이 기준)</option>
            </select>
            <p class="mt-1 text-xs text-muted-foreground">하이브리드는 시·도마다 따로 정해서(예: 경기 1,600cc 초과 매입, 인천 2026년 면제) 여기서는 내연기관 기준으로만 보여 줘요.</p>
          </div>

          <div>
            <label for="discount-rate" class="block text-xs font-bold text-foreground">
              당일 즉시 매도 할인율 (%)
            </label>
            <div class="mt-2 relative">
              <input
                type="number"
                id="discount-rate"
                value="6"
                step="0.1"
                min="0"
                max="30"
                class="w-full rounded-lg border border-input bg-background px-4 py-3 text-sm font-mono text-foreground focus-visible:outline-2 focus-visible:outline-ring"
              />
              <span class="absolute right-4 top-3.5 text-xs text-muted-foreground">%</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">기본값은 예시예요. 할인율은 매일 바뀌니 등록 당일 은행·대행기관이 안내하는 값을 넣어 주세요.</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 space-y-6">
        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs" aria-live="polite">
          <p class="text-xs font-bold text-primary mb-1">공채 추정 결과</p>
          <div class="flex items-baseline justify-between mt-2 border-b border-border pb-4">
            <span class="text-xs text-muted-foreground">즉시 매도 시 내는 할인료</span>
            <span id="res-discount-loss" class="text-2xl sm:text-3xl font-black text-foreground font-mono">-</span>
          </div>
          <div class="mt-4 space-y-3 text-xs">
            <div class="flex justify-between gap-4">
              <span class="text-muted-foreground">적용 매입 비율</span>
              <span id="res-bond-rate" class="font-mono text-foreground font-semibold">-</span>
            </div>
            <div class="flex justify-between gap-4">
              <span class="text-muted-foreground">공채 매입금액</span>
              <span id="res-bond-amount" class="font-mono text-foreground">-</span>
            </div>
            <div class="flex justify-between gap-4">
              <span class="text-muted-foreground">즉시 매도 시 돌려받는 금액</span>
              <span id="res-bank-payout" class="font-mono text-foreground">-</span>
            </div>
            <div class="flex justify-between gap-4 border-t border-border pt-2">
              <span id="res-maturity-label" class="text-muted-foreground">만기 보유 시 상환액 (세전)</span>
              <span id="res-maturity-refund" class="font-mono font-bold text-primary text-right">-</span>
            </div>
          </div>
          <p id="res-note" class="mt-4 rounded-lg bg-muted/40 px-3 py-2 text-xs leading-relaxed text-muted-foreground"></p>
          <p id="res-source" class="mt-2 text-xs leading-relaxed text-muted-foreground"></p>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6 shadow-xs space-y-3">
          <p class="font-bold text-foreground text-sm">알아 두면 좋아요</p>
          <ul class="list-disc list-inside space-y-2 text-xs text-muted-foreground leading-relaxed">
            <li>2023년 1월 발행분부터 지역개발채권과 서울 도시철도공채의 표면금리가 연 2.5%(연 복리)예요. 예전 1.05%·1.0%는 그 전에 산 채권에만 해당해요.</li>
            <li>만기는 지역개발채권 5년, 서울 도시철도공채 7년이에요. 만기 상환액에는 이자소득세가 따로 붙을 수 있어요.</li>
            <li>도시철도채권 원리금은 상환일부터 5년이 지나면 소멸시효가 끝나요(도시철도법 제20조). 예전에 산 채권은 해당 시·도 금고 은행에서 조회해 보세요.</li>
            <li>이 결과는 추정이에요. 장애인·국가유공자 감면, 리스·렌트 차량, 다목적형 등 예외는 등록 관청에서 확인해 주세요.</li>
          </ul>
        </div>
      </div>
    </div>

    <section class="mt-10 space-y-3" aria-labelledby="bond-table-title">
      <h2 id="bond-table-title" class="text-lg font-bold text-foreground">시·도별 신규등록 매입 비율 (비사업용 승용, 내연기관)</h2>
      <p class="text-xs text-muted-foreground">공식 자료 확인일 {CAR_BOND_VERIFIED_ON}. '확인 필요'는 공식 자료로 값을 확인하지 못한 칸이에요.</p>
      <div class="overflow-x-auto rounded-xl border border-border">
        <table class="w-full min-w-160 text-xs">
          <thead class="bg-muted/40 text-left text-muted-foreground">
            <tr>
              <th class="px-3 py-2 font-semibold">시·도</th>
              <th class="px-3 py-2 font-semibold">소형</th>
              <th class="px-3 py-2 font-semibold">중형</th>
              <th class="px-3 py-2 font-semibold">대형</th>
              <th class="px-3 py-2 font-semibold">기준일</th>
              <th class="px-3 py-2 font-semibold">근거</th>
            </tr>
          </thead>
          <tbody>
            {CAR_BOND_REGIONS.map((r) => (
              <tr class="border-t border-border align-top">
                <td class="px-3 py-2 font-semibold text-foreground">{r.name}</td>
                <td class="px-3 py-2 font-mono">{pct(r.rates.small)}</td>
                <td class="px-3 py-2 font-mono">{pct(r.rates.mid)}</td>
                <td class="px-3 py-2 font-mono">{pct(r.rates.large)}</td>
                <td class="px-3 py-2 text-muted-foreground">{r.basisDate}</td>
                <td class="px-3 py-2 text-muted-foreground"><a class="underline underline-offset-2 hover:text-primary" href={r.url} rel="noopener nofollow" target="_blank">{r.source}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-muted-foreground">경형(1,000cc 미만)은 모든 시·도에서 매입하지 않아요. 상환 조건 근거: {BOND_TERMS.regionalDev.source}; {BOND_TERMS.seoulRail.source}.</p>
    </section>

    <RelatedTools currentId="car-bond-refund" />
  </div>

  <script>
    import { carBond2026 } from "../../lib/car-bond-2026.mjs";

    const priceInput = document.getElementById("car-price") as HTMLInputElement;
    const regionSelect = document.getElementById("region-select") as HTMLSelectElement;
    const sizeSelect = document.getElementById("size-select") as HTMLSelectElement;
    const fuelSelect = document.getElementById("fuel-select") as HTMLSelectElement;
    const discountInput = document.getElementById("discount-rate") as HTMLInputElement;

    const priceKo = document.getElementById("car-price-ko")!;
    const resDiscountLoss = document.getElementById("res-discount-loss")!;
    const resBondRate = document.getElementById("res-bond-rate")!;
    const resBondAmount = document.getElementById("res-bond-amount")!;
    const resBankPayout = document.getElementById("res-bank-payout")!;
    const resMaturityLabel = document.getElementById("res-maturity-label")!;
    const resMaturityRefund = document.getElementById("res-maturity-refund")!;
    const resNote = document.getElementById("res-note")!;
    const resSource = document.getElementById("res-source")!;

    const krw = (v: number) => Math.round(v).toLocaleString("ko-KR") + "원";

    function koreanUnits(num: number): string {
      if (num <= 0) return "0원";
      const eok = Math.floor(num / 100000000);
      const man = Math.floor((num % 100000000) / 10000);
      let res = "";
      if (eok > 0) res += `${eok}억 `;
      if (man > 0) res += `${man.toLocaleString("ko-KR")}만 `;
      return res.trim() + " 원";
    }

    function calculate() {
      const price = Math.max(0, parseFloat(priceInput.value) || 0);
      priceKo.textContent = koreanUnits(price);
      const isEv = fuelSelect.value === "ev";
      const r = carBond2026({
        regionId: regionSelect.value,
        sizeClass: sizeSelect.value,
        isEv,
        taxBase: price,
        discountRate: Math.max(0, parseFloat(discountInput.value) || 0) / 100,
      });

      resNote.textContent = r.region.note;
      resSource.textContent = `근거: ${r.region.source} (기준: ${r.region.basisDate})`;

      if (r.status === "unknown") {
        resBondRate.textContent = "확인 필요";
        resBondAmount.textContent = "확인 필요";
        resDiscountLoss.textContent = "확인 필요";
        resBankPayout.textContent = "-";
        resMaturityRefund.textContent = "-";
        if (isEv) resNote.textContent = "이 시·도의 전기·수소차 매입 기준은 공식 자료로 확인하지 못했어요. 등록 관청에 확인해 주세요. " + r.region.note;
        return;
      }

      resBondRate.textContent =
        r.status === "exempt"
          ? r.rate === 0
            ? "면제"
            : "면제 (250만 원 이하)"
          : `${+(r.rate! * 100).toFixed(1)}%${isEv ? " (250만 원 면제 후)" : ""}`;
      resBondAmount.textContent = krw(r.bondAmount!);
      resDiscountLoss.textContent = krw(r.discountCost!);
      resBankPayout.textContent = krw(r.bankPayout!);
      if (r.maturity) {
        resMaturityLabel.textContent = `${r.maturity.years}년 만기 보유 시 상환액 (연 ${(r.maturity.couponRate * 100).toFixed(1)}% 복리, 세전)`;
        resMaturityRefund.textContent = krw(r.maturity.amount);
      } else {
        resMaturityLabel.textContent = "만기 보유 시 상환액 (세전)";
        resMaturityRefund.textContent = r.status === "exempt" ? "-" : "확인 필요";
      }
    }

    [priceInput, regionSelect, sizeSelect, fuelSelect, discountInput].forEach((el) => {
      el.addEventListener("input", calculate);
      el.addEventListener("change", calculate);
    });

    calculate();
  </script>
</Layout>
