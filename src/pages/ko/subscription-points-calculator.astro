    disclaimer: "이 도구는 일반적인 추정용이에요. 실제 청약 자격, 가점, 당첨 가능성은 모집공고와 관련 기관 또는 전문가에게 확인하세요.",
  };
const ko = { introTitle: c.introTitle, intro: c.intro, howToTitle: c.howToTitle, steps: c.steps, highlightsTitle: c.formulaTitle, highlights: c.formulas, disclaimer: c.disclaimer };
const faqs = c.faqs.map((f) => ({ q: f.question, a: f.answer }));
---
<KrFinancePage slug="subscription-points-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <SubscriptionPointsCalculator client:load locale="ko" />
</KrFinancePage>
