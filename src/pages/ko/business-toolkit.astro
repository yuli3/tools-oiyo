---
// 2026-11-14: 기업가·경영팀·회계사·세무사·경리용 경영 도구 모음 + 경영 이론 정리 + MCP·Claude 스킬 안내.
import KrFinancePage from "../../components/KrFinancePage.astro";
import { bizTools, coreBizTools, opsTools, FRAMEWORKS, FRAMEWORK_GROUPS, type FrameworkGroup } from "../../data/biz-tools";

const title = "경영 도구 모음 — 의사결정 트리·타임라인·SWOT·BCG·포지셔닝·단위경제와 경영 이론 총정리";
const description = "기업가와 경영팀, 회계사·세무사·경리가 함께 쓰는 경영 도구와 요즘 많이 쓰는 경영 이론 40가지를 한곳에 모았어요. 같은 계산을 AI 에이전트에서 쓰는 MCP 도구와 Claude 스킬도 있어요.";
const tools = coreBizTools.filter((t) => t.slug !== "business-toolkit");
const groups = Object.keys(FRAMEWORK_GROUPS) as FrameworkGroup[];
const toolTitle = (slug?: string) => (slug === "dcf-valuation-calculator" ? "DCF 계산기" : bizTools.find((t) => t.slug === slug)?.title);
const roles = [
  ["대표·창업자", "의사결정 트리로 큰 결정을, 단위경제·런웨이로 채용·투자 시점을, 체크리스트로 놓치면 안 되는 의무를 챙겨요."],
  ["경영팀", "SWOT·BCG·포지셔닝으로 전략 회의 자료를 만들고, 타임라인과 우선순위표로 실행을 맞춰요."],
  ["경리·총무", "체크리스트의 '경리' 역할과 세무 일정 달력으로 매달 신고 기한을 놓치지 않아요."],
  ["회계사·세무사", "고객사 점검표로 체크리스트를 쓰고, 단위경제·DCF로 사업계획 검토를 숫자로 도와요."],
];
const mcpTools = [
  ["evaluate_decision_tree", "의사결정 트리 기대값·리스크 프로필"],
  ["schedule_critical_path", "CPM 핵심 경로·여유·PERT 마감 확률"],
  ["analyze_swot", "SWOT 전략 위치·TOWS·IFE·EFE·IE"],
  ["classify_bcg_portfolio", "BCG 분류·매출 구성 진단"],
  ["calculate_unit_economics_runway", "LTV/CAC·회수 기간·런웨이·흑자 전환"],
  ["map_brand_positioning", "포지셔닝 맵 가장 가까운 경쟁자·빈자리"],
  ["rank_priorities", "가중 의사결정표·RICE"],
  ["get_kr_business_tax_calendar", "사업자 세무·노무 신고 일정(휴일 반영)·체크리스트"],
  ["plan_campaign_supply", "캠페인 품절 주차·추가 생산량"],
  ["evaluate_influencer_deal", "인플루언서 ROAS·본전 전환율·원천징수"],
  ["plan_quality_recovery", "회수 범위 비용·남은 재고 배분"],
  ["compare_alternative_materials", "대체 원료 절감·승인 기간·가중 점수"],
  ["check_big_order_capacity", "대형 수주 vs 기존 약속 이익 비교"],
  ["analyze_market_test", "표본 수·A/B 판정·진출 손익"],
  ["check_sales_rebates", "판매장려금 구간·특수관계·과다 지급"],
  ["evaluate_acquisition", "인수 주당이익 증감·회수·필요 시너지"],
];
---
<KrFinancePage slug="business-toolkit" locale="ko" title={title} description={description} koOnly>
  <section>
    <h2 class="text-lg font-bold text-foreground">바로 쓰는 경영 도구</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">모든 도구는 질문에 답하는 <b>쉬운 설명</b>과 숫자를 직접 넣는 <b>전문가</b> 모드가 있고, 가정을 바꾸면 그래프가 바로 움직여요. 입력은 이 브라우저 안에서만 계산·저장해요.</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {tools.map((t) => (
        <li class="rounded-md border border-border bg-background p-4">
          <a href={`/ko/${t.slug}/`} class="text-base font-semibold text-foreground underline-offset-4 hover:underline">{t.title}</a>
          <p class="mt-1 text-sm leading-6 text-muted-foreground">{t.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">운영 문제 8가지 바로 풀기</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">제조·유통 회사에서 부서가 엮여 자주 터지는 운영 문제를 하나씩 계산으로 풀어요. 결론마다 영향을 받는 부서와 근거 조문을 함께 적어요.</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {opsTools.map((t) => (
        <li class="rounded-md border border-border bg-background p-4">
          <p class="text-xs font-semibold text-muted-foreground">{t.problem}</p>
          <a href={`/ko/${t.slug}/`} class="mt-1 block text-base font-semibold text-foreground underline-offset-4 hover:underline">{t.title}</a>
          <p class="mt-1 text-sm leading-6 text-muted-foreground">{t.description}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">누가 어떻게 쓰나요</h2>
    <dl class="mt-3 space-y-3">
      {roles.map(([r, d]) => (
        <div><dt class="text-sm font-semibold text-foreground">{r}</dt><dd class="text-sm leading-6 text-muted-foreground">{d}</dd></div>
      ))}
    </dl>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">경영 이론 총정리: 언제 무엇을 쓰나</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">고전 이론부터 스타트업에서 요즘 많이 쓰는 틀까지 {FRAMEWORKS.length}가지를 '언제 쓰나'와 '핵심 방법' 한 줄로 정리했어요. 도구가 있는 이론은 바로 열 수 있어요.</p>
    {groups.map((g) => (
      <div class="mt-5">
        <h3 class="text-base font-semibold text-foreground">{FRAMEWORK_GROUPS[g]}</h3>
        <ul class="mt-2 space-y-2">
          {FRAMEWORKS.filter((f) => f.group === g).map((f) => (
            <li class="rounded-md border border-border bg-background px-3 py-2">
              <p class="text-sm font-semibold text-foreground">{f.name}{f.tool && <a class="ml-2 text-xs font-normal underline" href={`/ko/${f.tool}/`}>{toolTitle(f.tool)} 열기</a>}</p>
              <p class="text-xs leading-5 text-muted-foreground"><b class="font-semibold">언제</b> {f.when}</p>
              <p class="text-sm leading-6 text-foreground">{f.how}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">AI 에이전트에서 같은 계산 쓰기 (MCP)</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">Claude·Cursor·ChatGPT 같은 MCP 클라이언트에 아래 주소를 원격 서버로 추가하면 같은 계산을 도구로 불러요. 공식 MCP Registry 이름은 <code>io.github.yuli3/oiyo-calculations</code>예요.</p>
    <pre class="mt-3 overflow-x-auto rounded-md border border-border bg-muted px-3 py-2 text-xs"><code>https://api.oiyo.net/mcp</code></pre>
    <ul class="mt-3 space-y-1 text-sm text-muted-foreground">
      {mcpTools.map(([name, label]) => <li><code class="text-foreground">{name}</code> · {label}</li>)}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">Claude 스킬: 경영 전략 참모</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">Claude에 올리면 상황을 듣고 맞는 경영 이론을 골라 필요한 정보를 묻고, 같은 공식으로 계산한 뒤 결론·근거·다음 행동이 있는 한 장짜리 메모를 써 줘요. 의사결정 트리, 일정, SWOT, BCG, 포지셔닝, 단위경제, 우선순위와 사업자 세무 일정까지 다뤄요.</p>
    <p class="mt-3"><a href="/downloads/oiyo-business-strategist-skill.zip" download class="inline-flex min-h-11 items-center rounded-md bg-primary px-4 text-sm font-semibold text-primary-foreground">스킬 내려받기 (.zip)</a></p>
    <p class="mt-2 text-xs text-muted-foreground">Claude 설정 → 기능 → 스킬에서 zip 파일을 올리거나, Claude Code에서는 압축을 풀어 <code>~/.claude/skills/</code>에 두면 돼요. 세무 상담용은 <a class="underline" href="/ko/tax-advisor-toolkit/">세무·회계 실무 도구 모음</a>의 스킬을 함께 쓰세요.</p>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">법 문제로 이어질 때</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">운영 문제는 법 기한과 자주 겹쳐요. 품질 회수는 <a class="underline" href="/ko/administrative-law-guide/">행정 절차</a>, 판매장려금·특수관계 거래는 <a class="underline" href="/ko/tax-law-guide/">세금</a>, 인력 조정은 <a class="underline" href="/ko/labor-law-guide/">노동법</a>, 수입 원료는 <a class="underline" href="/ko/customs-law-guide/">관세·통관</a>, 브랜드·기술은 <a class="underline" href="/ko/ip-law-guide/">특허·상표</a> 길잡이에서 기한과 조문을 확인하세요. 직업별 역량과 도구는 <a class="underline" href="/ko/pro-competency-map/">전문 직업 역량 지도</a>에 모았어요.</p>
  </section>

  <p class="mt-8 text-xs text-muted-foreground">모든 결과는 판단을 돕는 참고값이에요. 법률·세무 자문이 아니며, 신고·계약 전에는 원문 법령과 전문가 의견을 확인해 주세요.</p>
</KrFinancePage>
