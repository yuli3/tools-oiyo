---
// 건강 금융 묶음 1 (2026-11-02, CHOSEUN 선택). ko-only: 한국 국민건강보험 본인부담상한제.
import KrFinancePage from "../../components/KrFinancePage.astro";
import CopayCapCalculator from "../../components/tools/CopayCapCalculator";
import { COPAY_CAP_2026, copayCapRefund, MEDICAL_COST_AS_OF } from "../../lib/kr-medical-cost-2026";

const title = "본인부담상한제 환급 계산기 2026 — 소득분위별 상한액과 돌려받을 병원비";
const description = "올해 병원·약국에 낸 건강보험 본인부담금과 월 건강보험료를 넣으면 2026년 소득분위별 상한액(90만~843만 원)을 넘은 금액, 곧 공단에서 돌려받을 수 있는 병원비를 계산해요.";

const man = (n: number) => `${(n / 10_000).toLocaleString("ko-KR")}만 원`;
const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const ex = copayCapRefund("d4_5", 2_500_000);

const ko = {
  eyebrow: "건강 금융 도구",
  introTitle: "병원비가 많이 나온 해, 돌려받을 돈이 있을까요?",
  intro: `건강보험 본인부담상한제는 한 해 동안 낸 건강보험 적용 병원비(본인부담금)가 소득 수준별 상한액을 넘으면 넘은 만큼을 국민건강보험공단이 돌려주는 제도예요. 2026년 진료분 상한액은 1분위 ${man(COPAY_CAP_2026.d1.general)}부터 10분위 ${man(COPAY_CAP_2026.d10.general)}까지예요. 예를 들어 4~5분위인 사람이 올해 병원과 약국에 본인부담금 250만 원을 냈다면 상한액 ${man(ex.cap)}을 넘은 ${won(ex.refund)}을 돌려받을 수 있어요. 분위는 소득이 아니라 그해 낸 건강보험료로 정해요. 비급여 진료비, 상급병실료, 임플란트처럼 상한제에 들어가지 않는 돈은 빼고 계산해요.`,
  howToTitle: "사용 방법",
  steps: [
    "급여명세서나 건강보험 고지서의 월 건강보험료(장기요양보험료 제외)를 넣어 분위를 추정해요. 분위를 알면 직접 골라도 돼요.",
    "올해 병원·약국 영수증의 '급여 본인부담금' 합계를 넣어요. 진료비 세부내역서나 The건강보험 앱에서 볼 수 있어요.",
    "요양병원에 올해 120일 넘게 입원했다면 '예'를 눌러요. 상한액이 더 높아져요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "2026년 상한액 표", body: "일반과 요양병원 120일 초과 상한액을 7개 구간 모두 보여 주고, 내 분위를 표시해요." },
    { title: "보험료로 분위 추정", body: "직장·지역가입자 월 보험료로 분위를 어림해요. 확정 분위는 공단이 다음 해에 정해요." },
    { title: "남은 금액까지", body: "아직 상한액에 닿지 않았다면 얼마 더 내야 환급이 시작되는지 알려 줘요." },
  ],
  relatedTitle: "관련 도구",
  related: [],
  disclaimer: `참고용 추정 계산이에요. 상한액은 2026년 진료분 기준이고, 분위 추정은 2025년 진료분 기준보험료(보건복지부 고시 제2026-126호) 구간을 썼어요. 실제 분위와 환급액은 다음 해 건강보험료 정산 뒤 국민건강보험공단이 확정해요. 비급여·선별급여·전액본인부담, 상급병실(2~3인실) 입원료, 임플란트, 추나요법 본인부담, 상급종합병원 경증 외래, 국가·지자체 의료비 지원금은 상한제 합산에서 빠져요. 정확한 금액은 국민건강보험공단(1577-1000, The건강보험 앱)에서 확인하세요. 이 도구는 의료 상담이나 진단을 하지 않아요. 기준일 ${MEDICAL_COST_AS_OF}.`,
};

const faqs = [
  { q: "환급금은 언제, 어떻게 받나요?", a: "개인별 상한액은 다음 해 건강보험료 정산이 끝난 뒤 확정돼요. 보통 진료받은 다음 해 8월 말쯤 공단이 안내문을 보내고, The건강보험 앱·홈페이지·전화·우편으로 계좌를 등록해 신청하면 받아요. 한 번 계좌를 등록해 두면 다음부터는 자동으로 들어와요." },
  { q: "따로 신청하지 않으면 사라지나요?", a: "환급받을 권리는 3년 동안 유지돼요(국민건강보험법 제91조). 3년이 지나면 소멸하니, 안내문을 받으면 미루지 말고 신청하세요." },
  { q: "공단을 사칭한 문자가 많다던데요.", a: "공단은 환급을 이유로 문자에 링크를 넣어 앱 설치를 요구하지 않아요. 문자 속 링크를 누르지 말고 The건강보험 공식 앱이나 1577-1000으로 직접 확인하세요." },
  { q: "실손보험금을 받았는데 상한제 환급도 받을 수 있나요?", a: "받을 수 있어요. 다만 실손보험 약관상 상한제 환급금은 보상하지 않는 손해라, 실손보험사가 나중에 환급분만큼 보험금을 돌려 달라고 하거나 미리 빼고 지급할 수 있어요. 세대와 약관에 따라 다르니 가입한 보험사에 확인하세요." },
  { q: "연말정산 의료비 세액공제와 겹치면요?", a: "공단에서 돌려받은 상한제 환급금은 의료비 세액공제 대상에서 빼야 해요. 같은 돈을 두 번 혜택받을 수 없어요. 의료비 세액공제 계산기에서 환급금을 뺀 금액으로 다시 계산해 보세요." },
  { q: "같은 병원에서 큰 금액을 냈는데 병원이 일부만 받았어요.", a: "사전급여예요. 한 병원에서 낸 본인부담금이 최고 상한액(2026년 843만 원)을 넘으면 병원이 그 위 금액을 환자 대신 공단에 청구해요. 요양병원은 사전급여 대상이 아니에요." },
];
---
<KrFinancePage slug="copay-cap-refund-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <CopayCapCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 국민건강보험법 제44조·시행령 제19조(본인부담상한제), 2026년 진료분 상한액(전년 대비 소비자물가 연동), 보건복지부 고시 제2026-126호(2025년 진료분 기준보험료). 기준일 {MEDICAL_COST_AS_OF}.</p>
</KrFinancePage>
