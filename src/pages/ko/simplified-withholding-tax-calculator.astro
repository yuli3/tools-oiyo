---
// 근로소득 간이세액표 월 원천징수 계산기 (2026-11-23, 실무 오피스 새 계산 3종, 세운 승인). 계산: lib/kr-payroll-month-2026.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import SimplifiedWithholding from "../../components/tools/office/SimplifiedWithholding";

const title = "근로소득 간이세액표 계산기 2026 — 월급에서 뗄 소득세 찾기";
const description = "소득세법 시행령 별표2 간이세액표(2026. 2. 27. 개정)로 월급여액과 공제대상가족 수에 맞는 원천징수 소득세를 찾아요. 8~20세 자녀 차감(20,830원·45,830원), 80·100·120% 선택, 1천만 원 초과 산식, 지방소득세까지.";
const shell = {
  introTitle: "매달 떼는 소득세는 표에서 찾아요",
  intro: "회사는 매달 급여를 줄 때 근로소득 간이세액표에서 월급여액(비과세·학자금 제외)과 공제대상가족 수가 만나는 칸의 세액을 떼요. 이 계산기는 국가법령정보센터의 별표2 원문 표 646구간을 그대로 담았어요. 실수령액 계산기의 추정 소득세와 달리 표 값 그대로예요.",
  howToTitle: "이렇게 써요",
  steps: ["월급여액에서 식대 같은 비과세와 학자금을 뺀 금액을 넣어요.", "공제대상가족 수를 넣어요. 본인과 배우자도 각각 1명이에요.", "그중 8세 이상 20세 이하 자녀 수를 넣으면 자녀 차감이 들어가요.", "근로자가 80%나 120%를 신청했다면 비율을 바꿔요."],
  highlightsTitle: "표에 담긴 규칙",
  highlights: [
    { title: "자녀 차감(2026. 2. 27. 개정)", body: "8~20세 자녀 1명 20,830원, 2명 45,830원, 3명 이상은 45,830원에 2명 넘는 1명마다 33,330원을 표 세액에서 빼요. 음수면 0원이에요." },
    { title: "1천만 원 초과", body: "1천만 원 세액에 원문 산식을 더해요. 예: 1천만~1,400만 원은 초과분 × 98% × 35% + 25,000원." },
    { title: "80·100·120%", body: "근로자가 신청하면 표 세액의 80% 또는 120%를 뗄 수 있고, 고른 비율은 그해 끝까지 적용돼요(시행령 제194조)." },
  ],
  disclaimer: "원천징수 금액을 찾는 도구예요. 실제 세금은 연말정산에서 확정돼요. 새 자녀 차감액이 어느 달 지급분부터 적용되는지는 부칙 확인 전이라, 지급 시점이 이르면 국세청 원천징수 안내(126)를 확인하세요.",
};
const faqs = [
  { q: "실수령액 계산기와 소득세가 왜 달라요?", a: "실수령액 계산기는 연간 세액을 12로 나눈 추정이고, 이 계산기는 회사가 실제로 쓰는 간이세액표 칸 값을 찾아요." },
  { q: "공제대상가족은 누구까지예요?", a: "기본공제를 받는 사람 수예요. 본인과 배우자도 각각 1명으로 세요. 11명이 넘으면 원문 4호 산식으로 계산해요." },
  { q: "77만 원 미만이면요?", a: "표가 770천원부터 시작하고 그 구간 세액이 0원이라 0원으로 보여요." },
];
---
<KrFinancePage slug="simplified-withholding-tax-calculator" locale="ko" title={title} description={description} shell={shell} faqs={faqs} koOnly group="money">
  <SimplifiedWithholding client:load />
  <p class="mt-4 text-sm text-muted-foreground">관련: <a class="underline underline-offset-4" href="/ko/join-leave-month-insurance-calculator/">입사·퇴사 달 4대보험료</a> · <a class="underline underline-offset-4" href="/ko/salary-calculator/">실수령액 계산기</a> · <a class="underline underline-offset-4" href="/ko/pro-office/#KR/tax">실무 오피스 세무실</a></p>
</KrFinancePage>
