---
import Layout from "../../components/Layout.astro";
import RelatedTools from "../../components/RelatedTools.astro";
---

<Layout
  title="부동산 중개보수(복비) 계산기 — 2026년 법정 상한요율·한도액·부가세 자동 계산"
  description="매매·전세·월세, 주택·오피스텔·상가별 공인중개사법 법정 상한 요율(0.3%~0.9%), 한도액, 부가세(10%)를 자동 적용하여 최대 중개수수료를 즉시 계산합니다."
>
  <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 sm:py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold mb-3">
        공인중개사법 시행규칙 제20조 개정 요율표 반영
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-foreground tracking-tight mb-2">
        부동산 중개보수 (복비) 계산기
      </h1>
      <p class="text-sm text-muted-foreground max-w-xl mx-auto">
        주택·오피스텔·상가의 매매, 전세, 월세 계약 시 법적으로 청구 가능한 최대 중개수수료와 부가세를 산출합니다.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Input Form -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm space-y-5">
        <!-- Property Type -->
        <div>
          <label class="block text-xs font-bold text-foreground mb-1.5">
            부동산 종류
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button
              id="prop-house"
              type="button"
              class="prop-btn py-2.5 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center"
              data-type="house"
            >
              주택 (아파트·빌라)
            </button>
            <button
              id="prop-officetel"
              type="button"
              class="prop-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-type="officetel"
            >
              주거용 오피스텔
            </button>
            <button
              id="prop-other"
              type="button"
              class="prop-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-type="other"
            >
              상가 · 토지
            </button>
          </div>
        </div>

        <!-- Deal Type -->
        <div>
          <label class="block text-xs font-bold text-foreground mb-1.5">
            거래 유형
          </label>
          <div class="grid grid-cols-3 gap-2">
            <button
              id="deal-trade"
              type="button"
              class="deal-btn py-2.5 px-3 text-xs font-bold rounded-xl border border-primary bg-primary/10 text-primary transition-all text-center"
              data-deal="trade"
            >
              매매 · 교환
            </button>
            <button
              id="deal-jeonse"
              type="button"
              class="deal-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-deal="jeonse"
            >
              전세
            </button>
            <button
              id="deal-monthly"
              type="button"
              class="deal-btn py-2.5 px-3 text-xs font-medium rounded-xl border border-border bg-muted/20 text-muted-foreground transition-all text-center hover:bg-muted"
              data-deal="monthly"
            >
              월세
            </button>
          </div>
        </div>

        <!-- Amount Inputs -->
        <div id="price-container">
          <label id="price-label" class="block text-xs font-bold text-foreground mb-1.5">
            매매 금액 (원)
          </label>
          <div class="relative">
            <input
              id="input-price"
              type="number"
              min="0"
              step="1000000"
              value="500000000"
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm text-foreground font-mono focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
            <span class="absolute right-3.5 top-2.5 text-xs text-muted-foreground font-medium">원</span>
          </div>
          <p id="price-text" class="text-xs text-primary font-medium mt-1">5억 원</p>
        </div>

        <!-- Monthly Rent Extra Input (Hidden by default) -->
        <div id="monthly-container" class="hidden">
          <label class="block text-xs font-bold text-foreground mb-1.5">
            월차임 (월세, 원)
          </label>
          <div class="relative">
            <input
              id="input-monthly"
              type="number"
              min="0"
              step="50000"
              value="1000000"
              class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm text-foreground font-mono focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
            <span class="absolute right-3.5 top-2.5 text-xs text-muted-foreground font-medium">원</span>
          </div>
          <p id="monthly-text" class="text-xs text-primary font-medium mt-1">100만 원</p>
        </div>

        <!-- VAT Selection -->
        <div>
          <label class="block text-xs font-bold text-foreground mb-1.5">
            부가가치세 (VAT)
          </label>
          <select
            id="vat-rate"
            class="w-full px-3.5 py-2.5 rounded-xl border border-border bg-background text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20"
          >
            <option value="10">일반과세자 (10% 별도 부과)</option>
            <option value="4">간이과세자 (4% 부과)</option>
            <option value="0">부가세 미포함 (면세/비과세)</option>
          </select>
        </div>
      </div>

      <!-- Result Panel -->
      <div class="lg:col-span-6 bg-card border border-border rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-base font-bold text-foreground mb-4 pb-2 border-b border-border">
            법정 최대 중개보수 산출 결과
          </h2>

          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs">
              <span class="text-muted-foreground">환산 거래금액</span>
              <span id="res-calc-amount" class="font-bold text-foreground font-mono">500,000,000원</span>
            </div>

            <div class="flex items-center justify-between text-xs">
              <span class="text-muted-foreground">적용 상한 요율</span>
              <span id="res-rate" class="font-bold text-foreground font-mono">0.4%</span>
            </div>

            <div class="flex items-center justify-between text-xs">
              <span class="text-muted-foreground">법정 한도액</span>
              <span id="res-cap" class="font-medium text-foreground">적용 없음 (한도 없음)</span>
            </div>

            <div class="flex items-center justify-between text-xs pt-2 border-t border-border/60">
              <span class="text-muted-foreground">중개보수 (VAT 제외)</span>
              <span id="res-fee" class="font-bold text-foreground font-mono">2,000,000원</span>
            </div>

            <div class="flex items-center justify-between text-xs">
              <span class="text-muted-foreground">부가가치세</span>
              <span id="res-vat" class="font-bold text-muted-foreground font-mono">200,000원</span>
            </div>

            <div class="p-4 rounded-xl bg-primary/10 border border-primary/20 text-center mt-6">
              <span class="text-xs font-semibold text-primary block">최종 지불 최대 금액 (중개보수 + VAT)</span>
              <span id="res-total" class="text-2xl sm:text-3xl font-black text-primary font-mono block mt-1">
                2,200,000원
              </span>
              <span id="res-total-kor" class="text-xs text-muted-foreground block mt-1">
                (이백이십만 원)
              </span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-border/60 text-xs text-muted-foreground space-y-1">
          <p>• 계산된 금액은 <strong>법률상 청구 가능한 상한액</strong>이며, 계약 당사자와 중개인 간 협의를 통해 이보다 낮은 금액으로 정할 수 있습니다.</p>
          <p>• 법정 한도를 초과하여 수수한 중개수수료는 초과분 전액이 무효이며, 공인중개사는 형사처벌 및 자격정지 처분을 받게 됩니다.</p>
        </div>
      </div>
    </div>

    <!-- Educational Section -->
    <div class="mt-12 bg-muted/20 border border-border rounded-2xl p-6 sm:p-8 space-y-6">
      <h3 class="text-lg font-bold text-foreground">
        2026년 주택 중개보수 법정 요율표 안내
      </h3>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left border-collapse">
          <thead>
            <tr class="border-b border-border bg-muted/40 text-foreground font-semibold">
              <th class="p-2.5">거래 종류</th>
              <th class="p-2.5">거래 금액 구간</th>
              <th class="p-2.5">상한 요율</th>
              <th class="p-2.5">한도액</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60 text-muted-foreground">
            <tr>
              <td rowspan="6" class="p-2.5 font-bold text-foreground bg-muted/10">매매 · 교환</td>
              <td class="p-2.5">5천만 원 미만</td>
              <td class="p-2.5 font-mono">0.6%</td>
              <td class="p-2.5">25만 원</td>
            </tr>
            <tr>
              <td class="p-2.5">5천만 원 이상 ~ 2억 원 미만</td>
              <td class="p-2.5 font-mono">0.5%</td>
              <td class="p-2.5">80만 원</td>
            </tr>
            <tr>
              <td class="p-2.5">2억 원 이상 ~ 9억 원 미만</td>
              <td class="p-2.5 font-mono">0.4%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">9억 원 이상 ~ 12억 원 미만</td>
              <td class="p-2.5 font-mono">0.5%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">12억 원 이상 ~ 15억 원 미만</td>
              <td class="p-2.5 font-mono">0.6%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">15억 원 이상</td>
              <td class="p-2.5 font-mono">0.7%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td rowspan="6" class="p-2.5 font-bold text-foreground bg-muted/10">임대차 (전세·월세)</td>
              <td class="p-2.5">5천만 원 미만</td>
              <td class="p-2.5 font-mono">0.5%</td>
              <td class="p-2.5">20만 원</td>
            </tr>
            <tr>
              <td class="p-2.5">5천만 원 이상 ~ 1억 원 미만</td>
              <td class="p-2.5 font-mono">0.4%</td>
              <td class="p-2.5">30만 원</td>
            </tr>
            <tr>
              <td class="p-2.5">1억 원 이상 ~ 9억 원 미만</td>
              <td class="p-2.5 font-mono">0.3%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">9억 원 이상 ~ 12억 원 미만</td>
              <td class="p-2.5 font-mono">0.4%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">12억 원 이상 ~ 15억 원 미만</td>
              <td class="p-2.5 font-mono">0.5%</td>
              <td class="p-2.5">-</td>
            </tr>
            <tr>
              <td class="p-2.5">15억 원 이상</td>
              <td class="p-2.5 font-mono">0.6%</td>
              <td class="p-2.5">-</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Related Tools -->
    <div class="mt-12">
      <RelatedTools currentId="brokerage-fee" />
    </div>
  </div>
</Layout>

<script>
  let propType = 'house';
  let dealType = 'trade';

  const propBtns = document.querySelectorAll('.prop-btn');
  const dealBtns = document.querySelectorAll('.deal-btn');
  const priceInput = document.getElementById('input-price') as HTMLInputElement;
  const monthlyInput = document.getElementById('input-monthly') as HTMLInputElement;
  const monthlyContainer = document.getElementById('monthly-container') as HTMLDivElement;
  const priceLabel = document.getElementById('price-label') as HTMLLabelElement;
  const priceText = document.getElementById('price-text') as HTMLParagraphElement;
  const monthlyText = document.getElementById('monthly-text') as HTMLParagraphElement;
  const vatSelect = document.getElementById('vat-rate') as HTMLSelectElement;

  function toKoreanAmount(num: number): string {
    if (num <= 0) return '0원';
    const eok = Math.floor(num / 100000000);
    const man = Math.floor((num % 100000000) / 10000);
    const won = num % 10000;
    const parts = [];
    if (eok > 0) parts.push(`${eok}억`);
    if (man > 0) parts.push(`${man.toLocaleString()}만`);
    if (won > 0) parts.push(`${won.toLocaleString()}`);
    return `${parts.join(' ')} 원`;
  }

  function calculateFee() {
    const rawPrice = parseFloat(priceInput.value) || 0;
    const rawMonthly = parseFloat(monthlyInput.value) || 0;
    const vatRate = parseFloat(vatSelect.value) / 100;

    let calcAmount = rawPrice;

    if (dealType === 'monthly') {
      let candidate = rawPrice + (rawMonthly * 100);
      if (candidate < 50000000) {
        candidate = rawPrice + (rawMonthly * 70);
      }
      calcAmount = candidate;
    }

    priceText.textContent = toKoreanAmount(rawPrice);
    monthlyText.textContent = toKoreanAmount(rawMonthly);

    let rate = 0.009;
    let cap: number | null = null;

    if (propType === 'house') {
      if (dealType === 'trade') {
        if (calcAmount < 50000000) { rate = 0.006; cap = 250000; }
        else if (calcAmount < 200000000) { rate = 0.005; cap = 800000; }
        else if (calcAmount < 900000000) { rate = 0.004; cap = null; }
        else if (calcAmount < 1200000000) { rate = 0.005; cap = null; }
        else if (calcAmount < 1500000000) { rate = 0.006; cap = null; }
        else { rate = 0.007; cap = null; }
      } else {
        // jeonse or monthly
        if (calcAmount < 50000000) { rate = 0.005; cap = 200000; }
        else if (calcAmount < 100000000) { rate = 0.004; cap = 300000; }
        else if (calcAmount < 900000000) { rate = 0.003; cap = null; }
        else if (calcAmount < 1200000000) { rate = 0.004; cap = null; }
        else if (calcAmount < 1500000000) { rate = 0.005; cap = null; }
        else { rate = 0.006; cap = null; }
      }
    } else if (propType === 'officetel') {
      rate = dealType === 'trade' ? 0.005 : 0.004;
      cap = null;
    } else {
      // other (commercial / land)
      rate = 0.009;
      cap = null;
    }

    let fee = Math.floor(calcAmount * rate);
    let capApplied = false;
    if (cap !== null && fee > cap) {
      fee = cap;
      capApplied = true;
    }

    const vat = Math.floor(fee * vatRate);
    const total = fee + vat;

    const resCalcAmount = document.getElementById('res-calc-amount')!;
    const resRate = document.getElementById('res-rate')!;
    const resCap = document.getElementById('res-cap')!;
    const resFee = document.getElementById('res-fee')!;
    const resVat = document.getElementById('res-vat')!;
    const resTotal = document.getElementById('res-total')!;
    const resTotalKor = document.getElementById('res-total-kor')!;

    resCalcAmount.textContent = `${calcAmount.toLocaleString()}원`;
    resRate.textContent = `${(rate * 100).toFixed(1)}%`;
    resCap.textContent = cap ? `${cap.toLocaleString()}원 ${capApplied ? '(한도 적용됨)' : '(초과 안 함)'}` : '한도 없음';
    resFee.textContent = `${fee.toLocaleString()}원`;
    resVat.textContent = `${vat.toLocaleString()}원`;
    resTotal.textContent = `${total.toLocaleString()}원`;
    resTotalKor.textContent = `(${toKoreanAmount(total)})`;
  }

  propBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      propBtns.forEach((b) => {
        b.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
        b.classList.add('border-border', 'bg-muted/20', 'text-muted-foreground', 'font-medium');
      });
      btn.classList.remove('border-border', 'bg-muted/20', 'text-muted-foreground', 'font-medium');
      btn.classList.add('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
      propType = btn.getAttribute('data-type')!;
      calculateFee();
    });
  });

  dealBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      dealBtns.forEach((b) => {
        b.classList.remove('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
        b.classList.add('border-border', 'bg-muted/20', 'text-muted-foreground', 'font-medium');
      });
      btn.classList.remove('border-border', 'bg-muted/20', 'text-muted-foreground', 'font-medium');
      btn.classList.add('border-primary', 'bg-primary/10', 'text-primary', 'font-bold');
      dealType = btn.getAttribute('data-deal')!;

      if (dealType === 'monthly') {
        monthlyContainer.classList.remove('hidden');
        priceLabel.textContent = '임대 보증금 (원)';
      } else {
        monthlyContainer.classList.add('hidden');
        priceLabel.textContent = dealType === 'trade' ? '매매 금액 (원)' : '전세 보증금 (원)';
      }
      calculateFee();
    });
  });

  priceInput.addEventListener('input', calculateFee);
  monthlyInput.addEventListener('input', calculateFee);
  vatSelect.addEventListener('change', calculateFee);

  calculateFee();
</script>
