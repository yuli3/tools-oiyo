---
import DebtReliefPage from '../../components/DebtReliefPage.astro';
import KrDesk from '../../components/tools/plan/KrDesk';
// 2026-11-23 brainstorm. Data: lib/kr-desks-2026.ts (no calculation; deadlines from statutes, amounts in linked calculators).
const c = {
  introTitle: '내 직업에는 어떤 세금·노무 일정이 있을까?',
  intro: '같은 1인 사업자라도 유튜버, 배달 라이더, 카페 사장, 쇼핑몰 운영자, 프리랜서 개발자는 챙길 것이 달라요. 하는 일을 고르면 사업자등록, 부가가치세·종합소득세 신고 시기, 4대보험·산재, 계약서처럼 그 직업에 맞는 할 일과 기한을 순서대로 보여 주고, 금액은 이어지는 계산기에서 바로 확인할 수 있어요.',
  formulaTitle: '이렇게 정리했어요',
  formulas: [
    { title: '할 일과 기한', body: '법령에 적힌 기한만 적고, 근거 조문을 함께 표시해요.' },
    { title: '이어지는 도구', body: '세액·급여·보험료 같은 금액은 각 계산기에서 계산해요.' },
    { title: '무료 창구', body: '국세청 126, 고용노동부 1350 같은 공식 상담 창구를 함께 안내해요.' },
  ],
  howToTitle: '이렇게 써요',
  steps: ['하는 일을 적거나 직업을 골라요.', '할 일을 하나씩 체크해요.', '필요한 계산기로 넘어가 금액을 확인해요.'],
  faqTitle: '자주 묻는 질문',
  faqs: [
    { question: '여러 일을 함께 하면요?', answer: '해당하는 직업을 모두 열어 보세요. 신고는 사업장·소득 종류별로 합쳐서 해요.' },
    { question: '체크한 내용이 저장되나요?', answer: '아니요. 이 화면에서만 쓰이고 어디에도 보내지 않아요.' },
  ],
  disclaimer: '일반 정보이며 세무·법률 자문이 아니에요. 개별 사안은 무료 공식 창구나 자격사에 확인하세요.',
};
const sources: [string, string][] = [['국가법령정보센터', 'https://www.law.go.kr/']];
---
<DebtReliefPage slug="job-desk" c={c} sources={sources} sourcesTitle="출처" checked="조문 확인: 2026-11-23">
  <KrDesk client:load kind="job" />
</DebtReliefPage>
