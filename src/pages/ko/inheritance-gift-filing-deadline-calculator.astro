const faqs = [{"q": "3월 15일에 돌아가셨으면 언제까지예요?", "a": "3월 31일부터 6개월이라 9월 30일까지 상속세를 신고·납부해요."}, {"q": "증여세는 누가 내요?", "a": "받은 사람(수증자)이 신고·납부해요."}, {"q": "기한을 넘겼어요.", "a": "1개월 안에 기한 후 신고를 하면 무신고 가산세의 50%를 깎아 줘요. 빠를수록 좋아요."}, {"q": "세금을 한 번에 못 내요.", "a": "1천만 원을 넘으면 2개월 분납, 2천만 원을 넘으면 담보를 잡고 연부연납(상속 10년, 증여 5년)을 신청할 수 있어요."}];
