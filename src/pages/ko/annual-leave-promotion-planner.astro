const faqs = [{"q": "회사가 문자로만 촉구했어요", "a": "고용노동부는 개별 근로자에게 서면(전자문서 포함)으로 해야 한다고 봐요. 단체 문자·게시판 공지는 인정되지 않을 수 있어요."}, {"q": "지정된 날에 출근했어요", "a": "회사가 노무 수령을 거부한다는 뜻을 분명히 하지 않았다면 수당을 청구할 수 있어요."}, {"q": "퇴사하면 촉진은 어떻게 되나요?", "a": "퇴사로 근로관계가 끝나면 남은 연차는 수당으로 정산하는 것이 원칙이에요."}, {"q": "5명 미만 회사는요?", "a": "연차휴가 자체가 적용되지 않아 촉진 절차도 없어요."}];
