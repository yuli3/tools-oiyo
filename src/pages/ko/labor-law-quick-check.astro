---
// Moved from blog.oiyo.net/labor-law-quick-check/ on 2026-10-27 (W10a). Korean labor law only; Blog's English
// version was generic advice. Static page (no client script): each card links to the tool that does the math.
import KrFinancePage from "../../components/KrFinancePage.astro";
import { RATES, RATES_AS_OF } from "../../lib/kr-payroll-2026";

const title = "사회초년생 노동법 체크리스트 2026 — 최저임금·주휴수당·휴게·근로계약";
const description = "2026년 최저임금 10,320원, 주휴수당, 휴게시간, 연장·야간 가산, 근로계약서, 부당해고 구제까지 첫 직장·알바 전에 확인할 노동법을 한 장에 정리했습니다.";
const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;

const groups = [
  {
    title: "임금",
    items: [
      { q: "2026년 최저임금은?", a: `시간급 ${won(RATES.minimumWage)}, 주 40시간 기준 월 환산액(209시간) 2,156,880원입니다. 2027년은 10,700원으로 결정됐습니다.`, href: "/ko/weekly-holiday-pay-calculator/", link: "주휴수당 계산" },
      { q: "주휴수당은 누가 받나요?", a: "4주 평균 1주 소정근로시간이 15시간 이상이고 그 주 소정근로일을 개근하면 받습니다. 5인 미만 사업장도 적용됩니다(근로기준법 제55조, 제18조 제3항).", href: "/ko/weekly-holiday-pay-calculator/", link: "주휴수당 계산" },
      { q: "연장·야간·휴일 가산은?", a: "상시 5인 이상 사업장은 연장·야간(22시~06시)·휴일근로에 통상임금의 50%를 더 줍니다. 휴일 8시간 초과분은 100%입니다(제56조). 5인 미만은 가산이 없습니다.", href: "/ko/overtime-pay-calculator/", link: "연장수당 계산" },
    ],
  },
  {
    title: "시간과 휴식",
    items: [
      { q: "휴게시간은 얼마나?", a: "4시간 일하면 30분 이상, 8시간이면 1시간 이상을 근로시간 도중에 줘야 합니다(제54조). 출근 전이나 퇴근 후에 몰아 주는 것은 휴게가 아닙니다." },
      { q: "일주일에 최대 몇 시간?", a: "기본 주 40시간, 당사자가 합의하면 연장 12시간까지 주 52시간입니다(제50조, 제53조). 5인 미만 사업장은 이 상한이 적용되지 않습니다." },
      { q: "연차휴가는 언제 생기나요?", a: "5인 이상 사업장에서 1년 미만은 1개월 개근마다 1일(최대 11일), 1년간 80% 이상 출근하면 15일이 생깁니다(제60조).", href: "/ko/annual-leave-calculator/", link: "연차 계산" },
    ],
  },
  {
    title: "계약과 보험",
    items: [
      { q: "근로계약서는 언제 쓰나요?", a: "일을 시작하기 전에 임금·근로시간·휴일·연차 등을 적어 서면으로 주고받아야 합니다. 안 쓰면 사업주에게 500만 원 이하 벌금입니다(제17조, 제114조). 단시간 근로자는 근무일·시간을 구체적으로 적어야 합니다." },
      { q: "알바도 4대보험에 가입하나요?", a: "월 60시간(주 15시간) 이상이면 대체로 고용·건강·국민연금 대상이고, 산재보험은 하루만 일해도 적용됩니다. 일용직은 월 8일·60시간 기준을 따로 봅니다.", href: "/ko/daily-worker-insurance-checker/", link: "4대보험 판정" },
      { q: "퇴직금은 언제 받나요?", a: "4주 평균 주 15시간 이상, 1년 이상 일하면 30일분 평균임금 × 근속연수를 퇴직 후 14일 안에 받습니다(근로자퇴직급여 보장법 제8조, 제9조).", href: "/ko/severance-calculator/", link: "퇴직금 계산" },
    ],
  },
  {
    title: "문제가 생기면",
    items: [
      { q: "월급을 못 받았다면?", a: "임금 체불은 고용노동부에 진정할 수 있고, 임금채권 소멸시효는 3년입니다(제49조). 퇴사 후 14일이 지나도 못 받으면 연 20% 지연이자가 붙습니다(제37조).", href: "/ko/statute-limitations-calculator/", link: "소멸시효 계산" },
      { q: "부당해고를 당했다면?", a: "상시 5인 이상 사업장이면 해고된 날부터 3개월 안에 지방노동위원회에 구제신청을 할 수 있습니다(제28조). 해고는 30일 전에 예고하거나 30일분 통상임금을 줘야 합니다(제26조)." },
      { q: "어디에 물어보나요?", a: "고용노동부 고객상담센터 1350, 대한법률구조공단 132에서 무료로 상담받을 수 있습니다." },
    ],
  },
];

const ko = {
  introTitle: "첫 출근 전에 꼭 확인할 노동법",
  intro: `2026년 최저임금은 시간급 ${won(RATES.minimumWage)}입니다. 주 15시간 이상 일하면 주휴수당, 5인 이상 사업장이면 연장·야간 가산과 연차휴가가 생깁니다. 근로계약서는 일을 시작하기 전에 써서 한 부를 받아야 합니다. 아래 카드에서 상황별 기준과 근거 조문, 바로 계산해 볼 수 있는 도구를 확인하세요.`,
  howToTitle: "사용 방법",
  steps: ["궁금한 항목을 눌러 기준과 근거 조문을 확인합니다.", "금액이 필요하면 카드 아래 계산기 링크로 이동합니다.", "분쟁이 생기면 1350(고용노동부)이나 132(법률구조공단)에 상담합니다."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "2026년 기준", body: "최저임금 10,320원과 현재 근로기준법 조문으로 정리했습니다." },
    { title: "5인 기준 표시", body: "5인 미만 사업장에 적용되지 않는 규정을 함께 적었습니다." },
    { title: "계산기 연결", body: "주휴수당·4대보험·연장수당·소멸시효 도구로 바로 이어집니다." },
  ],
  disclaimer: `일반적인 안내이며 법률 자문이 아닙니다. 업종·근로형태에 따라 예외가 있습니다. 기준일 ${RATES_AS_OF}.`,
};
---
<KrFinancePage slug="labor-law-quick-check" locale="ko" title={title} description={description} shell={ko} koOnly>
  <div class="space-y-6">
    {groups.map((g) => (
      <section>
        <h2 class="mb-2 text-sm font-semibold text-muted-foreground">{g.title}</h2>
        <div class="space-y-2">
          {g.items.map((item) => (
            <details class="rounded-lg border border-border bg-card px-4 py-3">
              <summary class="min-h-11 cursor-pointer py-2 font-semibold text-foreground">{item.q}</summary>
              <p class="mt-1 text-sm leading-6 text-muted-foreground">{item.a}</p>
              {item.href && <a class="mt-2 inline-flex min-h-11 items-center text-sm text-primary underline" href={item.href}>{item.link} →</a>}
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>
  <p class="mt-4 text-xs text-muted-foreground">근거: 근로기준법 제17조·제18조·제26조·제28조·제36조·제37조·제49조·제50조·제53조~제56조·제60조, 근로자퇴직급여 보장법 제8조·제9조, 2026년 최저임금 고시. 기준일 {RATES_AS_OF}.</p>
</KrFinancePage>
