---
// 구독형 달력(webcal) 안내 (2026-11-22, 창의 제안 #1). 한 번 구독하면 공휴일·24절기·세금 마감이 내 달력에 매년 떠요.
// 피드: src/pages/cal/[feed].ics.ts, 엔진: lib/calendar-feeds.ts (세금 마감은 biz-checklist taxCalendar 재사용)
import KrFinancePage from "../../components/KrFinancePage.astro";
import { FEEDS, FEEDS_AS_OF, feedEvents, feedUrl, googleAddUrl, webcalUrl, solarTerms } from "../../lib/calendar-feeds.ts";

const title = "구독형 달력 — 공휴일·24절기·세금 신고 마감을 내 폰 달력에";
const description = "구글 캘린더·아이폰 달력에 한 번 구독하면 2026~2027 공휴일, 24절기, 부가세·종합소득세·원천세 마감일이 자동으로 들어오고 마감 1주 전에 알려 줘요. 무료예요.";
const today = new Date(Date.now() + 9 * 3600_000).toISOString().slice(0, 10);
const cards = FEEDS.map((f) => {
  const ev = feedEvents(f.slug);
  const next = ev.find((e) => e.date >= today);
  return { ...f, count: ev.length, next, ics: feedUrl(f.slug), webcal: webcalUrl(f.slug), google: googleAddUrl(f.slug) };
});
const terms = solarTerms(2027);
const shell = {
  introTitle: "달력에 한 번만 넣어 두면 돼요",
  intro: "파일을 내려받는 방식이 아니라 '구독' 방식이에요. 달력 앱이 하루에 한 번 이 주소를 다시 읽어서, 대체공휴일이 새로 정해지거나 마감일이 바뀌면 저절로 고쳐져요. 세금 마감은 토·일·공휴일이면 다음 영업일로 옮긴 날짜(국세기본법 제5조)로 넣었고, 1주 전에 알림이 와요. 24절기는 태양 황경을 천문 계산해서 한국 표준시 날짜로 넣었어요.",
  howToTitle: "구독 방법",
  steps: [
    "아이폰·맥: 'iPhone·맥 달력에 추가'를 누르면 구독 창이 바로 떠요. '구독'을 누르면 끝이에요.",
    "구글 캘린더(안드로이드): 'Google 캘린더에 추가'를 눌러 컴퓨터나 폰 브라우저에서 '추가'를 누르세요. 몇 분 뒤 폰 앱에도 보여요.",
    "아웃룩·그 밖의 앱: '주소 복사'로 주소를 복사한 뒤 '인터넷 달력 추가(URL로 구독)' 메뉴에 붙여 넣으세요.",
  ],
  highlightsTitle: "어떤 일정이 들어오나요",
  highlights: [
    { title: "공휴일", body: "설·추석 연휴와 대체공휴일까지. 2027년 광복절·개천절·한글날·성탄절 대체공휴일도 들어 있어요." },
    { title: "24절기", body: `2026~2028년. 2027년 입춘은 ${terms.find((t) => t.name === "입춘")?.date}, 동지는 ${terms.find((t) => t.name === "동지")?.date}이에요.` },
    { title: "세금 마감 + 1주 전 알림", body: "사업 형태에 맞는 피드 하나를 고르세요. 직원·프리랜서에게 돈을 주면 원천세 피드를 하나 더 구독하면 돼요." },
    { title: "일정마다 계산기 링크", body: "부가세 마감엔 부가세 계산기, 지급명세서 마감엔 기한·가산세 계산기 링크가 붙어 있어 미리 계산해 볼 수 있어요." },
  ],
  disclaimer: `기준일 ${FEEDS_AS_OF}. 세금 일정은 12월 결산·일반적인 경우의 참고용이에요. 고지서, 홈택스 안내, 임시공휴일 지정에 따라 달라질 수 있어요. 2027년 5월 3일(노동절 대체 여부)은 자료가 엇갈려 넣지 않았어요.`,
};
const faqs = [
  { q: "돈이 들거나 가입해야 하나요?", a: "아니요. 무료이고 가입도 없어요. 달력 앱에 주소 하나를 구독하는 것뿐이에요." },
  { q: "구독을 끊고 싶어요", a: "달력 앱의 캘린더 목록에서 'OIYO …' 캘린더를 삭제하거나 구독 해지하면 일정이 모두 사라져요." },
  { q: "내 일정이 보내지나요?", a: "아니요. 달력 앱이 이 파일을 읽기만 해요. 내 달력 내용은 우리에게 오지 않아요." },
  { q: "2028년 일정은요?", a: "정부가 다음 해 공휴일을 발표하면 매년 가을에 더해요. 구독해 두면 따로 할 일이 없어요." },
];
const btn = "inline-flex min-h-11 items-center justify-center rounded-md border border-border px-3 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-ring";
---
<KrFinancePage slug="calendar-subscribe" locale="ko" title={title} description={description} shell={shell} faqs={faqs} koOnly group="time">
  <section class="space-y-6">
    {(["life", "tax"] as const).map((g) => (
      <div class="space-y-3">
        <h2 class="text-lg font-semibold">{g === "life" ? "누구나" : "사업자 세금 마감"}</h2>
        <ul class="space-y-3">
          {cards.filter((c) => c.group === g).map((c) => (
            <li class="rounded-lg border border-border p-4">
              <p class="font-semibold text-foreground">{c.name}</p>
              <p class="mt-1 text-sm text-muted-foreground">{c.short} · {c.who} · 일정 {c.count}개</p>
              {c.next && <p class="mt-1 text-sm text-foreground">다음 일정: <b>{c.next.date}</b> {c.next.title}</p>}
              <div class="mt-3 flex flex-wrap gap-2">
                <a class={btn} href={c.webcal} data-cal-sub={c.slug} data-cal-kind="webcal">iPhone·맥 달력에 추가</a>
                <a class={btn} href={c.google} target="_blank" rel="noopener" data-cal-sub={c.slug} data-cal-kind="google">Google 캘린더에 추가</a>
                <button type="button" class={btn} data-copy={c.ics} data-cal-sub={c.slug} data-cal-kind="copy">주소 복사</button>
              </div>
              <p class="mt-2 break-all font-mono text-xs text-muted-foreground">{c.ics}</p>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p aria-live="polite" id="copy-status" class="text-sm text-foreground"></p>
  </section>
  <p class="mt-4 text-xs text-muted-foreground">함께 보기: <a class="underline" href="/ko/business-must-do-checklist/">사업자 필수 체크리스트·세무 달력</a> · <a class="underline" href="/ko/annual-leave-combo-2027/">2027 연차 꿀조합 계산기</a> · <a class="underline" href="/ko/business-day-checker/">영업일·공휴일 판별기</a></p>
  <script>
    const status = document.getElementById("copy-status");
    document.querySelectorAll<HTMLElement>("[data-cal-sub]").forEach((el) => {
      el.addEventListener("click", async () => {
        const w = window as unknown as { gtag?: (...a: unknown[]) => void };
        w.gtag?.("event", "calendar_subscribe", { feed: el.dataset.calSub, method: el.dataset.calKind });
        const url = el.dataset.copy;
        if (!url) return;
        try {
          await navigator.clipboard.writeText(url);
          if (status) status.textContent = "주소를 복사했어요. 달력 앱의 'URL로 구독'에 붙여 넣으세요.";
        } catch {
          if (status) status.textContent = `복사가 안 되면 이 주소를 길게 눌러 복사하세요: ${url}`;
        }
      });
    });
  </script>
</KrFinancePage>
