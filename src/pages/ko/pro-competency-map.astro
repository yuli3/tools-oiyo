---
// 전문 직업 역량 지도 (2026-11-17). 세운 요청 "각 전문가들에게 필요한 역량들을 리스트화·분류·카테고리화, 도구와 스킬 등을 연결".
// 직업 이름은 "누가 이 역량을 쓰는지" 설명에만 써요. 우리 도구는 자격사가 아니고 법령 길잡이예요.
import KrFinancePage from "../../components/KrFinancePage.astro";
import CompetencyMap from "../../components/tools/lawguide/CompetencyMap";
import { CATEGORIES, COMPETENCIES, COMPETENCY_AS_OF, JOBS, SKILLS, SKILLS_REPO, isGap } from "../../data/pro-competencies";

const title = `전문 직업 역량 지도 — 세무·회계·노무·행정·등기·보험·관세·특허·감정평가·중개·건축·의료·가사·복지·경영 ${JOBS.length}개 직업의 역량과 연결 도구`;
const description = `${JOBS.map((j) => j.name).join("·")}에게 필요한 역량 ${COMPETENCIES.length}개를 법령 해석·계산·기한·서류·상담·업무 범위·전자 업무 7가지로 나누고, 바로 쓸 수 있는 계산 도구·Claude 스킬·MCP를 연결했어요. 일반인도 같은 도구로 자기 문제를 정리할 수 있어요.`;
const gaps = COMPETENCIES.filter(isGap);
const jobName = (id: string) => JOBS.find((j) => j.id === id)!.name;
const faqs = [
  { q: "이 지도를 누가 쓰나요?", a: "업계 종사자는 자기 직업에 필요한 역량을 점검하고 업무에 바로 쓸 계산 도구를 찾을 때, 수험생은 공부 범위를 잡을 때, 일반인은 자기 문제가 어느 전문 분야에 속하고 무엇을 먼저 계산해 볼 수 있는지 알고 싶을 때 써요." },
  { q: "도구가 자격사 일을 대신하나요?", a: "아니에요. 세무대리, 노동 사건 대리, 행정 서류 작성 대행, 등기 신청, 손해사정, 보험 모집은 각 자격사나 등록한 사람만 할 수 있어요. 연결한 도구는 계산·기한·근거 조문·질문 정리까지만 하고, 그다음은 무료 공공 창구나 자격사에게 이어 줘요." },
  { q: "'도구 준비 중'인 역량은 무엇인가요?", a: "아직 연결할 도구가 없는 역량이에요. 표에서 빨간 칸으로 보이고, 다음에 만들 도구 목록으로 써요. 자격사만 할 수 있는 업무(손해사정서 작성 등)는 원리 설명까지만 만들어요." },
];
---
<KrFinancePage slug="pro-competency-map" locale="ko" title={title} description={description} faqs={faqs} koOnly>
  <section>
    <h2 class="text-lg font-bold text-foreground">직업별로 필요한 역량과 쓸 수 있는 도구</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">직업 {JOBS.length}개의 역량 {COMPETENCIES.length}개를 {CATEGORIES.length}가지 분류로 나눴어요. 표의 칸을 누르면 그 직업·분류의 역량과 연결된 계산 도구, Claude 스킬, MCP 도구가 아래에 나와요. "일반인도 쓰는 역량"을 고르면 내 문제에 바로 쓸 도구만 볼 수 있어요.</p>
    <div class="mt-4"><CompetencyMap client:load /></div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">역량 분류 7가지</h2>
    <dl class="mt-3 space-y-2">
      {CATEGORIES.map((c) => (
        <div><dt class="inline text-sm font-semibold text-foreground">{c.name}</dt> <dd class="inline text-sm text-muted-foreground">— {c.desc}</dd></div>
      ))}
    </dl>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">다음에 만들 도구 ({gaps.length}개)</h2>
    <ul class="mt-3 space-y-1 text-sm text-muted-foreground">
      {gaps.map((g) => <li><span class="font-semibold text-foreground">{jobName(g.job)}</span> · {g.name}{g.exclusive ? " (원리 설명까지만)" : ""}</li>)}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold text-foreground">Claude 스킬 {Object.keys(SKILLS).length}종</h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">스킬 원본은 공개 저장소 <a class="underline" href={SKILLS_REPO}>github.com/yuli3/oiyo-skills</a>에 있고, Releases에서 묶음 zip을 받을 수 있어요. 각 스킬만 받으려면 아래를 누르세요.</p>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {Object.entries(SKILLS).map(([id, s]) => (
        <li><a href={s.zip} download class="flex min-h-11 items-center rounded-md border border-border bg-background px-3 text-sm font-semibold text-foreground hover:bg-muted">{s.name} <span class="ml-2 text-xs font-normal text-muted-foreground">{id}.zip</span></a></li>
      ))}
    </ul>
  </section>

  <p class="mt-8 text-xs text-muted-foreground">기준일 {COMPETENCY_AS_OF}. 직업별 업무 범위는 각 자격법 조문을 요약한 것이에요. 이 페이지와 도구는 법령 정보·계산이며 대리·자문이 아니에요. <a class="underline" href="/ko/law-guide/">법령 길잡이 15분야</a></p>
</KrFinancePage>
