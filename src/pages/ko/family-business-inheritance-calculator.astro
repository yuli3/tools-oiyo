const title = "가업상속공제 계산기 2026 — 300억·400억·600억 한도와 상속세 절감액";
const description = "가업 주식 평가액, 사업무관자산 비율, 경영 기간을 넣으면 가업상속공제액과 공제 전후 상속세를 비교해요. 일괄·배우자·금융재산공제와 신고세액공제를 함께 반영해요.";

const ko = {
  introTitle: "가업상속공제로 상속세가 얼마나 줄어드는지 비교해요",
