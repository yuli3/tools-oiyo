---
// Moved from blog.oiyo.net/incorporation-calculator/ on 2026-10-27 (W10a). Rewritten on kr-incorporation-2026:
// Blog used 2024 corporate rates (9/19/21%), its own salary deduction table and ignored dividend tax.
import KrFinancePage from "../../components/KrFinancePage.astro";
import IncorporationCalculator from "../../components/tools/IncorporationCalculator";
import { INCORPORATION_AS_OF, compareIncorporation } from "../../lib/kr-incorporation-2026";

const title = "개인사업자 vs 법인 세금 비교 계산기 2026 — 법인세 10·20·22·25%";
const description = "연 매출과 경비, 대표 연봉을 넣으면 개인사업자 종합소득세와 법인세+대표 급여 세금, 배당까지 꺼낼 때의 세금을 2026년 세율로 비교합니다.";
const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const s = compareIncorporation(200_000_000, 60_000_000);

const ko = {
  introTitle: "법인으로 바꾸면 세금이 얼마나 줄까요?",
  intro: `2026년부터 법인세율은 전 구간 1%p 올라 과세표준 2억 원 이하 10%, 200억 원 이하 20%입니다. 개인사업자는 소득세 6~45% 누진세율이라 이익이 커질수록 법인이 유리해지지만, 법인 돈을 개인이 쓰려면 급여나 배당으로 꺼내야 하고 그때 세금이 또 붙습니다. 예를 들어 연 이익 2억 원, 대표 연봉 6,000만 원이면 개인사업자 ${won(s.sole.total)}, 법인은 이익을 법인에 둘 때 ${won(s.corpKeep)}, 남은 이익을 모두 배당하면 ${won(s.corpPayout)}입니다(지방소득세 포함).`,
  howToTitle: "사용 방법",
  steps: ["연 매출과 대표 급여를 뺀 필요경비를 넣습니다.", "법인일 때 대표가 받을 연봉을 정합니다.", "개인·법인(유보)·법인(배당) 세 가지 세금을 비교합니다."],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "2026년 법인세율", body: "2025년 12월 개정으로 오른 10·20·22·25% 세율과 지방소득세를 반영합니다." },
    { title: "배당까지 비교", body: "법인에 남긴 이익을 배당(15.4%)으로 꺼낼 때의 세금도 함께 봅니다." },
    { title: "부동산임대 법인", body: "성실신고확인 소규모 부동산임대 법인은 2억 이하 구간 없이 20%를 적용합니다." },
  ],
  disclaimer: `참고용 추정입니다. 4대보험, 세무 기장료, 중소기업 특별세액감면·창업감면, 성실신고 비용, 배당 2천만 원 초과 종합과세와 배당세액공제는 넣지 않았습니다. 기준일 ${INCORPORATION_AS_OF}.`,
};

const faqs = [
  { q: "2026년 법인세율은 얼마인가요?", a: "2026년 1월 1일 이후 시작하는 사업연도부터 과세표준 2억 원 이하 10%, 200억 원 이하 20%, 3,000억 원 이하 22%, 초과 25%입니다(법인세법 제55조, 2025년 12월 2일 국회 통과). 지방소득세가 10% 더 붙습니다." },
  { q: "이익이 얼마부터 법인이 유리한가요?", a: "대표 급여와 배당 계획에 따라 다릅니다. 이익을 법인에 남겨 재투자한다면 과세표준 수천만 원대부터 차이가 나지만, 모두 꺼내 쓴다면 차이가 크게 줄어듭니다. 이 계산기로 연봉을 바꿔 가며 비교해 보세요." },
  { q: "대표 급여를 많이 주면 유리한가요?", a: "급여는 법인 비용이라 법인세가 줄지만 대표의 근로소득세와 4대보험이 늘어납니다. 법인세율(10~20%)과 대표 소득세율이 비슷해지는 지점이 보통 유리한 범위입니다." },
  { q: "부동산임대 법인도 10%인가요?", a: "지배주주 지분 50% 초과, 상시근로자 5인 미만이고 부동산임대업 등이 주업인 성실신고확인 대상 소규모 법인은 2억 원 이하 구간이 없어 최저 20%입니다." },
];
---
<KrFinancePage slug="incorporation-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <IncorporationCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 법인세법 제55조(2026 사업연도 세율), 지방세법 제103조의20, 소득세법 제47조·제55조·제59조·제59조의4, 제129조(배당 원천징수 14%). 기준일 {INCORPORATION_AS_OF}.</p>
</KrFinancePage>
