---
// 경영 도구 (2026-11-14). 엔진: lib/biz-strategy.ts · lib/biz-checklist.ts
import KrFinancePage from "../../components/KrFinancePage.astro";
import PriorityMatrix from "../../components/tools/biz/PriorityMatrix";

const title = "가중 의사결정표·RICE 우선순위 계산기 — 기준별 점수와 순위가 뒤집히는 가중치";
const description = "비용·속도·고객 가치 같은 기준에 중요도를 주고 선택지마다 1~5점을 매기면 가중 점수로 순위를 매겨요. 전문가 모드는 순위가 뒤집히는 가중치를 계산하고, RICE로 할 일 순서도 정해요.";
const ko = {
  introTitle: "목소리 큰 사람이 아니라 같은 기준으로",
