<KrFinancePage slug="priority-decision-matrix" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <PriorityMatrix client:load />
  <p class="mt-4 text-xs text-muted-foreground"><a class="underline" href="/ko/business-toolkit/">경영 도구 모음</a></p>
