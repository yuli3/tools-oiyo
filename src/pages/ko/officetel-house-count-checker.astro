const faqs = [{"q": "업무용으로 등록했는데 세입자가 전입신고를 했어요.", "a": "양도세·종부세는 실제 쓰임으로 봐서 주거용으로 볼 가능성이 커요. 취득세는 재산세 과세 구분을 따라요."}, {"q": "2020년 8월 전에 산 오피스텔은요?", "a": "다음 집 취득세 주택 수에는 안 들어가요. 양도세·종부세는 실제 쓰임으로 봐요."}, {"q": "오피스텔이 있으면 청약에서 유주택자인가요?", "a": "아니요. 주택공급 규칙상 오피스텔은 주택이 아니라 무주택 자격이 유지돼요."}, {"q": "오피스텔 취득세는 왜 4.6%예요?", "a": "건축법상 업무시설이라 주택 세율(1~3%) 대신 일반 부동산 4%에 농특세 0.2%, 지방교육세 0.4%가 붙어요."}];
