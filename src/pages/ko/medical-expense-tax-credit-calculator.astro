---
// 건강 금융 묶음 1 (2026-11-02, CHOSEUN 선택). ko-only: 소득세법 제59조의4 ② 의료비 세액공제.
import KrFinancePage from "../../components/KrFinancePage.astro";
import MedicalTaxCreditCalculator from "../../components/tools/MedicalTaxCreditCalculator";
import { MEDICAL_COST_AS_OF, medicalExpenseCredit } from "../../lib/kr-medical-cost-2026";

const title = "의료비 세액공제 계산기 2026 — 총급여 3% 문턱과 돌려받는 세금";
const description = "총급여와 가족별 의료비를 넣으면 2026년 귀속 연말정산 의료비 세액공제액을 계산해요. 3% 문턱, 일반 부양가족 700만 원 한도, 난임 30%·미숙아 20% 공제율을 반영해요.";

const won = (n: number) => `${n.toLocaleString("ko-KR")}원`;
const ex = medicalExpenseCredit(50_000_000, { general: 0, specific: 3_000_000 });

const ko = {
  eyebrow: "건강 금융 도구",
  introTitle: "병원비, 연말정산에서 얼마나 돌려받을까요?",
  intro: `근로자가 한 해 동안 쓴 의료비 가운데 총급여의 3%를 넘는 부분은 15%를 세금에서 빼 줘요. 총급여가 5,000만 원이면 문턱은 150만 원이라, 본인 의료비로 300만 원을 썼다면 150만 원의 15%인 ${won(ex.credit)}, 지방소득세까지 ${won(ex.withLocal)}의 세금이 줄어요. 본인, 65세 이상, 장애인, 6세 이하 자녀, 건강보험 산정특례자 의료비는 한도가 없고, 그 밖의 부양가족 의료비는 700만 원까지예요. 난임시술비는 30%, 미숙아·선천성이상아 의료비는 20%로 공제율이 더 높아요.`,
  howToTitle: "사용 방법",
  steps: [
    "원천징수영수증의 총급여(비과세 제외)를 넣어요.",
    "홈택스 연말정산 간소화 자료의 의료비를 사람별로 나눠 해당 칸에 넣어요. 실손보험금과 상한제 환급금은 빼고 넣어요.",
    "결과에서 3% 문턱이 어느 칸에서 빠졌는지 확인해요. 맞벌이라면 누구 쪽으로 모을지 비교해 보세요.",
  ],
  highlightsTitle: "주요 특징",
  highlights: [
    { title: "공제율 네 가지", body: "일반·본인 등 15%, 미숙아·선천성이상아 20%, 난임시술비 30%를 따로 계산해요." },
    { title: "문턱 차감 순서", body: "총급여 3%를 일반 의료비 → 본인 등 → 미숙아 → 난임 순서로 빼서, 높은 공제율이 최대한 남게 해요." },
    { title: "연말정산 계산기와 같은 식", body: "연말정산 계산기의 의료비 공제와 같은 식이라 결과가 일치해요." },
  ],
  relatedTitle: "관련 도구",
  related: [],
  disclaimer: `참고용 추정 계산이에요. 의료비 세액공제는 근로소득자(성실사업자 등 일부 포함)만 받을 수 있고, 결정세액을 넘어 돌려받지는 못해요. 미용·성형 수술, 건강기능식품, 실손보험금으로 보전받은 금액, 본인부담상한제 환급금, 국가·지자체 지원금은 공제 대상이 아니에요. 산후조리원 비용은 출산 1회당 200만 원까지 의료비에 넣을 수 있어요. 안경·콘택트렌즈는 1명당 연 50만 원까지예요. 최종 공제액은 홈택스 연말정산 간소화 자료와 회사의 연말정산 결과로 확인하세요. 기준일 ${MEDICAL_COST_AS_OF}.`,
};

const faqs = [
  { q: "맞벌이면 누가 의료비를 공제받는 게 유리한가요?", a: "의료비는 실제로 돈을 낸 사람이 공제받아요. 3% 문턱은 총급여에 비례하니, 보통 총급여가 낮은 쪽으로 모으면 문턱이 낮아 공제가 커져요. 다만 결정세액이 너무 적으면 공제를 다 못 쓰니 두 사람 모두 넣어 비교해 보세요." },
  { q: "부모님 의료비도 넣을 수 있나요?", a: "넣을 수 있어요. 의료비는 부양가족의 나이·소득 요건을 따지지 않아요. 부모님이 65세 이상이면 한도 없는 칸에, 65세 미만이면 700만 원 한도 칸에 넣어요. 다만 다른 형제가 그 부모님을 기본공제받고 있으면 그 형제만 공제받을 수 있어요." },
  { q: "실손보험금을 받았는데 어떻게 하나요?", a: "실손보험에서 돌려받은 금액만큼 의료비에서 빼야 해요. 간소화 자료에 실손보험금 수령액이 함께 나오니, 그 금액을 뺀 나머지만 넣으세요." },
  { q: "간소화 자료에 안 나오는 의료비도 있나요?", a: "안경 구입비, 일부 산후조리원, 보청기·휠체어 같은 장애인 보장구 구입비는 빠질 수 있어요. 영수증을 받아 회사에 따로 내면 공제받을 수 있어요." },
  { q: "본인부담상한제 환급금도 빼야 하나요?", a: "빼야 해요. 공단에서 돌려받은 상한제 환급금은 의료비 공제 대상이 아니에요. 다음 해에 환급을 받았다면 그 해 의료비에서 빼거나 수정신고가 필요할 수 있으니 회사나 홈택스에 확인하세요." },
];
---
<KrFinancePage slug="medical-expense-tax-credit-calculator" locale="ko" title={title} description={description} shell={ko} faqs={faqs} koOnly>
  <MedicalTaxCreditCalculator client:load />
  <p class="mt-4 text-xs text-muted-foreground">근거: 소득세법 제59조의4 제2항(의료비 세액공제)과 시행령 제118조의5. 2026년 귀속 기준. 기준일 {MEDICAL_COST_AS_OF}.</p>
</KrFinancePage>
