const faqs = [
  { q: "공탁금 이자는 얼마인가요?", a: "2022년 10월 1일부터 연 0.35%예요(공탁금의 이자에 관한 규칙). 공탁금을 찾을 때 원금과 함께 받아요. 은행의 일수 계산 방식에 따라 몇 원 차이가 날 수 있어요." },
  { q: "공탁금을 안 찾으면 어떻게 되나요?", a: "출급 또는 회수할 수 있는 날부터 10년이 지나면 청구권이 시효로 사라지고 국고에 귀속돼요(공탁법 제9조)." },
  { q: "형사공탁은 무엇이 다른가요?", a: "형사사건 피해자의 인적사항을 몰라도 사건번호 등으로 공탁할 수 있어요(공탁법 제5조의2). 피해자는 동의 없이 공탁된 돈을 받지 않을 수도 있어요." },
