const title = "공탁금 이자·시효 계산기 2026 — 연 0.35%, 10년 소멸시효, 변제공탁 사유";
const description = "공탁금과 공탁일·찾는 날로 공탁금 이자(연 0.35%)를 어림하고, 출급·회수청구권이 사라지는 10년 기한을 계산해요. 변제공탁 사유(수령 거절·수령 불능·채권자 불확지)도 점검해요.";
const ko = {
