---
// Moved from blog.oiyo.net/{locale}/cost-accounting-simulator/ on 2026-10-27 (W13).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import { CostAccountingSimulator } from '../../components/tools/CostAccountingSimulator';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "원가계산 시스템 — 전통적 원가계산·ABC 원가계산·손익분기점 분석기",
    description: "전통적 원가계산, 활동기준원가계산(ABC), 손익분기점·목표이익·영업레버리지를 대화형으로 실습하세요.",
  },
  en: {
    title: "Cost Accounting Simulator — Traditional, ABC Costing & Break-Even Analysis",
    description: "Practice traditional costing, activity-based costing (ABC), break-even analysis, target profit, and operating leverage interactively.",
  },
  ja: {
    title: "原価計算シミュレーター — 伝統的原価計算・ABC原価計算・CVP分析",
    description: "伝統的原価計算、活動基準原価計算（ABC）、損益分岐点分析を対話形式で練習。",
  },
  zh: {
    title: "成本计算系统 — 传统成本计算·作业成本法·损益平衡分析",
    description: "互动练习传统成本计算、作业基础成本法（ABC）和损益平衡分析。",
  },
  fr: {
    title: "Simulateur de Comptabilité des Coûts — ABC et Seuil de Rentabilité",
    description: "Pratiquez la comptabilité analytique traditionnelle, la méthode ABC et l'analyse du seuil de rentabilité.",
  },
  es: {
    title: "Simulador de Contabilidad de Costos — ABC y Punto de Equilibrio",
    description: "Practica la contabilidad de costos tradicional, ABC y análisis del punto de equilibrio.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/cost-accounting-simulator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <CostAccountingSimulator client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="cost-accounting-simulator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
