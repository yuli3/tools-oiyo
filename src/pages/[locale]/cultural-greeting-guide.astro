---
import ToolShell from '../../components/ToolShell.astro';
// Moved from blog.oiyo.net/{locale}/cultural-greeting-guide/ on 2026-10-27 (W15).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import CulturalGreetingGuide from '../../components/tools/CulturalGreetingGuide';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "세계 인사 문화 가이드 — 나라별 인사 방식 완벽 정리",
    description: "대한민국, 일본, 미국, 프랑스, 중국 등 세계 각국의 인사 문화와 비즈니스 에티켓을 알아보세요.",
  },
  en: {
    title: "Cultural Greeting Guide",
    description: "Explore greeting customs and business etiquette from around the world, including Korea, Japan, USA, France, and China.",
  },
  ja: {
    title: "世界の挨拶文化ガイド — 国別の挨拶方法を完全解説",
    description: "韓国、日本、アメリカ、フランス、中国など世界各国の挨拶文化とビジネスエチケットを学びましょう。",
  },
  zh: {
    title: "世界问候文化指南 — 各国问候方式完整整理",
    description: "了解韩国、日本、美国、法国、中国等世界各国的问候文化和商务礼仪。",
  },
  fr: {
    title: "Guide des Salutations Culturelles",
    description: "Découvrez les coutumes de salutation et l'étiquette commerciale du monde entier, incluant la Corée, le Japon, les États-Unis et la France.",
  },
  es: {
    title: "Guía de Saludos Culturales",
    description: "Explora las costumbres de saludo y etiqueta de negocios de todo el mundo, incluyendo Corea, Japón, EE.UU., Francia y China.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/cultural-greeting-guide/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <ToolShell title={m.title} description={m.description}>
    <CulturalGreetingGuide client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="cultural-greeting-guide" group="calc" />
  </ToolShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
