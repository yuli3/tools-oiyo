const m = meta[locale];
const c = content[locale];
const url = `https://tools.oiyo.net/${locale}/acquisition-tax-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: c.steps, faqs: c.faqs });
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    {country ? <AcquisitionTaxCountryCalculator client:load country={country} /> : <KrAcquisitionTaxCalculator client:load locale={locale} />}
    {!country && <p class="mt-4 text-xs text-muted-foreground">근거: 지방세법 제11조·제13조의2·제151조, 농어촌특별세법 제5조. 기준일 {REAL_ESTATE_TAX_AS_OF}.</p>}
    <UtilityArticle c={c} />
    <RelatedUtilities locale={locale} current="acquisition-tax-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
