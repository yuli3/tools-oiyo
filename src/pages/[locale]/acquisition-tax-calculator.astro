---
// Replaces blog.oiyo.net/{locale}/acquisition-tax-calculator/ (2026-10-27, W9b). Country pages keep Blog's
// checked country rules; the Korean calculator is rewritten on src/lib/kr-real-estate-tax.ts (Blog had no
// multi-home surcharge and rounded the 6~9억 rate wrongly).
import Layout from '../../components/Layout.astro';
import UtilityArticle, { type UtilityContent } from '../../components/UtilityArticle.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import KrAcquisitionTaxCalculator from '../../components/tools/KrAcquisitionTaxCalculator';
import AcquisitionTaxCountryCalculator from '../../components/tools/AcquisitionTaxCountryCalculator';
import type { AcquisitionCountry } from '../../lib/acquisition-tax-countries';
import { REAL_ESTATE_TAX_AS_OF } from '../../lib/kr-real-estate-tax';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };
// ja/zh/fr/es use their own country's law (세운 2026-10-19); ko and en use South Korea's.
const COUNTRY_BY_LOCALE: Partial<Record<ActiveLocale, AcquisitionCountry>> = { ja: 'jp', zh: 'cn', fr: 'fr', es: 'es' };
const country = COUNTRY_BY_LOCALE[locale];

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
      "title": "주택 취득세 계산기 2026 — 1~3% 표준세율, 다주택 8·12% 중과",
      "description": "취득가액·주택 수·조정대상지역·면적으로 2026년 주택 취득세와 지방교육세·농어촌특별세를 계산해요. 6~9억 구간 세율도 법 공식대로 계산해요."
  },
