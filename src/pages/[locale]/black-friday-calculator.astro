const p = P[locale];
const url = `https://tools.oiyo.net/${locale}/black-friday-calculator/`;
const schema = utilityJsonLd({ name: p.title, description: p.description, url, locale, steps: p.c.steps, faqs: p.c.faqs });
const relatedTitle = { en: 'More shopping math', es: 'Más cálculos de compras', fr: 'Autres calculs d’achat', ja: '買い物の計算', zh: '更多购物计算' }[locale];
---
<Layout title={p.title} description={p.description} locale={locale} availableLocales={[...LANGS]} canonicalURL={url}>
  <ToolShell title={p.title} description={p.description}>
    <BlackFridayCart client:load lang={locale} />
    <UtilityArticle c={p.c} />
    <RelatedLinkList title={relatedTitle} links={p.related.map(([href, label]) => ({ href, label }))} locale={locale} />
  </ToolShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
