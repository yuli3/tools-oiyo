const p = P[locale];
const url = `https://tools.oiyo.net/${locale}/card-installment-calculator/`;
const schema = utilityJsonLd({ name: p.title, description: p.description, url, locale, steps: p.c.steps, faqs: p.c.faqs });
---
<Layout title={p.title} description={p.description} locale={locale} availableLocales={[...LANGS]} canonicalURL={url}>
  <ToolShell title={p.title} description={p.description}>
    <a slot="meta" href={simpleHref(locale, 'card-installment')} class="inline-flex min-h-11 items-center text-sm font-semibold text-primary underline underline-offset-4">🔍 {SIMPLE_UI[locale].brand}</a>
    <CardInstallment client:load locale={locale} />
    <UtilityArticle c={p.c} />
    <RelatedLinkList title={p.relatedTitle} links={p.related.map(([href, label]) => ({ href, label }))} locale={locale} />
  </ToolShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
