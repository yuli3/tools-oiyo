---
/**
 * 카드 할부 수수료 계산기, 6개 언어 (2026-11-22, 간단계산기 출시와 함께).
 * 나라별 기본값: 한국 잔액×연율÷12, 일본·미국·프랑스·스페인 원리금균등, 중국 월 고정 수수료.
 * 쉬운 버전은 /{locale}/simple-calculators/card-installment/ 이에요.
 */
import Layout from '../../components/Layout.astro';
import ToolShell from '../../components/ToolShell.astro';
import UtilityArticle, { type UtilityContent } from '../../components/UtilityArticle.astro';
import RelatedLinkList from '../../components/RelatedLinkList.astro';
import CardInstallment from '../../components/tools/CardInstallment';
import { utilityJsonLd } from '../../lib/utility-jsonld';
import { SIMPLE_UI, simpleHref } from '../../data/simple-calculators';
import type { Locale } from '../../lib/i18n';

const LANGS = ['ko', 'en', 'ja', 'zh', 'fr', 'es'] as const;
export function getStaticPaths() {
  return (['ko', 'en', 'ja', 'zh', 'fr', 'es'] as const).map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };

const P: Record<Locale, { title: string; description: string; c: UtilityContent; relatedTitle: string; related: [string, string][] }> = {
