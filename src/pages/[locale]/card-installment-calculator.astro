      faqTitle: 'Questions fréquentes',
      faqs: [{ question: 'Le 4x sans frais est-il vraiment gratuit ?', answer: 'Mettez le taux à 0. Vérifiez les frais de dossier et les pénalités en cas de retard.' }],
