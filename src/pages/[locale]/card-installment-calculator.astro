      formulaTitle: 'Cómo se calcula',
      formulas: [
        { title: 'Cuota constante', body: 'Cuota = C × i ÷ (1 − (1 + i)^−n), con i = TAE ÷ 12.' },
        { title: 'Sobre lo pendiente', body: 'Capital igual cada mes; comisión = pendiente × TAE ÷ 12.' },
        { title: 'Comisión fija', body: 'Comisión = importe × tasa mensual cada mes; se muestra la tasa efectiva.' },
      ],
      howToTitle: 'Cómo se usa',
      steps: ['Escribe el importe de la compra.', 'Elige el número de cuotas.', 'Escribe la TAE o la comisión de tu tarjeta.', 'Mira la primera cuota y el total de intereses.'],
      faqTitle: 'Preguntas frecuentes',
      faqs: [{ question: '¿Y si es sin intereses?', answer: 'Pon el tipo a 0. Revisa si hay comisión de apertura por aplazar.' }],
      disclaimer: 'Estimación. El importe final es el que indique tu banco.',
