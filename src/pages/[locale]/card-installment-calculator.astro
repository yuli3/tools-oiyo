  },
  en: {
    title: 'Credit Card Installment Calculator — Monthly Payment & Total Interest',
    description: 'Enter the purchase, number of months and APR to see the first payment, each month’s principal and interest, and the total cost. Switch between level payments, balance-based fees and fixed monthly plan fees.',
    c: {
      introTitle: 'What a card installment plan really costs',
      intro: 'Paying a purchase off over a few months costs more than the sticker price unless the plan is 0%. This calculator shows the monthly payment and total interest three ways: a level payment at an APR (like paying a balance down), a fee on the remaining balance, and a fixed monthly plan fee charged on the original amount. The last one looks cheap but its effective APR is much higher than “fee × 12”.',
      formulaTitle: 'How it is calculated',
      formulas: [
        { title: 'Level payment', body: 'Payment = P × r ÷ (1 − (1 + r)^−n), where r = APR ÷ 12.' },
        { title: 'Balance-based fee', body: 'Equal principal each month; fee = remaining balance × APR ÷ 12.' },
        { title: 'Fixed plan fee', body: 'Fee = original amount × monthly fee every month. We also show the effective APR.' },
