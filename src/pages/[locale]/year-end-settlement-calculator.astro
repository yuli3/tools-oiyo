        answer: "5.550 € al año, 6.700 € desde los 65 años y 8.100 € desde los 75. Por hijos se añaden 2.400 €, 2.700 €, 4.000 € y 4.500 € (el cuarto y siguientes), más 2.800 € por cada hijo menor de 3 años, que este cálculo no incluye."
      },
      {
        question: "¿Por qué mi resultado real es distinto?",
        answer: "Cada comunidad autónoma tiene su escala y sus deducciones (alquiler, nacimiento, gastos educativos), y existen deducciones estatales como la de maternidad o por rendimientos del trabajo bajos. El programa Renta WEB las aplica con tus datos fiscales."
      }
    ],
    disclaimer: "Esta herramienta es para cálculo general. El resultado oficial es el del borrador en Renta WEB de la Agencia Tributaria."
  },
};
const m = meta[locale];
const c = content[locale];
const url = `https://tools.oiyo.net/${locale}/year-end-settlement-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: c.steps, faqs: c.faqs });
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    {country ? <YearEndSettlementCountryCalculator client:load country={country} /> : <YearEndSettlementCalculator client:load locale={locale === 'ko' ? 'ko' : 'en'} />}
    {!country && <p class="mt-4 text-xs text-muted-foreground">근거: 소득세법·조세특례제한법 2026년 귀속 조문. 기준일 {YEAR_END_AS_OF}.</p>}
    <UtilityArticle c={c} />
    <RelatedUtilities locale={locale} current="year-end-settlement-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
