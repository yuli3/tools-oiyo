---
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import QuartileCalculator from '../../components/tools/QuartileCalculator';
import { locales, type Locale } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const meta: Record<Locale, { title: string; description: string; h1: string }> = {
  ko: { title: "사분위수 계산기 — Q1·중앙값·Q3·IQR 한 번에", description: "숫자 목록을 붙여넣으면 제1사분위수(Q1), 중앙값, 제3사분위수(Q3), 사분위범위(IQR)와 1.5×IQR 기준 이상치까지 즉시 계산합니다.", h1: "사분위수(Q1·Q3) 계산기" },
  en: { title: "Quartile Calculator — Q1, Median, Q3 & IQR", description: "Paste a list of numbers to instantly get the first quartile (Q1), median, third quartile (Q3), interquartile range (IQR) and 1.5×IQR outliers.", h1: "Quartile (Q1·Q3) Calculator" },
  ja: { title: "四分位数計算機 — Q1・中央値・Q3・IQR", description: "数値リストを貼り付けるだけで第1四分位数(Q1)、中央値、第3四分位数(Q3)、四分位範囲(IQR)、1.5×IQR基準の外れ値まで即計算。", h1: "四分位数(Q1·Q3)計算機" },
  zh: { title: "四分位数计算器 — Q1·中位数·Q3·IQR", description: "粘贴数字列表，立即计算第一四分位数(Q1)、中位数、第三四分位数(Q3)、四分位距(IQR)以及1.5×IQR规则的离群值。", h1: "四分位数(Q1·Q3)计算器" },
  fr: { title: "Calculateur de quartiles — Q1, médiane, Q3 et IQR", description: "Collez une liste de nombres pour obtenir instantanément Q1, la médiane, Q3, l'écart interquartile (IQR) et les valeurs aberrantes (règle 1,5×IQR).", h1: "Calculateur de quartiles (Q1·Q3)" },
  es: { title: "Calculadora de cuartiles — Q1, mediana, Q3 e IQR", description: "Pega una lista de números y obtén al instante Q1, la mediana, Q3, el rango intercuartílico (IQR) y los valores atípicos (regla 1,5×IQR).", h1: "Calculadora de cuartiles (Q1·Q3)" },
};

const copy = {"ko": ["계산법과 상자그림", "숫자를 정렬하고 홀수 개이면 전체 중앙값을 제외한 두 절반의 중앙값을 Q1·Q3으로 삼아요. IQR=Q3−Q1이며, 울타리는 Q1−1.5×IQR과 Q3+1.5×IQR이에요. 울타리 밖 값은 검토 대상으로 표시할 뿐 틀린 데이터라고 판정하지 않아요.", "방법에 따른 차이", "표본 사분위수에는 여러 정의가 있어요. 이 계산은 R 기본 type 7이나 모든 Tukey 힌지 정의와 같다고 가정하지 않아요. 과제·프로그램의 계산법과 먼저 맞춰 주세요.", "상자그림의 선 끝은 울타리 자체가 아니라 울타리 안에서 가장 작은 관측값과 가장 큰 관측값이에요. 원은 울타리 밖 값이고, 모든 수치는 아래에도 표시돼요.", "정렬 예제 1, 2, 3, 4, 5, 6, 7 → Q1=2, 중앙값=4, Q3=6, IQR=4.", "숫자 목록을 입력해요.", "배제법의 결과와 상자그림을 확인해요.", "서로 다른 방법의 결과를 섞지 않아요."], "en": ["Method and box plot", "Sort the numbers. For an odd count, exclude the overall median, then take the median of each half as Q1 and Q3. IQR=Q3−Q1; fences are Q1−1.5×IQR and Q3+1.5×IQR. Values outside them are candidates for review, not automatically errors.", "Why methods differ", "Sample quartiles have multiple definitions. Do not assume this method equals R’s default type 7 or every definition of Tukey hinges. Match the method required by your assignment or software.", "Whiskers end at the smallest and largest observed values inside the fences, not at the fences themselves. Circles mark outside values; all values are also listed in text.", "Sorted example 1, 2, 3, 4, 5, 6, 7 → Q1=2, median=4, Q3=6, IQR=4.", "Enter a list of numbers.", "Inspect the median-excluded halves and box plot.", "Compare only results using the same method."], "ja": ["計算法と箱ひげ図", "値を並べ、個数が奇数なら全体の中央値を除き、下半分と上半分の中央値をQ1・Q3にします。IQR=Q3−Q1、境界はQ1−1.5×IQRとQ3+1.5×IQRです。外側の値は確認候補であり、誤りと断定しません。", "方法による違い", "標本四分位数には複数の定義があります。この方法がRの既定type 7やすべてのTukeyヒンジと一致するとは限りません。課題やソフトの指定を先に確認してください。", "ひげの端は境界そのものではなく、境界内の最小・最大観測値です。円は外側の値を示します。数値は本文にも表示します。", "整列例1, 2, 3, 4, 5, 6, 7 → Q1=2、中央値=4、Q3=6、IQR=4。", "数値リストを入力します。", "中央値を除く方法と箱ひげ図を確認します。", "同じ方法の結果を比較します。"], "zh": ["计算方法与箱线图", "将数值排序。个数为奇数时排除整体中位数，再取上下两半的中位数作为Q1和Q3。IQR=Q3−Q1，边界为Q1−1.5×IQR和Q3+1.5×IQR。边界外的值只是待检查对象，不一定错误。", "不同方法的差异", "样本四分位数有多种定义。本方法不保证等同于R默认的type 7或所有Tukey铰链定义。请先与作业或软件所用方法核对。", "须线端点是边界内最小和最大观测值，而非边界本身。圆点表示边界外的值，所有数值也会显示在正文中。", "排序示例1, 2, 3, 4, 5, 6, 7 → Q1=2，中位数=4，Q3=6，IQR=4。", "输入数字列表。", "查看排除整体中位数的方法和箱线图。", "只比较相同方法的结果。"], "fr": ["Méthode et boîte à moustaches", "Triez les nombres. Si l’effectif est impair, excluez la médiane générale, puis prenez la médiane de chaque moitié pour Q1 et Q3. IQR=Q3−Q1 ; les bornes sont Q1−1,5×IQR et Q3+1,5×IQR. Les valeurs extérieures sont à examiner, pas nécessairement erronées.", "Pourquoi les méthodes diffèrent", "Les quartiles d’un échantillon ont plusieurs définitions. Cette méthode ne correspond pas nécessairement au type 7 par défaut de R ni à toutes les définitions des charnières de Tukey. Vérifiez la convention demandée.", "Les moustaches s’arrêtent aux observations extrêmes comprises entre les bornes, pas aux bornes elles-mêmes. Les cercles indiquent les valeurs extérieures ; les nombres restent disponibles en texte.", "Exemple trié 1, 2, 3, 4, 5, 6, 7 → Q1=2, médiane=4, Q3=6, IQR=4.", "Saisissez les nombres avec un point décimal.", "Examinez les moitiés sans la médiane et le graphique.", "Comparez des résultats de même convention."], "es": ["Método y diagrama de caja", "Ordena los números. Si hay una cantidad impar, excluye la mediana general y toma la mediana de cada mitad como Q1 y Q3. IQR=Q3−Q1; los límites son Q1−1,5×IQR y Q3+1,5×IQR. Los valores exteriores requieren revisión, pero no son errores automáticamente.", "Por qué cambian los resultados", "Hay varias definiciones de cuartiles muestrales. Este método no equivale necesariamente al tipo 7 predeterminado de R ni a todas las definiciones de bisagras de Tukey. Comprueba la convención exigida.", "Los bigotes terminan en las observaciones extremas dentro de los límites, no en los límites mismos. Los círculos marcan valores exteriores y los números también se muestran como texto.", "Ejemplo ordenado 1, 2, 3, 4, 5, 6, 7 → Q1=2, mediana=4, Q3=6, IQR=4.", "Introduce números con punto decimal.", "Revisa las mitades sin la mediana y el gráfico.", "Compara resultados de la misma convención."]} as Record<Locale, string[]>;
const c=copy[locale],m=meta[locale];
const url=`https://tools.oiyo.net/${locale}/quartile-calculator/`;
const schema=utilityJsonLd({name:m.title,description:m.description,url,locale,steps:c.slice(6),faqs:[{question:c[2],answer:c[3]}]});
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold">{m.h1}</h1><p class="mt-2 text-sm text-muted-foreground">{m.description}</p>
    <QuartileCalculator client:load locale={locale} />
    <section class="space-y-3"><h2 class="text-lg font-semibold">{c[0]}</h2><p>{c[1]}</p><p>{c[4]}</p><p class="rounded-lg border border-border bg-muted p-3">{c[5]}</p><h2 class="text-lg font-semibold">{c[2]}</h2><p>{c[3]}</p><a class="inline-flex min-h-11 items-center text-primary underline" href="https://stat.ethz.ch/R-manual/R-devel/library/stats/html/quantile.html">R stats: Sample Quantiles</a></section>
    <RelatedUtilities locale={locale} current="quartile-calculator" group="calc" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
