const schema = utilityJsonLd({ name: p.title, description: p.description, url, locale, steps: p.c.steps, faqs: p.c.faqs });
---
<Layout title={p.title} description={p.description} locale={locale} availableLocales={[...LANGS]} canonicalURL={url}>
  <ToolShell title={p.title} description={p.description}>
    <SecretSanta client:load lang={locale} />
    <UtilityArticle c={p.c} />
    <RelatedLinkList title={p.relatedTitle} links={p.related.map(([href, label]) => ({ href, label }))} locale={locale} />
  </ToolShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
