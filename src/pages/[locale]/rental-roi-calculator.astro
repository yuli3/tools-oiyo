---
// Moved from blog.oiyo.net/{locale}/rental-roi-calculator/ on 2026-10-27 (W12).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import RentalRoiCalculator from '../../components/tools/RentalRoiCalculator';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "임대수익률 계산기 — 실투자 대비 ROI 계산",
    description: "매수가, 대출금, 임대보증금, 월세를 입력해 실투자금 대비 임대수익률(ROI)을 계산합니다.",
  },
  en: {
    title: "Rental ROI Calculator — Return on Actual Investment",
    description: "Calculate rental ROI based on purchase price, loan, security deposit, and monthly rent.",
  },
  ja: {
    title: "賃貸収益率計算機 — 実投資対比ROI計算",
    description: "購入価格、ローン、敷金・保証金、月家賃を入力して実投資対比賃貸収益率を計算します。",
  },
  zh: {
    title: "租金收益率计算机 — 实际投资回报率计算",
    description: "输入购买价格、贷款、租赁押金和月租金，计算实际投资的租金回报率。",
  },
  fr: {
    title: "Calculateur de Rentabilité Locative — ROI sur Investissement Réel",
    description: "Calculez la rentabilité locative en tenant compte du prix d'achat, du crédit, du dépôt et du loyer mensuel.",
  },
  es: {
    title: "Calculadora de Rentabilidad de Alquiler — ROI sobre Inversión Real",
    description: "Calcula la rentabilidad del alquiler considerando precio de compra, préstamo, depósito y renta mensual.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/rental-roi-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <RentalRoiCalculator client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="rental-roi-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
