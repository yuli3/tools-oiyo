---
// 간단계산기 개별 페이지(SIMPLE_TOOLS 전부) × 6개 언어 (2026-11-22, 3차 11-24에 15종). 계산 로직은 src/lib/simple-calc.ts·bill-split.ts.
import Layout from '../../../components/Layout.astro';
import SimpleShell from '../../../components/SimpleShell.astro';
import SimpleCalc from '../../../components/tools/SimpleCalc';
import { SIMPLE_COPY, simpleDetailHref, SIMPLE_UI, SIMPLE_LOCALES, SIMPLE_TOOLS, simpleHref, type SimpleTool } from '../../../data/simple-calculators';
import { utilityJsonLd } from '../../../lib/utility-jsonld';
import type { Locale } from '../../../lib/i18n';
export function getStaticPaths() {
  return SIMPLE_LOCALES.flatMap((locale) => SIMPLE_TOOLS.map((tool) => ({ params: { locale, tool }, props: { locale, tool } })));
}
const { locale, tool } = Astro.props as { locale: Locale; tool: SimpleTool };
const ui = SIMPLE_UI[locale];
const c = SIMPLE_COPY[locale][tool];
const url = `https://tools.oiyo.net${simpleHref(locale, tool)}`;
const schema = utilityJsonLd({ name: c.title, description: c.description, url, locale, steps: [c.help, ...ui.how.slice(2)], faqs: [] }).slice(0, 2);
---
<Layout title={c.title} description={c.description} locale={locale} availableLocales={[...SIMPLE_LOCALES]} canonicalURL={url} manifest={`/simple-calculators/${locale}.webmanifest`}>
  <SimpleShell locale={locale} title={c.name} lead={c.help} current={tool}>
    <SimpleCalc client:load tool={tool} locale={locale} />
    <p class="text-lg leading-relaxed text-muted-foreground">{c.description}</p>
    <a href={simpleDetailHref(locale, tool)} class="flex min-h-14 items-center justify-center rounded-xl border-2 border-border px-4 text-lg font-bold text-primary underline underline-offset-4 hover:border-primary">{ui.detail} →</a>
  </SimpleShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
