---
// Replaces blog.oiyo.net/{locale}/compound2-calculator/ (2026-10-27, W11a). Copy kept from Blog.
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import Compound2Calculator from '../../components/tools/Compound2Calculator';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "복리 수익 시뮬레이터 — 최저·평균·최고 시나리오 계산",
    description: "초기 투자금, 월 납입액, 기간, 수익률을 입력해 복리 수익을 세 가지 시나리오로 계산합니다.",
  },
  en: {
    title: "Compound Interest Simulator — Best, Average & Worst Cases",
    description: "Enter initial investment, monthly contribution, period, and return rate to simulate compound growth across three scenarios.",
  },
  ja: {
    title: "複利収益シミュレーター — 最低・平均・最高シナリオ",
    description: "初期投資額、月次積立額、期間、収益率を入力して複利成長を3つのシナリオで計算します。",
  },
  zh: {
    title: "复利收益模拟器 — 最低、平均、最高情境",
    description: "输入初始投资、月供、期限和收益率，以三种情境模拟复利增长。",
  },
  fr: {
    title: "Simulateur d'Intérêts Composés — Scénarios Min, Moyen, Max",
    description: "Calculez la croissance composée en entrant l'investissement initial, l'apport mensuel, la durée et le taux.",
  },
  es: {
    title: "Simulador de Interés Compuesto — Escenarios Mín, Promedio, Máx",
    description: "Calcula el crecimiento compuesto introduciendo inversión inicial, aportación mensual, plazo y tasa.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/compound2-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <Compound2Calculator client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="compound2-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
