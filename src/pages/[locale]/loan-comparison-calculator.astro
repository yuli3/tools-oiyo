---
import Layout from '../../components/Layout.astro';
import LoanComparison from '../../components/tools/LoanComparison';
import { loanCopy } from '../../lib/loan-comparison-copy';
import { locales, type Locale } from '../../lib/i18n';
export function getStaticPaths() {
  return locales.map(locale=>({params:{locale},props:{locale}}));
}
const {locale} = Astro.props as {locale:Locale};
const c = loanCopy[locale];
const url = `https://tools.oiyo.net/${locale}/loan-comparison-calculator/`;
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:c.title,description:c.description,url,inLanguage:locale,applicationCategory:'FinanceApplication',operatingSystem:'All',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
---
<Layout title={c.title} description={c.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <article class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{c.title}</h1>
    <p class="mb-4 mt-2 text-sm leading-relaxed text-muted-foreground">{c.description}</p>
    <p class="mb-5 rounded-lg border border-border bg-card p-3 text-sm leading-relaxed">{c.assumptions}</p>
    <LoanComparison locale={locale} client:load/>
    <section class="mt-6 border-t border-border pt-4">
      <h2 class="text-lg font-semibold">{c.mathTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed">{c.math}</p>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</Layout>
