---
// Replaces blog.oiyo.net/{locale}/fire-retirement-calculator/ (2026-10-27, W11a). Copy kept from Blog.
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import FireRetirementCalculator from '../../components/tools/FireRetirementCalculator';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "FIRE 조기 은퇴 계산기 — 4% 룰로 재정적 자유 시점 계산",
    description: "현재 자산, 월 저축액, 연 지출액을 입력해 FIRE(재정적 자유·조기 은퇴) 달성 시점과 필요 자산을 계산합니다.",
  },
  en: {
    title: "FIRE Retirement Calculator — When Can You Retire Early?",
    description: "Calculate your FIRE number and years to financial independence using the 4% rule.",
  },
  ja: {
    title: "FIRE早期退職計算機 — 4%ルールで経済的自由の時期を計算",
    description: "現在の資産、月の貯蓄、年間支出を入力してFIRE達成時期と必要資産を計算します。",
  },
  zh: {
    title: "FIRE提前退休计算机 — 4%法则计算财务自由",
    description: "输入资产、月储蓄和年支出，计算FIRE达成时间点和所需资产。",
  },
  fr: {
    title: "Calculateur FIRE — Quand pouvez-vous prendre votre retraite?",
    description: "Calculez votre numéro FIRE et le temps jusqu'à l'indépendance financière avec la règle des 4%.",
  },
  es: {
    title: "Calculadora FIRE — ¿Cuándo puedes jubilarte anticipadamente?",
    description: "Calcula tu número FIRE y los años hasta la independencia financiera usando la regla del 4%.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/fire-retirement-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <FireRetirementCalculator client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="fire-retirement-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
