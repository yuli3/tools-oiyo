  },
  en: {
    title: "Mortgage Calculator — Monthly Payment & Total Interest",
    description: "Enter loan amount, interest rate, and term to calculate monthly payment and total interest. Annuity repayment method.",
  },
  ja: {
    title: "住宅ローン計算機 — 月返済額・総利息を計算",
    description: "ローン金額、金利、期間を入力して月返済額と総利息を計算します。",
  },
  zh: {
    title: "房贷计算机 — 月供及总利息计算",
    description: "输入贷款金额、利率和期限，计算月供和总利息。",
  },
  fr: {
    title: "Calculateur de Prêt Immobilier — Mensualité & Intérêts Totaux",
