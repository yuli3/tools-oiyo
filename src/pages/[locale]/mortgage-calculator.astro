    faqs: [
    { question: "What is annuity (equal-payment) repayment?", answer: "You pay the same total amount each month; early payments are mostly interest and later payments are mostly principal." },
    { question: "How do I reduce total interest?", answer: "Shorten the term or lower the rate; prepayment also reduces total interest." },
    { question: "Does it handle variable rates?", answer: "This calculator assumes a fixed rate. With a variable rate, the actual payment changes as the rate changes." },
    ],
    disclaimer: "This calculator is for reference only. Actual results vary with loan terms, prepayment, and variable rates. Confirm exact terms with your lender.",
  },
  es: {
    introTitle: "What is the mortgage calculator?",
    intro: "Enter the loan amount, annual interest rate, and term to compute the monthly payment and total interest using the annuity (equal-payment) method.",
    howToTitle: "How to use",
    steps: ["Enter the loan principal.", "Enter the annual interest rate (%).", "Set the repayment term (years).", "Review the monthly payment, total interest, and total repayment."],
    formulaTitle: "Highlights",
    formulas: [
      { title: "Annuity repayment", body: "Calculates the most common equal-monthly-payment schedule." },
      { title: "Total interest", body: "Shows the total interest paid over the full term at a glance." },
      { title: "Instant result", body: "Results update as soon as you enter values." },
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
    { question: "What is annuity (equal-payment) repayment?", answer: "You pay the same total amount each month; early payments are mostly interest and later payments are mostly principal." },
    { question: "How do I reduce total interest?", answer: "Shorten the term or lower the rate; prepayment also reduces total interest." },
    { question: "Does it handle variable rates?", answer: "This calculator assumes a fixed rate. With a variable rate, the actual payment changes as the rate changes." },
