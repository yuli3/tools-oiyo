      { title: "Instant result", body: "Results update as soon as you enter values." },
    ],
    faqTitle: "常见问题",
    faqs: [
    { question: "What is annuity repayment?", answer: "You pay the same total amount each month, combining principal and interest." },
    { question: "How do I reduce total interest?", answer: "Shorten the term, lower the rate, or make prepayments where possible." },
    { question: "Is this different from a mortgage?", answer: "The math is the same; a mortgage is secured by collateral, which can change rate and limit terms." },
    ],
    disclaimer: "This calculator is for reference only. Actual results vary with loan terms, fees, and variable rates. Confirm exact terms with your lender.",
  },
  fr: {
    introTitle: "What is the loan calculator?",
    intro: "Enter the loan amount, annual rate, and term to compute the monthly payment and total interest with the annuity method, plus an early repayment schedule.",
    howToTitle: "How to use",
    steps: ["Enter the loan principal.", "Enter the annual interest rate (%).", "Set the term (months or years).", "Review the monthly payment, total interest, and schedule."],
    formulaTitle: "Highlights",
    formulas: [
      { title: "Annuity repayment", body: "Computes the equal-monthly-payment schedule." },
      { title: "Repayment schedule", body: "Shows the early monthly principal/interest split." },
      { title: "Instant result", body: "Results update as soon as you enter values." },
    ],
    faqTitle: "Questions fréquentes",
    faqs: [
    { question: "What is annuity repayment?", answer: "You pay the same total amount each month, combining principal and interest." },
    { question: "How do I reduce total interest?", answer: "Shorten the term, lower the rate, or make prepayments where possible." },
    { question: "Is this different from a mortgage?", answer: "The math is the same; a mortgage is secured by collateral, which can change rate and limit terms." },
    ],
    disclaimer: "This calculator is for reference only. Actual results vary with loan terms, fees, and variable rates. Confirm exact terms with your lender.",
  },
  es: {
    introTitle: "What is the loan calculator?",
    intro: "Enter the loan amount, annual rate, and term to compute the monthly payment and total interest with the annuity method, plus an early repayment schedule.",
    howToTitle: "How to use",
    steps: ["Enter the loan principal.", "Enter the annual interest rate (%).", "Set the term (months or years).", "Review the monthly payment, total interest, and schedule."],
    formulaTitle: "Highlights",
    formulas: [
      { title: "Annuity repayment", body: "Computes the equal-monthly-payment schedule." },
      { title: "Repayment schedule", body: "Shows the early monthly principal/interest split." },
      { title: "Instant result", body: "Results update as soon as you enter values." },
    ],
    faqTitle: "Preguntas frecuentes",
    faqs: [
    { question: "What is annuity repayment?", answer: "You pay the same total amount each month, combining principal and interest." },
    { question: "How do I reduce total interest?", answer: "Shorten the term, lower the rate, or make prepayments where possible." },
    { question: "Is this different from a mortgage?", answer: "The math is the same; a mortgage is secured by collateral, which can change rate and limit terms." },
    ],
    disclaimer: "This calculator is for reference only. Actual results vary with loan terms, fees, and variable rates. Confirm exact terms with your lender.",
  },
};
const c = content[locale];
const url = `https://tools.oiyo.net/${locale}/loan-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: c.steps, faqs: c.faqs });
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <LoanCalculator client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <UtilityArticle c={c} />
    <RelatedUtilities locale={locale} current="loan-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
