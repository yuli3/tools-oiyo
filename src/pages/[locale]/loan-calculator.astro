---
// Moved from blog.oiyo.net/{locale}/loan-calculator/ on 2026-10-27 (W15).
import Layout from '../../components/Layout.astro';
import UtilityArticle, { type UtilityContent } from '../../components/UtilityArticle.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import LoanCalculator from '../../components/tools/LoanCalculator';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "대출 계산기 — 월 상환액·총 이자 간편 계산 (원리금균등)",
    description: "대출금액, 금리, 기간을 입력해 월 상환액과 총 이자를 계산합니다. 원리금균등상환 방식 기준으로 첫 12개월 상환 스케줄을 제공합니다.",
  },
  en: {
    title: "Loan Repayment Calculator — Monthly Payment & Total Interest",
    description: "Calculate monthly payments and total interest for equal principal-and-interest (annuity) loans.",
  },
  ja: {
    title: "ローン返済計算機 — 月額返済額・総利息計算",
    description: "元利均等返済方式で月額返済額と総利息を計算します。",
  },
  zh: {
    title: "贷款计算机 — 月还款额与总利息计算",
