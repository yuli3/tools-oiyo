const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: c.steps, faqs: c.faqs });
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    {country ? <FreelancerTaxCountryCalculator client:load country={country} /> : <KrIncomeTaxCalculator client:load locale={locale === 'ko' ? 'ko' : 'en'} variant="freelancer" />}
    {!country && <p class="mt-4 text-xs text-muted-foreground">근거: 소득세법 제55조·제59조의4·제129조, 국세청 경비율 고시. 기준일 {INCOME_TAX_AS_OF}.</p>}
    <UtilityArticle c={c} />
    <RelatedUtilities locale={locale} current="freelancer-tax-calculator" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
