---
import Layout from '../../components/Layout.astro';
import {locales,shellCopy,utilityLabels,utilitySlugs,type Locale} from '../../lib/i18n';
import {monitorPpiCopy} from '../../data/monitor-ppi-copy';
import {laborToolsForLocale} from '../../data/country-labor';
import {regionalLaborForLocale} from '../../data/regional-labor';
import {loanCopy} from '../../lib/loan-comparison-copy';
import {usageCostCopy} from '../../data/usage-cost-copy';
import {converterCopy} from '../../lib/fx-copy';
import {EXCHANGE_COPY} from '../../components/tools/ForeignExchangeFeeCalculator';
import {utilityCatalog,utilityGroups} from '../../data/utility-catalog';
export function getStaticPaths(){return locales.filter(l=>l!=='ko').map(locale=>({params:{locale},props:{locale}}));}
const {locale}=Astro.props as {locale:Locale};
const copy=shellCopy[locale],labor=[...laborToolsForLocale(locale),...regionalLaborForLocale(locale)];
const heading={ko:'도구',en:'Tools in English',ja:'日本語のツール',zh:'中文工具',fr:'Outils en français',es:'Herramientas en español'}[locale];
---
<Layout title={heading} description={heading} locale={locale} canonicalURL={`https://tools.oiyo.net/${locale}/`}>
  <div class="mx-auto max-w-3xl space-y-5 px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{heading}</h1>
    <section class="space-y-2 border-b border-border pb-4"><h2 class="text-lg font-semibold"><a href={`/${locale}/usage-cost-calculator/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{usageCostCopy[locale].title}</a></h2><p class="text-sm leading-relaxed">{usageCostCopy[locale].description}</p></section>
    <section class="space-y-2 border-b border-border pb-4"><h2 class="text-lg font-semibold"><a href={`/${locale}/currency-converter/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{converterCopy[locale].title}</a></h2><p class="text-sm leading-relaxed">{converterCopy[locale].description}</p></section>
    <section class="space-y-2 border-b border-border pb-4"><h2 class="text-lg font-semibold"><a href={`/${locale}/foreign-exchange-fee-calculator/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{EXCHANGE_COPY[locale][0]}</a></h2><p class="text-sm leading-relaxed">{EXCHANGE_COPY[locale][1]}</p></section>
    <section class="space-y-2 border-b border-border pb-4"><h2 class="text-lg font-semibold"><a href={`/${locale}/loan-comparison-calculator/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{loanCopy[locale].title}</a></h2><p class="text-sm leading-relaxed">{loanCopy[locale].description}</p></section>
    {labor.map(t=><section class="space-y-2 border-b border-border pb-4" lang={t.languageTag} data-country-tool={t.slug}><h2 class="text-lg font-semibold"><a href={`/${t.locale}/${t.slug}/`} class="text-primary underline underline-offset-4">{t.title}</a></h2><p class="text-sm leading-relaxed">{t.description}</p><p class="text-sm text-muted-foreground">{t.jurisdiction}</p></section>)}
    <section class="space-y-3"><h2 class="text-lg font-semibold">{copy.related}</h2><ul class="space-y-2 text-sm">{utilitySlugs.map((slug,i)=><li><a href={`/${locale}/${slug}/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{utilityLabels[locale][i]}</a></li>)}<li><a class="inline-flex min-h-11 items-center text-primary underline underline-offset-4" href={`/${locale}/monitor-ppi-calculator/`}>{monitorPpiCopy[locale].title}</a></li></ul></section>
    {(['money','everyday','screen','image','color','dev'] as const).map(g=><section class="space-y-3 border-t border-border pt-4"><h2 class="text-lg font-semibold">{utilityGroups[g][locale]}</h2><ul class="space-y-2 text-sm">{utilityCatalog.filter(t=>t.group===g).map(t=><li><a href={`/${locale}/${t.slug}/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{t.title[locale]}</a><p class="text-muted-foreground">{t.description[locale]}</p></li>)}</ul></section>)}
    <nav aria-label="Deutsch · Nederlands" class="flex flex-wrap gap-3 text-sm"><a href="/de/" lang="de" class="inline-flex min-h-11 items-center text-primary underline">Deutsch: Arbeitsrecht</a><a href="/nl/" lang="nl" class="inline-flex min-h-11 items-center text-primary underline">Nederlands: werk en verlof</a></nav>
    <nav aria-label={copy.language} class="flex flex-wrap gap-3 text-sm">{locales.map(lang=><a href={lang==='ko'?'/':`/${lang}/`} lang={lang} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{lang.toUpperCase()}</a>)}</nav>
  </div>
</Layout>
