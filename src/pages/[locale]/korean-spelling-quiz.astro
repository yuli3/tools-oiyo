---
// Moved from blog.oiyo.net/{locale}/korean-spelling-quiz/ on 2026-10-27 (W15).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import KoreanSpellingQuiz from '../../components/tools/KoreanSpellingQuiz';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "한국어 맞춤법 퀴즈 — 헷갈리는 맞춤법 테스트",
    description: "돼/되, 왠/웬, 며칠/몇일 등 헷갈리는 한국어 맞춤법을 테스트해보세요. 무작위 10문제로 나의 맞춤법 실력을 확인합니다.",
  },
  en: {
    title: "Korean Spelling Quiz — Test Your Knowledge of Tricky Korean Spelling",
    description: "Test your knowledge of confusing Korean spelling rules like 됐/됬, 왠지/웬지, and more. 10 random questions to check your spelling skills.",
  },
  ja: {
    title: "韓国語スペルクイズ — 間違いやすい綴りをテスト",
    description: "돼/되、왠/웬、며칠/몇일など、間違いやすい韓国語の綴りをテスト。ランダム10問で実力を確認しましょう。",
  },
  zh: {
    title: "韩语拼写测验 — 测试容易混淆的拼写规则",
    description: "测试돼/되、왠/웬、며칠/몇일等容易混淆的韩语拼写规则，10道随机题目。",
  },
  fr: {
    title: "Quiz d'Orthographe Coréenne — Testez les Règles Difficiles",
    description: "Testez votre connaissance des règles d'orthographe coréenne difficiles avec 10 questions aléatoires.",
  },
  es: {
    title: "Quiz de Ortografía Coreana — Prueba las Reglas Difíciles",
    description: "Pon a prueba tu conocimiento de las reglas de ortografía coreana difíciles con 10 preguntas aleatorias.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/korean-spelling-quiz/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <KoreanSpellingQuiz client:load locale={locale} />
    <RelatedUtilities locale={locale} current="korean-spelling-quiz" group="calc" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
