---
// Moved from blog.oiyo.net/{locale}/journal-entry-trainer/ on 2026-10-27 (W13).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import { JournalEntryTrainer } from '../../components/tools/JournalEntryTrainer';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "회계 분개 연습기 — 차변·대변 15문제 퀴즈 & T계정 시각화",
    description: "분개의 기본 원리를 15가지 실전 문제로 연습하세요. 차변·대변 계정 선택 후 즉시 정오답 확인 및 T계정 시각화 제공.",
  },
  en: {
    title: "Journal Entry Trainer — 15-Question Debit/Credit Quiz with T-Account",
    description: "Practice double-entry bookkeeping with 15 real-world scenarios. Select debit/credit accounts and get instant feedback with T-account visualization.",
  },
  ja: {
    title: "仕訳練習ツール — 借方・貸方15問クイズ＆T勘定可視化",
    description: "15の実務シナリオで複式簿記を練習。借方・貸方勘定を選択し、即座にフィードバックとT勘定可視化を取得。",
  },
  zh: {
    title: "会计分录练习器 — 借贷15题测验",
    description: "通过15个实务场景练习复式记帐，即时获得反馈和T帐户可视化。",
  },
  fr: {
    title: "Entraîneur d'Écritures Comptables — Quiz Débit/Crédit",
    description: "Pratiquez la comptabilité en partie double avec 15 scénarios réels.",
  },
  es: {
    title: "Entrenador de Asientos Contables — Quiz Debe/Haber",
    description: "Practica contabilidad de partida doble con 15 escenarios del mundo real.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/journal-entry-trainer/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <JournalEntryTrainer client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="journal-entry-trainer" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
