---
// Moved from blog.oiyo.net/{locale}/mbti-salary-expert/ on 2026-10-27 (W13).
import Layout from '../../components/Layout.astro';
import RelatedUtilities from '../../components/RelatedUtilities.astro';
import MbtiSalaryExpert from '../../components/tools/MbtiSalaryExpert';
import { locales } from '../../lib/i18n';
import { utilityJsonLd } from '../../lib/utility-jsonld';

type ActiveLocale = (typeof locales)[number];
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: ActiveLocale };

const meta: Record<ActiveLocale, { title: string; description: string }> = {
  ko: {
    title: "MBTI 연봉 전문가 — 성격 유형별 연봉 인상 전략",
    description: "나의 MBTI 유형에 맞는 연봉 협상 전략과 인사이트를 확인하세요. 맞춤형 협상 스크립트도 제공합니다.",
  },
  en: {
    title: "MBTI Salary Expert",
    description: "Get salary negotiation strategies tailored to your MBTI personality type, including personalized negotiation scripts and insights.",
  },
  ja: {
    title: "MBTI給与エキスパート — 性格タイプ別給与交渉戦略",
    description: "MBTIタイプに合わせた給与交渉戦略とインサイトを確認。カスタマイズされた交渉スクリプトも提供します。",
  },
  zh: {
    title: "MBTI薪资专家 — 性格类型别薪资谈判策略",
    description: "确认适合您MBTI类型的薪资谈判策略和洞察。还提供个性化的谈判脚本。",
  },
  fr: {
    title: "Expert Salaire MBTI",
    description: "Obtenez des stratégies de négociation salariale adaptées à votre type MBTI, avec des scripts de négociation personnalisés.",
  },
  es: {
    title: "Experto en Salario MBTI",
    description: "Obtén estrategias de negociación salarial adaptadas a tu tipo MBTI, incluyendo scripts de negociación personalizados.",
  },
};
const m = meta[locale];
const url = `https://tools.oiyo.net/${locale}/mbti-salary-expert/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: [], faqs: [] }).slice(0, 1);
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <div class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{m.title}</h1>
    <p class="mb-5 mt-2 text-sm text-muted-foreground">{m.description}</p>
    <MbtiSalaryExpert client:load locale={locale === 'ko' ? 'ko' : 'en'} />
    <RelatedUtilities locale={locale} current="mbti-salary-expert" group="money" />
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
