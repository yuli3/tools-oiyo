---
import Layout from '../../components/Layout.astro';
import CurrencyConverter from '../../components/tools/CurrencyConverter';
import { converterCopy } from '../../lib/fx-copy';
import { EXCHANGE_COPY } from '../../components/tools/ForeignExchangeFeeCalculator';
import { locales, type Locale } from '../../lib/i18n';
export function getStaticPaths() {
  return locales.map(locale=>({params:{locale},props:{locale}}));
}
const {locale} = Astro.props as {locale:Locale};
const c = converterCopy[locale];
const url = `https://tools.oiyo.net/${locale}/currency-converter/`;
const schema = {'@context':'https://schema.org','@type':'WebApplication',name:c.title,description:c.description,url,inLanguage:locale,applicationCategory:'FinanceApplication',operatingSystem:'All',offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}};
---
<Layout title={c.title} description={c.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <article class="mx-auto max-w-3xl px-4 py-6">
    <h1 class="text-2xl font-bold tracking-tight">{c.title}</h1>
    <p class="mb-4 mt-2 text-sm leading-relaxed text-muted-foreground">{c.description}</p>
    <CurrencyConverter locale={locale} client:load/>
    <section class="mt-6 border-t border-border pt-4">
      <h2 class="text-lg font-semibold">{c.mathTitle}</h2>
      <p class="mt-2 text-sm leading-relaxed">{c.math}</p>
      <p class="mt-3 text-sm"><a href={`/${locale}/foreign-exchange-fee-calculator/`} class="inline-flex min-h-11 items-center text-primary underline underline-offset-4">{EXCHANGE_COPY[locale][0]}</a></p>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</Layout>
