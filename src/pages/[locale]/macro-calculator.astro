const c = content[locale];
const url = `https://tools.oiyo.net/${locale}/macro-calculator/`;
const schema = utilityJsonLd({ name: m.title, description: m.description, url, locale, steps: c.steps, faqs: c.faqs });
---
<Layout title={m.title} description={m.description} locale={locale} availableLocales={[...locales]} canonicalURL={url}>
  <ToolShell title={m.title} description={m.description}>
    <MacroCalculator client:load locale={locale} />
    <UtilityArticle c={c} />
    <RelatedUtilities locale={locale} current="macro-calculator" group="health" />
  </ToolShell>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
