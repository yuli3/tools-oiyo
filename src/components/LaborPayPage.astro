---
import Layout from './Layout.astro';
import LaborPayWorksheet from './tools/LaborPayWorksheet';
import {laborPay,type LaborPayId} from '../data/labor-wave4';
const {tool}=Astro.props as {tool:LaborPayId};
const t=laborPay[tool], english=t.locale==='en',url=`https://tools.oiyo.net/${t.locale}/${t.slug}/`;
const schema={'@context':'https://schema.org','@type':'WebApplication',name:t.title,description:t.description,url,inLanguage:t.languageTag,applicationCategory:'BusinessApplication',operatingSystem:'All',isAccessibleForFree:true};
---
<Layout title={t.title} description={t.description} locale={t.locale} languageTag={t.languageTag} ogLocale={t.ogLocale} canonicalURL={url}>
  <article class="mx-auto max-w-3xl space-y-4 px-4 py-6">
    <header class="space-y-2"><h1 class="text-2xl font-bold tracking-tight sm:text-3xl">{t.title}</h1><p class="text-sm leading-relaxed">{t.description}</p><p class="text-sm font-semibold">{t.jurisdiction}</p></header>
    <p class="text-sm leading-relaxed">{t.intro}</p>
    <section class="space-y-2 rounded-lg border border-border p-3"><h2 class="font-semibold">{english?'Supported scope and exclusions':'適用範圍與不支援情況'}</h2><p class="text-sm leading-relaxed">{t.scope}</p></section>
    <LaborPayWorksheet tool={tool} client:load/>
    <section class="space-y-3 border-t border-border pt-4"><h2 class="text-lg font-semibold">{english?'Method and official sources':'計算方法與官方資料'}</h2><p class="text-sm leading-relaxed">{t.method}</p>{t.notes.map(note=><p class="text-sm leading-relaxed">{note}</p>)}<ul class="list-disc space-y-2 pl-5 text-sm">{t.sources.map(([name,href])=><li><a href={href} class="text-primary underline underline-offset-4">{name}</a></li>)}</ul><p class="text-xs text-muted-foreground">{english?'Official guidance checked: 26 October 2026. Inputs are calculated in browser memory and are not added to the URL.':'官方資料確認：2026-10-26。輸入在瀏覽器記憶體內計算，不加入網址。'}</p></section>
  </article><script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</Layout>
