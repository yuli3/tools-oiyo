const targetIds = RECOMMENDATIONS[currentId] ?? ["net-salary", "severance-pay", "business-day"];
const items = targetIds.map((id) => ALL_TOOLS[id]).filter(Boolean);
---

<div class="mt-8 border-t border-border pt-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-sm font-bold text-foreground">함께 많이 찾는 도구</h3>
    <a href="/" class="text-xs font-semibold text-primary hover:underline">전체 보기 →</a>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex flex-col justify-between rounded-xl border border-border bg-card p-4 transition hover:border-primary/60 hover:shadow-xs"
      >
        <div>
          <div class="flex items-center justify-between gap-1 mb-2">
            <span class="rounded bg-muted px-1.5 py-0.5 text-[11px] font-semibold text-muted-foreground">
              {item.category}
            </span>
            <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[11px] font-bold text-primary">
              {item.badge}
            </span>
          </div>
          <h4 class="text-xs font-bold text-foreground group-hover:text-primary transition-colors">
            {item.title}
          </h4>
          <p class="mt-1 text-[11px] text-muted-foreground leading-relaxed line-clamp-2">
            {item.desc}
          </p>
        </div>
        <div class="mt-3 flex items-center gap-1 text-[11px] font-bold text-primary">
          <span>계산하기</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </div>
      </a>
    ))}
  </div>
</div>
