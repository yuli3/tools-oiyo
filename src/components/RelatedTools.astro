---
interface ToolItem {
  id: string;
  title: string;
  desc: string;
  href: string;
  badge: string;
  category: string;
}

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;

const ALL_TOOLS: Record<string, ToolItem> = {
  "unemployment-benefits": {
    id: "unemployment-benefits",
    title: "실업급여(구직급여) 모의 계산기",
    desc: "2026년 최저시급 상·하한액 기준 소정급여일수와 총 수급액",
    href: "/ko/unemployment-benefits-calculator/",
    badge: "2026 기준",
    category: "노동/복지",
  },
  "parental-leave": {
    id: "parental-leave",
    title: "육아휴직 급여 & 6+6 부모육아휴직 계산기",
    desc: "사후지급금 폐지 반영 일반 육아휴직 및 6+6 부모 특례 월별 수령액",
    href: "/ko/parental-leave-calculator/",
    badge: "부모특례 450만",
    category: "복지/육아휴직",
  },
  "overtime-pay": {
    id: "overtime-pay",
    title: "연장·야간·휴일수당 계산기",
    desc: "근로기준법 제56조 1.5배~2.0배 법정 가산수당 정밀 산출",
    href: "/ko/overtime-pay-calculator/",
    badge: "가산수당",
    category: "근로/수당",
  },
  "health-insurance": {
    id: "health-insurance",
    title: "국민건강보험료 지역가입자 & 피부양자 판정기",
    desc: "2026년 요율 7.19%·재산 기본공제 1억 원 기준 지역 건보료와 피부양자 자격 확인",
    href: "/ko/health-insurance-calculator/",
    badge: "2026 개편",
    category: "세무/복지",
  },
  "temporary-two-house": {
    id: "temporary-two-house",
    title: "일시적 2주택 비과세 처분기한 시뮬레이터",
    desc: "신규주택 1년 경과 취득 요건, 3년 처분기한 마감일 D-Day 및 비과세 충족 진단",
    href: "/ko/temporary-two-house-tax-calculator/",
    badge: "1-2-3 법칙",
    category: "부동산/세무",
  },
  "car-bond-refund": {
    id: "car-bond-refund",
    title: "자동차 채권 환급금 & 공채 할인 매도 계산기",
    desc: "시·도별 공채 매입 비율·면제 기준 및 즉시 할인 매도 본인부담금 산출",
    href: "/ko/car-bond-refund-calculator/",
    badge: "차량 공채",
    category: "자동차/세무",
  },
  "gas-bill": {
    id: "gas-bill",
    title: "도시가스 요금 계산기 (난방·취사)",
    desc: "열량단가 및 기본료, 부가세 10% 반영 예상 청구액 산출",
    href: "/ko/gas-bill-calculator/",
    badge: "가스공사 공식",
    category: "생활/공공요금",
  },
  "waste-sorter": {
    id: "waste-sorter",
    title: "생활 폐기물 분리배출 판별기",
    desc: "16대 생활 품목의 종량제·음식물·재활용 분류 기준 실시간 검색",
    href: "/ko/waste-sorter/",
    badge: "인기",
    category: "생활 규약",
  },
  "wind-chill": {
    id: "wind-chill",
    title: "체감온도 및 온열지수 계산기",
    desc: "기상청 JAG/TI 모델 및 여름철 습구 온열지수 정밀 연산",
    href: "/ko/wind-chill-calculator/",
    badge: "기상청 공식",
    category: "기상 환경",
  },
  "military-service": {
    id: "military-service",
    title: "군 복무일 · 전역일 및 진급일 계산기",
    desc: "군별 복무기간 기준 전역일, 남은 일수, 복무율(%) 산출",
    href: "/ko/military-service-calculator/",
    badge: "병역법",
    category: "생활/병무",
  },
  "business-day": {
    id: "business-day",
    title: "대한민국 법정 영업일·공휴일 조회기",
    desc: "관공서 공휴일 규정 및 대체공휴일 기준 영업일 여부 판별",
    href: "/ko/business-day-checker/",
    badge: "B2A 지원",
    category: "캘린더/행정",
  },
};

const RECOMMENDATIONS: Record<string, string[]> = {
  "unemployment-benefits": ["parental-leave", "overtime-pay", "health-insurance"],
  "parental-leave": ["unemployment-benefits", "health-insurance", "business-day"],
  "overtime-pay": ["unemployment-benefits", "parental-leave", "business-day"],
  "health-insurance": ["unemployment-benefits", "parental-leave", "temporary-two-house"],
  "temporary-two-house": ["health-insurance", "car-bond-refund", "business-day"],
  "car-bond-refund": ["temporary-two-house", "gas-bill", "health-insurance"],
  "gas-bill": ["waste-sorter", "wind-chill", "car-bond-refund"],
  "waste-sorter": ["gas-bill", "wind-chill", "business-day"],
  "wind-chill": ["gas-bill", "waste-sorter", "business-day"],
  "military-service": ["business-day", "unemployment-benefits", "overtime-pay"],
  "business-day": ["military-service", "unemployment-benefits", "waste-sorter"],
};

const targetIds = RECOMMENDATIONS[currentId] ?? ["unemployment-benefits", "health-insurance", "business-day"];
const items = targetIds.map((id) => ALL_TOOLS[id]).filter(Boolean);
---

<div class="mt-8 border-t border-border pt-6">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-sm font-bold text-foreground">함께 많이 찾는 도구</h3>
    <a href="/" class="text-xs font-semibold text-primary hover:underline">전체 보기 →</a>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    {items.map((item) => (
      <a
        href={item.href}
        class="group flex flex-col justify-between rounded-xl border border-border bg-card p-4 transition hover:border-primary/60 hover:shadow-xs"
      >
        <div>
          <div class="flex items-center justify-between gap-1 mb-2">
            <span class="rounded bg-muted px-1.5 py-0.5 text-[11px] font-semibold text-muted-foreground">
              {item.category}
            </span>
            <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[11px] font-bold text-primary">
              {item.badge}
            </span>
          </div>
          <h4 class="text-xs font-bold text-foreground group-hover:text-primary transition-colors">
            {item.title}
          </h4>
          <p class="mt-1 text-[11px] text-muted-foreground leading-relaxed line-clamp-2">
            {item.desc}
          </p>
        </div>
        <div class="mt-3 flex items-center gap-1 text-[11px] font-bold text-primary">
          <span>계산하기</span>
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </div>
      </a>
    ))}
  </div>
</div>
