---
import Layout from './Layout.astro';
import UtilityArticle from './UtilityArticle.astro';
import RelatedUtilities from './RelatedUtilities.astro';
import {smallUtilities} from '../data/small-utilities';
import {locales,type Locale} from '../lib/i18n';
const {slug,locale}=Astro.props as {slug:string;locale:Locale};
const {meta,content}=smallUtilities[slug][locale];
const canonical=`https://tools.oiyo.net/${locale}/${slug}/`;
const schema={'@context':'https://schema.org','@type':'WebApplication',name:meta.title,description:meta.description,url:canonical,inLanguage:locale,applicationCategory:'UtilitiesApplication',operatingSystem:'All',isAccessibleForFree:true};
---
<Layout title={meta.title} description={meta.description} locale={locale} availableLocales={[...locales]} canonicalURL={canonical}>
<article class="mx-auto max-w-3xl space-y-4 px-4 py-5" data-small-utility={slug}>
<header class="space-y-2"><h1 class="text-2xl font-bold tracking-tight">{meta.title}</h1><p class="text-sm leading-relaxed text-muted-foreground">{meta.description}</p></header>
<slot/>
<UtilityArticle c={content}/>
<RelatedUtilities locale={locale} current={slug} group={slug==='anniversary-calculator'?'time':'calc'}/>
</article><script type="application/ld+json" set:html={JSON.stringify(schema)}/>
</Layout>
