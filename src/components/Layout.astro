---
import SEO from "./SEO.astro";
import ManualAds from "./ManualAds.astro";
import "../styles/global.css";
import { shellCopy, type Locale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  canonicalURL?: URL | string;
  noindex?: boolean;
  locale?: Locale;
  availableLocales?: Locale[];
  languageTag?: string;
  ogLocale?: string;
}

const { title, description, keywords, canonicalURL, noindex, locale = 'ko', availableLocales = [], languageTag = locale, ogLocale } = Astro.props;
const copy = (languageTag==='zh-Hant-TW'||languageTag==='zh-Hant-HK')?{all:'所有工具',related:'檔案工具',language:'語言',license:'授權',note:'輸入內容在瀏覽器內計算。本站使用訪問統計與廣告。'}:shellCopy[locale];
const home=locale==='ko'?'/':`/${locale}/`;
const pageSlug = Astro.url.pathname.split('/').filter(Boolean)[1];

const FAMILY = [
  { host: "oiyo.net", name: "OIYO tests", label: "심리테스트" },
  { host: "blog.oiyo.net", name: "OIYO blog", label: "강의·해설" },
  { host: "wiki.oiyo.net", name: "OIYO wiki", label: "지식창고" },
  { host: "game.oiyo.net", name: "OIYO game", label: "웹게임" },
  { host: "news.oiyo.net", name: "OIYO news", label: "AI·증시뉴스" },
  { host: "show.oiyo.net", name: "OIYO show", label: "AI 쇼케이스" },
  { host: "api.oiyo.net", name: "OIYO api", label: "B2A 게이트웨이" },
];
---

<!doctype html>
<html lang={languageTag}>
  <head>
    <SEO title={title} description={description} keywords={keywords} canonicalURL={canonicalURL} noindex={noindex} locale={locale} availableLocales={availableLocales} ogLocale={ogLocale} />
  </head>
  <body class="min-h-screen flex flex-col bg-background text-foreground selection:bg-primary/20">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-border/80 bg-background/80 backdrop-blur-md px-4 py-3 sm:px-8">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-3">
          <a href={home} class="flex items-center gap-1.5 text-lg font-black tracking-tight text-foreground sm:text-xl">
            <svg class="w-6 h-6 text-primary" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="100" height="100" rx="22" fill="currentColor"/>
              <path d="M68 32 C64 24 54 22 46 26 L56 36 L52 40 L42 30 C38 38 40 48 48 52 L30 70 C28 72 28 76 30 78 C32 80 36 80 38 78 L56 60 C60 68 70 70 78 66 C82 58 80 48 72 44 L62 54 L58 50 L68 40 Z" fill="#ffffff"/>
            </svg>
            <span>OIYO <span class="text-primary font-bold">tools</span></span>
          </a>
        </div>
        <nav class="flex flex-wrap items-center gap-3 text-xs font-semibold text-muted-foreground">
          <a href={home} class="inline-flex min-h-11 items-center hover:text-primary transition-colors">{copy.all}</a>
          {availableLocales.length > 1 && <label class="flex items-center gap-2">{copy.language}<select class="min-h-11 rounded-lg border border-border bg-background px-2" data-locale-switch aria-label={copy.language}>
            {availableLocales.map(lang => <option value={`/${lang}/${pageSlug}/`} selected={lang === locale}>{lang.toUpperCase()}</option>)}
          </select></label>}
        </nav>
      </div>
    </header>

    <!-- Content Slot -->
    <main id="main-content" class="flex-1">
      <slot />
      <ManualAds noindex={noindex} locale={locale} />
    </main>

    <!-- Footer with Family Links -->
    <footer class="border-t border-border bg-muted/30 px-4 py-12 text-center text-xs text-muted-foreground sm:px-8">
      <div class="mx-auto max-w-5xl space-y-6">
        <div>
          <p class="font-bold uppercase tracking-wider text-muted-foreground/80 mb-3">OIYO Family Network</p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs">
            {FAMILY.map((item) => (
              <a
                href={`https://${item.host}/?utm_source=tools&utm_medium=footer&utm_campaign=family_nav`}
                class="hover:text-primary transition-colors"
              >
                <span class="font-medium text-foreground">{item.name}</span>
                {locale === 'ko' && <span class="text-muted-foreground ml-1">({item.label})</span>}
              </a>
            ))}
          </div>
        </div>
        <div class="pt-4 border-t border-border/50 text-[11px] text-muted-foreground/70">
          <p>© {new Date().getFullYear()} Oiyo Tech · <a href={`https://blog.oiyo.net/${locale}/license/`} class="hover:text-primary">{copy.license}</a> · {copy.note}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  // 2026-10-19: switch only between the same utility's existing locale routes.
  document.querySelectorAll<HTMLSelectElement>('[data-locale-switch]').forEach(select => {
    select.addEventListener('change', () => { window.location.assign(select.value); });
  });
</script>
