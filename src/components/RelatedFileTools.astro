---
import { utilitySlugs, utilityLabels, shellCopy, type Locale } from '../lib/i18n';
interface Props { locale: Locale; current?: string; slugs?: string[] }
const { locale, current } = Astro.props;
---
<nav data-related-tools class="mt-8 rounded-xl border border-border bg-card p-4" aria-label={shellCopy[locale].related}>
  <p class="font-semibold">{shellCopy[locale].related}</p>
  <ul class="mt-3 flex flex-wrap gap-3">
    {utilitySlugs.map((slug, i) => slug !== current && <li><a class="inline-flex min-h-11 items-center rounded-lg border border-border px-3 text-primary underline" href={`/${locale}/${slug}/`}>{utilityLabels[locale][i]}</a></li>)}
  </ul>
</nav>
