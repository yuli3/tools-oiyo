---
import RelatedLinkList from './RelatedLinkList.astro';
import { utilitySlugs, utilityLabels, shellCopy, type Locale } from '../lib/i18n';
interface Props { locale: Locale; current?: string; slugs?: string[] }
const { locale, current } = Astro.props;
---
<RelatedLinkList title={shellCopy[locale].related} locale={locale} links={utilitySlugs.flatMap((slug, i) => slug === current ? [] : [{ href: `/${locale}/${slug}/`, label: utilityLabels[locale][i] }])} />
