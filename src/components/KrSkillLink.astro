---
// 11-23 주간 리포트: 사람들은 도구 페이지보다 스킬 zip·MCP를 더 많이 받아요. 한국 도구 페이지마다 같은 공식을 쓰는
// Claude 스킬과 MCP 도구 이름을 한 줄로 보여 줘요. 연결은 pro-competencies(직업 × 역량)의 tools/skills/mcp에서 와요.
import { COMPETENCIES, MCP_URL, SKILLS } from '../data/pro-competencies';
interface Props { slug: string }
const { slug } = Astro.props;
const hits = COMPETENCIES.filter((c) => c.tools.includes(slug));
const skills = [...new Set(hits.flatMap((c) => c.skills))].filter((s) => SKILLS[s]);
const mcp = [...new Set(hits.flatMap((c) => c.mcp ?? []))].slice(0, 4);
---
{(skills.length > 0 || mcp.length > 0) && (
  <aside class="rounded-lg border border-border bg-muted/40 p-4 text-sm print:hidden" aria-label="AI로 이어서 쓰기">
    <p class="font-semibold">Claude·AI로 이어서 쓰기</p>
    <ul class="mt-2 space-y-1">
      {skills.map((s) => (
        <li>Claude 스킬 <a class="font-medium underline underline-offset-4" href={SKILLS[s].zip} download>{SKILLS[s].name} (zip)</a> — 같은 근거로 Claude와 대화하며 이어 가요.</li>
      ))}
      {mcp.length > 0 && (
        <li>MCP 서버 <code class="break-all">{MCP_URL}</code> 도구: {mcp.map((m, i) => (<>{i ? ', ' : ''}<code>{m}</code></>))}</li>
      )}
    </ul>
    <p class="mt-2 text-xs text-muted-foreground">분야별로 모아 보려면 <a class="underline underline-offset-4" href="/ko/pro-office/#KR">실무 오피스</a>에 들러요.</p>
  </aside>
)}
