---
import RelatedLinkList from './RelatedLinkList.astro';
import { utilityCatalog, utilityGroups, type UtilityGroup } from '../data/utility-catalog';
import { monitorPpiCopy } from '../data/monitor-ppi-copy';
import { krFinanceTools } from '../data/kr-finance';
import { bizTools } from '../data/biz-tools';
import { welfareTools } from '../data/welfare-tools';
import { lawGuides } from '../data/law-guides';
import { krHealthTools, enHealthTools } from '../data/kr-health';
import { utilityLabels, type Locale } from '../lib/i18n';
import { CRAWL_LINKS } from '../data/crawl-links';
import { CRAWL_LINKS_INTL } from '../data/crawl-links-intl';
interface Props { locale: Locale; current: string; group: UtilityGroup }
const { locale, current, group } = Astro.props;
const isBiz = locale === 'ko' && bizTools.some((t) => t.slug === current);
const isWelfare = locale === 'ko' && welfareTools.some((t) => t.slug === current);
const isLaw = locale === 'ko' && lawGuides.some((t) => t.slug === current);
const links = isBiz || isWelfare || isLaw ? [] : utilityCatalog.filter((t) => t.group === group && t.slug !== current).map((t) => ({ href: `/${locale}/${t.slug}/`, label: t.title[locale] }));
// WHY: PPI moved earlier (2026-10-21) and sits in the same screen group.
if (group === 'screen') links.push({ href: `/${locale}/monitor-ppi-calculator/`, label: monitorPpiCopy[locale].title });
// WHY: the image converter moved first (2026-10-21) and belongs with the W2 image tools.
if (group === 'image') links.push({ href: `/${locale}/image-converter/`, label: utilityLabels[locale][0] });
// WHY 2026-11-14: business tools link to each other first, then the tax-advisor toolkit.
if (isBiz) links.push(...bizTools.filter((t) => t.slug !== current).map((t) => ({ href: `/ko/${t.slug}/`, label: t.title })), { href: '/ko/tax-advisor-toolkit/', label: '세무·회계 실무 도구 모음' });
// WHY 2026-11-16: benefit/labor-rights tools link to each other first, then the related finance tools.
if (isWelfare) links.push(...welfareTools.filter((t) => t.slug !== current).map((t) => ({ href: `/ko/${t.slug}/`, label: t.title })), { href: '/ko/unemployment-benefits-calculator/', label: '실업급여 계산기' }, { href: '/ko/parental-leave-calculator/', label: '육아휴직 급여 계산기' }, { href: '/ko/benefit-finder/', label: '생애주기 혜택 찾기' });
// WHY 2026-11-16: law guides link to each other, then the benefit and tax toolkits.
if (isLaw) links.push(...lawGuides.filter((t) => t.slug !== current).map((t) => ({ href: `/ko/${t.slug}/`, label: t.title })), { href: '/ko/benefit-rights-toolkit/', label: '생활 지원금·노동권 도구 모음' }, { href: '/ko/tax-advisor-toolkit/', label: '세무·회계 실무 도구 모음' }, { href: '/ko/statute-limitations-calculator/', label: '소멸시효 계산기' });
// WHY: the W8 Korean finance tools exist only on ko pages.
if (group === 'money' && locale === 'ko' && !isBiz && !isWelfare && !isLaw) links.push(...krFinanceTools.filter((t) => t.slug !== current).map((t) => ({ href: `/ko/${t.slug}/`, label: t.title })));
// WHY: W14 health tools outside the six-locale catalog (ko-only, or en/ko and en only like Blog had them).
if (group === 'health' && locale === 'ko') links.push(...krHealthTools.filter((t) => t.slug !== current).map((t) => ({ href: `/ko/${t.slug}/`, label: t.title })));
if (group === 'health' && locale === 'en') links.push(...enHealthTools.filter((t) => t.slug !== current).map((t) => ({ href: `/en/${t.slug}/`, label: t.title })));
// WHY 2026-11-21: 색인된 페이지에서 아직 안 읽힌 관련 새 도구를 맨 앞에 걸어 발견을 앞당겨요(크롤 진단 대책 3).
if (locale === 'ko' && CRAWL_LINKS[current]) {
  const fresh = CRAWL_LINKS[current].map((l) => ({ href: `/ko/${l.slug}/`, label: l.label }));
  const seen = new Set(fresh.map((l) => l.href));
  links.splice(0, links.length, ...fresh, ...links.filter((l) => !seen.has(l.href)));
}
// WHY 2026-11-23: en·ja·zh·fr·es 색인 페이지 → 아직 안 읽힌 금융·세금·급여 도구(scripts/build-crawl-links-intl.mjs).
// 주제가 다른 페이지에도 걸리므로 맨 앞이 아니라 뒤에 붙여요. 접힌 목록이어도 HTML에 있어 크롤러는 읽어요.
const intl = locale === 'ko' ? undefined : CRAWL_LINKS_INTL[locale]?.[current];
if (intl) {
  const seen = new Set(links.map((l) => l.href));
  links.push(...intl.map((l) => ({ href: `/${locale}/${l.slug}/`, label: l.label })).filter((l) => !seen.has(l.href)));
}
---
<RelatedLinkList title={isBiz ? '경영 도구' : isWelfare ? '생활 지원금·노동권 도구' : isLaw ? '법령 길잡이' : utilityGroups[group][locale]} links={links} locale={locale} />
